[Unit]
Description=Docker socket for the %i agent's parallel clones
Requires=agent-docker@%i.service
After=agent-docker@%i.service

# A folder of its own beside the clones: a clone's sandbox mounts this folder, never the project's
# checkout, and a folder mount stays live when the socket is made again.
[Service]
User=agent-%i
Group=agent-docker
TemporaryFileSystem=/home:ro
BindPaths=/home/theo/IdeaProjects/.parallel/%i/.agent-docker
ExecStart=/usr/bin/socat -t 86400 UNIX-LISTEN:/home/theo/IdeaProjects/.parallel/%i/.agent-docker/docker.sock,fork,mode=0660,unlink-early UNIX-CONNECT:/run/agent-%i/docker.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
