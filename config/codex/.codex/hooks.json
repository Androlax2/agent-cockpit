{
  "description": "Cockpit lifecycle reporting only; never grants native tool approvals.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 5 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 5 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 5 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 3 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "cockpit-codex-hook", "timeout": 3 }] }]
  }
}
