{
  "filesystem": {
    "defaultDenyRead": true,
    "allowRead": [
      "~/.cache/chrome-sandbox",
      "~/dotfiles/config/claude",
      "~/dotfiles/config/bin/.local/bin/ask-to-run",
      "~/dotfiles/config/bin/.local/bin/ask-to-guide",
      "~/dotfiles/config/bin/.local/bin/claude-todo",
      "~/dotfiles/config/bin/.local/bin/claude-design",
      "~/dotfiles/apps/target/release/ask-to-run",
      "~/dotfiles/apps/target/release/ask-to-guide",
      "~/dotfiles/apps/target/release/claude-todo",
      "~/dotfiles/apps/target/release/claude-design"
    ],
    "allowWrite": [
      "/run/user/1000/osd.fifo",
      "/run/user/1000/claude-report"
    ],
    "denyRead": [
      "~/.ssh/id_*",
      "~/.gnupg/**",
      "~/.aws/**",
      "~/.kube/**",
      "~/.docker/config.json",
      "~/.netrc",
      "~/.git-credentials",
      "~/.password-store/**",
      "~/.local/share/keyrings/**",
      "~/.mozilla/**",
      "~/.config/chromium/**",
      "~/.config/google-chrome/**",
      ".env",
      ".env.*",
      "~/.local/share/greyproxy/ca-key.pem",
      "~/.local/share/greyproxy/session.key",
      "~/.local/share/greyproxy/greyproxy.db",
      "~/.local/share/greyproxy/greyproxy.db-wal",
      "~/.local/share/greyproxy/greyproxy.db-shm",
      "~/.local/share/fish/**",
      "~/.local/share/DBeaverData/**",
      "~/.local/share/opencode/**",
      "~/.local/share/com.vercel.cli/**",
      "~/.local/share/Trash/**",
      "~/.local/share/JetBrains/**",
      "~/.local/state/restic-backup/**",
      "~/.local/state/claude-audit",
      "~/.config/Bitwarden/**",
      "~/.config/BraveSoftware/**",
      "~/.config/vivaldi/**",
      "~/.config/opera/**",
      "~/.config/microsoft-edge/**",
      "~/.config/mozilla/**",
      "~/.config/zen/**",
      "~/.config/Element/**",
      "~/.config/Ledger Live/**",
      "~/.config/Ledger Wallet/**",
      "~/.config/composer/**",
      "~/.config/configstore/**",
      "~/.config/Synology/**",
      "~/.config/privateinternetaccess/**",
      "~/.config/HTTPie/**",
      "~/.config/sunshine/**",
      "~/.config/opencode/**",
      "~/.config/vdirsyncer/**",
      "~/.config/khal/**",
      "~/.config/kdeconnect/**",
      "~/.config/JetBrains/**",
      "~/.cache/thunderbird/**",
      "~/.cache/mozilla/**",
      "~/.cache/zen/**",
      "~/.cache/google-chrome/**",
      "~/.cache/chromium/**",
      "~/.cache/com.bitwarden.desktop/**",
      "~/.cache/thumbnails/**",
      "~/.cache/restic/**"
    ],
    "denyWrite": [
      "~/.config/fish",
      "~/.local/bin",
      "~/.config/greywall",
      "~/dotfiles/config/greywall",
      "~/.config/systemd",
      "~/.config/autostart",
      "~/.gitconfig",
      "~/.ssh",
      "~/.gnupg",
      ".git/hooks",
      ".git/config",
      "~/.claude/settings.json",
      "~/.claude/settings.local.json",
      "~/.claude/hooks",
      "~/.claude/statusline-command.sh",
      "~/.claude/plugins",
      "~/.claude/agents",
      "~/.claude/skills",
      "~/.claude/CLAUDE.md",
      ".claude/settings.json",
      ".claude/settings.local.json",
      "~/.local/share/claude/versions",
      "~/.ssh/known_hosts"
    ]
  },
  "command": {
    "useDefaults": true,
    "deny": [
      "sudo",
      "git push --force",
      "git push -f",
      "git push origin main",
      "npm publish",
      "pnpm publish",
      "gh pr merge",
      "gh repo delete",
      "gh secret"
    ]
  }
}
