{
  "network": {
    "rules": [
      { "destination": "api.openai.com", "port": "443", "action": "allow" },
      { "destination": "*.frame.claudeusercontent.com", "port": "443", "action": "allow" },
      { "destination": "assets-proxy.anthropic.com", "port": "443", "action": "allow" },
      { "destination": "api.anthropic.com", "port": "443", "action": "allow" },
      { "destination": "opencode.ai", "port": "443", "action": "allow" },
      { "destination": "models.dev", "port": "443", "action": "allow" },
      { "destination": "github.com", "port": "443", "action": "allow" },
      { "destination": "claude.ai", "port": "443", "action": "allow" },
      { "destination": "*.claude.ai", "port": "443", "action": "allow" },
      { "destination": "*.claudeusercontent.com", "port": "443", "action": "allow" },
      { "destination": "fonts.googleapis.com", "port": "443", "action": "allow" },
      { "destination": "fonts.gstatic.com", "port": "443", "action": "allow" },
      { "destination": "api.github.com", "port": "443", "action": "allow" },
      { "destination": "*.githubusercontent.com", "port": "443", "action": "allow" },
      { "destination": "registry.npmjs.org", "port": "443", "action": "allow" }
    ]
  },
  "filesystem": {
    "allowRead": [
      ".", "~/CLAUDE.md", "~/AGENTS.md", "~/.gitconfig", "~/.gitignore", "~/.config/git",
      "~/.ssh/config", "~/.ssh/known_hosts", "~/.ssh/allowed_signers", "~/.skills", "~/.agents",
      "~/.claude/agents", "~/.claude/skills", "~/.config/gh", "~/.config/glab-cli",
      "~/.codex", "~/.local/npm/bin/codex", "~/.local/npm/lib/node_modules/@openai/codex",
      "~/dotfiles/config/codex", "~/dotfiles/config/bin/.local/bin/cockpit-codex-hook",
      "~/dotfiles/apps/target/release/cockpit-codex-hook"
    ],
    "denyRead": ["~/.ssh/id_*", "~/.gnupg/**", ".env", ".env.*"],
    "allowWrite": [".", "~/.cache/gh", "~/.local/state/gh", "~/.codex", "~/.cache/claude"],
    "denyWrite": [
      "~/.bashrc", "~/.bash_profile", "~/.zshrc", "~/.zprofile", "~/.profile", "~/.ssh", "~/.gnupg",
      "~/.config/fish", "~/.local/bin", "~/.config/greywall", "~/dotfiles/config/greywall",
      "~/.config/systemd", "~/.config/autostart", "~/.gitconfig", ".git/hooks", ".git/config",
      "~/.skills", "~/.agents", "~/AGENTS.md", "~/.config/gh", "~/.local/share/gh",
      "~/.codex/config.toml", "~/.codex/hooks.json", "~/.codex/hooks", "~/.claude/hooks",
      "~/dotfiles/config/codex", "~/.local/npm"
    ]
  },
  "command": {
    "deny": ["sudo", "git push --force", "git push -f", "git push origin main", "npm publish", "pnpm publish", "gh pr merge", "gh repo delete", "gh secret"],
    "allow": null,
    "useDefaults": true
  },
  "ssh": { "allowedHosts": null, "deniedHosts": null, "allowedCommands": null, "deniedCommands": null },
  "credentials": {},
  "schemaVersion": 1
}
