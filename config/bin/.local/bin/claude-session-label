#!/usr/bin/env bash
set -euo pipefail

if (( $# != 1 )); then
    echo "usage: claude-session-label '<3–6 word task label>'" >&2
    exit 2
fi
if [[ ${COCKPIT_AGENT:-} == codex ]]; then
    jq -cn --arg session "${CODEX_THREAD_ID:-}" --arg label "$1" --arg cwd "$PWD" \
        '{hook_event_name: "TaskLabel", session_id: $session, label: $label, cwd: $cwd}' | cockpit-codex-hook
    exit $?
fi
session=${CLAUDE_CODE_SESSION_ID:-}
agent=claude
[[ $session != ses_* ]] || agent=opencode
here=$(dirname "$(readlink -f "$0")")
jq -cn --arg session "$session" --arg label "$1" --arg cwd "$PWD" \
    '{hook_event_name: "TaskLabel", session_id: $session, label: $label, cwd: $cwd}' |
    COCKPIT_AGENT="$agent" bash "$here/../../../claude/.claude/hooks/session-state.sh"
