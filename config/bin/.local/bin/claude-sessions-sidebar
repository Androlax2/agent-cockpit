def collapse(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def reported_sessions() -> list[dict]:
    try:
        with open(SNAPSHOT_PATH) as snapshot:
            return json.load(snapshot)["sessions"]
    except (OSError, ValueError, KeyError, TypeError):
        return []


def tmux_claude_panes() -> list[dict]:
    """One row per claude-retry-* tmux session: the pane claude runs in, its path and title."""
    result = subprocess.run(
        ["tmux", "list-panes", "-a", "-F", "#{session_name}\t#{pane_id}\t#{pane_current_path}\t#{pane_title}\t#{session_created}"],
        capture_output=True, text=True)
    if result.returncode != 0:
        return []
    rows = []
    for line in result.stdout.splitlines():
        session_name, pane, path, title, created = (line.split("\t") + [""] * 5)[:5]
        if session_name.startswith(RETRY_SESSION_PREFIX):
            rows.append({"name": session_name, "pane": pane, "path": path, "title": title, "created": created})
    return rows


def running_sessions() -> list[dict]:
    """Reported sessions first, then tmux sessions the daemon does not know about."""
    sessions = reported_sessions()
    known_panes = {session.get("tmux_pane") for session in sessions}
    for row in tmux_claude_panes():
        if row["pane"] in known_panes:
            continue
        sessions.append({
            "session": row["name"], "state": "unknown", "project": project_name(row["path"]),
            "task": row["title"].lstrip("✳◐◑ "), "since": int(row["created"] or time.time()), "tmux_pane": row["pane"],
            "started": int(row["created"] or time.time()),
            "cwd": row["path"],
        })
    return sessions


def usage_cache() -> dict:
    try:
        with open(USAGE_CACHE_PATH) as cache:
            usage = json.load(cache)
    except (OSError, ValueError):
        return {}
    return usage if isinstance(usage, dict) else {}


def usage_windows() -> list[dict]:
    """Every limit in the cache claude-usage.sh keeps, as the claude.ai usage page lists them:
    label, rounded percentage (None when unknown), reset time, and a note for scoped limits."""
    usage = usage_cache()
    if isinstance(usage.get("limits"), list):
        return [limit_window(limit) for limit in usage["limits"] if isinstance(limit, dict)]
    known = dict(USAGE_WINDOWS)
    windows = [(key, label, usage.get(key)) for key, label in USAGE_WINDOWS]
    windows += [(key, usage_label(key), window) for key, window in sorted(usage.items())
                if key not in known and isinstance(window, dict) and "utilization" in window]
    windows += [(f"model-{index}", f"{scoped.get('display_name') or 'Model'} this week", scoped)
                for index, scoped in enumerate(usage.get("model_scoped") or [])]
    rows = []
    for key, label, window in windows:
        if not isinstance(window, dict):
            continue
        value = window.get("utilization")
        rows.append({"key": key, "label": label, "percentage": round(value) if isinstance(value, (int, float)) else None,
                     "resets": reset_time(window.get("resets_at")), "resets_at": window.get("resets_at"), "note": ""})
    return rows


def limit_window(limit: dict) -> dict:
    """One entry of the response's limits list. A scoped weekly limit names its model or surface
    (Fable this week) and says so, as the page does."""
    kind = limit.get("kind") or ""
    scope = limit.get("scope") or {}
    scoped_name = next((part.get("display_name") for part in (scope.get("model"), scope.get("surface"))
                        if isinstance(part, dict) and part.get("display_name")), "")
    if kind in USAGE_LIMIT_LABELS:
        label, note = USAGE_LIMIT_LABELS[kind], ""
    elif scoped_name:
        label, note = f"{scoped_name} this week", f"separate weekly limit for {scoped_name}"
    else:
        label, note = kind.replace("_", " ").capitalize() or "Limit", ""
    percent = limit.get("percent")
    return {"key": kind + (":" + scoped_name if scoped_name else ""), "label": label,
            "percentage": round(percent) if isinstance(percent, (int, float)) else None,
            "resets": reset_time(limit.get("resets_at")), "resets_at": limit.get("resets_at"), "note": note}


def usage_breakdown() -> list[tuple[str, int]]:
    """Where this week's usage went (Claude Code, Chats, Cowork …), non-zero rows only."""
    rows = (usage_cache().get("seven_day_breakdown") or {}).get("rows") or []
    return [(row.get("display_name") or row.get("key") or "?", round(row["percent"]))
            for row in rows if isinstance(row, dict) and isinstance(row.get("percent"), (int, float)) and row["percent"] > 0]


def usage_credits() -> str:
    """"€0 of €170 usage credits" from the spend block, empty when the response has none."""
    spend = usage_cache().get("spend") or {}
    used, limit = spend.get("used") or {}, spend.get("limit") or {}
    if not isinstance(used.get("amount_minor"), (int, float)):
        return ""
    def money(amount: dict) -> str:
        exponent = amount.get("exponent", 2)
        value = amount.get("amount_minor", 0) / (10 ** exponent)
        symbol = {"EUR": "€", "USD": "$", "GBP": "£"}.get(amount.get("currency"), amount.get("currency", "") + " ")
        return f"{symbol}{value:.0f}" if value == int(value) else f"{symbol}{value:.2f}"
    text = f"{money(used)} of {money(limit)} usage credits" if isinstance(limit.get("amount_minor"), (int, float)) else f"{money(used)} usage credits"
    if not spend.get("enabled"):
        text += "  (off)"
    return text


def usage_label(key: str) -> str:
    """"seven_day_fable" -> "Fable this week"; anything else keeps its words."""
    if key.startswith("seven_day_"):
        return key[len("seven_day_"):].replace("_", " ").capitalize() + " this week"
    return key.replace("_", " ").capitalize()


def reset_time(stamp) -> str:
    """"15:00" when the window resets within a day, else "Mon 09:00"; empty when unknown."""
    if not stamp:
        return ""
    try:
        moment = datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return ""
    local_format = "%H:%M" if moment - datetime.now().astimezone() < timedelta(days=1) else "%a %H:%M"
    return moment.strftime(local_format)


def usage_plan() -> str:
    try:
        with open(CREDENTIALS_PATH) as credentials:
            plan = json.load(credentials).get("claudeAiOauth", {}).get("subscriptionType") or ""
    except (OSError, ValueError, AttributeError):
        return ""
    return plan.capitalize()


def usage_bar(percentage, width: int) -> str:
    if percentage is None:
        return "·" * width
    filled = min(width, round(percentage / 100 * width))
    return "█" * filled + "░" * (width - filled)


def usage_color(percentage) -> int:
    if percentage is None:
        return FG_DARK
    if percentage >= 90:
        return RED
    if percentage >= 70:
        return YELLOW
    return MAGENTA


class UsageRefresher:
    """Runs claude-usage.sh every 5 minutes so the cache the header reads stays fresh."""

    def __init__(self):
        self.last_run = 0.0

    def tick(self, force: bool = False):
        if not force and time.time() - self.last_run < USAGE_REFRESH_S:
            return
        self.last_run = time.time()
        if force:
            try:
                os.remove(USAGE_CACHE_PATH)  # the script trusts a cache younger than 4 min
            except OSError:
                pass
        if not os.access(USAGE_SCRIPT, os.X_OK):
            return  # the header then shows no usage, which is the honest display
        subprocess.Popen([USAGE_SCRIPT, "five_hour"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


COST_RESCAN_S = 60
# $ per million tokens: input, output, cache read, cache write (5 min TTL), cache write (1 h TTL).
# From the Claude API reference bundled with Claude Code (claude-api skill, prices cached
# 2026-10-06): writes cost 1.25x / 2x input, reads 0.1x input except where the table lists them.
MODEL_PRICES = {
    "claude-fable-5-1": (10, 50, 0.25, 12.5, 20), "claude-mythos-5-1": (10, 50, 0.25, 12.5, 20),
    "claude-fable-5": (10, 50, 1.0, 12.5, 20), "claude-mythos-5": (10, 50, 1.0, 12.5, 20),
    "claude-opus-5-5": (4, 20, 0.20, 5, 8),
    "claude-opus-5": (5, 25, 0.5, 6.25, 10),
    "claude-opus-4-8": (5, 25, 0.5, 6.25, 10), "claude-opus-4-7": (5, 25, 0.5, 6.25, 10), "claude-opus-4-6": (5, 25, 0.5, 6.25, 10),
    "claude-sonnet-5-5": (2, 10, 0.20, 2.5, 4), "claude-sonnet-5": (2, 10, 0.20, 2.5, 4),
    "claude-sonnet-4-6": (3, 15, 0.3, 3.75, 6),
    "claude-haiku-5-5": (0.10, 0.50, 0.01, 0.125, 0.2),
    "claude-haiku-4-5": (1, 5, 0.1, 1.25, 2),
}
HAIKU_5_5_LONG_PROMPT = (100_000, (0.50, 2.50, 0.05, 0.625, 1.0))  # above 100K prompt tokens
FAST_MODE_MULTIPLIER = 2  # usage.speed == "fast": Opus 5.5 $8 / $40


def model_prices(model: str):
    """The price row of a model id (date-suffixed ids included), or None for an unknown model."""
    matches = [known for known in MODEL_PRICES if model == known or model.startswith(known + "-")]
    return MODEL_PRICES[max(matches, key=len)] if matches else None


def reply_cost(model: str, usage: dict):
    """What one reply would cost at API prices, or None when the model has no known price."""
    prices = model_prices(model)
    if prices is None:
        return None
    tokens = lambda key: usage.get(key) or 0
    written = tokens("cache_creation_input_tokens")
    by_ttl = usage.get("cache_creation") or {}
    written_1h = by_ttl.get("ephemeral_1h_input_tokens") or 0
    written_5m = by_ttl.get("ephemeral_5m_input_tokens", written - written_1h) or 0
    prompt = tokens("input_tokens") + tokens("cache_read_input_tokens") + written
    if model.startswith("claude-haiku-5-5") and prompt > HAIKU_5_5_LONG_PROMPT[0]:
        prices = HAIKU_5_5_LONG_PROMPT[1]
    input_price, output_price, read_price, write_5m_price, write_1h_price = prices
    cost = (tokens("input_tokens") * input_price + tokens("output_tokens") * output_price
            + tokens("cache_read_input_tokens") * read_price + written_5m * write_5m_price + written_1h * write_1h_price) / 1e6
    return cost * FAST_MODE_MULTIPLIER if usage.get("speed") == "fast" else cost


USAGE_ARCHIVE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                                  "claude-sessions", "usage.sqlite")
ARCHIVE_SCHEMA = """
create table if not exists replies (
    key text primary key,          -- message id and request id: a reply copied into a forked or
                                   -- resumed transcript is the same row
    day text not null,             -- local date of the reply
    at text not null,              -- its timestamp as recorded (UTC)
    model text not null,
    project text not null,         -- basename of the session's directory
    session text not null,
    input integer not null, output integer not null, cache_read integer not null,
    cache_write_5m integer not null, cache_write_1h integer not null,
    speed text not null,
    cost real                      -- at the prices of MODEL_PRICES when archived; null: no price known
);
create index if not exists replies_day on replies (day);
create table if not exists files (path text primary key, mtime real not null, size integer not null);
"""


def open_archive(path: str = "") -> sqlite3.Connection:
    path = path or USAGE_ARCHIVE_PATH
    os.makedirs(os.path.dirname(path), exist_ok=True)
    archive = sqlite3.connect(path, timeout=10)
    archive.executescript(ARCHIVE_SCHEMA)
    return archive


def archive_transcripts(archive: sqlite3.Connection, transcripts_dir: str) -> int:
    """Copy every reply of the transcripts into the archive, which keeps them after Claude Code
    deletes the transcripts (cleanupPeriodDays, 30 days by default). Files unchanged since the last
    pass are skipped. Returns how many replies were new."""
    known = dict((path, (mtime, size)) for path, mtime, size in archive.execute("select path, mtime, size from files"))
    added = 0
    for path in glob.glob(os.path.join(transcripts_dir, "**", "*.jsonl"), recursive=True):
        try:
            status = os.stat(path)
        except OSError:
            continue
        if known.get(path) == (status.st_mtime, status.st_size):
            continue
        rows = []
        try:
            with open(path, "rb") as transcript:
                for line in transcript:
                    row = reply_row(line)
                    if row:
                        rows.append(row)
        except OSError:
            continue
        before = archive.total_changes
        archive.executemany("insert or ignore into replies values (?,?,?,?,?,?,?,?,?,?,?,?,?)", rows)
        added += archive.total_changes - before
        archive.execute("insert or replace into files values (?,?,?)", (path, status.st_mtime, status.st_size))
        archive.commit()
    return added


def reply_row(line: bytes):
    """The archive row of one transcript line, or None when it is not a priced-or-pricable reply."""
    if b'"usage"' not in line:
        return None
    try:
        record = json.loads(line)
    except ValueError:
        return None
    message = record.get("message") if isinstance(record, dict) else None
    usage = message.get("usage") if isinstance(message, dict) else None
    model = message.get("model", "") if isinstance(message, dict) else ""
    if not isinstance(usage, dict) or not record.get("timestamp") or not model or model.startswith("<"):
        return None
    try:
        moment = datetime.fromisoformat(record["timestamp"].replace("Z", "+00:00")).astimezone()
    except (ValueError, AttributeError):
        return None
    message_id, request_id = message.get("id") or "", record.get("requestId") or ""
    key = f"{message_id}:{request_id}" if message_id or request_id else "line:" + hashlib.sha1(line).hexdigest()
    tokens = lambda name: usage.get(name) or 0
    written = tokens("cache_creation_input_tokens")
    by_ttl = usage.get("cache_creation") or {}
    written_1h = by_ttl.get("ephemeral_1h_input_tokens") or 0
    written_5m = by_ttl.get("ephemeral_5m_input_tokens", written - written_1h) or 0
    return (key, moment.date().isoformat(), record["timestamp"], model, os.path.basename(record.get("cwd") or "") or "?",
            record.get("sessionId") or "", tokens("input_tokens"), tokens("output_tokens"), tokens("cache_read_input_tokens"),
            written_5m, written_1h, usage.get("speed") or "standard", reply_cost(model, usage))


def archived_costs(archive: sqlite3.Connection) -> tuple[dict[str, float], dict[str, int], float]:
    """Cost per day, output tokens of replies without a known price per model, and the all-time cost."""
    days = dict(archive.execute("select day, sum(cost) from replies where cost is not null group by day"))
    unpriced = dict(archive.execute("select model, sum(output) from replies where cost is null group by model"))
    return days, unpriced, sum(days.values())


def transcript_costs(transcripts_dir: str, archive_path: str = "") -> tuple[dict[str, float], dict[str, int]]:
    archive = open_archive(archive_path)
    try:
        archive_transcripts(archive, transcripts_dir)
        days, unpriced, _ = archived_costs(archive)
    finally:
        archive.close()
    return days, unpriced


class TranscriptCosts:
    """The archive brought up to date every minute in a thread, so the column never waits on it."""

    def __init__(self):
        self.days: dict[str, float] = {}
        self.unpriced: dict[str, int] = {}
        self.all_time = 0.0
        self.error = ""  # shown in the Status panel: a broken archive must not pass for $0
        self.scanned_at = 0.0
        self.scanning = False
        self.lock = threading.Lock()

    def tick(self):
        if self.scanning or time.time() - self.scanned_at < COST_RESCAN_S:
            return
        self.scanning = True
        threading.Thread(target=self._scan, daemon=True).start()

    def _scan(self):
        try:
            archive = open_archive()
            try:
                archive_transcripts(archive, TRANSCRIPTS_DIR)
                days, unpriced, all_time = archived_costs(archive)
            finally:
                archive.close()
        except (sqlite3.Error, OSError) as error:
            if f"usage archive: {error}" != self.error:
                log_event("ERROR", f"usage archive {USAGE_ARCHIVE_PATH}: {error}")
            with self.lock:
                self.error = f"usage archive: {error}"
                self.scanned_at, self.scanning = time.time(), False
            return
        with self.lock:
            self.days, self.unpriced, self.all_time, self.error = days, unpriced, all_time, ""
            self.scanned_at, self.scanning = time.time(), False

    def total_since(self, first_day: date) -> float:
        with self.lock:
            return sum(cost for day, cost in self.days.items() if day >= first_day.isoformat())

    def totals(self) -> dict[str, float]:
        today = date.today()
        return {"today": self.total_since(today),
                "week": self.total_since(today - timedelta(days=today.weekday())),
                "month": self.total_since(today.replace(day=1))}


def money(amount: float) -> str:
    if amount >= 10000:
        return f"${amount / 1000:.1f}k"
    return f"${amount:,.0f}" if amount >= 100 else f"${amount:.2f}"


ALERT_THRESHOLDS = (80, 95)  # percent of a usage limit
ALERTS_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                           "claude-sessions", "alerts.json")
OSD_FIFO = os.path.join(RUNTIME_DIR, "osd.fifo")
CONTEXT_COMPACT_AT = 90  # percent of the context window: the card suggests /compact


def send_notice(notice: dict) -> bool:
    """One banner through the OSD daemon's FIFO; False when the daemon is not reading it."""
    try:
        fifo = os.open(OSD_FIFO, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        os.write(fifo, ("notice " + json.dumps(notice) + "\n").encode())
    except OSError:
        return False
    finally:
        os.close(fifo)
    return True


class BudgetAlerts:
    """A banner once per limit, threshold and window when a usage limit passes 80% and 95%: the
    plan's weekly limits are the ones that stop work for days. Remembered in alerts.json so a
    restarted sidebar does not repeat itself."""

    def __init__(self, send=send_notice):
        self.send = send
        try:
            with open(ALERTS_PATH) as saved:
                self.fired = set(json.load(saved))
        except (OSError, ValueError, TypeError):
            self.fired = set()

    def check(self, windows: list[dict]):
        live, changed = set(), False
        for window in windows:
            percentage = window.get("percentage")
            for threshold in ALERT_THRESHOLDS:
                key = f"{window['key']}:{threshold}:{window.get('resets_at') or ''}"
                live.add(key)
                if percentage is None or percentage < threshold or key in self.fired:
                    continue
                resets = usage_resets_in(window)
                if self.send({"id": f"claude-usage-{threshold}", "title": f"Claude · {window['label']} at {percentage}%",
                              "message": resets[:1].upper() + resets[1:] if resets else "the plan's limit is close"}):
                    log_event("INFO", f"budget alert: {window['label']} at {percentage}% (threshold {threshold}%)")
                    self.fired.add(key)
                    changed = True
        stale = self.fired - live if windows else set()  # no usage read: keep what fired
        if stale:
            self.fired -= stale
            changed = True
        if changed:
            self.save()

    def save(self):
        try:
            os.makedirs(os.path.dirname(ALERTS_PATH), exist_ok=True)
            with open(ALERTS_PATH, "w") as saved:
                json.dump(sorted(self.fired), saved)
        except OSError:
            pass  # read-only state: alerts may repeat, nothing worse


def statusline_facts(session_id: str) -> dict:
    """The status line's last report for the session (model, context, remote). Keyed by session id,
    so it can only be old, never another session's: no age cutoff (claude-sessions reset and sweep
    delete the files)."""
    path = os.path.join(STATUSLINE_DIR, f"statusline-{session_id}.json")
    try:
        with open(path) as facts:
            return json.load(facts)
    except (OSError, ValueError):
        return {}


class ViewState:
    """What the user chose: hidden past sessions, folded projects, pins, trivial-session visibility.
    Kept on disk."""

    def __init__(self):
        self.hidden: list[str] = []
        self.folded: list[str] = []
        self.pinned: list[str] = []
        self.show_trivial = False
        self.restored_boot = 0  # the boot whose sessions were brought back (B): not offered again
        try:
            with open(VIEW_STATE_PATH) as state:
                saved = json.load(state)
            self.hidden = [str(item) for item in saved.get("hidden", [])]
            self.folded = [str(item) for item in saved.get("folded", [])]
            self.pinned = [str(item) for item in saved.get("pinned", [])]
            self.show_trivial = bool(saved.get("show_trivial", False))
            self.restored_boot = int(saved.get("restored_boot", 0))
        except (OSError, ValueError, AttributeError):
            pass

    def save(self):
        os.makedirs(os.path.dirname(VIEW_STATE_PATH), exist_ok=True)
        with open(VIEW_STATE_PATH + ".tmp", "w") as state:
            json.dump({"hidden": self.hidden, "folded": self.folded, "pinned": self.pinned,
                       "show_trivial": self.show_trivial, "restored_boot": self.restored_boot}, state)
        os.replace(VIEW_STATE_PATH + ".tmp", VIEW_STATE_PATH)

    def forget_unknown_hidden(self, known_ids: set[str]):
        """Hidden ids of sessions that left the history would otherwise accumulate forever."""
        kept = [session_id for session_id in self.hidden if session_id in known_ids]
        if len(kept) != len(self.hidden):
            self.hidden = kept
            self.save()

    def hide(self, session_id: str):
        if session_id not in self.hidden:
            self.hidden.append(session_id)
            self.save()

    def unhide_last(self) -> bool:
        if not self.hidden:
            return False
        self.hidden.pop()
        self.save()
        return True

    def toggle(self, collection: list[str], item: str):
        if item in collection:
            collection.remove(item)
        else:
            collection.append(item)
        self.save()


branch_cache: dict[str, tuple[float, str]] = {}  # cwd -> (HEAD mtime, branch)


CLONES_DIR = os.environ.get("CLAUDE_SESSIONS_CLONES", os.path.expanduser("~/IdeaProjects/.parallel"))


def repository_root(path: str) -> str:
    """The git checkout holding `path` (Claude often works in a subdirectory), or `path` itself."""
    directory = path
    while directory and directory != "/":
        if os.path.exists(os.path.join(directory, ".git")):
            return directory
        directory = os.path.dirname(directory)
    return path


def project_name(path: str) -> str:
    """A directory's project: the repository for a claude-sessions clone (<CLONES_DIR>/<repo>/<name>),
    else the directory's own name. Same rule as claude_registry.parallel_clone_repository."""
    relative = os.path.relpath(path, CLONES_DIR) if path else ".."
    parts = relative.split(os.sep)
    if len(parts) >= 2 and not relative.startswith(".."):
        return parts[0]
    return os.path.basename(path.rstrip("/")) or path


FOCUS_STATES = ("needs-you", "waiting")  # what the focus filter (f) keeps: sessions waiting on you


GREYPROXY_DB = os.environ.get("CLAUDE_SESSIONS_GREYPROXY_DB", os.path.expanduser("~/.local/share/greyproxy/greyproxy.db"))
GREYPROXY_RECENT_MINUTES = 10  # a held request retried this recently is blocking someone now
GREYPROXY_POLL_S = 10

# What a session reads only when it starts: after a change, the sessions started before it run on
# the old version until they restart. Label -> path (symlinks followed; a missing file is skipped).
SESSION_START_FILES = {
    "CLAUDE.md": "~/.claude/CLAUDE.md",
    "settings": "~/.claude/settings.json",
    "plugins": "~/.claude/plugins/installed_plugins.json",
    "ADHD mode": "~/.claude/.i-have-adhd-always",
    "session hook": "~/.claude/hooks/agent-environment.sh",
    "sandbox": "~/.config/greywall/greywall.json",
    "sandbox profile": "~/.config/greywall/learned/claude.json",
    "launcher": "~/.local/bin/greywall-agents/claude",
}


def start_file_mtimes(files: dict[str, str]) -> dict[str, float]:
    mtimes = {}
    for label, path in files.items():
        try:
            mtimes[label] = os.stat(os.path.expanduser(path)).st_mtime
        except OSError:
            continue
    return mtimes


def changed_since_start(session: dict, mtimes: dict[str, float]) -> list[str]:
    """What changed after the session started, so it does not have it yet; [] without a start time."""
    started = session.get("started")
    if not isinstance(started, (int, float)):
        return []
    return [label for label, mtime in mtimes.items() if mtime > started]


def greyproxy_held(db_path: str) -> list[str]:
    """host:port of the requests greyproxy holds for approval and that were retried in the last
    GREYPROXY_RECENT_MINUTES (older rows linger after their session gave up). Read-only."""
    try:
        database = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1)
        try:
            rows = database.execute(
                "select destination_host, destination_port from pending_requests "
                "where last_seen >= datetime('now', ?) order by last_seen desc",
                (f"-{GREYPROXY_RECENT_MINUTES} minutes",)).fetchall()
        finally:
            database.close()
    except sqlite3.Error:
        return []
    return [f"{host}:{port}" for host, port in rows]


def waiting_request(session: dict) -> str:
    """What a session needing you asks: the dialog's own lines from its pane ("Bash command · npm
    test") when the daemon read them, else the hook's sentence."""
    if session.get("state") != "needs-you":
        return ""
    return session.get("detail") or session.get("request") or ""


STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "claude-sessions")
RECENT_SESSIONS_PATH = os.path.join(STATE_DIR, "recent-sessions.json")  # kept by the daemon
ENDED_SESSIONS_PATH = os.path.join(STATE_DIR, "ended-sessions")  # appended by claude-sessions exit
RESTORE_WINDOW_S = 600  # alive in the last ten minutes before the machine went down
RESTORE_OFFER_HOURS = 6


def boot_time() -> int:
    try:
        with open("/proc/uptime") as uptime:
            return int(time.time() - float(uptime.read().split()[0]))
    except (OSError, ValueError, IndexError):
        return 0


def sessions_to_restore(recent: dict, ended: set[str], running: set[str], boot: int, resumable) -> list[dict]:
    """The sessions still alive when the machine went down: seen before this boot, within
    RESTORE_WINDOW_S of the last one seen, not ended on purpose, not running now, and with a
    conversation to resume."""
    before = {session: row for session, row in recent.items()
              if isinstance(row, dict) and row.get("last_seen", 0) < boot and row.get("cwd")}
    if not before:
        return []
    last = max(row["last_seen"] for row in before.values())
    return sorted(({"session": session, **row} for session, row in before.items()
                   if row["last_seen"] >= last - RESTORE_WINDOW_S and session not in ended
                   and session not in running and resumable(session)),
                  key=lambda row: row.get("project", ""))


def restore_offer(view: "ViewState", running: set[str]) -> list[dict]:
    boot = boot_time()
    if not boot or view.restored_boot == boot or time.time() - boot > RESTORE_OFFER_HOURS * 3600:
        return []
    try:
        with open(RECENT_SESSIONS_PATH) as saved:
            recent = json.load(saved)
    except (OSError, ValueError):
        return []
    try:
        with open(ENDED_SESSIONS_PATH) as ended_file:
            ended = set(ended_file.read().split())
    except OSError:
        ended = set()
    resumable = lambda session: bool(glob.glob(os.path.join(TRANSCRIPTS_DIR, "*", f"{session}.jsonl")))
    return sessions_to_restore(recent if isinstance(recent, dict) else {}, ended, running, boot, resumable)


def grouped_by_project(sessions: list[dict]) -> list[dict]:
    """Stable order, a repository's sessions together: pinned first, then each project at the place
    of its first session, its other sessions (parallel clones, a second session) right under it.
    Each session gets group_size (sessions of its project shown) and group_position (0 first)."""
    ordered = sorted(sessions, key=lambda session: (not session.get("pinned"), session.get("started", session.get("since", 0)), session["session"]))
    groups: dict[str, list[dict]] = {}
    for session in ordered:
        groups.setdefault(session.get("project", "?"), []).append(session)
    result = []
    for members in groups.values():
        for position, session in enumerate(members):
            session["group_size"], session["group_position"] = len(members), position
            result.append(session)
    return result


def visible_task(session: dict) -> str:
    """The session's task line, unless it is one of Claude's internal messages (<agent-message …>,
    <task-notification>), which reach the hook like prompts but mean nothing on a card."""
    task = (session.get("task") or "").strip()
    return "" if task.startswith("<") else task


def git_head_path(cwd: str) -> str:
    """The HEAD file of the repository at cwd, through a worktree's gitdir file; empty if none."""
    dot_git = os.path.join(cwd, ".git")
    if os.path.isdir(dot_git):
        return os.path.join(dot_git, "HEAD")
    try:
        with open(dot_git) as pointer:
            first = pointer.readline().strip()
    except OSError:
        return ""
    if not first.startswith("gitdir:"):
        return ""
    gitdir = first[len("gitdir:"):].strip()
    return os.path.join(cwd, gitdir, "HEAD") if not os.path.isabs(gitdir) else os.path.join(gitdir, "HEAD")


def git_branch(cwd: str) -> str:
    """The checked-out branch (or a short commit when detached), read from HEAD itself: no git
    process per tick. Cached by HEAD's mtime."""
    if not cwd:
        return ""
    head = git_head_path(cwd)
    if not head:
        return ""
    try:
        mtime = os.stat(head).st_mtime
    except OSError:
        return ""
    cached = branch_cache.get(cwd)
    if cached and cached[0] == mtime:
        return cached[1]
    try:
        with open(head) as file:
            content = file.read().strip()
    except OSError:
        return ""
    branch = content[len("ref: refs/heads/"):] if content.startswith("ref: refs/heads/") else content[:7]
    branch_cache[cwd] = (mtime, branch)
    return branch


def project_color(project: str) -> int:
    return PROJECT_COLORS[sum(map(ord, project)) % len(PROJECT_COLORS)]


def context_color(percentage) -> int:
    if percentage is None:
        return FG_DARK
    if percentage >= 80:
        return RED
    if percentage >= 50:
        return YELLOW
    return GREEN


class History:
    """Past sessions from history.jsonl (re-read when it changes) with lazily loaded titles."""

    def __init__(self):
        self.mtime = None
        self.entries: list[dict] = []
        self.titles: dict[str, str] = {}
        self.title_checked: dict[str, float] = {}  # session id -> when its transcript was last read for a title

    def refresh(self):
        try:
            mtime = os.stat(HISTORY_PATH).st_mtime
        except OSError:
            self.entries = []
            return
        if mtime == self.mtime:
            return
        self.mtime = mtime
        latest: dict[str, dict] = {}
        with open(HISTORY_PATH) as history:
            for line in history:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                session_id, project = row.get("sessionId"), row.get("project")
                if not session_id or not project:
                    continue
                since = int(row.get("timestamp", 0)) // 1000
                prompt = collapse(str(row.get("display", "")))
                entry = latest.setdefault(session_id, {"session": session_id, "cwd": project,
                                                       "project": project_name(project), "since": 0, "prompt": ""})
                entry["since"] = max(entry["since"], since)
                # Slash commands ("/resume") and paste placeholders ("[Pasted text #1 +9 lines]") say nothing
                # about the session; keep the last real prompt.
                if prompt and not prompt.startswith("/") and not prompt.startswith("[Pasted text"):
                    entry["prompt"] = prompt
        self.entries = sorted(latest.values(), key=lambda entry: -entry["since"])

    def title(self, session_id: str) -> str:
        return self.titles.get(session_id, "")

    def is_trivial(self, entry: dict) -> bool:
        """No generated title and at most a few words of prompt: nothing to come back to."""
        if self.titles.get(entry["session"], None) is None:
            return False  # not known yet: keep it visible rather than hide it on a guess
        return not self.titles[entry["session"]] and len(entry["prompt"].split()) < TRIVIAL_PROMPT_WORDS

    def recent(self, exclude: set[str], query: str, view: "ViewState") -> list[dict]:
        rows = []
        for entry in self.entries:
            if entry["session"] in exclude or entry["session"] in view.hidden:
                continue
            if not view.show_trivial and self.is_trivial(entry):
                continue
            row = {**entry, "state": "recent", "task": self.title(entry["session"]) or entry["prompt"]}
            if matches(row, query):
                rows.append(row)
            if len(rows) == RECENT_LIMIT:
                break
        return rows

    def load_titles(self, session_ids: list[str], budget: int):
        """Read the generated titles not known yet. Claude writes a session's title after its first
        exchange, so an empty one is read again every TITLE_RETRY_S instead of staying empty."""
        now = time.time()
        for session_id in session_ids:
            if budget == 0:
                return
            if self.titles.get(session_id) or now - self.title_checked.get(session_id, 0) < TITLE_RETRY_S:
                continue
            self.titles[session_id] = read_title(session_id)
            self.title_checked[session_id] = now
            budget -= 1


def read_title(session_id: str) -> str:
    transcripts = glob.glob(os.path.join(TRANSCRIPTS_DIR, "*", f"{session_id}.jsonl"))
    if not transcripts:
        return ""
    try:
        with open(transcripts[0], "rb") as transcript:
            head = transcript.read(TITLE_SCAN_BYTES)
    except OSError:
        return ""
    title = ""
    for line in head.split(b"\n"):
        if b"ai-title" not in line:
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if record.get("type") == "ai-title":
            title = record.get("aiTitle", "") or title
    return title


def matches(row: dict, query: str) -> bool:
    haystack = f"{row.get('project', '')} {row.get('task', '')} {row.get('prompt', '')}".lower()
    return all(word in haystack for word in query.lower().split())


def current_session() -> str:
    try:
        with open(CURRENT_PATH) as current:
            return current.read().strip()
    except OSError:
        return ""


def age(since: int) -> str:
    seconds = int(time.time()) - since
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def day_bucket(since: int) -> str:
    days = (date.today() - date.fromtimestamp(since)).days
    if days <= 0:
        return "TODAY"
    if days == 1:
        return "YESTERDAY"
    if days < 7:
        return "THIS WEEK"
    return "OLDER"


def clock(since: int) -> str:
    """The time inside today's and yesterday's buckets, the weekday this week, the date beyond."""
    moment = datetime.fromtimestamp(since)
    days = (date.today() - moment.date()).days
    if days <= 1:
        return moment.strftime("%H:%M")
    if days < 7:
        return moment.strftime("%a")
    return moment.strftime("%d %b")


def scratchpad_call(name: str, page: str = "") -> list[str]:
    """hyprctl eval of OPEN_IN_SCRATCHPAD (scratchpads.lua): a cockpit web window, on a page."""
    if page and (not SCRATCHPAD_PAGE.fullmatch(page) or '"' in page or "\\" in page):
        raise ValueError(f"not a page address: {page!r}")
    arguments = f'"{name}", "{page}"' if page else f'"{name}"'
    return ["hyprctl", "eval", f"OPEN_IN_SCRATCHPAD({arguments})"]


def refresh_hyprland_instance():
    """hyprctl finds Hyprland through HYPRLAND_INSTANCE_SIGNATURE. Processes that outlive a Hyprland
    restart, or start outside it (the manager's tmux server, systemd units), hold a stale or no
    value: take the running instance, the newest $XDG_RUNTIME_DIR/hypr/<id> with a socket."""
    base = os.path.join(RUNTIME_DIR, "hypr")
    current = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if current and os.path.exists(os.path.join(base, current, ".socket.sock")):
        return
    try:
        running = [entry for entry in os.scandir(base) if os.path.exists(os.path.join(entry.path, ".socket.sock"))]
    except OSError:
        return
    if running:
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = max(running, key=lambda entry: entry.stat().st_mtime).name


def open_in_scratchpad(name: str, page: str = "") -> str:
    try:
        call = scratchpad_call(name, page)
    except ValueError as error:
        return str(error)
    refresh_hyprland_instance()
    result = subprocess.run(call, capture_output=True, text=True)
    return "" if result.returncode == 0 else f"hyprctl: {(result.stderr or result.stdout).strip()[:60]}"


def focus_viewer():
    subprocess.run(["claude-sessions", "focus-viewer"])


LOG_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "claude-sessions", "log")
LOG_MAX_BYTES = 1_048_576
LOG_LINE_MAX = 300


def log_event(level: str, message: str, component: str = "sidebar"):
    """A line in the shared log (format and rotation as in claude-sessions' log_event). Never
    raises: logging must not take the column down, and the state dir is read-only in greywall."""
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > LOG_MAX_BYTES:
            os.replace(LOG_PATH, LOG_PATH + ".1")
        stamp = datetime.now().astimezone().isoformat(timespec="seconds")
        with open(LOG_PATH, "a") as log:
            log.write(f"{stamp} {level} {component}: {' '.join(message.split())[:LOG_LINE_MAX]}\n")
    except OSError:
        pass


def manager_in_background(*arguments: str):
    """For exit and restart, which wait on Claude for seconds: the sidebar must not freeze meanwhile.
    Nobody sees its terminal, so the manager sends its error messages to the log."""
    subprocess.Popen(["claude-sessions", *arguments], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     env={**os.environ, "CLAUDE_SESSIONS_LOG_STDERR": "1"})


def manager(*arguments: str) -> str:
    """Runs the manager command; returns its last error line, empty on success."""
    result = subprocess.run(["claude-sessions", *arguments], capture_output=True, text=True)
    if result.returncode == 0:
        return ""
    lines = result.stderr.strip().splitlines()
    if lines:
        log_event("ERROR", f"claude-sessions {arguments[0]}: {lines[-1]}")
    return lines[-1] if lines else f"claude-sessions {arguments[0]} failed"


def tmux_session_of(pane: str) -> str:
    if not pane:
        return ""
    result = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{session_name}"],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def kill_session(session: dict) -> str:
    """Ends the session gracefully through the manager (Ctrl-C, then its tmux session), or closes
    its terminal window when it never had a pane (started outside claude-auto-retry).
    Returns a message for the footer."""
    if session.get("tmux_pane"):
        manager_in_background("exit", session["session"])
        return f"exiting {session['project']} …"
    kitty_pid = session.get("kitty_pid")
    if kitty_pid:
        refresh_hyprland_instance()
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "pid:{kitty_pid}" }})'],
                       capture_output=True)
        return f"no tmux session for {session['project']}: closed its terminal window instead"
    # Nothing to kill: tell the daemon the session is gone. If its hook is still alive it comes back,
    # which is the signal that it lives somewhere this manager cannot see.
    report = json.dumps({"session": session["session"], "state": "gone", "project": session["project"]})
    subprocess.run(["osd-show", f"session {report}"])
    return f"nothing to kill for {session['project']}: removed it from the list"


def input_line(prompt: str) -> str:
    try:
        return input(f"\n  {prompt}").strip()
    except (EOFError, KeyboardInterrupt):
        return ""


def recent_projects(history_path: str) -> list[str]:
    """Project directories from Claude's history, most recently used first."""
    last_used: dict[str, float] = {}
    try:
        with open(history_path, "rb") as history:
            for line in history:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                project, stamp = entry.get("project"), entry.get("timestamp")
                if isinstance(project, str) and isinstance(stamp, (int, float)):
                    last_used[project] = max(stamp, last_used.get(project, 0))
    except OSError:
        return []
    return sorted(last_used, key=last_used.get, reverse=True)


def project_choices(history_path: str) -> list[str]:
    """The picker's list: the project directories (PROJECT_PATTERNS), the ones used with Claude
    most recently first (a session in a subfolder counts for its project), the rest alphabetically.
    Directories outside the projects (home, a game folder) stay out, as do claude-sessions clones."""
    known = sorted({os.path.expanduser(path).rstrip("/") for pattern in PROJECT_PATTERNS
                    for path in glob.glob(os.path.expanduser(pattern))})
    ranked: list[str] = []
    for used in recent_projects(history_path):
        owner = next((project for project in known if used == project or used.startswith(project + os.sep)), None)
        if owner and owner not in ranked:
            ranked.append(owner)
    return ranked + [project for project in known if project not in ranked]


def pick_project() -> str:
    result = subprocess.run(["fzf", "--prompt", "project> ", "--height", "100%", "--no-sort"],
                            input="\n".join(project_choices(HISTORY_PATH)), capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def next_attention_index(rows: list[dict], selected: int) -> int | None:
    candidates = [index for index, row in enumerate(rows) if row["state"] not in ("working", "recent")]
    if not candidates:
        return None
    later = [index for index in candidates if index > selected]
    return later[0] if later else candidates[0]


def group_by_day(sessions: list[dict]) -> list[tuple[str, list[dict]]]:
    buckets: dict[str, list[dict]] = {}
    for session in sessions:
        buckets.setdefault(day_bucket(session["since"]), []).append(session)
    order = ("TODAY", "YESTERDAY", "THIS WEEK", "OLDER")
    return [(name, buckets[name]) for name in order if name in buckets]


def group_by_project(sessions: list[dict]) -> list[tuple[str, list[dict]]]:
    """Projects in order of their most recent session (the input is newest first)."""
    groups: dict[str, list[dict]] = {}
    for session in sessions:
        groups.setdefault(session["project"], []).append(session)
    return list(groups.items())


def session_checkouts(only_session: str = "") -> dict[str, str]:
    """owner/repo -> local directory, for every running session whose directory has a github.com
    origin, or for the one session given (the one shown in the session pane) when it is known."""
    try:
        with open(SNAPSHOT_PATH) as snapshot:
            sessions = json.load(snapshot)["sessions"]
    except (OSError, ValueError, KeyError, TypeError):
        return {}
    if only_session:
        sessions = [session for session in sessions if session.get("session") == only_session] or sessions
    directories = {session.get("cwd") for session in sessions if session.get("cwd")}
    checkouts: dict[str, str] = {}
    for directory in sorted(directories):
        try:
            result = subprocess.run(["git", "-C", directory, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            continue
        match = GITHUB_REMOTE.search(result.stdout.strip()) if result.returncode == 0 else None
        if match and match.group(1) not in checkouts:
            checkouts[match.group(1)] = directory
    return checkouts


def session_repositories(only_session: str = "") -> list[str]:
    return list(session_checkouts(only_session))


GH_LIST_FIELDS = "number,title,url,updatedAt,author,isDraft,reviewDecision,statusCheckRollup,headRefName"
BOT_AUTHORS = {"dependabot", "renovate", "app/dependabot", "app/renovate", "dependabot[bot]", "renovate[bot]"}
CHECK_FAILED = {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"}
CHECK_PENDING = {"PENDING", "QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED", "EXPECTED"}


def gh_command(repositories: list[str]) -> list[str]:
    """Every review request, used when no session runs in a GitHub repository."""
    since = (datetime.now(timezone.utc) - timedelta(days=REVIEWS_RECENT_DAYS)).strftime("%Y-%m-%d")
    return [*GH_COMMAND, "--review-requested=@me", f"--updated=>={since}", "--", *GH_QUERY]


def gh_list_command(repository: str) -> list[str]:
    """One repository's open pull requests with their CI and review state (gh search has neither)."""
    return ["gh", "pr", "list", "--repo", repository, "--state", "open", "--limit", "20", "--json", GH_LIST_FIELDS]


def ci_state(checks) -> str:
    """failing, pending, passing, or empty when the pull request has no checks."""
    if not isinstance(checks, list) or not checks:
        return ""
    states = {str(check.get("conclusion") or check.get("state") or check.get("status") or "").upper() for check in checks if isinstance(check, dict)}
    if states & CHECK_FAILED:
        return "failing"
    if states & CHECK_PENDING or "" in states:
        return "pending"
    return "passing"


def parse_reviews(raw: str, repository: str = "") -> list[dict]:
    """Rows from gh search prs (repository in each row) or gh pr list (repository given)."""
    try:
        rows = json.loads(raw)
    except ValueError:
        return []
    reviews = []
    for row in rows if isinstance(rows, list) else []:
        full = repository or (row.get("repository") or {}).get("nameWithOwner") or (row.get("repository") or {}).get("name") or ""
        reviews.append({
            "title": row.get("title", ""), "url": row.get("url", ""), "number": row.get("number"),
            "repository": full.split("/")[-1], "full_repository": full, "author": (row.get("author") or {}).get("login", ""),
            "updated": row.get("updatedAt", ""), "draft": bool(row.get("isDraft")),
            "review": row.get("reviewDecision") or "", "ci": ci_state(row.get("statusCheckRollup")),
        })
    return reviews


def wanted_review(row: dict, since: str) -> bool:
    """Not a bot bump, and touched in the last REVIEWS_RECENT_DAYS days."""
    return row["author"] not in BOT_AUTHORS and row["updated"][:10] >= since


def fetch_reviews(repositories: list[str]) -> tuple[list[dict], str]:
    """The pull requests, or an empty list and the reason (gh missing, not logged in, offline)."""
    if REVIEWS_FIXTURE:
        with open(REVIEWS_FIXTURE) as fixture:
            return parse_reviews(fixture.read()), ""
    commands = [(gh_list_command(repository), repository) for repository in repositories] or [(gh_command([]), "")]
    rows, errors = [], []
    for command, repository in commands:
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=30)
        except FileNotFoundError:
            return [], "gh is not installed"
        except subprocess.TimeoutExpired:
            errors.append(f"{repository or 'gh'}: timed out")
            continue
        if result.returncode != 0:
            reason = result.stderr.strip().splitlines()
            errors.append(f"{repository or 'gh'}: {reason[-1] if reason else f'exit {result.returncode}'}")
            continue
        rows += parse_reviews(result.stdout, repository)
    since = (datetime.now(timezone.utc) - timedelta(days=REVIEWS_RECENT_DAYS)).strftime("%Y-%m-%d")
    rows = sorted((row for row in rows if wanted_review(row, since)), key=lambda row: row["updated"], reverse=True)
    return rows[:REVIEWS_LIMIT], "; ".join(errors)


GH_ISSUE_FIELDS = "number,title,url,updatedAt,labels"
ISSUES_PER_REPOSITORY = 20


def parse_issues(raw: str, repository: str) -> list[dict]:
    try:
        rows = json.loads(raw)
    except ValueError:
        return []
    return [{"kind": "issue", "number": row.get("number"), "title": row.get("title", ""), "url": row.get("url", ""),
             "repository": repository.split("/")[-1], "full_repository": repository, "updated": row.get("updatedAt", ""),
             "labels": [label.get("name", "") for label in row.get("labels") or [] if isinstance(label, dict)]}
            for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []


def fetch_issues(repositories: list[str]) -> tuple[list[dict], str]:
    """Open issues of the sessions' repositories (none when no session runs in one)."""
    rows, errors = [], []
    for repository in repositories:
        try:
            result = subprocess.run(["gh", "issue", "list", "--repo", repository, "--state", "open",
                                     "--limit", str(ISSUES_PER_REPOSITORY), "--json", GH_ISSUE_FIELDS],
                                    capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            errors.append(f"{repository}: {error}")
            continue
        if result.returncode != 0:
            reason = result.stderr.strip().splitlines()
            errors.append(f"{repository}: {reason[-1] if reason else f'exit {result.returncode}'}")
            continue
        rows += parse_issues(result.stdout, repository)
    return sorted(rows, key=lambda row: row["updated"], reverse=True), "; ".join(errors)


def review_age(updated: str) -> str:
    try:
        moment = datetime.fromisoformat(updated.replace("Z", "+00:00"))
    except ValueError:
        return ""
    seconds = int((datetime.now(timezone.utc) - moment).total_seconds())
    if seconds < 3600:
        return f"{max(seconds, 0) // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


PRIORITY_LOW, PRIORITY_NORMAL, PRIORITY_HIGH = 1, 2, 3
PRIORITY_MAX = PRIORITY_NORMAL + 4  # + up to four times: ! !! !!! !!!!
HIGH_LABEL = re.compile(r"\b(p0|p1|urgent|critical|high|priority[ :/_-]*(high|urgent|critical))\b", re.IGNORECASE)
LOW_LABEL = re.compile(r"\b(p3|p4|low|priority[ :/_-]*low)\b", re.IGNORECASE)


def issue_priority(labels: list[str]) -> int:
    """From the issue's labels: P0/P1/urgent/critical/high are high, P3/P4/low are low."""
    if any(HIGH_LABEL.search(label) for label in labels):
        return PRIORITY_HIGH
    if any(LOW_LABEL.search(label) for label in labels):
        return PRIORITY_LOW
    return PRIORITY_NORMAL


def priority_mark(priority: int) -> tuple[str, int]:
    """! to !!!! above normal, ↓ below, nothing at normal."""
    if priority > PRIORITY_NORMAL:
        return "!" * (priority - PRIORITY_NORMAL), style(RED, -1, curses.A_BOLD)
    if priority < PRIORITY_NORMAL:
        return "↓", style(FG_DARK, -1, curses.A_DIM)
    return "", 0


def todo_order(item: dict) -> tuple:
    """Done last; otherwise high priority first, in progress before to do, typed items before
    issues, then oldest typed and most recently updated issues first."""
    priority = item.get("priority", PRIORITY_NORMAL)
    status = item.get("status", "todo")
    head = (status == "done", -priority, status != "doing")
    if item["kind"] == "typed":
        return head + (0, item.get("created", 0), "")
    return head + (1, 0, "".join(chr(0x10FFFF - ord(character)) for character in item.get("updated", "")))


# Errors in the shared log go to a dotfiles session to be fixed: the waiting one gets a message,
# else one starts in the background (claude-sessions background, the session pane is not
# touched). The same error (ids and numbers masked) once a day, at most ERROR_REPORTS_PER_DAY a
# day, held while Theo games. Lines logged before the column started are not reported.
ERROR_REPORTS_PATH = os.path.join(STATE_DIR, "error-reports.json")
# One file per report handed to a waiting session: `say` takes one line, the report has many.
ERROR_REPORT_DIR = os.path.join(STATE_DIR, "error-reports")
ERROR_REPORTS_PER_DAY = 3
ERROR_REPORT_REPEAT_S = 24 * 3600
ERROR_POLL_S = 15
ERROR_CONTEXT_LINES = 40
DOTFILES_DIR = os.path.expanduser("~/dotfiles")
MASKED = re.compile(r"[0-9a-f]{8}-[0-9a-f-]{27}|[0-9a-f]{12,}|\d+")
GAME_CLASS = re.compile(r"^(steam_app_[0-9]+|Star Citizen|Dofus\.x64|retroarch)$")  # as claude_registry.gaming


def error_signature(line: str) -> str:
    """The error without its time and with ids and numbers masked: the same failure, whichever session."""
    message = line.split(" ", 1)[1] if line[:4].isdigit() and " " in line else line
    return MASKED.sub("#", message.strip())[:200]


def gaming() -> bool:
    """Game mode (the gamemode submap) or a game window focused; same rule as the daemon's."""
    try:
        submap = subprocess.run(["hyprctl", "submap"], capture_output=True, text=True, timeout=2).stdout.strip()
        window = subprocess.run(["hyprctl", "-j", "activewindow"], capture_output=True, text=True, timeout=2).stdout
        window_class = json.loads(window).get("class", "") if window.strip().startswith("{") else ""
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return False
    return submap == "gamemode" or bool(GAME_CLASS.match(window_class or ""))


def error_report_prompt(error: str, context: list[str]) -> str:
    return ("claude-sessions logged an error (sent automatically by the cockpit's error hand-off). Find the cause in "
            "the dotfiles and fix it, with a regression test. Ask me before anything that needs ask-to-run.\n\n"
            f"Error:\n{error}\n\nThe log before it (~/.local/state/claude-sessions/log):\n" + "\n".join(context))


def error_report_message(report_path: str) -> str:
    """The one line `say` can type: the instructions, and where the error and its log wait."""
    return ("claude-sessions logged an error (sent automatically by the cockpit's error hand-off). Find the cause in "
            "the dotfiles and fix it, with a regression test. Ask me before anything that needs ask-to-run. "
            f"The error and the log before it: {report_path}")


def write_error_report(prompt: str) -> str:
    os.makedirs(ERROR_REPORT_DIR, exist_ok=True)
    path = os.path.join(ERROR_REPORT_DIR, f"{time.strftime('%Y%m%dT%H%M%S')}-{secrets.token_hex(3)}.md")
    with open(path, "w") as file:
        file.write(prompt + "\n")
    return path


class ErrorReporter:
    def __init__(self):
        self.checked_at = 0.0
        try:
            with open(ERROR_REPORTS_PATH) as file:
                self.state = json.load(file)
        except (OSError, ValueError):
            self.state = {}
        self.state.setdefault("sent", {})
        try:
            self.offset = os.path.getsize(LOG_PATH)  # what was logged before the column started is not news
        except OSError:
            self.offset = 0

    def new_errors(self) -> list[tuple[str, list[str]]]:
        """The ERROR lines logged since the last look, each with the lines before it."""
        try:
            size = os.path.getsize(LOG_PATH)
            if size < self.offset:
                self.offset = 0  # rotated
            with open(LOG_PATH, errors="replace") as file:
                file.seek(max(0, self.offset - 20_000))
                earlier = file.read(self.offset - max(0, self.offset - 20_000)).splitlines()[-ERROR_CONTEXT_LINES:]
                fresh = file.read().splitlines()
            self.offset = size
        except OSError:
            return []
        errors = []
        for index, line in enumerate(fresh):
            if line.split(" ", 2)[1:2] == ["ERROR"]:  # the level field: INFO lines quoting an error are no new error
                errors.append((line, (earlier + fresh[:index])[-ERROR_CONTEXT_LINES:]))
        return errors

    def due(self, signature: str, now: float) -> bool:
        sent = self.state["sent"]
        today = [stamp for stamp in sent.values() if now - stamp < 24 * 3600]
        return now - sent.get(signature, 0) >= ERROR_REPORT_REPEAT_S and len(today) < ERROR_REPORTS_PER_DAY

    def tick(self, sessions: list[dict]):
        if time.time() - self.checked_at < ERROR_POLL_S:
            return
        self.checked_at = time.time()
        pending = self.state.setdefault("pending", [])
        pending += [{"error": line, "context": context} for line, context in self.new_errors()]
        if not pending or gaming():
            self.save()
            return
        while pending:
            report = pending.pop(0)
            signature = error_signature(report["error"])
            if not self.due(signature, time.time()):
                continue
            self.state["sent"][signature] = time.time()
            self.hand_over(report, sessions)
        self.save()

    def hand_over(self, report: dict, sessions: list[dict]):
        prompt = error_report_prompt(report["error"], report["context"])
        waiting = next((session for session in sessions if session.get("project") == "dotfiles" and session.get("state") == "waiting"), None)
        if waiting:
            try:
                problem = manager("say", waiting["session"], error_report_message(write_error_report(prompt)))
            except OSError as error:
                problem = f"report not written: {error}"
            if not problem:
                log_event("INFO", f"error handed to dotfiles session {waiting['session'][:8]}: {error_signature(report['error'])[:120]}")
                return
            log_event("WARN", f"error hand-off to dotfiles session {waiting['session'][:8]} failed ({problem}); starting a new session")
        manager_in_background("background", DOTFILES_DIR, prompt)
        log_event("INFO", f"error handed to a new dotfiles session: {error_signature(report['error'])[:120]}")

    def save(self):
        self.state["sent"] = {signature: stamp for signature, stamp in self.state["sent"].items() if time.time() - stamp < 7 * 24 * 3600}
        try:
            os.makedirs(os.path.dirname(ERROR_REPORTS_PATH), exist_ok=True)
            with open(ERROR_REPORTS_PATH + ".tmp", "w") as file:
                json.dump(self.state, file)
            os.replace(ERROR_REPORTS_PATH + ".tmp", ERROR_REPORTS_PATH)
        except OSError as error:
            log_event("WARN", f"cannot save {ERROR_REPORTS_PATH}: {error}")


TODO_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "claude-sessions", "todo.json")


TODO_UPDATES = os.environ.get("CLAUDE_TODO_UPDATES", os.path.expanduser("~/.cache/claude/todo/updates.jsonl"))
TODO_STATUSES = ("todo", "doing", "done")
TODO_DONE_KEPT_DAYS = 7
TYPED_ID = re.compile(r"[0-9a-f]{8}")
ISSUE_KEY = re.compile(r"[\w.-]+/[\w.-]+#\d+")


class TodoList:
    """Theo's list for Claude: items he types (t), per project, and a status for each item or
    GitHub issue: todo, doing (in progress) or done. Kept in ~/.local/state/claude-sessions/todo.json.
    Sessions cannot write there (greywall): claude-todo appends their changes to
    ~/.cache/claude/todo/updates.jsonl, which apply_updates checks and applies."""

    def __init__(self):
        self.items: list[dict] = []
        self.issues: dict[str, dict] = {}  # "owner/repo#12" -> {"status", "updated", "session"}
        try:
            with open(TODO_PATH) as saved:
                data = json.load(saved)
        except (OSError, ValueError):
            data = {}
        if isinstance(data, list):  # the first format: items only, "sent" for handed to Claude
            data = {"items": data}
        for item in data.get("items", []) if isinstance(data, dict) else []:
            if isinstance(item, dict) and item.get("text") and TYPED_ID.fullmatch(str(item.get("id", ""))):
                item.setdefault("status", "doing" if item.pop("sent", False) else "todo")
                self.items.append(item)
        issues = data.get("issues", {}) if isinstance(data, dict) else {}
        self.issues = {key: value for key, value in issues.items() if ISSUE_KEY.fullmatch(key) and isinstance(value, dict)}

    def save(self):
        oldest = time.time() - TODO_DONE_KEPT_DAYS * 86400
        self.items = [item for item in self.items if item.get("status") != "done" or item.get("updated", 0) >= oldest]
        self.issues = {key: value for key, value in self.issues.items() if value.get("status") != "done" or value.get("updated", 0) >= oldest}
        os.makedirs(os.path.dirname(TODO_PATH), exist_ok=True)
        with open(TODO_PATH + ".tmp", "w") as saved:
            json.dump({"items": self.items, "issues": self.issues}, saved)
        os.replace(TODO_PATH + ".tmp", TODO_PATH)

    def add(self, project: str, cwd: str, text: str) -> str:
        item_id = secrets.token_hex(4)
        self.items.append({"id": item_id, "project": project, "cwd": cwd, "priority": PRIORITY_NORMAL,
                           "text": " ".join(text.split())[:300], "created": int(time.time()), "status": "todo"})
        self.save()
        return item_id

    def remove(self, item_id: str):
        self.items = [item for item in self.items if item["id"] != item_id]
        self.save()

    def change_priority(self, item_id: str, step: int):
        for item in self.items:
            if item["id"] == item_id:
                item["priority"] = max(PRIORITY_LOW, min(PRIORITY_MAX, item.get("priority", PRIORITY_NORMAL) + step))
        self.save()

    def status_of(self, key: str) -> str:
        if ISSUE_KEY.fullmatch(key):
            return self.issues.get(key, {}).get("status", "todo")
        return next((item.get("status", "todo") for item in self.items if item["id"] == key), "todo")

    def set_status(self, key: str, status: str, session: str = "") -> bool:
        """Status of a typed item (its id) or an issue ("owner/repo#12"); False when unknown."""
        if status not in TODO_STATUSES:
            return False
        if ISSUE_KEY.fullmatch(key):
            self.issues[key] = {"status": status, "updated": int(time.time()), "session": session}
        else:
            item = next((item for item in self.items if item["id"] == key), None)
            if item is None:
                return False
            item.update(status=status, updated=int(time.time()), session=session or item.get("session", ""))
        self.save()
        return True

    def apply_updates(self) -> int:
        """The changes sessions asked for (claude-todo), each checked; returns how many applied."""
        if not os.path.exists(TODO_UPDATES):
            return 0
        taken = f"{TODO_UPDATES}.{os.getpid()}"
        try:
            os.replace(TODO_UPDATES, taken)
            with open(taken) as updates:
                lines = updates.read().splitlines()
        except OSError:
            return 0
        finally:
            try:
                os.remove(taken)
            except OSError:
                pass
        applied = 0
        for line in lines:
            try:
                update = json.loads(line)
                action, session = update.get("action"), str(update.get("session", ""))[:40]
            except (ValueError, AttributeError):
                continue
            if action == "add":
                text, cwd = str(update.get("text", "")).strip(), str(update.get("cwd", ""))
                if text and os.path.isdir(cwd):
                    item_id = self.add(project_name(repository_root(cwd)), cwd, text)
                    log_event("INFO", f"todo {item_id} added by a session: {text[:60]}")
                    applied += 1
            elif action in TODO_STATUSES and self.set_status(str(update.get("id", "")), action, session):
                log_event("INFO", f"todo {update.get('id')} marked {action} by a session")
                applied += 1
        return applied


def issue_key(issue: dict) -> str:
    return f"{issue['full_repository']}#{issue['number']}"


def todo_key(item: dict) -> str:
    return item["id"] if item["kind"] == "typed" else issue_key(item)


def with_todo_note(text: str, key: str) -> str:
    """The message for Claude, with the item's key: Claude marks it done with claude-todo."""
    return f"{text} (todo {key}: when this is done, run claude-todo done {key})"


def issue_prompt(issue: dict) -> str:
    return (f"Work on GitHub issue #{issue['number']} of this repository: {issue['title']}. "
            f"Read it with gh issue view {issue['number']} first, then say how you will approach it before changing anything.")


class Reviews:
    """Pull requests fetched in a thread, so a slow GitHub never freezes the column."""

    def __init__(self):
        self.rows: list[dict] = []
        self.error = ""
        self.fetched_at = 0.0
        self.loading = False
        self.lock = threading.Lock()
        self.repositories: list[str] = []
        self.checkouts: dict[str, str] = {}  # owner/repo -> a local checkout, for c (review session)
        self.issues: list[dict] = []  # open issues of the same repositories (the Todo panel)
        self.scope_key = None

    def refresh(self):
        if self.loading:
            return
        self.loading = True
        threading.Thread(target=self._fetch, args=(list(self.repositories),), daemon=True).start()

    def _fetch(self, repositories: list[str]):
        rows, error = fetch_reviews(repositories)
        issues, issue_error = fetch_issues(repositories) if not REVIEWS_FIXTURE else ([], "")
        if error and error != self.error:
            log_event("WARN", f"pull requests: {error}")
        if issue_error:
            log_event("WARN", f"issues: {issue_error}")
        with self.lock:
            self.rows, self.error, self.issues, self.fetched_at, self.loading = rows, error, issues, time.time(), False

    def tick(self):
        """Re-read the repositories when the snapshot or the viewed session changes; refetch when
        they change or age. In a session, only its repository; otherwise every running one."""
        viewed = current_session()
        try:
            mtime = os.stat(SNAPSHOT_PATH).st_mtime
        except OSError:
            mtime = None
        if (mtime, viewed) != self.scope_key:
            self.scope_key = (mtime, viewed)
            self.checkouts = session_checkouts()
            repositories = session_repositories(viewed)
            if repositories != self.repositories:
                self.repositories = repositories
                self.fetched_at = 0
        if time.time() - self.fetched_at > REVIEWS_REFRESH_S:
            self.refresh()

    def current(self) -> tuple[list[dict], str, bool]:
        with self.lock:
            return list(self.rows), self.error, self.loading


def style(foreground: int, background: int = -1, extra: int = 0) -> int:
    key = (foreground, background)
    if key not in color_pairs:
        color_pairs[key] = len(color_pairs) + 1
        curses.init_pair(color_pairs[key], foreground, background)
    return curses.color_pair(color_pairs[key]) | extra


def put(screen, row: int, column: int, text: str, attributes=0, limit: int | None = None):
    height, width = screen.getmaxyx()
    available = (width - column - 1) if limit is None else min(limit, width - column - 1)
    if 0 <= row < height and column < width and available > 0:
        screen.addnstr(row, column, text, available, attributes)


def fit(text: str, available: int) -> str:
    if available <= 1:
        return ""
    return text if len(text) <= available else text[:available - 1] + "…"


def run_outside_curses(screen, action):
    curses.def_prog_mode()
    curses.endwin()
    try:
        return action()
    finally:
        curses.reset_prog_mode()
        screen.refresh()


def confirm(screen, app, question: str) -> bool:
    app.message = f"{question}  y/n"
    app.draw(screen)
    screen.timeout(-1)
    answer = screen.getch()
    screen.timeout(POLL_MS)
    app.message = ""
    return answer == ord("y")


class Line:
    """One rendered line of a panel: segments at columns inside the box, an optional right-aligned
    stamp, and the item it belongs to (None for headings) for selection and clicks."""

    __slots__ = ("segments", "right", "item", "accent")

    def __init__(self, segments=(), right=None, item=None, accent=None):
        self.segments = list(segments)
        # Right-aligned parts, two spaces apart: (text, attr) or (text, attr, action), where a click
        # on that part runs the action (App.handle_mouse). A single (text, attr) pair is accepted.
        if right and isinstance(right[0], str):
            right = [right]
        self.right = [part for part in (right or []) if part and part[0]]
        self.item = item
        self.accent = accent  # attr of a bar in the left padding column (the session in the pane)


class Panel:
    key = "?"
    title = ""

    def __init__(self):
        self.items: list = []
        self.lines: list[Line] = []
        self.selected = 0
        self.scroll = 0

    def subtitle(self, app) -> str:
        return ""

    def height(self) -> int | None:
        """A fixed number of lines, or None to share the column with the other flexible panels."""
        return None

    def build(self, app):
        raise NotImplementedError

    def handle(self, key: int, app, screen) -> str:
        return ""

    def hints(self) -> list[tuple[str, str]]:
        return []

    def help(self) -> list[tuple[str, str]]:
        return self.hints()

    def selected_item(self):
        return self.items[self.selected] if self.items else None

    def move(self, delta: int):
        self.selected = max(0, min(len(self.items) - 1, self.selected + delta)) if self.items else 0

    def clamp(self):
        self.selected = max(0, min(len(self.items) - 1, self.selected)) if self.items else 0

    def keep_selected_visible(self, inner_height: int):
        target = next((index for index, line in enumerate(self.lines) if line.item == self.selected), 0)
        if target < self.scroll:
            self.scroll = max(0, target - 1)
        elif target >= self.scroll + inner_height:
            self.scroll = target - inner_height + 1

    def draw(self, screen, top: int, height: int, width: int, focused: bool, panel_index: int, app):
        border = style(BLUE if focused else BG_HIGHLIGHT, -1, curses.A_BOLD if focused else 0)
        inner_height = height - 2
        self.keep_selected_visible(inner_height)
        put(screen, top, 0, "┌" + "─" * (width - 3) + "┐", border)
        label = f"[{self.key}] {self.title}"
        put(screen, top, 2, label, style(BLUE if focused else FG_DARK, -1, curses.A_BOLD))
        subtitle = fit(self.subtitle(app), width - 8 - len(label))
        if subtitle:
            put(screen, top, 2 + len(label), f" · {subtitle} ", style(FG_DARK, -1, curses.A_DIM))
        for offset in range(inner_height):
            row = top + 1 + offset
            put(screen, row, 0, "│", border)
            put(screen, row, width - 2, "│", border)
            index = self.scroll + offset
            if index >= len(self.lines):
                continue
            line = self.lines[index]
            highlighted = focused and line.item is not None and line.item == self.selected
            background = BG_HIGHLIGHT if highlighted else -1
            if highlighted:
                put(screen, row, 1, " " * (width - 3), style(FG, background))
            if line.accent is not None:
                put(screen, row, 1, "▌", line.accent if not highlighted else (line.accent & ~curses.A_COLOR) | style(BLUE, background))
            right_width = sum(len(part[0]) for part in line.right) + 2 * (len(line.right) - 1) if line.right else 0
            for column, text, attr in line.segments:
                fg_attr = attr if not highlighted else (attr & ~curses.A_COLOR) | style(FG, background)
                put(screen, row, 2 + column, fit(text, width - 4 - column - (right_width + 2 if right_width else 0)), fg_attr)
            column = width - 3 - right_width
            for part in line.right:
                text, attr = part[0], part[1]
                put(screen, row, column, text, attr if not highlighted else (attr & ~curses.A_COLOR) | style(FG_DARK, background))
                if len(part) > 2:
                    hit_actions[row] = (column, column + len(text), part[2])
                column += len(text) + 2
            hit_lines[row] = (panel_index, line.item)
        put(screen, top + height - 1, 0, "└" + "─" * (width - 3) + "┘", border)
        hidden_below = len(self.lines) - self.scroll - inner_height
        if hidden_below > 0:
            note = f" ▼ {hidden_below} "
            put(screen, top + height - 1, width - 3 - len(note), note, style(FG_DARK, -1, curses.A_DIM))
        if self.scroll > 0:
            note = f" ▲ {self.scroll} "
            put(screen, top, width - 3 - len(note), note, style(FG_DARK, -1, curses.A_DIM))


# Anthropic's status page (Atlassian Statuspage): overall indicator none / minor / major / critical /
# maintenance, each product's status, the open incidents. Fetched in the background; an empty
# CLAUDE_STATUS_URL turns it off (tests).
CLAUDE_STATUS_URL = os.environ.get("CLAUDE_STATUS_URL", "https://status.claude.com/api/v2/summary.json")
CLAUDE_STATUS_PAGE = "https://status.claude.com/"
CLAUDE_STATUS_POLL_S = 120
CLAUDE_STATUS_COLORS = {"none": GREEN, "minor": YELLOW, "major": RED, "critical": RED, "maintenance": CYAN}


def parse_claude_status(summary: dict) -> dict:
    """The parts of a Statuspage summary.json shown here: indicator, description, the products not
    operational and the open incidents' names."""
    status = summary.get("status") or {}
    components = [component for component in summary.get("components") or [] if not component.get("group")]
    return {"indicator": status.get("indicator") or "", "description": status.get("description") or "",
            "degraded": [(component.get("name", "?"), component.get("status", "?").replace("_", " "))
                         for component in components if component.get("status") != "operational"],
            "incidents": [incident.get("name", "?") for incident in summary.get("incidents") or [] if incident.get("status") != "resolved"]}


class ClaudeStatus:
    def __init__(self):
        self.lock = threading.Lock()
        self.current: dict | None = None
        self.error = ""
        self.fetched_at = 0.0
        self.fetching = False

    def tick(self):
        if not CLAUDE_STATUS_URL or self.fetching or time.time() - self.fetched_at < CLAUDE_STATUS_POLL_S:
            return
        self.fetching = True
        threading.Thread(target=self._fetch, daemon=True).start()

    def _fetch(self):
        try:
            request = urllib.request.Request(CLAUDE_STATUS_URL, headers={"User-Agent": "claude-sessions"})
            with urllib.request.urlopen(request, timeout=10) as response:
                current, error = parse_claude_status(json.load(response)), ""
        except (OSError, ValueError) as failure:
            current, error = None, f"status.claude.com unreachable ({failure.__class__.__name__})"
        with self.lock:
            previous = self.current
            if current is not None:
                self.current = current
            if error != self.error:
                log_event("WARN" if error else "INFO", error or "status.claude.com reachable again")
            self.error, self.fetched_at, self.fetching = error, time.time(), False
        if current and (previous or {}).get("indicator") != current["indicator"]:
            # WARN, not ERROR: Anthropic's outage is not a claude-sessions bug for the error hand-off.
            log_event("INFO" if current["indicator"] == "none" else "WARN", f"Claude status: {current['description']}")

    def snapshot(self) -> tuple[dict | None, str, float]:
        with self.lock:
            return self.current, self.error, self.fetched_at


def claude_status_lines(current: dict | None, error: str, label_width: int) -> list:
    """The Status panel's Claude line, and one line per product not operational (at most three)."""
    if current is None:
        text = error or ("not checked" if not CLAUDE_STATUS_URL else "checking status.claude.com …")
        return [Line([(0, "Claude", style(FG)), (label_width + 2, text, style(FG_DARK, -1, curses.A_DIM))])]
    color = style(CLAUDE_STATUS_COLORS.get(current["indicator"], YELLOW), -1, curses.A_BOLD)
    lines = [Line([(0, "Claude", style(FG)), (label_width + 2, "● " + current["description"], color)],
                  right=("stale", style(YELLOW)) if error else None)]
    for name, status in current["degraded"][:3]:
        lines.append(Line([(label_width + 4, f"{name}: {status}", color)]))
    return lines


class StatusPanel(Panel):
    """Fixed height: one line per usage window, never expands."""

    key = "0"
    title = "Status"

    def build(self, app):
        windows = usage_windows()
        self.items = windows
        self.clamp()
        label_width = max((len(window["label"]) for window in windows), default=0)
        resets = [usage_resets_short(window) for window in windows]
        resets_width = max((len(text) for text in resets), default=0)
        # Box edges and padding (4), label, gaps, the value, the right column: the bar takes the rest.
        bar_width = max(USAGE_BAR_MIN, min(USAGE_BAR_MAX, app.width - 4 - label_width - 2 - 5 - (resets_width + 2 if resets_width else 0)))
        lines = []
        for index, (window, reset) in enumerate(zip(windows, resets)):
            percentage = window["percentage"]
            color = style(usage_color(percentage), -1, curses.A_BOLD)
            value = f"{percentage:3d}%" if percentage is not None else "   –"
            lines.append(Line([(0, window["label"], style(FG)), (label_width + 2, usage_bar(percentage, bar_width), color),
                               (label_width + 3 + bar_width, value, color)],
                              right=(reset, style(FG_DARK, -1, curses.A_DIM)), item=index))
        if not windows:
            lines.append(Line([(0, "No usage yet (claude-usage.sh has not fetched).", style(FG_DARK, -1, curses.A_DIM))]))
        totals = app.costs.totals()
        if any(totals.values()):
            segments, column = [(0, "At API prices", style(FG))], label_width + 2
            for label, key in (("today", "today"), ("week", "week"), ("month", "month")):
                amount = money(totals[key])
                segments += [(column, label, style(FG_DARK, -1, curses.A_DIM)), (column + len(label) + 1, amount, style(MAGENTA, -1, curses.A_BOLD))]
                column += len(label) + len(amount) + 3
            lines.append(Line(segments))
        if app.costs.error:
            lines.append(Line([(0, app.costs.error, style(YELLOW))]))
        current, error, _ = app.claude_status.snapshot()
        lines += claude_status_lines(current, error, label_width)
        self.lines = lines

    def height(self) -> int:
        return len(self.lines) + 2

    def subtitle(self, app):
        all_time = app.costs.all_time
        return f"{usage_plan()} · all time {money(all_time)}".lstrip(" ·") if all_time else usage_plan()

    def hints(self):
        return [("⏎", "details"), ("r", "refetch"), ("o", "status page")]

    def help(self):
        return [("⏎", "the full usage report in the session pane"), ("r", "fetch the usage again now"),
                ("o", "open status.claude.com: Anthropic's incidents and each product's state")]

    def handle(self, key, app, screen):
        if key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER):
            return manager("usage")
        elif key == ord("r"):
            app.usage.tick(force=True)
            return "fetching usage …"
        elif key == ord("o"):
            subprocess.Popen(["xdg-open", CLAUDE_STATUS_PAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return "opening status.claude.com …"
        return ""


def restart_all(screen, app, sessions: list[dict]) -> str:
    """Restart (same conversation, new process) every session sitting at its prompt: one that works
    or asks for a permission would lose its turn, so it is skipped and named."""
    ready = [session for session in sessions if session["state"] == "waiting"]
    busy = [session for session in sessions if session["state"] in ("working", "needs-you")]
    if not ready:
        return "nothing to restart: every session is busy" if busy else "no session to restart"
    skipped = f", leaving {len(busy)} busy" if busy else ""
    if not confirm(screen, app, f"restart {len(ready)} session{'s' * (len(ready) > 1)}{skipped}? same conversations, new processes"):
        return ""
    manager_in_background("restart-all", *[session["session"] for session in ready])
    busy_names = ", ".join(session["project"] for session in busy)
    return f"restarting {len(ready)} …" + (f" busy, not restarted: {busy_names}" if busy else "")


class SessionsPanel(Panel):
    key = "1"
    title = "Sessions"

    def subtitle(self, app):
        return "waiting on you · f shows all" if app.focus_waiting else ""

    def build(self, app):
        running = [session for session in running_sessions() if matches(session, app.query)]
        if app.focus_waiting:
            running = [session for session in running if session["state"] in FOCUS_STATES]
        app.history.load_titles([session["session"] for session in running if session["state"] != "unknown"], TITLES_PER_TICK)
        for session in running:
            if session["state"] != "unknown":
                session["facts"] = statusline_facts(session["session"])
                session["title"] = app.history.title(session["session"])
            session["pinned"] = session["session"] in app.view.pinned
        # A card keeps its place: pinned first, then in the order the sessions started. Urgency
        # shows in the glyph and the header count, and n jumps to the next one needing you.
        running = grouped_by_project(running)
        self.items = running
        self.clamp()
        current = current_session()
        lines = []
        if time.time() - app.restore_checked > 30:
            app.restore_checked = time.time()
            app.restore = restore_offer(app.view, {session["session"] for session in running})
        if time.time() - app.held_checked > GREYPROXY_POLL_S:
            app.held_checked = time.time()
            app.held = greyproxy_held(GREYPROXY_DB)
        claude, _, _ = app.claude_status.snapshot()
        if claude and claude["indicator"] not in ("none", ""):
            color = style(CLAUDE_STATUS_COLORS.get(claude["indicator"], YELLOW), -1, curses.A_BOLD)
            lines.append(Line([(0, f"⚠ Claude: {claude['description']}", color)]))
            details = [f"{name}: {status}" for name, status in claude["degraded"][:2]] + claude["incidents"][:1]
            if details:
                lines.append(Line([(2, " · ".join(details), style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line([(2, "0 then o opens status.claude.com", style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line())
        app.start_files = start_file_mtimes(SESSION_START_FILES)
        outdated = [session for session in running if changed_since_start(session, app.start_files)]
        if outdated:
            changes = sorted({label for session in outdated for label in changed_since_start(session, app.start_files)})
            count = f"{len(outdated)} session{'s' * (len(outdated) > 1)}"
            lines.append(Line([(0, f"⟳ {count} started before a change to {', '.join(changes)}", style(YELLOW, -1, curses.A_BOLD))]))
            lines.append(Line([(2, "^R restarts the ones waiting at their prompt", style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line())
        if app.held:
            hosts = ", ".join(app.held[:3]) + (f" and {len(app.held) - 3} more" if len(app.held) > 3 else "")
            lines.append(Line([(0, f"⛔ greyproxy holds {hosts}", style(YELLOW, -1, curses.A_BOLD))]))
            lines.append(Line([(2, "G opens its dashboard to approve or deny", style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line())
        if app.restore:
            names = ", ".join(row.get("project", "?") for row in app.restore)
            lines.append(Line([(0, f"↺ {len(app.restore)} running before the restart: {names}", style(CYAN, -1, curses.A_BOLD))]))
            lines.append(Line([(2, "B brings them back, one after the other", style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line())
        for index, session in enumerate(running):
            state_color = style(STATE_COLORS.get(session["state"], FG_DARK), -1, curses.A_BOLD)
            accent = state_color if session["session"] == current else None
            branch = git_branch(session.get("cwd", ""))
            grouped = session.get("group_size", 1) > 1
            # Sessions of one repository: its name once as a heading, then each card on a rail,
            # named by its branch, with no gap between them.
            indent = 2 if grouped else 0
            rail = [(0, "│", style(project_color(session.get("project", "")), -1, curses.A_DIM))] if grouped else []
            if grouped and session["group_position"] == 0:
                lines.append(Line([(0, session.get("project", "?"), style(project_color(session.get("project", "")), -1, curses.A_BOLD)),
                                   (len(session.get("project", "?")) + 1, f"· {session['group_size']} sessions", style(FG_DARK, -1, curses.A_DIM))]))
            if grouped:
                segments = rail + [(2, GLYPHS.get(session["state"], "·"), state_color),
                                   (4, branch or session.get("project", "?"), style(FG, -1, curses.A_BOLD))]
            else:
                segments = [(0, GLYPHS.get(session["state"], "·"), state_color),
                            (2, session.get("project", "?"), style(project_color(session.get("project", "")), -1, curses.A_BOLD))]
                if branch:
                    segments.append((4 + len(session.get("project", "?")), f"⎇ {branch}", style(FG_DARK, -1, curses.A_DIM)))
            facts = session.get("facts") or {}
            context = facts.get("context")
            badges = [part for part, shown in (
                (("/compact", style(YELLOW, -1, curses.A_BOLD)), isinstance(context, (int, float)) and context >= CONTEXT_COMPACT_AT),
                (("⬆ update", style(GREEN, -1, curses.A_BOLD)), session.get("update")),
                (("⟳ restart", style(YELLOW, -1, curses.A_BOLD)), changed_since_start(session, app.start_files)),
                (("⇅ remote", style(CYAN, -1, curses.A_BOLD)), facts.get("remote")),
                (("⚲", style(YELLOW)), session.get("pinned"))) if shown]
            lines.append(Line(segments, right=badges + [(age(int(session.get("since", time.time()))), state_color)], item=index, accent=accent))
            title = session.get("title") or visible_task(session) or ""
            right = []
            if session["state"] != "unknown":
                context = facts.get("context")
                right = [(facts.get("model") or "", style(FG_DARK, -1, curses.A_DIM)),
                         (f"{facts.get('effort') or 'effort'} ▾", style(CYAN), "effort"),
                         (f"{round(context)}%" if context is not None else "", style(context_color(context), -1, curses.A_BOLD))]
            lines.append(Line(rail + [(2 + indent, title, style(FG))], right=right, item=index, accent=accent))
            task = visible_task(session)
            asks = waiting_request(session)
            if asks:
                lines.append(Line(rail + [(2 + indent, "⚠ " + asks, style(RED))], item=index, accent=accent))
            elif session["state"] == "waiting" and session.get("outcome"):
                lines.append(Line(rail + [(2 + indent, "✓ " + session["outcome"], style(GREEN, -1, curses.A_DIM))], item=index, accent=accent))
            elif session["state"] == "working" and session.get("title") and task and task != session["title"]:
                lines.append(Line(rail + [(2 + indent, task, style(FG_DARK, -1, curses.A_DIM))], item=index, accent=accent))
            if not grouped or session["group_position"] == session["group_size"] - 1:
                lines.append(Line())
        if not running:
            empty = "Nothing waits on you." if app.focus_waiting else "Nothing matches." if app.query else "No running session."
            lines.append(Line([(0, empty, style(FG_DARK, -1, curses.A_DIM))]))
            lines.append(Line([(0, "a  start one in a project", style(FG_DARK, -1, curses.A_DIM))]))
        self.lines = lines

    def hints(self):
        selected = self.selected_item() or {}
        if selected.get("state") == "needs-you" and waiting_request(selected):
            return [("⏎", "open"), ("Y", "approve"), ("N", "decline"), ("n", "next"), ("g", "git"), ("z", "zoom")]
        context = (selected.get("facts") or {}).get("context")
        if isinstance(context, (int, float)) and context >= CONTEXT_COMPACT_AT:
            return [("⏎", "open"), ("C", "/compact"), ("e", "effort"), ("g", "git"), ("z", "zoom"), ("x", "exit")]
        if selected.get("update"):
            return [("⏎", "open"), ("r", "restart to apply the update"), ("e", "effort"), ("g", "git"), ("x", "exit")]
        return [("⏎", "open"), ("n", "peek"), ("+", "another"), ("e", "effort"), ("g", "git"), ("z", "zoom"), ("x", "exit")]

    def help(self):
        return [("⏎", "show the session and move the cursor into it"), ("n", "peek at the next session needing you"),
                ("x", "exit the session: Ctrl-C twice, then killed if it lingers"), ("r", "restart in place: same conversation, new process"),
                ("^R", "restart every session that waits for you; working ones and pending permissions are left alone"),
                ("R", "toggle Remote Control (phone / claude.ai/code)"), ("p", "pin on top"), ("e", "effort level: pick one, the session restarts on it (or click the level on the card)"),
                ("g", "lazygit on the session's repository, in a popup (q closes it)"),
                ("+", "another session on this repository, on its own branch in a separate clone"),
                ("C", "/compact in the session, when it waits (the /compact badge suggests it)"),
                ("B", "after a reboot: bring back the sessions that were running"),
                ("z", "the session over the whole window; Ctrl+Tab comes back"),
                ("f", "focus: only the sessions waiting on you; f again shows all"),
                ("Y N", "approve or decline the permission a card asks for, after a y/n confirmation"),
                ("m", "a message for the session without opening it: sent at its prompt, queued while it works")]

    def handle(self, key, app, screen):
        session = self.selected_item()
        if key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER) and session:
            return manager("open", session["session"])
        if key == ord("n"):
            index = next_attention_index(self.items, self.selected)
            if index is None:
                return "nothing needs you"
            self.selected = index
            return manager("view", self.items[index]["session"])
        elif key == ord("p") and session and session["state"] != "unknown":
            app.view.toggle(app.view.pinned, session["session"])
        elif key == ord("R") and session and session["state"] != "unknown":
            manager_in_background("remote", session["session"])
            return f"toggling remote control for {session['project']} …"
        elif key == ord("r") and session and session["state"] != "unknown":
            if confirm(screen, app, f"restart {session['project']}? same conversation, new process"):
                manager_in_background("restart", session["session"])
                return f"restarting {session['project']} …"
        elif key == KEY_CTRL_R:
            return restart_all(screen, app, app.sessions)
        elif key == ord("e") and session:
            return app.open_effort_menu(session)
        elif key == ord("B") and app.restore:
            pairs = [value for row in app.restore for value in (row["cwd"], row["session"])]
            manager_in_background("restore", *pairs)
            app.view.restored_boot = boot_time()
            app.view.save()
            count, app.restore = len(app.restore), []
            return f"bringing back {count} session{'s' if count != 1 else ''} …"
        elif key == ord("+") and session:
            if not session.get("cwd"):
                return "no directory known for this session"
            suggested = time.strftime("parallel-%H%M")
            branch = run_outside_curses(screen, lambda: input_line(f"branch for another {session['project']} session (Enter: {suggested})> ")) or suggested
            manager_in_background("parallel", session["cwd"], branch)
            return f"cloning {session['project']} for {branch} …"
        elif key == ord("C") and session and session["state"] != "unknown":
            error = manager("compact", session["session"])
            return error or f"/compact sent to {session['project']}"
        elif key == ord("z"):
            return manager("zoom")
        elif key in (ord("Y"), ord("N")) and session and session["state"] == "needs-you":
            approve = key == ord("Y")
            asks = waiting_request(session) or "its request"
            if not confirm(screen, app, f"{'approve' if approve else 'decline'} {session['project']}: {asks[:60]}?"):
                return ""
            error = manager("answer", session["session"], "yes" if approve else "no")
            return error or f"{'approved' if approve else 'declined'} for {session['project']}"
        elif key == ord("m") and session and session["state"] != "unknown":
            message = run_outside_curses(screen, lambda: input_line(f"message for {session['project']} (Enter sends, empty cancels)> "))
            if not message:
                return ""
            error = manager("say", session["session"], message)
            return error or (f"sent to {session['project']}" if session["state"] != "working" else f"queued for {session['project']}")
        elif key == ord("f"):
            app.focus_waiting = not app.focus_waiting
            return "only the sessions waiting on you (f shows all)" if app.focus_waiting else ""
        elif key == ord("g") and session:
            if not session.get("cwd"):
                return "no directory known for this session"
            manager_in_background("git", session["cwd"])
        elif key == ord("x") and session:
            if confirm(screen, app, f"exit {session['project']}?"):
                return kill_session(session)
        return ""


class ReviewsPanel(Panel):
    key = "2"
    title = "Pull requests"

    def build(self, app):
        rows, error, loading = app.reviews.current()
        self.items = [row for row in rows if matches({"project": row["repository"], "task": row["title"]}, app.query)]
        self.clamp()
        lines = []
        if error:
            lines.append(Line([(0, error, style(YELLOW))]))
        elif not self.items and not loading:
            lines.append(Line([(0, "No open pull request here.", style(FG_DARK, -1, curses.A_DIM))]))
        ci_marks = {"failing": ("✗", RED), "pending": ("●", YELLOW), "passing": ("✓", GREEN)}
        reviews = {"APPROVED": ("approved", GREEN), "CHANGES_REQUESTED": ("changes", RED), "REVIEW_REQUIRED": ("review", YELLOW)}
        for index, row in enumerate(self.items):
            label = f"{row['repository']}#{row['number']}"
            right = []
            if row.get("draft"):
                right.append(("draft", style(FG_DARK, -1, curses.A_DIM)))
            if row.get("review") in reviews:
                text, color = reviews[row["review"]]
                right.append((text, style(color)))
            if row.get("ci") in ci_marks:
                glyph, color = ci_marks[row["ci"]]
                right.append((glyph, style(color, -1, curses.A_BOLD)))
            right.append((review_age(row["updated"]), style(FG_DARK, -1, curses.A_DIM)))
            lines.append(Line([(0, label, style(MAGENTA, -1, curses.A_BOLD)), (1 + len(label), row["title"], style(FG_DARK))],
                              right=right, item=index))
        self.lines = lines

    def subtitle(self, app):
        scope = ", ".join(repository.split("/")[-1] for repository in app.reviews.repositories) or "awaiting my review"
        return scope + ("  ⟳" if app.reviews.loading else "")

    def hints(self):
        return [("⏎", "open"), ("c", "Claude review"), ("P", "list"), ("r", "refresh")]

    def help(self):
        return [("⏎", "open the pull request in the pull requests window"),
                ("c", "a Claude session reviewing it, in its own clone of the repository"),
                ("P", "the pull requests window on the viewed session's repository (or your review requests)"), ("r", "refresh now"),
                ("✓ ● ✗", "CI passing, running, failing"), ("approved", "review state: approved, changes (requested), review (required)")]

    def handle(self, key, app, screen):
        row = self.selected_item()
        if key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER) and row:
            return open_in_scratchpad("prs", row["url"])
        if key == ord("c") and row:
            checkout = app.reviews.checkouts.get(row.get("full_repository", ""))
            if not checkout:
                return f"no local checkout of {row['repository']}: start a session there first"
            manager_in_background("review", checkout, str(row["number"]))
            return f"preparing a review of {row['repository']}#{row['number']} …"
        elif key == ord("r"):
            app.reviews.fetched_at = 0
            return "refreshing pull requests …"
        return ""


class TodoPanel(Panel):
    key = "3"
    title = "Todo"

    def build(self, app):
        # Like the issues: the viewed session's project only, every project when none is viewed.
        viewed = next((session for session in app.sessions if session["session"] == current_session()), None)
        self.scope = viewed["project"] if viewed else ""
        typed = [{"kind": "typed", **item} for item in app.todos.items
                 if (not self.scope or item["project"] == self.scope) and matches({"project": item["project"], "task": item["text"]}, app.query)]
        with app.reviews.lock:
            issues = [issue for issue in app.reviews.issues if matches({"project": issue["repository"], "task": issue["title"]}, app.query)]
        for issue in issues:
            issue["priority"] = issue_priority(issue["labels"])
            issue["status"] = app.todos.status_of(issue_key(issue))
        self.items = sorted(typed + issues, key=todo_order)
        self.clamp()
        lines = []
        if not self.items:
            lines.append(Line([(0, "Nothing to do. t adds an item for the viewed project.", style(FG_DARK, -1, curses.A_DIM))]))
        for index, item in enumerate(self.items):
            status = item.get("status", "todo")
            done = status == "done"
            mark, mark_style = priority_mark(item.get("priority", PRIORITY_NORMAL))
            mark = "" if done else mark
            start = 2 + (len(mark) + 1 if mark else 0)
            glyph, glyph_style = {"todo": ("•", style(YELLOW, -1, curses.A_BOLD)), "doing": ("◐", style(BLUE, -1, curses.A_BOLD)),
                                  "done": ("✓", style(GREEN, -1, curses.A_DIM))}[status]
            text_style = style(FG_DARK, -1, curses.A_DIM) if done else None
            right = [("in progress", style(BLUE))] if status == "doing" else []
            if item["kind"] == "typed":
                lines.append(Line([(0, glyph, glyph_style), (2, mark, mark_style),
                                   (start, item["project"], text_style or style(project_color(item["project"]), -1, curses.A_BOLD)),
                                   (start + 1 + len(item["project"]), item["text"], text_style or style(FG))], right=right, item=index))
            else:
                label = f"{item['repository']}#{item['number']}"
                labels = ", ".join(item["labels"][:2])
                lines.append(Line([(0, glyph if status != "todo" else "◇", glyph_style if status != "todo" else style(MAGENTA)), (2, mark, mark_style),
                                   (start, label, text_style or style(MAGENTA, -1, curses.A_BOLD)), (start + 1 + len(label), item["title"], text_style or style(FG_DARK))],
                                  right=right or ([(labels, style(FG_DARK, -1, curses.A_DIM))] if labels else []), item=index))
        self.lines = lines

    def subtitle(self, app):
        doing = sum(1 for item in self.items if item.get("status") == "doing")
        waiting = sum(1 for item in self.items if item.get("status") == "todo")
        return f"{getattr(self, 'scope', '') or 'all projects'} · {doing} in progress · {waiting} to do"

    def hints(self):
        return [("⏎", "to Claude"), ("t", "add"), ("i", "in progress"), ("d", "done"), ("+", "priority"), ("x", "remove")]

    def help(self):
        return [("⏎", "hand the item to Claude: the project's running session, or a new one"),
                ("t", "add an item for the viewed session's project (or pick a project)"),
                ("i", "mark in progress (Enter does it too); i again: back to to do"),
                ("d", "mark done, or back to to do; done items stay 7 days, dimmed at the bottom"),
                ("+", "raise a typed item's priority: ! then !! up to !!!!"), ("-", "lower it"), ("x", "remove a typed item"),
                ("! ↓", "raised and low priority; an issue's comes from its labels (P0/P1/urgent/high, P3/P4/low)"),
                ("• ◐ ✓", "to do · in progress · done; ◇ an open GitHub issue still to do"),
                ("", "Claude marks items itself with claude-todo: start, done, add")]

    def target_directory(self, app, item) -> str:
        if item["kind"] == "typed":
            return item.get("cwd", "")
        return app.reviews.checkouts.get(item.get("full_repository", ""), "")

    def handle(self, key, app, screen):
        item = self.selected_item()
        if key == ord("t"):
            viewed = next((session for session in app.sessions if session["session"] == current_session() and session.get("cwd")), None)
            directory = viewed["cwd"] if viewed else run_outside_curses(screen, pick_project)
            if not directory:
                return ""
            text = run_outside_curses(screen, lambda: input_line(f"to do in {project_name(directory)} (Enter adds, empty cancels)> "))
            if text:
                app.todos.add(viewed["project"] if viewed else project_name(directory), directory, text)
                return f"added to {project_name(directory)}"
            return ""
        if key == ord("x") and item and item["kind"] == "typed":
            app.todos.remove(item["id"])
            return "removed"
        if key in (ord("i"), ord("d")) and item:
            target = "doing" if key == ord("i") else "done"
            status = "todo" if app.todos.status_of(todo_key(item)) == target else target
            app.todos.set_status(todo_key(item), status)
            return {"doing": "in progress", "done": "done", "todo": "back to do"}[status]
        if key in (ord("+"), ord("-")) and item:
            if item["kind"] != "typed":
                return "an issue's priority comes from its labels on GitHub"
            app.todos.change_priority(item["id"], 1 if key == ord("+") else -1)
            self.build(app)
            self.selected = next(index for index, moved in enumerate(self.items) if moved.get("id") == item["id"])
            return ""
        if key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER) and item:
            directory = self.target_directory(app, item)
            if not directory:
                return f"no local checkout of {item.get('repository', '?')}: start a session there first"
            key_name = todo_key(item)
            text = with_todo_note(item["text"] if item["kind"] == "typed" else issue_prompt(item), key_name)
            running = next((session for session in app.sessions if session.get("cwd") == directory and session["state"] != "unknown"), None)
            if running:
                error = manager("say", running["session"], text)
                if error:
                    return error
                outcome = f"sent to {running['project']}"
            else:
                manager_in_background("new", directory, text)
                outcome = f"starting a session in {project_name(directory)}"
            app.todos.set_status(key_name, "doing", running["session"] if running else "")
            return outcome
        return ""


class EffortMenu:
    """The effort picker over a session card: the five levels, the current one marked. Choosing a
    different level restarts the session on it (claude-sessions restart <id> <level>)."""

    WIDTH = 30

    def __init__(self, session: dict, anchor_row: int):
        self.session = session
        self.anchor_row = anchor_row
        self.current = (session.get("facts") or {}).get("effort") or ""
        self.selected = EFFORT_LEVELS.index(self.current) if self.current in EFFORT_LEVELS else EFFORT_LEVELS.index("high")
        self.rows: dict[int, int] = {}  # screen row -> level index, from the last draw
        self.box: tuple[int, int, int, int] = (0, 0, 0, 0)  # top, left, bottom, right

    def draw(self, screen):
        height, width = screen.getmaxyx()
        box_height = len(EFFORT_LEVELS) + 3
        top = self.anchor_row + 1 if self.anchor_row + 1 + box_height < height - 1 else max(1, self.anchor_row - box_height)
        left = max(1, width - 3 - self.WIDTH)
        right = left + self.WIDTH - 1
        self.box = (top, left, top + box_height - 1, right)
        frame, ground = style(BLUE, BG_HIGHLIGHT, curses.A_BOLD), style(FG, BG_HIGHLIGHT)
        put(screen, top, left, "╭" + "─" * (self.WIDTH - 2) + "╮", frame)
        put(screen, top, left + 2, f" Effort · {self.session.get('project', '?')} "[:self.WIDTH - 4], frame)
        self.rows.clear()
        for index, level in enumerate(EFFORT_LEVELS):
            row = top + 1 + index
            chosen = index == self.selected
            put(screen, row, left, "│" + " " * (self.WIDTH - 2) + "│", frame)
            put(screen, row, left + 1, " " * (self.WIDTH - 2), style(BG_HIGHLIGHT, BLUE) if chosen else ground)
            marker = "●" if level == self.current else " "
            text_style = style(BG_HIGHLIGHT, BLUE, curses.A_BOLD) if chosen else (style(GREEN, BG_HIGHLIGHT, curses.A_BOLD) if level == self.current else ground)
            put(screen, row, left + 2, f"{marker} {level}", text_style)
            if level == self.current:
                put(screen, row, right - 9, "current", style(BG_HIGHLIGHT, BLUE) if chosen else style(FG_DARK, BG_HIGHLIGHT))
            self.rows[row] = index
        note_row = top + 1 + len(EFFORT_LEVELS)
        put(screen, note_row, left, "│" + " " * (self.WIDTH - 2) + "│", frame)
        put(screen, note_row, left + 2, "⏎ restarts on it  esc", style(FG_DARK, BG_HIGHLIGHT, curses.A_DIM))
        put(screen, note_row + 1, left, "╰" + "─" * (self.WIDTH - 2) + "╯", frame)

    def contains(self, x: int, y: int) -> bool:
        top, left, bottom, right = self.box
        return top <= y <= bottom and left <= x <= right


PANEL_NAMES = ("Status", "Sessions", "Pull requests", "Todo")
GLOBAL_HINTS = [("⇥", "panel"), ("/", "filter"), (":", "actions"), ("a", "new"), ("?", "help"), ("q", "close")]
GLOBAL_HELP = [("0-3", "focus a panel"), ("H", "resume a past session, searched by project and prompt"), ("^1 ^2 ^3", "focus a panel from inside the session (tmux)"), ("⇥ ⇧⇥", "next / previous panel"), ("j/k ↑↓", "move inside the panel"),
               ("/", "filter the focused panel, Esc clears"), (":", "every action, searchable"), ("a", "new session in a project"),
               ("A", "new session on its own branch, in a separate clone (parallel work on one repository)"),
               ("D", "the digest: yesterday, today, plan usage, who waits, pull requests (also once a day by itself)"),
               ("P W G", "windows on top: pull requests, Claude on the web, greyproxy (also Super+Ctrl+P/A/G)"),
               ("≈ $", "today's Claude Code replies on this machine at API prices (the plan is flat); week and month in Status"),
               ("^⇥", "cursor between the column and the session (tmux)"), ("l →  ←", "into the session from any panel; ← from the session comes back"), ("q ^C", "close the manager window; sessions keep running")]
LEGEND = [("●", "working"), ("○", "waiting for you"), ("!", "needs you: permission or question"), ("·", "running, state unknown"),
          ("↻", "past session"), ("▌", "shown in the session pane"), ("⚲", "pinned"), ("⇅", "remote controlled"),
          ("⬆", "Claude updated itself: r restarts on the new version"),
          ("/compact", "context over 90%: /compact in the session before it gets slow and costly"), ("high ▾", "effort level: click to change it")]


def palette_entries(app) -> list[tuple[int | None, str, str]]:
    """Every action a single key runs, from the help tables: (panel index or None for anywhere,
    key, description). Keys that are not one press (j/k ↑↓, ^⇥, 0-4) stay out."""
    entries = [(None, key, label) for key, label in GLOBAL_HELP if len(key) == 1 and key not in ":?"]
    for index, panel in enumerate(app.panels):
        entries += [(index, key, label) for key, label in panel.help() if len(key) == 1 or key == "⏎"]
    return entries


def pick_action(entries: list[tuple[int | None, str, str]]):
    """fzf over the actions; the chosen entry, or None."""
    lines = [f"{number}\t{'everywhere' if panel is None else PANEL_NAMES[panel]:<13} {key:<2} {label}"
             for number, (panel, key, label) in enumerate(entries)]
    result = subprocess.run(["fzf", "--prompt", "action> ", "--height", "100%", "--delimiter", "\t", "--with-nth", "2..", "--no-sort"],
                            input="\n".join(lines), capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return entries[int(result.stdout.split("\t", 1)[0])]


def pick_past_session(app):
    """fzf over the past sessions (history.jsonl, newest first, running ones left out); the chosen
    entry, or None."""
    app.history.refresh()
    running = {session["session"] for session in app.sessions}
    entries = [entry for entry in app.history.entries if entry["session"] not in running]
    lines = [f"{number}\t{datetime.fromtimestamp(entry['since']).strftime('%d %b %H:%M')}  {entry['project']:<18} "
             f"{app.history.title(entry['session']) or entry['prompt']}" for number, entry in enumerate(entries)]
    result = subprocess.run(["fzf", "--prompt", "resume> ", "--height", "100%", "--delimiter", "\t", "--with-nth", "2..", "--no-sort"],
                            input="\n".join(lines), capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return entries[int(result.stdout.split("\t", 1)[0])]


def run_palette_entry(app, entry, screen) -> str:
    """Focus the action's panel and press its key, as if typed there."""
    panel, key, _ = entry
    if panel is not None:
        app.focus_panel(panel)
    app.handle(KEY_ENTER_LF if key == "⏎" else ord(key), screen)
    return app.message


class App:
    def __init__(self):
        self.history = History()
        self.view = ViewState()
        self.usage = UsageRefresher()
        self.alerts = BudgetAlerts()
        self.costs = TranscriptCosts()
        self.reviews = Reviews()
        self.todos = TodoList()
        self.errors = ErrorReporter()
        self.claude_status = ClaudeStatus()
        self.panels: list[Panel] = [StatusPanel(), SessionsPanel(), ReviewsPanel(), TodoPanel()]
        self.focus = 1
        self.query = ""
        self.filtering = False
        self.help_open = False
        self.message = ""
        self.labelled = ("", "")  # (session, state) last pushed with label-state
        self.menu: EffortMenu | None = None
        self.restore: list[dict] = []  # sessions running before the reboot (restore_offer)
        self.focus_waiting = False  # f: only the sessions waiting on you
        self.held: list[str] = []  # requests greyproxy holds for approval (greyproxy_held)
        self.held_checked = 0.0
        self.start_files: dict[str, float] = {}
        self.restore_checked = 0.0
        self.width = DEFAULT_COLUMN_WIDTH

    @property
    def panel(self) -> Panel:
        return self.panels[self.focus]

    def focus_panel(self, index: int):
        """A panel taking the focus shows from its top: while small it scrolled to keep its
        selection in view, and that scroll would otherwise stay once it is big again."""
        if index != self.focus:
            self.panels[index].scroll = 0
        self.focus = index

    @property
    def sessions(self) -> list[dict]:
        return self.panels[1].items

    def tick(self):
        self.todos.apply_updates()
        self.errors.tick(reported_sessions())
        self.claude_status.tick()
        self.usage.tick()
        self.alerts.check(usage_windows())
        self.costs.tick()
        self.reviews.tick()
        for panel in self.panels:
            panel.build(self)
        self.push_viewed_state()

    def push_viewed_state(self):
        """The viewed session's state goes to the manager (its title line's colour) when it changes."""
        viewed = current_session()
        state = next((session["state"] for session in self.sessions if session["session"] == viewed), "")
        if (viewed, state) == self.labelled:
            return
        self.labelled = (viewed, state)
        if viewed and state:
            manager_in_background("label-state", state)

    def layout(self, height: int) -> list[int]:
        """Fixed panels keep their size; of the flexible ones, the focused takes half the rest."""
        heights = [panel.height() for panel in self.panels]
        flexible = [index for index, fixed in enumerate(heights) if fixed is None]
        available = height - HEADER_LINES - 1 - sum(fixed for fixed in heights if fixed is not None)
        expanded = self.focus if self.focus in flexible else flexible[0]
        others = max(MIN_PANEL_LINES, (available - max(MIN_PANEL_LINES, available // 2)) // max(1, len(flexible) - 1))
        for index in flexible:
            heights[index] = others
        heights[expanded] = max(MIN_PANEL_LINES, available - others * (len(flexible) - 1))
        return heights

    def draw(self, screen):
        screen.erase()
        hit_lines.clear()
        hit_actions.clear()
        height, width = screen.getmaxyx()
        self.width = width
        self.draw_header(screen, width)
        top = HEADER_LINES
        for index, (panel, panel_height) in enumerate(zip(self.panels, self.layout(height))):
            panel.draw(screen, top, panel_height, width, index == self.focus, index, self)
            top += panel_height
        self.draw_footer(screen, height - 1, width)
        if self.menu:
            self.menu.draw(screen)
        if self.help_open:
            self.draw_help(screen)
        screen.refresh()

    def open_effort_menu(self, session: dict, anchor_row: int | None = None) -> str:
        if session["state"] == "unknown":
            return "no effort for a session the daemon does not know"
        if anchor_row is None:
            # Under the card's last line, so the card and its effort stay readable above the menu.
            anchor_row = max((row for row, (panel, item) in hit_lines.items() if panel == 1 and item == self.panels[1].selected), default=HEADER_LINES)
        self.menu = EffortMenu(session, anchor_row)
        return ""

    def choose_effort(self, screen) -> str:
        menu, self.menu = self.menu, None
        level = EFFORT_LEVELS[menu.selected]
        session = menu.session
        if level == menu.current:
            return f"{session['project']} already runs on {level}"
        if session["state"] == "working" and not confirm(screen, self, f"{session['project']} is working: restart it on {level}?"):
            return ""
        manager_in_background("restart", session["session"], level)
        return f"restarting {session['project']} on {level} effort …"

    def handle_menu(self, key: int, screen) -> str:
        """Keys and clicks while the effort menu is open; anything else closes it."""
        if key == curses.KEY_MOUSE:
            try:
                _, x, y, _, _ = curses.getmouse()
            except curses.error:
                return ""
            if y in self.menu.rows:
                self.menu.selected = self.menu.rows[y]
                return self.choose_effort(screen)
            if not self.menu.contains(x, y):
                self.menu = None
            return ""
        if key in (ord("j"), curses.KEY_DOWN):
            self.menu.selected = min(len(EFFORT_LEVELS) - 1, self.menu.selected + 1)
        elif key in (ord("k"), curses.KEY_UP):
            self.menu.selected = max(0, self.menu.selected - 1)
        elif ord("1") <= key < ord("1") + len(EFFORT_LEVELS):
            self.menu.selected = key - ord("1")
            return self.choose_effort(screen)
        elif key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER):
            return self.choose_effort(screen)
        else:
            self.menu = None
        return ""

    def draw_header(self, screen, width: int):
        """Title, the needs-you count and the clock (the bar is hidden on this workspace)."""
        put(screen, 0, 2, "Claude sessions", style(BLUE, -1, curses.A_BOLD))
        needing = sum(1 for session in self.sessions if session["state"] == "needs-you")
        column = 2 + len("Claude sessions") + 2
        if needing:
            put(screen, 0, column, f"{needing} need you", style(RED, -1, curses.A_BOLD))
            column += len(f"{needing} need you") + 2
        if self.held:
            put(screen, 0, column, f"⛔ {len(self.held)}", style(YELLOW, -1, curses.A_BOLD))
        stamp = time.strftime("%H:%M  %a %d %b")
        put(screen, 0, max(2, width - 2 - len(stamp)), stamp, style(FG_DARK))
        cost = self.costs.totals()["today"]
        if cost:
            amount, label = f"≈ {money(cost)}", " today"
            column = width - 2 - len(stamp) - 3 - len(amount) - len(label)
            if column > 2 + len("Claude sessions") + (12 if needing else 0) + 2:
                put(screen, 0, column, amount, style(MAGENTA, -1, curses.A_BOLD))
                put(screen, 0, column + len(amount), label, style(FG_DARK, -1, curses.A_DIM))

    def draw_footer(self, screen, row: int, width: int):
        if self.filtering:
            put(screen, row, 2, "/", style(BLUE, -1, curses.A_BOLD))
            put(screen, row, 4, self.query + "▏", style(FG))
            return
        if self.message:
            put(screen, row, 2, self.message, style(YELLOW))
            return
        column = 2
        for key, label in self.panel.hints() + GLOBAL_HINTS:
            if column + len(key) + len(label) + 3 > width:
                break
            put(screen, row, column, key, style(BLUE, -1, curses.A_BOLD))
            column += len(key) + 1
            put(screen, row, column, label, style(FG_DARK, -1, curses.A_DIM))
            column += len(label) + 2

    def draw_help(self, screen):
        height, width = screen.getmaxyx()
        sections = [("Everywhere", GLOBAL_HELP)] + [(f"[{panel.key}] {panel.title}", panel.help()) for panel in self.panels] + [("Glyphs", LEGEND)]
        rows = []
        for title, entries in sections:
            rows.append((title, None))
            rows.extend(entries)
            rows.append(("", ""))
        box_top, box_height = HEADER_LINES, height - HEADER_LINES - 1
        for line in range(box_height):
            put(screen, box_top + line, 0, " " * (width - 1), style(FG, BG_HIGHLIGHT))
        for index, (key, label) in enumerate(rows[:box_height - 2]):
            if label is None:
                put(screen, box_top + 1 + index, 2, key, style(MAGENTA, BG_HIGHLIGHT, curses.A_BOLD))
            else:
                put(screen, box_top + 1 + index, 2, key, style(YELLOW, BG_HIGHLIGHT, curses.A_BOLD))
                put(screen, box_top + 1 + index, 11, label, style(FG_DARK, BG_HIGHLIGHT))
        put(screen, box_top + box_height - 1, 2, "any key closes", style(FG_DARK, BG_HIGHLIGHT, curses.A_DIM))

    def handle_mouse(self):
        try:
            _, x, y, _, state = curses.getmouse()
        except curses.error:
            return
        hit = hit_lines.get(y)
        if hit is None:
            return
        panel_index, item = hit
        self.focus_panel(panel_index)
        if item is not None:
            self.panel.selected = item
            action = hit_actions.get(y)
            if action and action[0] <= x < action[1] and action[2] == "effort":
                self.message = self.open_effort_menu(self.panel.selected_item(), y)
            elif state & curses.BUTTON1_DOUBLE_CLICKED:
                self.message = self.panel.handle(KEY_ENTER_LF, self, None)

    def handle(self, key: int, screen):
        self.message = ""
        if self.menu:
            self.message = self.handle_menu(key, screen)
            return
        if self.help_open:
            self.help_open = False
            return
        if curses.KEY_F1 <= key < curses.KEY_F1 + len(self.panels) - 1:
            self.focus_panel(key - curses.KEY_F1 + 1)  # F1..F3 from the tmux Ctrl+digit binds, even mid-filter
            self.filtering = False
            return
        if self.filtering:
            if key == KEY_ESCAPE:
                self.query, self.filtering = "", False
            elif key in (KEY_ENTER_LF, KEY_ENTER_CR, curses.KEY_ENTER):
                self.filtering = False
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                self.query = self.query[:-1]
            elif 32 <= key < 127:
                self.query += chr(key)
            return
        if key == curses.KEY_MOUSE:
            self.handle_mouse()
        elif ord("0") <= key < ord("0") + len(self.panels):
            self.focus_panel(key - ord("0"))
        elif key == KEY_TAB:
            self.focus_panel((self.focus + 1) % len(self.panels))
        elif key == curses.KEY_BTAB:
            self.focus_panel((self.focus - 1) % len(self.panels))
        elif key in (ord("j"), curses.KEY_DOWN):
            self.panel.move(1)
        elif key in (ord("k"), curses.KEY_UP):
            self.panel.move(-1)
        elif key in (ord("l"), curses.KEY_RIGHT):
            focus_viewer()  # from any panel, as ← comes back from the session (tmux.conf)
        elif key == ord("/"):
            self.filtering = True
        elif key == KEY_ESCAPE:
            self.query = ""
        elif key == ord("?"):
            self.help_open = True
        elif key == ord(":"):
            choice = run_outside_curses(screen, lambda: pick_action(palette_entries(self)))
            if choice:
                self.message = run_palette_entry(self, choice, screen)
        elif key == ord("a"):
            directory = run_outside_curses(screen, pick_project)
            if directory:
                self.message = manager("new", directory)
        elif key == ord("D"):
            self.message = manager("digest")
        elif key == ord("H"):
            past = run_outside_curses(screen, lambda: pick_past_session(self))
            if past:
                self.message = activate(past, self.view)
        elif key == ord("A"):
            directory = run_outside_curses(screen, pick_project)
            branch = run_outside_curses(screen, lambda: input_line("branch for the parallel session> ")) if directory else ""
            if directory and branch:
                manager_in_background("parallel", directory, branch)
                self.message = f"cloning {os.path.basename(directory)} for {branch} …"
        elif key == ord("P"):
            self.message = manager("prs")
        elif key in (ord("W"), ord("G")):
            self.message = open_in_scratchpad({ord("W"): "claude", ord("G"): "greyproxy"}[key])
        elif key in (ord("q"), KEY_CTRL_C):
            if confirm(screen, self, "close the manager window? sessions keep running"):
                subprocess.run(["tmux", "detach-client"])
        else:
            self.message = self.panel.handle(key, self, screen)


def activate(session: dict, view: ViewState) -> str:
    if session.get("folded"):
        view.toggle(view.folded, session["project"])
        return ""
    if session["state"] == "recent":
        return manager("resume", session["cwd"], session["session"])
    return manager("open", session["session"])


def usage_report_lines(columns: int) -> list[str]:
    """The usage page as text with ANSI colours, for the session pane (claude-sessions usage)."""
    bold, dim, reset = "\033[1m", "\033[2m", "\033[0m"
    ansi = {RED: "\033[31m", YELLOW: "\033[33m", MAGENTA: "\033[35m", FG_DARK: "\033[2m"}
    width = max(10, min(USAGE_REPORT_BAR_WIDTH, columns - 30))
    lines = ["", f"  {bold}\033[34mClaude usage{reset}  {dim}{usage_plan() or 'plan unknown'}{reset}", ""]
    windows = usage_windows()
    if not windows:
        lines.append(f"  {dim}No usage fetched yet. r in the Status panel fetches it.{reset}")
    for window in windows:
        percentage = window["percentage"]
        colour = ansi[usage_color(percentage)]
        filled = 0 if percentage is None else min(width, round(percentage / 100 * width))
        bar = colour + "█" * filled + dim + "░" * (width - filled) + reset
        value = f"{percentage:3d}%" if percentage is not None else "   –"
        heading = f"  {bold}{window['label']}{reset}" + (f"  {dim}{window['note']}{reset}" if window.get("note") else "")
        lines += [heading, f"  {bar}  {colour}{bold}{value}{reset}  {dim}{usage_resets_in(window)}{reset}", ""]
    breakdown = usage_breakdown()
    if breakdown:
        lines += [f"  {bold}This week by product{reset}", "  " + "   ".join(f"{name} {dim}{percent}%{reset}" for name, percent in breakdown), ""]
    credits = usage_credits()
    if credits:
        lines += [f"  {bold}Usage credits{reset}  {dim}{credits}{reset}", ""]
    try:
        fetched = int(time.time() - os.stat(USAGE_CACHE_PATH).st_mtime)
        lines.append(f"  {dim}Fetched {age(int(time.time()) - fetched)} ago, refreshed every {USAGE_REFRESH_S // 60} min. Pick a session to replace this.{reset}")
    except OSError:
        pass
    return lines


def usage_time_left(window: dict) -> str:
    """"2d 3h", "2h 13m" or "7m" until the window resets; empty when unknown."""
    try:
        moment = datetime.fromisoformat(window["resets_at"].replace("Z", "+00:00"))
    except (ValueError, AttributeError, TypeError, KeyError):
        return ""
    remaining = int((moment - datetime.now(timezone.utc)).total_seconds())
    if remaining <= 0:
        return "now"
    hours, minutes = divmod(remaining // 60, 60)
    if hours >= 48:
        return f"{hours // 24}d {hours % 24}h"
    if hours:
        return f"{hours}h {minutes:02d}m"
    return f"{minutes}m"


def usage_resets_short(window: dict) -> str:
    """The Status panel's right column: "in 2h 13m", or the clock time when only that is known."""
    left = usage_time_left(window)
    if left:
        return "resets now" if left == "now" else f"in {left}"
    return f"resets {window['resets']}" if window.get("resets") else ""


def usage_resets_in(window: dict) -> str:
    """The report's form: "resets 15:39  (in 2h 13m)"."""
    if not window.get("resets"):
        return ""
    left = usage_time_left(window)
    if left == "now":
        return "resetting"
    return f"resets {window['resets']}  (in {left})" if left else f"resets {window['resets']}"


def usage_report():
    """Redraws the report until the pane is replaced (claude-sessions usage runs this in the viewer)."""
    while True:
        columns = os.get_terminal_size().columns if sys.stdout.isatty() else 80
        sys.stdout.write("\033[2J\033[H" + "\n".join(usage_report_lines(columns)) + "\n")
        sys.stdout.flush()
        time.sleep(USAGE_REPORT_REDRAW_S)


def print_costs():
    """claude-sessions-sidebar costs: the API-price estimate per day this month, per month, per
    model and per project, from the archive (brought up to date first)."""
    archive = open_archive()
    archive_transcripts(archive, TRANSCRIPTS_DIR)
    days, unpriced, all_time = archived_costs(archive)
    first = date.today().replace(day=1).isoformat()
    print("this month")
    for day in sorted(day for day in days if day >= first):
        print(f"  {day}  {money(days[day]):>9}")
    print("per month")
    for month, cost in archive.execute("select substr(day, 1, 7), sum(cost) from replies group by 1 order by 1"):
        print(f"  {month}     {money(cost or 0):>9}")
    print("per model")
    for model, cost, output in archive.execute("select model, sum(cost), sum(output) from replies group by 1 order by 2 desc"):
        print(f"  {model:<24} {money(cost or 0):>9}  {output / 1e6:.1f}M output tokens")
    print("top projects")
    for project, cost in archive.execute("select project, sum(cost) from replies group by 1 order by 2 desc limit 10"):
        print(f"  {project:<24} {money(cost or 0):>9}")
    first_day = archive.execute("select min(day) from replies").fetchone()[0]
    print(f"all time      {money(all_time):>9}  (since {first_day})")
    for model, tokens in sorted(unpriced.items()):
        print(f"no price for {model}: {tokens} output tokens left out")
    archive.close()


DIGEST_MIN_REPLIES = 3


def digest_lines(archive: sqlite3.Connection, sessions: list[dict], reviews: list[dict], today: date) -> list[str]:
    """The morning digest as ANSI text: the last day with work before today, today so far, the
    plan's usage, the sessions waiting for you, and the pull requests (failing CI first)."""
    bold, dim, reset = "\033[1m", "\033[2m", "\033[0m"
    red, green, yellow, blue, magenta = "\033[31m", "\033[32m", "\033[33m", "\033[34m", "\033[35m"
    lines = ["", f"  {bold}{blue}Claude · {today.strftime('%A %d %B')}{reset}", ""]
    last_day = archive.execute("select max(day) from replies where day < ?", (today.isoformat(),)).fetchone()[0]
    if last_day:
        total, count = archive.execute("select sum(cost), count(distinct session) from replies where day = ?", (last_day,)).fetchone()
        label = "Yesterday" if last_day == (today - timedelta(days=1)).isoformat() else date.fromisoformat(last_day).strftime("%A %d %b")
        lines.append(f"  {bold}{label}{reset}  {magenta}{money(total or 0)}{reset} {dim}at API prices · {count} session{'s' if count != 1 else ''}{reset}")
        short_count, short_cost = 0, 0.0
        for session, project, cost, replies in archive.execute(
                "select session, project, sum(cost), count(*) from replies where day = ? group by session order by 3 desc", (last_day,)):
            if replies < DIGEST_MIN_REPLIES:  # a one-off question, or a session opened and left
                short_count, short_cost = short_count + 1, short_cost + (cost or 0)
                continue
            title = read_title(session) or "(untitled)"
            lines.append(f"    {project[:18]:<18}  {title[:44]:<44}  {money(cost or 0):>8}  {dim}{replies} replies{reset}")
        if short_count:
            lines.append(f"    {dim}and {short_count} short session{'s' if short_count != 1 else ''} · {money(short_cost)}{reset}")
        lines.append("")
    week_start = today - timedelta(days=today.weekday())
    today_cost = archive.execute("select sum(cost) from replies where day = ?", (today.isoformat(),)).fetchone()[0] or 0
    week_cost = archive.execute("select sum(cost) from replies where day >= ?", (week_start.isoformat(),)).fetchone()[0] or 0
    lines.append(f"  {bold}Today so far{reset}  {magenta}{money(today_cost)}{reset}   {dim}this week{reset} {magenta}{money(week_cost)}{reset}")
    windows = usage_windows()
    if windows:
        parts = [f"{window['label']} {window['percentage']}%" + (f" {dim}({usage_time_left(window)} left){reset}" if usage_time_left(window) else "")
                 for window in windows if window["percentage"] is not None]
        lines.append(f"  {bold}Plan{reset}  " + "   ".join(parts))
    lines.append("")
    waiting = [session for session in sessions if session.get("state") in ("needs-you", "waiting")]
    if waiting:
        lines.append(f"  {bold}Waiting for you{reset}")
        for session in waiting:
            mark = f"{red}!{reset}" if session["state"] == "needs-you" else f"{yellow}○{reset}"
            lines.append(f"    {mark} {session.get('project', '?'):<18} {dim}{visible_task(session)[:50]}{reset}")
        lines.append("")
    if reviews:
        order = {"failing": 0, "pending": 1, "passing": 2, "": 3}
        lines.append(f"  {bold}Pull requests{reset}")
        marks = {"failing": f"{red}✗{reset}", "pending": f"{yellow}●{reset}", "passing": f"{green}✓{reset}", "": " "}
        for row in sorted(reviews, key=lambda row: order.get(row.get("ci", ""), 3))[:10]:
            review = {"APPROVED": f"{green}approved{reset}", "CHANGES_REQUESTED": f"{red}changes{reset}", "REVIEW_REQUIRED": f"{yellow}review{reset}"}.get(row.get("review", ""), "")
            lines.append(f"    {marks.get(row.get('ci', ''), ' ')} {row['repository']}#{row['number']}  {row['title'][:50]}  {review}")
        lines.append("")
    return lines


def print_digest():
    """claude-sessions-sidebar digest: the morning digest (claude-sessions digest shows it)."""
    archive = open_archive()
    archive_transcripts(archive, TRANSCRIPTS_DIR)
    reviews, _ = fetch_reviews(list(session_checkouts()))
    print("\n".join(digest_lines(archive, reported_sessions(), reviews, date.today())))
    archive.close()


def main(screen):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.set_escdelay(25)
    curses.raw()  # Ctrl-C arrives as a key (same as q) instead of killing the column
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    screen.timeout(POLL_MS)
    app = App()
    subprocess.run(["claude-sessions", "sweep"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    app.history.refresh()
    app.view.forget_unknown_hidden({entry["session"] for entry in app.history.entries})
    while True:
        app.tick()
        app.draw(screen)
        key = screen.getch()
        if key == -1:
            continue
        app.handle(key, screen)


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["usage"]:
            usage_report()
        elif sys.argv[1:] == ["costs"]:
            print_costs()
        elif sys.argv[1:] == ["digest"]:
            print_digest()
        elif sys.argv[1:]:
            sys.exit(f"usage: {os.path.basename(sys.argv[0])} [usage|costs|digest]")
        else:
            log_event("INFO", f"started (pid {os.getpid()})")
            curses.wrapper(main)
    except KeyboardInterrupt:
        pass
    except Exception:
        # The traceback on one line, so the sidebar's death is found later; then die as before.
        log_event("ERROR", "crashed: " + " | ".join(line.strip() for line in traceback.format_exc().splitlines()[-6:]))
        raise
