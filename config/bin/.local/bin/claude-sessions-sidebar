hit_actions: dict[int, tuple[int, int, str]] = {}  # screen row -> (first column, last column, action) of a clickable stamp
EFFORT_LEVELS = ("low", "medium", "high", "xhigh", "max")  # claude --help, --effort

# Pull requests: the running sessions' repositories, else every review request.
