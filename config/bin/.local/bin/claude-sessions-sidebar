#!/usr/bin/env python3
"""Left column of the Claude session manager (`claude-sessions`): three stacked panels, in the
spirit of lazygit, with the viewed session in the terminal pane on the right.

  [0] Status         the plan's usage as claude.ai shows it: the current session, this week, and
                     every separate weekly limit (Fable …), with reset times (claude-usage.sh's cache)
  [1] Sessions       running sessions (e, or a click on the effort level on a card, opens the effort
                     menu: the chosen level restarts the session on it): state, project, title, model and context; most urgent first,
                     pinned ones on top, then claude-retry-* tmux sessions the daemon does not know
  [2] History        past sessions from ~/.claude/history.jsonl under day headings and projects, the
                     transcript's generated title; trivial ones hidden unless shown with .
  [3] Pull requests  open pull requests in the viewed session's repository, or in every running
                     session's when none is viewed (your review requests when nothing runs), without
                     bot authors or anything untouched for months

The focused panel takes half the column (Status keeps its size); 0/1/2/3, Tab and Shift+Tab move the focus, j/k or the
arrows move inside it, / filters the focused panel (Esc clears), ? shows every key, q or Ctrl-C
close the manager window, a starts a session in a project picked with fzf. Enter opens a running
session (shows it in the viewer and moves the cursor there), resumes a past one, or opens a pull
request in the cockpit's pull requests window (P, W and G show that window, Claude on the web and
greyproxy's dashboard on top, like Super+Ctrl+P/A/G). Status: Enter shows the full usage report in the session pane, r refetches. Sessions: n peeks at the next one needing you, x exits (Ctrl-C twice,
then killed if it lingers), r restarts in place, R toggles Remote Control, p pins. History: x hides
(u undoes), h or Left folds a project. Pull requests: r refreshes. Mouse: click focuses and
selects, double-click opens. Ctrl+Tab (tmux.conf) moves between the column and the session.
F1 to F3 from tmux (Ctrl+1/2/3 in the session pane, tmux.conf) focus a panel
even while filtering. Pins, folds and hidden sessions persist in ~/.local/state/claude-sessions/view.json.
claude-sessions-sidebar costs prints this month's cost estimate per day.
CLAUDE_REVIEWS_FIXTURE points at a saved gh JSON output for testing without GitHub.
"""
import curses
import glob
import hashlib
import json
import os
import re
import sqlite3
import secrets
import subprocess
import sys
import threading
import time
import traceback
from datetime import date, datetime, timedelta, timezone

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SNAPSHOT_PATH = os.path.join(RUNTIME_DIR, "claude-sessions.json")
CURRENT_PATH = os.path.join(RUNTIME_DIR, "claude-sessions.current")
HISTORY_PATH = os.environ.get("CLAUDE_SESSIONS_HISTORY", os.path.expanduser("~/.claude/history.jsonl"))
TRANSCRIPTS_DIR = os.environ.get("CLAUDE_SESSIONS_TRANSCRIPTS", os.path.expanduser("~/.claude/projects"))
STATUSLINE_DIR = os.path.expanduser("~/.cache/claude")
USAGE_CACHE_PATH = os.path.join(RUNTIME_DIR, "claude-usage.json")
USAGE_SCRIPT = os.path.expanduser("~/.config/waybar/scripts/claude-usage.sh")
USAGE_REFRESH_S = 300
# The usage page is driven by the response's "limits" list (session, weekly_all, weekly_scoped
# per model or surface); the flat windows below are the older shape, used only without that list.
USAGE_WINDOWS = (("five_hour", "Current session"), ("seven_day", "This week"),
                 ("seven_day_opus", "Opus this week"), ("seven_day_sonnet", "Sonnet this week"))
USAGE_LIMIT_LABELS = {"session": "Current session", "weekly_all": "This week"}
USAGE_BAR_MIN, USAGE_BAR_MAX = 8, 40
DEFAULT_COLUMN_WIDTH = 60  # SIDEBAR_WIDTH in claude-sessions, until the first draw measures it
USAGE_REPORT_BAR_WIDTH = 40
USAGE_REPORT_REDRAW_S = 30
CREDENTIALS_PATH = os.path.expanduser("~/.claude/.credentials.json")
VIEW_STATE_PATH = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                               "claude-sessions", "view.json")
PROJECT_PATTERNS = ("~/IdeaProjects/*/", "~/dotfiles/")
POLL_MS = 500
RETRY_SESSION_PREFIX = "claude-retry-"
RECENT_LIMIT = 40
TITLE_SCAN_BYTES = 2 * 1024 * 1024  # the ai-title record lands early in a transcript
TITLES_PER_TICK = 8
TITLE_RETRY_S = 30
TRIVIAL_PROMPT_WORDS = 4
GLYPHS = {"working": "●", "waiting": "○", "needs-you": "!", "unknown": "·", "recent": "↻"}
# kitty's 16-colour palette is Tokyo Night, so plain colour indexes match the rest of the desktop.
RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN, FG_DARK, BG_HIGHLIGHT, FG = 1, 2, 3, 4, 5, 6, 7, 8, 15
STATE_COLORS = {"working": BLUE, "waiting": YELLOW, "needs-you": RED, "unknown": FG_DARK, "recent": CYAN}
PROJECT_COLORS = (MAGENTA, CYAN, GREEN, BLUE, YELLOW)
KEY_ESCAPE, KEY_ENTER_LF, KEY_ENTER_CR, KEY_TAB, KEY_CTRL_C = 27, 10, 13, 9, 3
HEADER_LINES = 1
