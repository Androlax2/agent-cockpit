#!/usr/bin/env bash
# claude-sessions-left <pane>: Left in the cockpit's session pane (tmux.conf). When the prompt's
# cursor sits right after Claude's ❯ marker (or opencode's ┃ bar), nothing is left of it in the
# prompt (an empty prompt, or the start of its text): Left goes back to the column, as Ctrl+Tab
# does. Anywhere else it reaches the agent, to move in the text. Read from the pane as it shows: its cursor and that line
# (an empty prompt can show a dim placeholder after ❯, so the cursor decides, not the text).
# A script of its own, not claude-sessions: tmux waits for it on every Left.
set -u
export LC_ALL=C.UTF-8 # ${line:0:n} counts characters, not the bytes of ❯
pane=${1:?usage: claude-sessions-left <pane>}
read -r cursor_x cursor_y < <(tmux display-message -p -t "$pane" '#{cursor_x} #{cursor_y}')
line=$(tmux capture-pane -p -t "$pane" -S "${cursor_y:-0}" -E "${cursor_y:-0}")
before_cursor=${line:0:${cursor_x:-0}}
# Spaces or the box's │, then ❯ and the space or no-break space Claude draws after it.
prompt_start=$'^[[:space:]\u2502]*\u276f[ \u00a0]$'
# opencode's input box: spaces, its heavy bar ┃ and the two spaces before the text.
opencode_prompt_start=$'^[[:space:]]*\u2503  $'
if [[ $before_cursor =~ $prompt_start || $before_cursor =~ $opencode_prompt_start ]]; then
    tmux select-pane -L -t "$pane"
else
    tmux send-keys -t "$pane" Left
fi
