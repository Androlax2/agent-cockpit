#!/usr/bin/env python3
"""Run background build tools at the lowest CPU priority, below interactive work."""

import os
import shutil
import sys
from pathlib import Path

LOWEST_NICE = 19


def main():
    invoked_name = Path(sys.argv[0]).name
    is_shim = invoked_name != "agent-build"
    arguments = [invoked_name, *sys.argv[1:]] if is_shim else sys.argv[1:]
    if not arguments:
        print("usage: agent-build COMMAND [ARGUMENTS...]", file=sys.stderr)
        return 2

    search_path = os.environ.get("PATH", os.defpath)
    if is_shim:
        # Keep the shims on the child's PATH: make must still find the cargo shim.
        shim_directory = Path(sys.argv[0]).absolute().parent
        search_path = os.pathsep.join(
            directory
            for directory in search_path.split(os.pathsep)
            if Path(directory).absolute() != shim_directory
        )
    executable = shutil.which(arguments[0], path=search_path)
    if executable is None:
        print(f"agent-build: command not found: {arguments[0]}", file=sys.stderr)
        return 127

    # Nice alone only orders tasks inside one cgroup, and every session has its own. A waking
    # normal task preempts a SCHED_IDLE one and treats its CPU as free, across cgroups too.
    # Builds keep every CPU thread they were given: idle cores are better used than reserved.
    os.setpriority(os.PRIO_PROCESS, 0, LOWEST_NICE)
    os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
    os.execv(executable, arguments)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except OSError as error:
        print(f"agent-build: {error}", file=sys.stderr)
        sys.exit(126)
