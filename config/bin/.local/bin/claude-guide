#!/usr/bin/env python3
"""claude-guide <id>: steps Claude handed Theo to do by hand (ask-to-guide), one at a time.

Started by the OSD daemon outside the sandbox, in a floating kitty window of its own (class
claude-guide) that Theo moves wherever he needs it. The guide file comes from the sandbox, so
it is read once and checked; hidden characters are shown escaped; links open only on o, values are
copied only on c; a run: step goes through the same approval as ask-to-run (claude-run-approve's
code): nothing runs without Theo's "Run it". When every step is done, or Theo is stuck or closes
it, the result goes back to Claude; <id>.progress tells a waiting Claude where Theo is.
CLAUDE_GUIDES_DIR overrides the folder (tests).
"""

import curses
import importlib.machinery
import importlib.util
import json
import locale
import os
import re
import subprocess
import sys
import textwrap
import time

GUIDES_DIR = os.environ.get("CLAUDE_GUIDES_DIR", os.path.expanduser("~/.cache/claude/guides"))
GUIDE_ID = re.compile(r"[0-9a-f]{12}")
MAX_AGE_S = 2 * 3600  # a guide can wait in the queue behind another one
MAX_STEPS = 60
MAX_TEXT = 2000
STEP_FIELDS = ("text", "section", "open", "copy", "ask", "run")
LINK = re.compile(r"https?://[^\s<>\"')]+")
KEY_ENTER = (10, 13, curses.KEY_ENTER)


def load_approval():
    """claude-run-approve, next to this script: one approval code for ask-to-run and run: steps."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "claude-run-approve")
    loader = importlib.machinery.SourceFileLoader("claude_run_approve", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


approval = load_approval()


def read_guide(guide_id: str) -> dict:
    """The guide, checked, or a ValueError saying why it cannot be shown."""
    if not GUIDE_ID.fullmatch(guide_id):
        raise ValueError("not a guide id")
    if os.path.exists(os.path.join(GUIDES_DIR, f"{guide_id}.result")):
        raise ValueError("already answered")
    with open(os.path.join(GUIDES_DIR, f"{guide_id}.guide")) as file:
        guide = json.load(file)
    if not isinstance(guide, dict) or time.time() - int(guide.get("requested_at", 0)) > MAX_AGE_S:
        raise ValueError("older than two hours")
    steps = guide.get("steps")
    if not isinstance(steps, list) or not 0 < len(steps) <= MAX_STEPS:
        raise ValueError("no steps, or too many")
    for step in steps:
        if not isinstance(step, dict) or not isinstance(step.get("text"), str) or not step["text"].strip():
            raise ValueError("a step without text")
        if any(not isinstance(step.get(field, ""), str) or len(step.get(field, "")) > MAX_TEXT for field in STEP_FIELDS):
            raise ValueError("a step field that is not text, or too long")
    if not isinstance(guide.get("title", ""), str):
        raise ValueError("a title that is not text")
    return guide


def shown(text: str) -> str:
    """Text as displayed: characters that could hide what it says are escaped."""
    return approval.HIDING.sub(lambda match: f"\\u{ord(match.group()):04x}", text)


def link_of(step: dict) -> str:
    """The link o opens: the step's open: value, else the first link in its text; http(s) only."""
    candidate = step.get("open") or next(iter(LINK.findall(step["text"])), "")
    return candidate if LINK.fullmatch(candidate) else ""


class Guide:
    """Where Theo is: the step on screen, the steps done, his answers and the commands run."""

    def __init__(self, guide_id: str, guide: dict):
        self.id, self.title, self.steps = guide_id, guide.get("title") or "Steps from Claude", guide["steps"]
        self.cwd = guide.get("cwd") if isinstance(guide.get("cwd"), str) and os.path.isdir(guide.get("cwd")) else os.path.expanduser("~")
        self.project = approval.project_of(self.cwd)
        self.position = 0
        self.done: set[int] = set()
        self.answers: dict[int, str] = {}
        self.notes: dict[int, str] = {}
        self.runs: dict[int, dict] = {}

    @property
    def step(self) -> dict:
        return self.steps[self.position]

    def move(self, offset: int):
        self.position = max(0, min(len(self.steps) - 1, self.position + offset))

    def mark_done(self) -> bool:
        """Marks the step on screen done and moves to the next one not done; True when all are."""
        self.done.add(self.position)
        remaining = [index for index in range(len(self.steps)) if index not in self.done]
        if not remaining:
            return True
        self.position = next((index for index in remaining if index > self.position), remaining[0])
        return False

    def typed(self) -> str:
        """What the box holds for the step on screen: its answer, or its note to Claude."""
        return (self.answers if self.step.get("ask") else self.notes).get(self.position, "")

    def submit(self, text: str):
        """The box's text: the answer when the step asks something, else a note (dropped when empty)."""
        text = " ".join(text.split())
        if self.step.get("ask"):
            self.answers[self.position] = text
        elif text:
            self.notes[self.position] = text
        else:
            self.notes.pop(self.position, None)

    def progress(self) -> dict:
        return {"step": self.position + 1, "total": len(self.steps), "done": len(self.done)}

    def result(self, status: str, note: str = "") -> dict:
        return {"status": status, "step": self.position + 1, "total": len(self.steps),
                "step_text": self.step["text"].split("\n")[0], "note": note, "done": sorted(index + 1 for index in self.done),
                "answers": [{"step": index + 1, "question": self.steps[index]["ask"], "answer": answer}
                            for index, answer in sorted(self.answers.items())],
                "notes": [{"step": index + 1, "note": note} for index, note in sorted(self.notes.items())],
                "runs": [{"step": index + 1, **run} for index, run in sorted(self.runs.items())]}


def write_json(path: str, data: dict):
    with open(path + ".tmp", "w") as file:
        json.dump(data, file)
    os.replace(path + ".tmp", path)


def save_progress(guide: Guide):
    write_json(os.path.join(GUIDES_DIR, f"{guide.id}.progress"), guide.progress())


def finish(guide: Guide, status: str, note: str = ""):
    write_json(os.path.join(GUIDES_DIR, f"{guide.id}.result"), guide.result(status, note))
    try:
        os.remove(os.path.join(GUIDES_DIR, f"{guide.id}.progress"))
    except OSError:
        pass
    approval.send(f"notice-clear guide-{guide.id}")
    approval.log("INFO", f"guide {guide.id} for {guide.project}: {status} at step {guide.position + 1}/{len(guide.steps)}"
                         f"{' (' + note[:80] + ')' if note else ''}")


def render_step(guide: Guide, width: int) -> list[tuple[str, str]]:
    """The step on screen as (text, kind) lines, kind naming the style: its section, its text, and
    its link, value and command with their keys. The box and the keys are drawn apart."""
    step, lines = guide.step, []
    wrap = lambda text, indent: [" " * indent + line for line in textwrap.wrap(shown(text), max(10, width - indent))] or [""]
    if step.get("section"):
        lines += [(shown(step["section"])[:width], "section"), ("", "plain")]
    for paragraph in step["text"].split("\n"):
        lines += [(line, "current") for line in wrap(paragraph, 0)]
    if any(shown(step.get(field, "")) != step.get(field, "") for field in STEP_FIELDS):
        lines += [("", "plain"), ("⚠ hidden characters, shown as \\uXXXX", "warning")]
    details = [(label, value, key) for label, value, key in (("link", link_of(step), "^O opens"), ("copy", step.get("copy", ""), "^Y copies"),
                                                           ("run", step.get("run", ""), "^R runs (⏎ too)")) if value]
    if details:
        lines.append(("", "plain"))
    for label, value, key in details:
        lines.append((f"  {label} · {key}", "label"))
        lines += [(line, "value") for line in wrap(value, 4)]
    if guide.position in guide.runs:
        run = guide.runs[guide.position]
        lines.append((f"  ↳ {'declined' if run.get('status') == 'declined' else 'exit ' + str(run.get('exit'))}", "answer"))
    return lines


HINTS = ("⏎ next   ↑ back   ^O open   ^Y copy   ^R run", "^S stuck: send my note now   Esc close")


def run_step(guide: Guide):
    """The step's command, through the ask-to-run approval: shown escaped, Decline by default."""
    command = original = guide.step["run"]
    print(f"\n{approval.BOLD}Step {guide.position + 1} of the guide{approval.RESET} asks you to run, "
          f"in {approval.DIM}{guide.cwd}{approval.RESET}:\n")
    while True:
        text, hiding = approval.visible_command(command)
        print("\n".join(f"  {approval.BOLD}{line}{approval.RESET}" for line in text.split("\n")) + "\n")
        if hiding:
            print(f"{approval.RED}{approval.BOLD}This command contains hidden characters (shown in red as \\uXXXX). "
                  f"Decline unless you know why.{approval.RESET}\n")
        answer = approval.choose("Run it?", [("n", "Decline"), ("y", "Run it"), ("e", "Edit it first")], "n")
        if answer != "e":
            break
        command = approval.edit(command) or command
    edited = command if command != original else None
    if answer != "y":
        guide.runs[guide.position] = {"status": "declined", "command": original, "edited_command": edited}
        return
    log_path = os.path.join(approval.LOG_DIR, f"guide-{guide.id}-{guide.position + 1}.log")
    exit_code = approval.run(command, guide.cwd, log_path)
    print(f"{approval.DIM}─── {approval.RESET}exit {exit_code}")
    keep = approval.choose("Send the output to Claude?", [("y", "Send the output"), ("n", "Keep it out (only the exit status)")], "y") == "y"
    guide.runs[guide.position] = {"status": "ran", "command": original, "edited_command": edited, "exit": exit_code,
                                  "output": approval.recorded_output(log_path) if keep else "", "output_withheld": not keep}
    try:
        os.remove(log_path)
    except OSError:
        pass


def outside(screen, action):
    """Leaves curses for a plain terminal (prompts, the command's output), then comes back."""
    curses.def_prog_mode()
    curses.endwin()
    try:
        return action()
    finally:
        curses.reset_prog_mode()
        screen.clear()


def copy(value: str) -> str:
    try:
        subprocess.run(["wl-copy"], input=value, text=True, check=True, timeout=5)
        return "copied"
    except (OSError, subprocess.SubprocessError) as error:
        return f"cannot copy: {error}"


def open_link(link: str) -> str:
    try:
        subprocess.Popen(["xdg-open", link], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return "opened in the browser"
    except OSError as error:
        return f"cannot open: {error}"


def draw(screen, guide: Guide, draft: str, message: str):
    height, width = screen.getmaxyx()
    screen.erase()
    styles = {"current": curses.A_BOLD, "section": curses.color_pair(1) | curses.A_BOLD, "label": curses.color_pair(2),
              "value": curses.A_NORMAL, "answer": curses.color_pair(3), "warning": curses.color_pair(4) | curses.A_BOLD,
              "plain": curses.A_NORMAL}
    counter = f"step {guide.position + 1} of {len(guide.steps)}"
    put(screen, 0, 1, shown(guide.title)[:max(1, width - len(counter) - 4)], curses.A_BOLD)
    put(screen, 0, width - len(counter) - 2, counter, curses.color_pair(1))
    put(screen, 1, 1, f"Claude · {guide.project}" + (f" · {len(guide.done)} done" if guide.done else ""), curses.A_DIM)
    put(screen, 2, 1, "─" * (width - 3), curses.A_DIM)
    box_lines = textwrap.wrap(draft, max(10, width - 6)) or [""]
    box_lines = box_lines[-3:]
    box_top = height - 4 - len(box_lines) - 3
    for row, (text, kind) in enumerate(render_step(guide, width - 4)[:max(0, box_top - 5)]):
        put(screen, 4 + row, 2, text, styles[kind])
    question = f"Claude asks: {shown(guide.step['ask'])}" if guide.step.get("ask") else "A note for Claude about this step (optional)"
    put(screen, box_top - 1, 2, question[:width - 4], curses.color_pair(2) | (curses.A_BOLD if guide.step.get("ask") else curses.A_DIM))
    put(screen, box_top, 1, "┌" + "─" * (width - 4) + "┐", curses.A_DIM)
    for row, line in enumerate(box_lines):
        put(screen, box_top + 1 + row, 1, "│ " + line.ljust(width - 6) + " │", curses.A_NORMAL)
    put(screen, box_top + 1 + len(box_lines), 1, "└" + "─" * (width - 4) + "┘", curses.A_DIM)
    put(screen, height - 3, 2, message[:width - 4], curses.color_pair(3))
    for offset, hint in enumerate(HINTS):
        put(screen, height - 2 + offset, 2, hint[:width - 4], curses.A_DIM)
    cursor_row, cursor_column = box_top + len(box_lines), 3 + len(box_lines[-1])
    try:
        screen.move(cursor_row, min(cursor_column, width - 3))
    except curses.error:
        pass
    screen.refresh()


def put(screen, row: int, column: int, text: str, attribute: int):
    try:
        screen.addstr(row, column, text, attribute)
    except curses.error:
        pass  # the bottom-right cell, or a panel narrower than the text


PASTE_START, PASTE_END = "[200~", "[201~"
CTRL_C, CTRL_O, CTRL_R, CTRL_S, CTRL_Y, ESCAPE = "\x03", "\x0f", "\x12", "\x13", "\x19", "\x1b"
BACKSPACES = (curses.KEY_BACKSPACE, "\x7f", "\x08")


def escape_sequence(screen) -> str:
    """What follows an Escape right away (a pasted block's markers, an arrow); "" for Escape alone."""
    screen.nodelay(True)
    sequence = ""
    try:
        while len(sequence) < 8:
            try:
                key = screen.get_wch()
            except curses.error:
                break
            sequence += key if isinstance(key, str) else ""
            if sequence[-1:] in ("~", "A", "B", "C", "D") and len(sequence) > 1:
                break
    finally:
        screen.nodelay(False)
    return sequence


def read_paste(screen) -> str:
    """A bracketed paste, up to its end marker: line breaks become spaces, so a paste never moves on."""
    pasted = ""
    while not pasted.endswith("\x1b" + PASTE_END):
        key = screen.get_wch()
        if isinstance(key, str):
            pasted += key
    return pasted[: -len("\x1b" + PASTE_END)].replace("\r", " ").replace("\n", " ")


def loop(screen, guide: Guide):
    curses.raw()  # Ctrl+S, Ctrl+O, Ctrl+Y and Ctrl+C reach the guide instead of the terminal
    curses.set_escdelay(25)
    curses.use_default_colors()
    for pair, color in ((1, curses.COLOR_CYAN), (2, curses.COLOR_BLUE), (3, curses.COLOR_GREEN), (4, curses.COLOR_RED)):
        curses.init_pair(pair, color, -1)
    sys.stdout.write("\x1b[?2004h")  # bracketed paste
    sys.stdout.flush()
    draft, message = guide.typed(), ""
    while True:
        save_progress(guide)
        curses.curs_set(1)
        draw(screen, guide, draft, message)
        key = screen.get_wch()
        message = ""
        if key == ESCAPE:
            sequence = escape_sequence(screen)
            if sequence == PASTE_START:
                draft += read_paste(screen)
                continue
            if sequence == "[A":
                key = curses.KEY_UP
            elif sequence:
                continue
        if key in ("\n", "\r", curses.KEY_ENTER):
            if guide.step.get("run") and guide.position not in guide.runs:
                outside(screen, lambda: run_step(guide))
            guide.submit(draft)
            if guide.mark_done():
                finish(guide, "done")
                return "Every step done: Claude is told."
            draft = guide.typed()
        elif key == curses.KEY_UP:
            guide.submit(draft)
            guide.move(-1)
            draft = guide.typed()
        elif key in BACKSPACES:
            draft = draft[:-1]
        elif key == CTRL_O:
            message = open_link(link_of(guide.step)) if link_of(guide.step) else "no link on this step"
        elif key == CTRL_Y:
            message = copy(guide.step["copy"]) if guide.step.get("copy") else "nothing to copy on this step"
        elif key == CTRL_R and guide.step.get("run"):
            outside(screen, lambda: run_step(guide))
        elif key == CTRL_S:
            guide.submit(draft)
            finish(guide, "stuck", draft.strip() or "(no note)")
            return "Claude is told where you are stuck."
        elif key in (ESCAPE, CTRL_C):
            guide.submit(draft)
            closing = outside(screen, lambda: approval.choose("Close the guide? Claude is told where you stopped.",
                                                              [("n", "Keep going"), ("y", "Close it")], "n"))
            if closing == "y":
                finish(guide, "closed")
                return "Closed: Claude is told."
        elif isinstance(key, str) and key.isprintable():
            draft += key


def main(guide_id: str) -> int:
    try:
        guide = Guide(guide_id, read_guide(guide_id))
    except (OSError, ValueError) as error:
        print(f"Cannot show guide {guide_id}: {error}.")
        time.sleep(5)
        return 1
    locale.setlocale(locale.LC_ALL, "")  # curses reads typed é, ü… as characters, not bytes
    print(curses.wrapper(loop, guide))
    time.sleep(1.5)
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: claude-guide <id>")
    sys.exit(main(sys.argv[1:][0]))
