#!/usr/bin/env bash
# Claude session manager, Turborepo style: a sidebar listing every Claude Code session on the
# left (cockpit-sidebar) and the selected session, attached with nested tmux, on the
# right. Sessions come from the OSD daemon's snapshot ($XDG_RUNTIME_DIR/cockpit.json);
# each one lives in the tmux session claude-auto-retry created for it, so viewing is attaching.
#
#   cockpit                      attach the manager in this terminal (created on first use)
#   cockpit show [id]            open or focus the manager window (kitty, workspace 6), view id;
#                                without id, from the Claude workspace itself, go back to the
#                                previous workspace instead (ALT + C toggles)
#   cockpit view <id>            show a session in the viewer pane; id is the
#                                daemon's session id or a claude-retry-* tmux session name
#   cockpit open <id>            view it and put the cursor in it (the sidebar's Enter)
#   cockpit attend <id>          focus its approval or question, return after answering (the sidebar's n)
#   cockpit attention-answered <run-id>
#                                return from command input without closing its output (the daemon)
#   cockpit new <dir> [claude args…]
#                                start `claude` in <dir> inside the viewer pane (the sidebar's a,
#                                and the fish `claude` function from any terminal). Without claude
#                                arguments, a session already running in <dir> is shown instead:
#                                typing `claude` twice in a project must not leave the first one
#                                running unseen in the background.
#   cockpit resume <dir> <id>
#                                resume a past session there (the sidebar's Enter on a recent one)
#   cockpit exit <id>            end a running session the way you would by hand: Ctrl-C twice,
#                                then its tmux session is killed if it is still there (the sidebar's x)
#   cockpit restart <id> [effort]
#                                exit it and resume the same conversation in its directory, which
#                                is how an installed Claude update gets applied (the sidebar's r);
#                                with an effort level (low … max) it comes back on that one (the
#                                sidebar's effort menu), without one it keeps the level it had
#   cockpit restart-all [<id>...]
#                                without ids, restart every managed running session, including the
#                                caller; terminal/external and sleeping sessions are left alone.
#                                With ids, restart only those (the sidebar's Ctrl+R).
#                                Active turns and background jobs are interrupted, as with restart.
#   cockpit background <dir> <prompt>
#                                start a session there out of sight, with that first message (the
#                                sidebar's error hand-off); it shows as a card
#   cockpit loading-screen
#                                what the popup over the viewer pane runs while a session starts
#   cockpit restarting-screen <id>
#                                what the viewer pane runs while the session on screen restarts out of
#                                sight; it views the session again once it reports
#   cockpit idle                 what the viewer pane runs while nothing is selected
#   cockpit usage                show the plan's usage report in the viewer pane (the sidebar's Enter on Status)
#   cockpit logs [lines] the end of the log (~/.local/state/cockpit/log) and the hook's
#   cockpit log <component> <INFO|WARN|ERROR> <message>
#                                add a line, for the lock, idle and update scripts
#   cockpit git <dir>            lazygit on that repository in a popup over the manager (the sidebar's g)
#   cockpit push <dir>           push its branch to origin with Theo's SSH key, after a yes (the sidebar's U)
#   cockpit apply [clone]        apply a reviewed clone's exported commits (.outgoing) to its running
#                                copy after a yes: dotfiles, agent-cockpit or vitals (apply-dotfiles too)
#   cockpit prs                  the pull requests window on the viewed session's repository (Super+Ctrl+P)
#   cockpit digest               yesterday, today, usage, waiting sessions and pull requests in the viewer
#                                (the digest action of the sidebar's : list; also the first time the cockpit opens each day)
#   cockpit parallel <dir> <branch>
#                                a new session on <branch> in its own clone of the repository (the sidebar's +)
#   cockpit clones               the clones of + and of reviews, and delete those holding nothing new (also once a day by itself)
#   cockpit review <dir> <pr-number>
#                                a session reviewing that pull request in its own clone (the sidebar's c)
#   cockpit label-state <state>
#                                colour the viewer's title line by the viewed session's state (the sidebar)
#   cockpit focus-viewer move the cursor into the viewer pane (the sidebar's Right)
#   cockpit prepare              create the manager's tmux session without a window (login autostart)
#   cockpit reload               restart the sidebar in place (after editing it), and the OSD daemon
#                                and the phone page when they run an older build than the one on disk
#   cockpit layout               reapply the sidebar width
#   cockpit design-review start|stop [session-id] [--figcraft-window <address>]
#                                approved host-only conversation float on FigCraft's workspace
#   cockpit reset                close the manager and forget every tracked session; running
#                                Claude sessions themselves are left alone
#   cockpit doctor               check every piece this depends on (daemon, FIFO, greywall paths,
#                                hooks, bar, tmux, manager) and what the pane heuristics see
#   cockpit handoff [on|off]
#                                hand every running session to Remote Control (Claude's /rc, driven
#                                from claude.ai/code) before leaving, or take them back
#   cockpit away on|off          the phone page (claude-remote) notifies while away: the lock screen
#                                runs it (nothing while the setting phone-on-lock is off)
#   cockpit setting <name> [on|off]
#                                show or change a setting (the sidebar's S): phone-on-lock,
#                                todo-queue, error-handoff, freeze-while-gaming, idle-lock, daily-digest,
#                                idle-sleep (off: idle sessions stay running); idle-sleep-after <minutes>
#                                (30 or more, default 60) is how long a session idles before it sleeps
#                                chief-starts-per-hour <1-60> (default 6) caps the sessions the Chief may ask
#                                for in an hour; todos you queued with Q do not count
#                                chief-dispatches-own-todos on|off (default off): on lets the Chief start or
#                                give todos it filed itself without your Q (still capped, logged and audited)
#   cockpit remote <id>          toggle Remote Control for one session (the remote action of the sidebar's : list)
#   cockpit restore <dir> <id> […]
#                                resume those sessions one after the other (the sidebar's B after a reboot)
#   cockpit sleep <id>           exit a session idle at its prompt and keep a note to wake it (asleep/<id>);
#                                exit 3 and the reason on stderr when it stays awake (a draft, a background process…)
#   cockpit compact <id> type /compact into a session waiting at its prompt (the sidebar's C)
#   cockpit variants <id>
#                                open opencode's native effort picker and focus its pane (the sidebar's e)
#   cockpit approval-pane <id>|close
#                                show a run request's approval under the session pane (the daemon)
#   cockpit say <id> <message>
#                                send a session a message without opening it (the cockpit's queued prompts, and error hand-offs)
#   cockpit --agent <name> new|parallel|background|review …
#                                the same start with another agent (cockpit-agents/; the cockpit asks):
#                                opencode runs in a claude-retry-opencode-* tmux session, and its
#                                plugin reports it like a Claude session; resume, restart, restore,
#                                exit and say follow its id (ses_…), and what only Claude Code does
#                                (compact, remote, effort, billing) is refused for it
set -euo pipefail
# Resume authority comes only from a managed sleep note, never the caller's environment.
unset COCKPIT_TEAM_RESUME
# Run from a tmux popup or binding, this gets the tmux server's PATH (/usr/local/bin:/usr/bin): the
# helpers it calls (osd-show, osd, cockpit-sidebar) live in ~/.local/bin. Without it a U push
# never told the daemon, and the card kept its "unpushed" count.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac

MANAGER=claude-manager
MANAGER_WINDOW="$MANAGER:manager"
SNAPSHOT="${XDG_RUNTIME_DIR:-/tmp}/cockpit.json"
# One log for the manager, the sidebar, the daemon and the lock and idle scripts: a line per event
# ("<time> <LEVEL> <component>: <message>"), never per redraw. 1 MB, then one previous file. Prompt
# text stays out of it; long command lines are cut. `cockpit logs` shows the end of it.
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/log"
LOG_MAX_BYTES=1048576
LOG_LINE_MAX=300
HOOK_LOG_FILE="$HOME/.cache/claude/hook.log"
RUNS_DIR="${COCKPIT_RUNS_DIR-${CLAUDE_RUNS_DIR:-$HOME/.cache/cockpit/runs}}"
if [[ ! -d $RUNS_DIR && -z ${COCKPIT_RUNS_DIR+x} && -z ${CLAUDE_RUNS_DIR+x} && -d $HOME/.cache/claude/runs ]]; then
    RUNS_DIR="$HOME/.cache/claude/runs"
fi
REQUESTS_DIR="${XDG_RUNTIME_DIR:-/tmp}/cockpit-requests"
if [[ ! -d $REQUESTS_DIR && -d ${XDG_RUNTIME_DIR:-/tmp}/claude-requests ]]; then
    REQUESTS_DIR="${XDG_RUNTIME_DIR:-/tmp}/claude-requests"
fi
CURRENT="${XDG_RUNTIME_DIR:-/tmp}/cockpit.current"
ATTENTION="${XDG_RUNTIME_DIR:-/tmp}/cockpit.attention"
# The sandbox scopes game-performance froze for a game, one per line; its `off` thaws them.
GAME_FROZEN="${XDG_RUNTIME_DIR:-/tmp}/game-performance.frozen"
SIDEBAR_WIDTH=60   # columns; the rest is the session
WINDOW_CLASS=cockpit
KITTY_CONFIG="$HOME/.config/kitty/kitty.conf"
KITTY_MANAGER_CONFIG="$HOME/.config/kitty/cockpit.conf"
WORKSPACE=6  # apps/claude.lua routes the manager window there
ON_CLAUDE_WORKSPACE="$HOME/.config/waybar/scripts/on-claude-workspace.sh"
BAR_VISIBILITY="$HOME/.config/waybar/scripts/waybar-visibility.sh"

# hyprctl finds Hyprland through HYPRLAND_INSTANCE_SIGNATURE. This runs from the manager's tmux
# server and systemd units, which can hold a stale value (Hyprland restarted since) or none: take
# the running instance, the newest $XDG_RUNTIME_DIR/hypr/<id> with a socket.
refresh_hyprland_instance() {
    local base="${XDG_RUNTIME_DIR:-/tmp}/hypr" instance
    [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -e $base/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock ]] && return
    while read -r instance; do
        if [[ -e $base/$instance/.socket.sock ]]; then
            export HYPRLAND_INSTANCE_SIGNATURE=$instance
            return
        fi
    done < <(ls -t "$base" 2>/dev/null)
}
refresh_hyprland_instance

log_event() { # LEVEL component message
    # No control character reaches the log: a session's text in it could carry escape codes to the
    # terminal `cockpit logs` prints to (security audit 2026-10-19, M6).
    local message=${3//$'\n'/ }
    message=${message//[[:cntrl:]]/}
    local stamp
    # The clock from bash itself, +0200 made +02:00 as date -Iseconds wrote it: one fork less per line.
    printf -v stamp '%(%Y-%m-%dT%H:%M:%S%z)T' -1
    stamp="${stamp:0:${#stamp}-2}:${stamp:${#stamp}-2}"
    {
        [[ -d ${LOG_FILE%/*} ]] || mkdir -p "${LOG_FILE%/*}"
        if (( $(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0) > LOG_MAX_BYTES )); then
            mv -f "$LOG_FILE" "$LOG_FILE.1"
        fi
        printf '%s %s %s: %s\n' "$stamp" "$1" "$2" "${message:0:$LOG_LINE_MAX}" >> "$LOG_FILE"
    } 2>/dev/null || true  # a read-only state dir (inside greywall) must not break the command
}

# An event in the audit log (claude-audit; security audit 2026-10-19, M6): key=value fields, and
# fp:key=value for a text kept only as its hash and length. Never fails the command.
audit_event() { # component event outcome [key=value | fp:key=value]...
    claude-audit record "$@" >/dev/null 2>&1 || log_event WARN audit "event $2 not written (is claude-audit on PATH?)"
}

show_logs() { # [lines]
    local lines=${1:-80}
    [[ $lines =~ ^[0-9]+$ ]] || { echo "usage: cockpit logs [lines]" >&2; return 1; }
    echo "== $LOG_FILE"
    tail -n "$lines" "$LOG_FILE" 2>/dev/null || echo "(empty)"
    if [[ -f $HOOK_LOG_FILE ]]; then
        echo "== $HOOK_LOG_FILE (the hook, inside greywall)"
        tail -n 20 "$HOOK_LOG_FILE"
    fi
}

apply_layout() {
    tmux resize-pane -t "$(sidebar_pane)" -x "$SIDEBAR_WIDTH"
}

# tmux expands formats in -c start directories, so refuse any directory containing #.
require_plain_directory() {
    local directory=$1
    if [[ $directory == *"#"* || ! -d $directory ]]; then
        echo "cockpit: refusing directory $directory" >&2
        audit_event manager validation.refused refused "claimed_directory=$directory" "reason=a # in it, or not a directory"
        exit 1
    fi
}

# Panes are addressed by a role tag (@role = sidebar | viewer), never by index: tmux
# numbers panes by position, so a later split moves the numbers around.
pane_by_role() {
    tmux list-panes -t "$MANAGER_WINDOW" -F '#{pane_id} #{@role}' 2>/dev/null | awk -v role="$1" '$2 == role { print $1; exit }'
}

# The manager window's panes in one tmux call (open ran 21 tmux clients, 42 ms; security audit
# 2026-10-19, performance 3): sets the caller's locals sidebar, viewer, approval, approval_run (the
# run its pane shows) and sidebar_dead.
read_manager_panes() {
    local pane_id role dead run
    sidebar="" viewer="" approval="" approval_run="" sidebar_dead=""
    while read -r pane_id role dead run; do
        case $role in
            sidebar) sidebar=$pane_id sidebar_dead=$dead ;;
            viewer) viewer=$pane_id ;;
            approval) approval=$pane_id approval_run=$run ;;
        esac
    done <<< "$(tmux list-panes -t "$MANAGER_WINDOW" -F '#{pane_id} #{@role} #{pane_dead} #{@run}' 2>/dev/null)"
}

sidebar_pane() { pane_by_role sidebar; }
viewer_pane() { pane_by_role viewer; }

tag_pane() { # pane role
    tmux set-option -p -t "$1" @role "$2"
}

ensure_manager() {
    local sidebar viewer approval approval_run sidebar_dead
    if ! tmux has-session -t "=$MANAGER" 2>/dev/null; then
        tmux new-session -d -s "$MANAGER" -n manager -x 240 -y 60 cockpit-sidebar
        # A pane whose command ends (a viewed session exits, the sidebar crashes) stays as a dead
        # pane to be respawned instead of vanishing and leaving the sidebar alone in the window.
        tmux set-option -w -t "$MANAGER_WINDOW" remain-on-exit on
        # The kitty window's title: "Claude · <project>" on the sidebar, "Claude · ✳ <task>" in a session.
        tmux set-option -t "$MANAGER" set-titles-string 'Claude · #{pane_title}'
        tag_pane "$(tmux display-message -p -t "$MANAGER_WINDOW" '#{pane_id}')" sidebar
    fi
    read_manager_panes
    if [[ -z $sidebar ]]; then
        echo "cockpit: the manager predates pane roles; run: tmux kill-session -t $MANAGER" >&2
        return 1
    fi
    # A title line over the session pane names the project and Claude's own title for it, so the
    # session you are typing in is never a guess; the sidebar's own top border stays blank.
    # @state (label_state, pushed by the sidebar) colours the title: red needs you, yellow waiting.
    # While the session pane has the focus the title is a filled bar of that colour (reverse); the
    # column greys its own panel then, so the lit side is the one the keys go to. The divider between
    # them is orange along its full height. The pane without the focus fades: the column fades
    # itself, the session through claude-fade (view_session); tmux's window-style cannot.
    # @pane-border-clip-top is consumed by the opt-in renderer patch in packages/tmux.
    tmux set-option -w -t "$MANAGER_WINDOW" pane-border-status top ";" set-option -w -t "$MANAGER_WINDOW" pane-border-format \
        '#{?#{==:#{@role},viewer},#{?pane_active,#[reverse],}#{?#{@project},#{?#{==:#{@state},needs-you},#[fg=red],#{?#{==:#{@state},waiting},#[fg=yellow],#[fg=blue]}} #[bold]#{@project}#[nobold] · #{pane_title} #[default], no session #[default]},}' \
        ";" set-option -w -t "$MANAGER_WINDOW" pane-border-indicators off \
        ";" set-option -w -t "$MANAGER_WINDOW" @pane-border-clip-top on \
        ";" set-option -w -t "$MANAGER_WINDOW" pane-active-border-style 'fg=#ff9e64'
    if [[ -z $viewer ]]; then
        viewer=$(tmux split-window -h -t "$sidebar" -l 70% -P -F '#{pane_id}' cockpit idle)
        tag_pane "$viewer" viewer
        tmux resize-pane -t "$sidebar" -x "$SIDEBAR_WIDTH"
        tmux select-pane -t "$sidebar"
    fi
    if [[ $sidebar_dead == 1 ]]; then
        tmux respawn-pane -k -t "$sidebar" cockpit-sidebar
    fi
}

view_session() {
    local id=$1 pane="" state="" started="" project="" target
    if [[ $id == claude-retry-* ]]; then
        [[ $id == *"#"* ]] && { echo "cockpit: refusing session name $id" >&2; return 1; }
        target=$id
    else
        # The session's fields in one jq pass, separated by \x1f: a tab would merge empty fields.
        IFS=$'\x1f' read -r pane state started project < <(jq -r --arg id "$id" \
            'first(.sessions[] | select(.session == $id)) | [.tmux_pane // "", .state // "", (.started // "" | tostring), .project // ""] | join("\u001f")' \
            "$SNAPSHOT" 2>/dev/null) || true
        if [[ -z $pane ]]; then
            if is_asleep "$id"; then
                wake_session "$id" || return 1
                printf '%s\n' "$id" > "$CURRENT"
                show_restarting "$id"
                return 0
            fi
            echo "cockpit: session $id has no tmux pane" >&2
            return 1
        fi
        target=$(tmux display-message -p -t "$pane" '#{session_name}')
    fi
    ensure_manager
    rm -f "$ATTENTION"
    # The session and its approval pane change in one tmux command: tmux redraws once, after both.
    # In two steps the session showed a moment at full height before the pane appeared or went.
    local sidebar viewer approval approval_run sidebar_dead run new_pane
    read_manager_panes
    run=$(approval_for "$id")
    local size_before
    size_before=$(tmux display-message -p -t "=$target:" '#{window_width} #{window_height}' 2>/dev/null || true)
    # Nested on purpose: the inner client is the real, interactive session. claude-fade relays it and
    # fades it while the column has the focus.
    local commands=(respawn-pane -k -t "$viewer" cockpit-fade env -u TMUX tmux attach-session -t "=$target")
    # The pane shows this session's own approval: another session's goes, this one's comes.
    if [[ -n $approval && ( -z $run || $approval_run != "$run" ) ]]; then
        # It can exit after read_manager_panes. Test membership inside tmux's command queue;
        # delimit IDs so %77 cannot match %775, and keep unrelated tmux errors visible.
        commands+=(";" if-shell -t "$viewer" -F "#{m:*|$approval|*,#{P:|#{pane_id}|}}" "kill-pane -t $approval")
        approval=""
    fi
    if [[ -z $approval && -n $run ]]; then
        commands+=(";" split-window -v -d -l 40% -t "$viewer" -P -F '#{pane_id}' env -u TMUX tmux attach-session -t "=claude-run-$run")
    fi
    new_pane=$(tmux "${commands[@]}")
    if [[ -n $new_pane ]]; then
        tag_approval_pane "$new_pane" "$run"
    fi
    redraw_if_stale "$target" "$size_before" "$id" "$state" "$started" "$viewer"
    printf '%s\n' "$id" > "$CURRENT"
    # Its banner ("waiting for your input") has been read now that the session is on screen.
    osd-show session-seen "$id" 2>/dev/null || true
    label_panes "$project" "$sidebar" "$viewer"
}

# A session whose window the viewer resizes as it attaches can stay blank: Claude Code does not
# always repaint after that resize (seen on a session restarted while an approval pane was open).
# A session (re)started out of sight can also show a screen drawn for another size, prompt borders
# gone and the status line cut (seen after restart-all while other cards were clicked): the first
# view after each start redraws too, once ($VIEWED_STARTS keeps "<id> <started>" lines).
# Ctrl+L makes it clear and redraw, the conversation kept. Not at a permission dialog: no key goes
# near a pending yes/no, and that start stays unseen so a later view still redraws it. In the
# background, once the nested client has attached and resized it.
VIEWED_STARTS="${XDG_RUNTIME_DIR:-/tmp}/cockpit.viewed-starts"

redraw_if_stale() { # target size-before id state started viewer-pane
    local id=$3 state=$4 started=$5 size_after is_stale=""
    [[ $state != needs-you ]] || return 0
    # Ctrl+L is Claude's redraw; an agent without the feature redraws itself on a resize.
    agent_can "$(agent_of_session "$id")" redraw || return 0
    size_after=$(tmux display-message -p -t "$6" '#{pane_width} #{pane_height}' 2>/dev/null || true)
    [[ -n $2 && $2 != "$size_after" ]] && is_stale=1
    if [[ -n $started ]] && ! grep -qxF "$id $started" "$VIEWED_STARTS" 2>/dev/null; then
        printf '%s %s\n' "$id" "$started" >> "$VIEWED_STARTS"
        is_stale=1
    fi
    [[ -n $is_stale ]] || return 0
    ( sleep "${COCKPIT_REDRAW_DELAY:-0.4}"; tmux send-keys -t "=$1:" C-l ) </dev/null >/dev/null 2>&1 &
    disown
}

# The kitty window title (sidebar pane title) and the session pane's title line both carry the project.
label_panes() { # project [sidebar-pane viewer-pane]
    local sidebar=${2:-} viewer=${3:-} approval approval_run sidebar_dead
    [[ -n $sidebar && -n $viewer ]] || read_manager_panes
    tmux select-pane -t "$sidebar" -T "${1:-sessions}" ";" set-option -p -t "$viewer" @project "${1:-}" ";" set-option -p -t "$viewer" @state ""
}

# The viewed session's state for the title line's colour (the sidebar calls this when it changes).
label_state() {
    local state=$1
    case $state in
        working|waiting|needs-you|unknown) ;;
        *) echo "cockpit: unknown state $state" >&2; return 1 ;;
    esac
    [[ -z ${2:-} || $2 == "$(cat "$CURRENT" 2>/dev/null)" ]] || return 0
    tmux set-option -p -t "$(viewer_pane)" @state "$state"
    local attended initial run
    if [[ -f $ATTENTION ]]; then
        read -r attended initial run < "$ATTENTION"
        if [[ -z $run && ( $state == working || ( $initial == needs-you && $state == waiting ) ) ]]; then
            finish_attention
        fi
    fi
}

focus_viewer() {
    rm -f "$ATTENTION"
    local sidebar viewer approval approval_run sidebar_dead
    read_manager_panes
    tmux select-pane -t "${approval:-$viewer}"
}

attend_session() {
    view_session "$1" || return
    local run pane state
    run=$(approval_for "$1")
    pane=$(pane_by_role approval)
    [[ -n $pane ]] || pane=$(viewer_pane)
    state=$(session_field "$1" state)
    if [[ $(session_field "$1" needs_input) == true ]]; then state=needs-you; fi
    printf '%s %s %s\n' "$1" "$state" "$run" > "$ATTENTION"
    tmux select-pane -t "$pane"
}

finish_attention() {
    [[ -f $ATTENTION ]] || return 0
    local attended initial run pane="" sidebar active
    read -r attended initial run < "$ATTENTION"
    rm -f "$ATTENTION"
    [[ $attended == "$(cat "$CURRENT" 2>/dev/null)" ]] || return 0
    if [[ -n $run ]]; then pane=$(pane_by_role approval); fi
    [[ -n $pane ]] || pane=$(viewer_pane)
    active=$(tmux display-message -p -t "$pane" '#{pane_active}')
    [[ $active == 1 ]] || return 0
    sidebar=$(pane_by_role sidebar)
    tmux select-pane -t "$sidebar" ";" send-keys -t "$sidebar" F1
}

attention_answered() { # run id (empty when all approvals close)
    [[ -f $ATTENTION ]] || return 0
    local attended initial run
    read -r attended initial run < "$ATTENTION"
    if [[ -n $run && ( -z $1 || $1 == "$run" ) ]]; then finish_attention; fi
}

running_session_in() { # dir agent
    jq -r --arg cwd "$1" --arg agent "$2" '.sessions[] | select(.cwd == $cwd and (.agent // "claude") == $agent) | .session' "$SNAPSHOT" 2>/dev/null | head -1
}

# The agent that runs a session: the one whose reported id it is, else the one whose tmux session
# name has the longest matching prefix (before its first report a session is its tmux session),
# else Claude, the agent of every older session.
agent_of_session() { # id
    local agent prefix best=$DEFAULT_AGENT best_length=0
    for agent in "${AGENTS[@]}"; do
        if "agent_${agent}_is_session_id" "$1"; then echo "$agent"; return; fi
    done
    for agent in "${AGENTS[@]}"; do
        prefix=$("agent_${agent}_tmux_prefix")
        if [[ $1 == "$prefix"* ]] && (( ${#prefix} > best_length )); then best=$agent best_length=${#prefix}; fi
    done
    echo "$best"
}

# Whether a reported id is some agent's (not a tmux session's name).
is_session_id() { # id
    local agent
    for agent in "${AGENTS[@]}"; do "agent_${agent}_is_session_id" "$1" && return 0; done
    return 1
}

agent_can() { # agent feature
    "agent_${1}_can" "$2"
}

# What an agent cannot do (effort, billing, compact, remote) is refused by name, rather than typed
# into a screen where it means something else.
require_feature() { # id feature what
    local agent
    agent=$(agent_of_session "$1")
    if ! agent_can "$agent" "$2"; then
        echo "cockpit: $3 is not $("agent_${agent}_label")'s to do; $(session_field "$1" project) runs $agent" >&2
        return 1
    fi
}

# The viewer pane's size, "<width> <height>": a session started out of sight at that size is shown
# there later without a resize. Resized, Claude redrew and a resumed conversation sat above, out of
# view (an empty pane). An approval pane open now takes rows the viewer gets back once it closes:
# they count.
detached_size() {
    local size width=200 height=50 approval approval_height
    size=$(tmux display-message -p -t "$(viewer_pane)" '#{pane_width} #{pane_height}' 2>/dev/null || true)
    if [[ $size =~ ^([0-9]+)\ ([0-9]+)$ ]]; then width=${BASH_REMATCH[1]} height=${BASH_REMATCH[2]}; fi
    approval=$(pane_by_role approval)
    if [[ -n $approval ]]; then
        approval_height=$(tmux display-message -p -t "$approval" '#{pane_height}' 2>/dev/null || true)
        [[ $approval_height =~ ^[0-9]+$ ]] && height=$(( height + approval_height + 1 ))
    fi
    echo "$width $height"
}

# Whether the next launch bills the Console's API credits (1) or the subscription (0): the launcher
# reads COCKPIT_CREDITS. Every launch sets it, so none inherits it from this environment.
# restart, billing and restore set it from the session; everything else starts on the subscription.
launch_credits=0
# The approved team start a launch belongs to (team-spawn); the daemon reads it from the launch's
# host environment to give the new session its role. Empty for every other start.
launch_team_spawn=
launch_team_resume=

subscription_route() ( # origin generation
    local origin=$1 generation=$2 helper folder status stage ticket directory agent attempt failure
    [[ $generation =~ ^[0-9a-f]{32}$ ]] || { echo "cockpit: invalid subscription generation" >&2; return 1; }
    helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription"
    folder="${COCKPIT_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/cockpit/subscriptions"
    umask 077
    mkdir -p "$folder"
    exec 9>"$folder/$generation.dispatch.lock"
    flock -n 9 || return 0
    status=$("$helper" route-status "$origin" "$generation" 9>&-) || return
    stage=$(jq -er '.stage' <<<"$status") || return
    [[ $stage != Active ]] || return 0
    if [[ $stage == Prepared ]]; then
        "$helper" prepare-plan "$origin" "$generation" 9>&- >/dev/null || return
        "$helper" retire "$origin" "$generation" 9>&- || return
        stage=Retired
    fi
    if [[ $stage == Retired ]]; then
        ticket=$("$helper" submit "$origin" "$generation" 9>&-) || return
        directory=$(jq -er '.directory' <<<"$ticket") || return
        agent=$(jq -er '.agent' <<<"$ticket") || return
        launch_subscription_route=$generation
        launch_credits=0
        launch_team_spawn=
        case $agent in
            claude) claude_launch_detached "$directory" 9>&- || return ;;
            codex) codex_launch "$directory" 9>&- >/dev/null || return ;;
            *) echo "cockpit: unsupported native subscription destination" >&2; return 1 ;;
        esac
    elif [[ $stage != Submitted && $stage != Bound ]]; then
        echo "cockpit: subscription route is not launchable" >&2
        return 1
    fi
    for ((attempt=0; attempt<120; attempt++)); do
        if failure=$("$helper" bind "$origin" "$generation" 9>&- 2>&1); then return 0; fi
        sleep 0.25
    done
    echo "cockpit: subscription handoff remains paused; no second launch will be attempted: $failure" >&2
    return 1
)

new_session() {
    local directory=$1 existing
    shift
    require_plain_directory "$directory"
    audit_event manager session.start ok "directory=$directory" "agent=$launch_agent" "claude_arguments=$#"
    ensure_manager
    if (( $# == 0 )); then
        existing=$(running_session_in "$directory" "$launch_agent")
        if [[ -n $existing ]]; then
            view_session "$existing"
            return
        fi
    fi
    "agent_${launch_agent}_new" "$directory" "$@"
}

# A new session whose first message is <prompt>, in the viewer pane (a pull request review).
new_session_with_prompt() { # dir prompt
    require_plain_directory "$1"
    audit_event manager session.start ok "directory=$1" "agent=$launch_agent" "claude_arguments=1"
    ensure_manager
    "agent_${launch_agent}_new_with_prompt" "$1" "$2"
}

# A session started out of sight, in a tmux session of its own: the session pane keeps what it
# shows. It appears as a card once it reports in. The sidebar's error hand-off uses it.
background_session() { # dir prompt
    require_plain_directory "$1"
    [[ -n $2 ]] || { echo "cockpit: background needs a prompt" >&2; return 1; }
    local prompt=$2
    [[ $prompt == -* ]] && prompt="Task: $prompt" # never an option of the agent's
    "agent_${launch_agent}_background" "$1" "$prompt"
}

# Claude's effort levels (claude --help, --effort).
EFFORT_LEVELS=(low medium high xhigh max)

require_effort() {
    local level=$1 known
    for known in "${EFFORT_LEVELS[@]}"; do [[ $level == "$known" ]] && return 0; done
    echo "cockpit: unknown effort $level (${EFFORT_LEVELS[*]})" >&2
    return 1
}

# While a session closes and starts in the viewer pane (restart, effort switch, new, resume), a
# popup exactly over that pane shows what is happening instead of the shell, the launcher and the
# sandbox scrolling by. It closes once the new session reports in (its SessionStart in the
# snapshot), after LOADING_TIMEOUT_S (logged), or on Escape. A second call while it shows only
# changes its text. Nothing when no terminal shows the manager.
LOADING_STATE="${XDG_RUNTIME_DIR:-/tmp}/cockpit-loading"
LOADING_PID="${XDG_RUNTIME_DIR:-/tmp}/cockpit-loading.pid"
LOADING_TIMEOUT_S=${COCKPIT_LOADING_TIMEOUT_S:-60}

loading_overlay() { # label directory [session-id] [start|gone]
    local client pane size
    printf '%s\n%s\n%s\n%s\n%s\n' "$1" "$2" "${3:-}" "$(date +%s)" "${4:-start}" > "$LOADING_STATE"
    client=$(tmux list-clients -t "=$MANAGER" -F '#{client_name}' 2>/dev/null | head -n 1)
    [[ -n $client ]] || return 0
    # One loading screen at a time, this cockpit's own (its runtime folder), not any on the machine.
    kill -0 "$(cat "$LOADING_PID" 2>/dev/null)" 2>/dev/null && return 0
    pane=$(viewer_pane)
    size=$(tmux display-message -p -t "$pane" '#{pane_width} #{pane_height}')
    # display-popup waits for the popup to close: started in the background.
    tmux display-popup -B -E -c "$client" -t "$pane" -x '#{popup_pane_left}' -y '#{popup_pane_bottom}' \
        -w "${size% *}" -h "${size#* }" cockpit loading-screen >/dev/null 2>&1 &
    disown
}

loading_ready() { # directory session-id since start|gone
    if [[ $4 == gone ]]; then
        # Closing: done once the daemon has dropped the session.
        ! jq -e --arg session "$2" 'any(.sessions[]; .session == $session)' "$SNAPSHOT" >/dev/null 2>&1
        return
    fi
    jq -e --arg directory "$1" --arg session "$2" --argjson since "$3" \
        '[.sessions[] | select((.started // 0) >= $since)
          | select(if $session != "" then .session == $session else .cwd == $directory end)] | length > 0' \
        "$SNAPSHOT" >/dev/null 2>&1
}

# Claude can ask something before SessionStart (the workspace trust prompt, for one): the loading
# screen must not hide it. Its selection prompts end with this footer.
viewer_shows_prompt() {
    tmux capture-pane -p -t "$(viewer_pane)" 2>/dev/null | grep -q 'Enter to confirm'
}

show_loading() {
    printf '%s\n' "$$" > "$LOADING_PID"
    local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) tick=0 label directory session since mode rows columns
    # No TERM (the tests run from a systemd unit by the health check): no cursor to hide, and no
    # reason to stop.
    tput civis 2>/dev/null || true
    while { read -r label; read -r directory; read -r session; read -r since; read -r mode; } < "$LOADING_STATE" 2>/dev/null; do
        if loading_ready "$directory" "$session" "$since" "$mode"; then
            sleep 0.5  # the session reported in; give it a moment to draw its screen
            break
        fi
        if viewer_shows_prompt; then
            log_event INFO sessions "loading screen yielded to a prompt: $label in $directory"
            break
        fi
        if (( $(date +%s) - since > LOADING_TIMEOUT_S )); then
            log_event WARN sessions "loading screen timed out after ${LOADING_TIMEOUT_S}s: $label in $directory"
            break
        fi
        rows=$(tput lines 2>/dev/null || echo 24) columns=$(tput cols 2>/dev/null || echo 80)
        printf '\033[2J\033[%d;%dH\033[1;34m%s\033[0m  \033[1m%s\033[0m' \
            $(( rows / 2 )) $(( (columns - ${#label} - 3) / 2 > 1 ? (columns - ${#label} - 3) / 2 : 1 )) "${frames[tick % 10]}" "$label"
        printf '\033[%d;%dH\033[2m%s\033[0m' $(( rows / 2 + 2 )) $(( (columns - 20) / 2 > 1 ? (columns - 20) / 2 : 1 )) "Escape hides this"
        tick=$(( tick + 1 ))
        sleep 0.15
    done
    rm -f "$LOADING_STATE" "$LOADING_PID"
}

resume_session() { # dir id [effort]
    require_plain_directory "$1"
    [[ -z ${3:-} ]] || require_feature "$2" effort "effort" || return 1
    "agent_$(agent_of_session "$2")_resume" "$@"
}

session_field() { # id field
    jq -r --arg id "$1" --arg field "$2" '.sessions[] | select(.session == $id) | .[$field] // empty' "$SNAPSHOT" 2>/dev/null
}


# The session is over once its tmux session ended, or once no Claude runs in its pane any more:
# claude-auto-retry keeps a shell after a non-zero exit, and that wait used to cost two rounds.
# Bound each /proc scan too: checking the deadline only between scans cannot stop a stalled one.
claude_left() { # tmux-session pane timeout-seconds
    local deadline=$(( ${EPOCHREALTIME//[!0-9]/} + $3 * 1000000 ))
    while (( ${EPOCHREALTIME//[!0-9]/} < deadline )); do
        tmux has-session -t "=$1" 2>/dev/null || return 0
        [[ $(timeout --signal=KILL 0.5s osd liveness "" "$2" 2>/dev/null) == none ]] && return 0
        sleep 0.1
    done
    return 1
}

# A sandbox frozen for a game ignores /exit and Ctrl-C, and a kill left its frozen processes and
# scope behind. Thawed first, it leaves cleanly, and the game's end no longer counts it as paused.
thaw_frozen_pane() { # pane
    local pane_pid scope remaining
    pane_pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 0
    [[ $pane_pid =~ ^[0-9]+$ ]] || return 0
    scope=$(ps -o cgroup= -p "$pane_pid" 2>/dev/null | sed -n 's|.*/\([^/]*\.scope\)$|\1|p') || return 0
    [[ -n $scope ]] && grep -qxF "$scope" "$GAME_FROZEN" 2>/dev/null || return 0
    if ! systemctl --user thaw "$scope"; then
        log_event WARN manager "could not thaw $scope, frozen for a game; its exit may fail"
        return 0
    fi
    log_event INFO manager "thawed $scope, frozen for a game, so its session can exit"
    remaining=$(grep -vxF "$scope" "$GAME_FROZEN" || true)
    printf '%s' "${remaining:+$remaining$'\n'}" > "$GAME_FROZEN"
}

# What a session that ignores /exit and Ctrl-C looks like, saved just before it is killed: the
# cause of opusline's 2026-10-19 case could not be found afterwards (todo a788e999). The screen
# holds conversation text, so the folder is hidden from the sandboxes (greywall.json). Each step is
# bounded: the capture must not hold up the close it explains.
# The lines of a `ps -eo pid=,ppid=,…` table on stdin for root and the processes under it, by pid.
descendants_of() { # root-pid
    awk -v root="$1" '
        { line[$1] = $0; parent[$1] = $2 }
        END { for (pid in line) { ancestor = pid
                while (ancestor != "" && ancestor != root && ancestor in parent && ancestor != parent[ancestor]) ancestor = parent[ancestor]
                if (ancestor == root) print line[pid] } }' | sort -n
}

STUCK_EXITS_DIR="${COCKPIT_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/cockpit-stuck-exits"
STUCK_EXITS_KEPT=20
record_stuck_exit() { # tmux-session pane id
    local target=$1 pane=$2 id=$3 stamp file pane_pid cgroup started liveness elapsed_ms
    printf -v stamp '%(%Y%m%dT%H%M%S)T' -1
    file="$STUCK_EXITS_DIR/$stamp-${id:0:8}.txt"
    mkdir -p -m 700 "$STUCK_EXITS_DIR" 2>/dev/null || return 0
    pane_pid=$(timeout 1 tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null) || pane_pid=
    started=${EPOCHREALTIME//[!0-9]/}
    liveness=$(timeout --signal=KILL 1s osd liveness "" "$pane" 2>/dev/null) || liveness=
    elapsed_ms=$(( (${EPOCHREALTIME//[!0-9]/} - started) / 1000 ))
    {
        echo "session $id, tmux session $target, pane $pane, agent $(agent_of_session "$id" 2>/dev/null)"
        echo "osd liveness: ${liveness:-no answer} in ${elapsed_ms} ms"
        echo "== pane"
        # pane_in_mode: keys sent to a pane in copy mode never reach the agent; pane_input_off: select-pane -d.
        timeout 1 tmux display-message -p -t "$pane" 'pid #{pane_pid} dead #{pane_dead} command #{pane_current_command} in_mode #{pane_in_mode} mode #{pane_mode} input_off #{pane_input_off} size #{pane_width}x#{pane_height}' 2>&1
        echo "== processes of the pane (stat D: waits in the kernel; wchan: where)"
        if [[ $pane_pid =~ ^[0-9]+$ ]]; then
            timeout 2 ps -eo pid=,ppid=,stat=,wchan:32=,etime=,time=,rss=,comm= 2>/dev/null | descendants_of "$pane_pid"
            cgroup=$(sed -n 's/^0:://p' "/proc/$pane_pid/cgroup" 2>/dev/null)
            echo "== cgroup $cgroup"
            echo "cgroup.freeze: $(cat "/sys/fs/cgroup$cgroup/cgroup.freeze" 2>/dev/null || echo unreadable)"
            grep -h frozen "/sys/fs/cgroup$cgroup/cgroup.events" 2>/dev/null
        else
            echo "no pane pid (${pane_pid:-tmux did not answer})"
        fi
        echo "== every process in D state"
        timeout 2 ps -eo pid=,stat=,wchan:32=,comm= 2>/dev/null | awk '$2 ~ /^D/'
        echo "== screen (last 40 lines)"
        timeout 1 tmux capture-pane -p -t "$pane" -S -40 2>&1
    } > "$file" 2>/dev/null || true  # under set -e: a failed probe must not stop the kill
    chmod 600 "$file" 2>/dev/null || true
    ls -1t "$STUCK_EXITS_DIR"/*.txt 2>/dev/null | tail -n +$(( STUCK_EXITS_KEPT + 1 )) | xargs -r rm -f || true
    log_event WARN manager "$id did not exit: its state is in $file"
}

exit_session() {
    local id=$1 pane target
    audit_event manager session.exit asked "session=$id"
    if agent_opencode_is_session_id "$id"; then
        exit_opencode_conversation "$id"
        return
    fi
    if [[ $id == claude-retry-* ]]; then
        [[ $id == *"#"* ]] && { echo "cockpit: refusing session name $id" >&2; return 1; }
        target=$id
        pane=$(tmux list-panes -t "=$target" -F '#{pane_id}' | head -1)
    else
        pane=$(session_field "$id" tmux_pane)
        if [[ -z $pane ]]; then
            echo "cockpit: session $id has no tmux pane" >&2
            return 1
        fi
        target=$(tmux display-message -p -t "$pane" '#{session_name}')
    fi
    thaw_frozen_pane "$pane"
    "agent_$(agent_of_session "$id")_exit" "$target" "$pane" "$id"
}

# Newlines must be pasted as text, not sent as Enter keys. Named buffers keep concurrent sends
# separate; -r preserves LF bytes and -p wraps the paste when the receiving app enables it.
type_into_pane() { # pane text
    if [[ $2 != *$'\n'* ]]; then
        tmux send-keys -t "$1" -l -- "$2"
        return
    fi
    local buffer="cockpit-message-$$-$(date +%s%N)"
    if ! printf '%s' "$2" | tmux load-buffer -b "$buffer" -; then
        tmux delete-buffer -b "$buffer" >/dev/null 2>&1 || true
        return 1
    fi
    if ! tmux paste-buffer -d -p -r -b "$buffer" -t "$1"; then
        tmux delete-buffer -b "$buffer" >/dev/null 2>&1 || true
        return 1
    fi
}

# A command typed at Claude's prompt and submitted. Text and Enter go in two calls with a
# pause: in one burst Claude's input takes them as a paste and the Enter becomes a newline, so the
# command never runs (claude-auto-retry's SUBMIT_DELAY_MS, src/tmux.js, documents the same).
submit_to_pane() { # pane text
    type_into_pane "$1" "$2" || return $?
    sleep 0.15
    tmux send-keys -t "$1" Enter
}

pane_at_prompt() {
    # The daemon's reading of the pane (osd classify): one definition of "idle".
    [[ $(tmux capture-pane -p -t "$1" -S -20 2>/dev/null | osd classify) == waiting ]]
}

session_is_remote() {
    [[ $(jq -r '.remote // false' "$HOME/.cache/claude/statusline-$1.json" 2>/dev/null) == true ]]
}

# Claude's /rc toggles Remote Control. At an idle prompt it is typed and sent; while Claude works
# it is queued (ctrl+x, Enter) so the running turn is not interrupted.
send_remote_toggle() { # pane
    tmux send-keys -t "$1" "/rc"
    if pane_at_prompt "$1"; then
        tmux send-keys -t "$1" Enter
    else
        tmux send-keys -t "$1" C-x Enter
    fi
}

toggle_remote() {
    local id=$1 pane
    require_feature "$id" remote "Remote Control" || return 1
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        echo "cockpit: session $id has no tmux pane" >&2
        return 1
    fi
    send_remote_toggle "$pane"
}

# /compact typed into a session that waits at its prompt (the sidebar's C). Not queued while it
# works: a compaction landing mid-task would summarise away what it is doing.
compact_session() { # id
    local id=$1 pane
    require_feature "$id" compact "/compact" || return 1
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        echo "cockpit: session $id has no tmux pane" >&2
        return 1
    fi
    if ! pane_at_prompt "$pane"; then
        echo "cockpit: $(session_field "$id" project) is busy; compact it when it waits" >&2
        return 1
    fi
    submit_to_pane "$pane" "/compact"
}

open_variants() { # id
    local id=$1 pane state
    require_feature "$id" variants "the model variant picker" || return 1
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        echo "cockpit: session $id has no tmux pane" >&2
        return 1
    fi
    state=$(session_field "$id" state)
    if [[ $state != waiting && $state != working && $state != needs-you ]]; then
        echo "cockpit: cannot open the variant picker without a known session state (${state:-no state yet})" >&2
        return 1
    fi
    view_session "$id" || return 1
    # Dedicated binding in opencode/cli.json: no prompt text or Enter that could submit a draft.
    tmux send-keys -t "$pane" F6 || return 1
    focus_viewer
}

# A message for a session without opening it; each agent says when it takes one (agent_*_say).
say_to_session() { # id message
    local id=$1 message=$2 pane waking="" routing subscription_helper
    message=${message//$'\r\n'/$'\n'}
    if [[ -z $message || ${#message} -gt 4000 ]]; then
        echo "cockpit: a message is at most 4000 characters" >&2
        return 1
    fi
    # LF is bracketed-pasted; other controls could escape the paste or press a key.
    if [[ ${message//$'\n'/} == *[[:cntrl:]]* ]]; then
        echo "cockpit: a message cannot carry control characters" >&2
        return 1
    fi
    subscription_helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription"
    routing=$("$subscription_helper" message-target "$id") || return
    id=$(jq -er '.session' <<<"$routing") || return
    if jq -e '.native_inbox == true' <<<"$routing" >/dev/null; then
        printf '%s' "$message" | "$subscription_helper" queue-message "$id" || return
        echo "queued for the native subscription inbox"
        return 0
    fi
    if jq -e '.held == true' <<<"$routing" >/dev/null; then
        printf '%s' "$message" | "$subscription_helper" queue-message "$id" || return
        echo "queued until subscription ownership is bound"
        return 0
    fi
    # A sandboxed session has neither the list nor the tmux server: typing into another session's
    # pane stays host-only. `cockpit-team chief` is the Chief's own route, refused to every other
    # session, so the hint names what does reach the Chief instead.
    if [[ ! -r $SNAPSHOT ]]; then
        echo "cockpit: cannot read the session list ($SNAPSHOT): cockpit say runs on the host only. From a sandbox no command messages the Chief: it sees an OpenCode session's question (cockpit-needs-input) or its turn ending on a doing todo. Otherwise ask Theo to run this cockpit say with ask-to-run." >&2
        return 1
    fi
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        # Asleep, or restarting with no pane yet: the message waits for the new process.
        if is_asleep "$id"; then waking=asleep; elif is_restarting "$id"; then waking=restarting; fi
        [[ -n $waking ]] || { echo "cockpit: session $id has no tmux pane" >&2; return 1; }
    fi
    if [[ -n $waking ]]; then
        if [[ $waking == asleep ]]; then
            local project directory remote agent
            check_wakeable "$id" || return 1
        fi
        queue_for_wake "$id" "$message"
        if [[ $waking == asleep ]]; then setsid -f cockpit wake "$id" >/dev/null 2>&1; fi
        echo "queued until it wakes"
        return 0
    fi
    "agent_$(agent_of_session "$id")_say" "$id" "$pane" "$message"
}

# A prompt for the end of the session's turn (Alt+Q, tmux.conf): it waits in the queue the column
# sends from (apps/cockpit/src/prompts.rs), one per finished turn, instead of cutting into the turn.
# The pane is the cockpit's viewer (the session on screen) or a session's own pane (a terminal).
queue_prompt_ask() { # [pane]
    # In the popup, the client's active pane is the one Alt+Q was pressed in: the binding cannot
    # pass #{pane_id} (tmux leaves it empty in a command nested in if -F).
    local pane=${1:-} session text
    [[ -n $pane ]] || pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)
    if [[ $(tmux display-message -p -t "$pane" '#{@role}' 2>/dev/null) == viewer ]]; then
        session=$(cat "$CURRENT" 2>/dev/null || true)
    else
        session=$(jq -r --arg pane "$pane" '.sessions[] | select(.tmux_pane == $pane) | .session' "$SNAPSHOT" 2>/dev/null | head -1)
    fi
    if ! is_session_id "$session"; then
        read -r -p "No agent session here. Enter closes. " _ || true
        return 1
    fi
    # Escape alone closes the popup; arrow keys (Escape then more within 30 ms) still edit the line.
    bind 'set keyseq-timeout 30' 2>/dev/null
    bind -x '"\e": exit 0' 2>/dev/null
    read -r -e -p "for $(session_field "$session" project), when its turn ends (Esc cancels)> " text || return 0
    [[ -n ${text// } ]] || return 0
    if [[ $text == *[[:cntrl:]]* || ${#text} -gt 4000 ]]; then
        read -r -p "One line, without control characters. Enter closes. " _ || true
        return 1
    fi
    printf '%s' "$text" | "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription" queue-message "$session" || return
    log_event INFO sessions "prompt queued for $(session_field "$session" project)"
    audit_event manager prompt.queued queued "session=$session" "fp:text=$text"
}

# While it exists, the phone page (claude-remote) notifies: set by the lock screen (away on).
PHONE_AWAY="${XDG_RUNTIME_DIR:-/tmp}/cockpit-remote-away"

# Theo's choices, on or off, kept across reboots ({"phone-on-lock": false}). A setting missing
# from the file is on: what the setup did before it had settings. The cockpit's S menu lists the
# same names (apps/cockpit/src/settings.rs).
SETTINGS_FILE="${COCKPIT_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/cockpit/settings.json"
KNOWN_SETTINGS=(phone-on-lock todo-queue error-handoff freeze-while-gaming idle-lock daily-digest idle-sleep)
LAUNCH_SETTINGS=(default-agent opencode-model opencode-effort idle-sleep-after chief-starts-per-hour chief-dispatches-own-todos)

launch_setting_value() { # name
    local fallback=""
    [[ $1 == default-agent ]] && fallback=claude
    if [[ ! -e $SETTINGS_FILE ]]; then printf '%s\n' "$fallback"; return; fi
    jq -er --arg name "$1" --arg fallback "$fallback" '
        if type != "object" then error("settings must be an object")
        elif has($name) then .[$name] | if type == "string" then . else error("setting must be a string") end
        else $fallback end' "$SETTINGS_FILE" || {
        echo "cockpit: cannot read $1 from $SETTINGS_FILE" >&2; return 1;
    }
}

validate_launch_setting() { # name value
    case $1 in
        default-agent) [[ -n $2 && " ${AGENTS[*]} " == *" $2 "* ]] ;;
        opencode-model) [[ -z $2 || $2 =~ ^[^/#[:space:][:cntrl:]]+/[^#[:space:][:cntrl:]]+$ ]] ;;
        opencode-effort) [[ -z $2 || $2 =~ ^[^/#[:space:][:cntrl:]]+$ ]] ;;
        idle-sleep-after) [[ $2 =~ ^[1-9][0-9]{1,5}$ ]] && (( $2 >= 30 )) ;;
        chief-starts-per-hour) [[ -z $2 || ( $2 =~ ^[1-9][0-9]?$ && $2 -le 60 ) ]] ;;
        chief-dispatches-own-todos) [[ -z $2 || $2 == on || $2 == off ]] ;;
    esac || { echo "cockpit: invalid $1: $2" >&2; return 1; }
}

launch_setting() { # name [value]
    local name=$1 value current
    if (( $# == 1 )); then
        value=$(launch_setting_value "$name") || return
        printf '%s: %s\n' "$name" "$value"
        return
    fi
    value=$2
    validate_launch_setting "$name" "$value" || return
    if [[ $name == opencode-effort && -n $value ]]; then
        local model
        model=$(launch_setting_value opencode-model) || return
        [[ -n $model ]] || { echo "cockpit: pick an opencode-model before its effort" >&2; return 1; }
    fi
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    current='{}'
    [[ -e $SETTINGS_FILE ]] && current=$(<"$SETTINGS_FILE")
    if ! jq -e --arg name "$name" --arg value "$value" '
        if type != "object" then error("settings must be an object") else
            (if $name == "opencode-model" and .[$name] != $value then .["opencode-effort"] = "" else . end)
            | .[$name] = $value end' <<< "$current" > "$SETTINGS_FILE.new"; then
        rm -f "$SETTINGS_FILE.new"
        echo "cockpit: $SETTINGS_FILE is not valid settings, left as it is" >&2; return 1
    fi
    mv -f "$SETTINGS_FILE.new" "$SETTINGS_FILE"
    log_event INFO manager "setting $name $value"
    audit_event manager setting.changed ok "name=$name" "value=$value"
    printf '%s: %s\n' "$name" "$value"
}

setting_is_on() { # name
    [[ -f $SETTINGS_FILE ]] || return 0
    local value
    if ! value=$(jq -r --arg name "$1" '.[$name] | if . == null then true else . end' "$SETTINGS_FILE" 2>/dev/null); then
        log_event WARN manager "$SETTINGS_FILE is not valid JSON: $1 taken as on"
        return 0
    fi
    [[ $value != false ]]
}

setting() { # name [on|off]
    if [[ " ${LAUNCH_SETTINGS[*]} " == *" $1 "* ]]; then launch_setting "$@"; return; fi
    local name=$1 wanted=${2:-} known current
    for known in "${KNOWN_SETTINGS[@]}"; do [[ $known == "$name" ]] && break; known=; done
    if [[ -z $known ]]; then
        echo "cockpit: unknown setting $name (known: ${KNOWN_SETTINGS[*]})" >&2; return 1
    fi
    case $wanted in
        '') if setting_is_on "$name"; then echo "$name: on"; else echo "$name: off"; fi; return 0 ;;
        on|off) ;;
        *) echo "usage: cockpit setting <name> [on|off]" >&2; return 1 ;;
    esac
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    current='{}'
    [[ -s $SETTINGS_FILE ]] && current=$(<"$SETTINGS_FILE")
    if ! jq --arg name "$name" --argjson value "$([[ $wanted == on ]] && echo true || echo false)" '.[$name] = $value' \
            <<< "$current" > "$SETTINGS_FILE.new" 2>/dev/null; then
        rm -f "$SETTINGS_FILE.new"
        echo "cockpit: $SETTINGS_FILE is not valid JSON, left as it is" >&2; return 1
    fi
    mv -f "$SETTINGS_FILE.new" "$SETTINGS_FILE"
    log_event INFO manager "setting $name $wanted"
    echo "$name: $wanted"
}

# on / off: every session to Remote Control (Super+Shift+C), or back.
handoff() { # on|off
    local wanted=${1:-on} id pane count=0
    case $wanted in on|off) ;; *) echo "usage: cockpit handoff [on|off]" >&2; return 1 ;; esac
    audit_event manager session.handoff "$wanted"
    if [[ ! -s $SNAPSHOT ]]; then
        echo "cockpit: no running session" >&2; return 1
    fi
    while IFS=$'\t' read -r id pane; do
        [[ -n $pane ]] || continue
        if [[ $wanted == on ]]; then session_is_remote "$id" && continue; else session_is_remote "$id" || continue; fi
        send_remote_toggle "$pane"; count=$((count + 1))
    done < <(jq -r '.sessions[] | select((.agent // "claude") == "claude") | [.session, (.tmux_pane // "")] | @tsv' "$SNAPSHOT")
    echo "cockpit: remote control $wanted for $count session(s)"
}

# The lock screen's away on / off: while away, the phone page notifies (a session needs you, an
# ask-to-run asks, a turn ends); at the desk it stays quiet. The setting phone-on-lock turns it off.
away() { # on|off
    case ${1:-} in
        on)
            if ! setting_is_on phone-on-lock; then
                rm -f "$PHONE_AWAY" "${XDG_RUNTIME_DIR:-/tmp}/claude-remote-away"
                log_event INFO lock "phone-on-lock is off: the phone stays quiet"
                echo "cockpit: phone-on-lock is off, the phone stays quiet"
                return 0
            fi
            : > "$PHONE_AWAY" ;;
        off) rm -f "$PHONE_AWAY" "${XDG_RUNTIME_DIR:-/tmp}/claude-remote-away" ;;
        *) echo "usage: cockpit away on|off" >&2; return 1 ;;
    esac
    audit_event manager phone.away "$1"
    echo "cockpit: away $1"
}

# Claude writes a conversation's transcript only once something was said in it: a session nobody
# typed in yet has nothing to resume (claude --resume fails with "No conversation found").
has_conversation() { # id
    local transcript
    for transcript in "${COCKPIT_TRANSCRIPTS:-$HOME/.claude/projects}"/*/"$1".jsonl; do
        [[ -f $transcript ]] && grep -qs '"type":"user"' "$transcript" && return 0
    done
    return 1
}

# opencode keeps its sessions in its database (paths::opencode_database in the column): present,
# gone, or unknown when sqlite3 or the database cannot answer. Read-only: its sandboxes write it.
OPENCODE_DATABASE=${COCKPIT_OPENCODE_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db}
opencode_session_state() { # id
    local count
    # The id goes into the SQL text: sqlite3's shell has no parameters for a one-shot query.
    [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] && command -v sqlite3 >/dev/null && [[ -f $OPENCODE_DATABASE ]] || { echo unknown; return; }
    count=$(sqlite3 -readonly -batch -noheader -cmd '.timeout 1000' "$OPENCODE_DATABASE" \
        "select count(*) from session_v2 where id = '$1'" 2>/dev/null) || { echo unknown; return; }
    case $count in
        0) echo gone ;;
        [1-9]*) echo present ;;
        *) echo unknown ;;
    esac
}

# Sleeping: a session idle at its prompt exits and leaves a note here, its card stays as Asleep, and
# `cockpit wake` resumes the conversation. Notes live in the state folder (they outlive a reboot)
# and are not ended-sessions: a sleep is not Theo's decision to end it.
ASLEEP_DIR="${COCKPIT_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/cockpit/asleep"

is_asleep() { # id
    [[ $1 =~ ^[A-Za-z0-9_-]+$ && -f $ASLEEP_DIR/$1 ]]
}

team_sleep_request() { # command id token-object
    [[ $2 =~ ^[A-Za-z0-9_-]+$ ]] || return 1
    printf '%s\n' "$3" | cockpit-team "$1" "$2" 2>/dev/null
}

cancel_sleep_permit() { # id token-object
    [[ -n $2 ]] || return 0
    if ! team_sleep_request sleep-cancel "$1" "$2" >/dev/null; then
        log_event WARN sleep "$1 sleep cancellation unavailable; daemon reconciliation must check permission"
    fi
}

forget_sleep_note() { # id
    [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || return 1
    local permit
    permit=$(jq -ce 'select(.team_resume | type == "string" and length > 0) | {token: .team_resume}' "$ASLEEP_DIR/$1" 2>/dev/null) || permit=""
    # Deletion is durable revocation, even when the host daemon cannot be reached.
    rm -f "$ASLEEP_DIR/$1" || return 1
    cancel_sleep_permit "$1" "$permit"
}

# Whether anything sits in the prompt of the agent's pane. Only the cursor right after the agent's
# prompt start, with nothing but blanks or dim text (a placeholder) after it, reads as empty:
# anything else, or a screen that cannot be read, counts as a draft.
prompt_has_draft() { # pane agent
    local LC_ALL=C.UTF-8 # ${#line} and ${line:i:1} count characters, not the bytes of ❯
    local pane=$1 agent=$2 cursor_x cursor_y line prompt_start
    local plain= dim_flags= dim=0 index=0 char sequence params codes code step before_cursor after_cursor
    read -r cursor_x cursor_y < <(tmux display-message -p -t "$pane" '#{cursor_x} #{cursor_y}' 2>/dev/null) || return 0
    [[ $cursor_x =~ ^[0-9]+$ && $cursor_y =~ ^[0-9]+$ ]] || return 0
    line=$(tmux capture-pane -p -e -N -t "$pane" -S "$cursor_y" -E "$cursor_y" 2>/dev/null) || return 0
    prompt_start=$("agent_${agent}_prompt_start") || return 0
    [[ -n $prompt_start ]] || return 0
    # The cursor is a column of the screen: read the line without the colour codes in it.
    while (( index < ${#line} )); do
        char=${line:index:1}
        if [[ $char != $'\e' ]]; then
            plain+=$char dim_flags+=$dim index=$(( index + 1 ))
            continue
        fi
        sequence=${line:index+1}
        [[ $sequence =~ ^\[([0-9;]*)([@-~]) ]] || return 0
        index=$(( index + ${#BASH_REMATCH[0]} + 1 ))
        [[ ${BASH_REMATCH[2]} == m ]] || continue
        params=${BASH_REMATCH[1]}
        IFS=';' read -ra codes <<< "${params:-0}"
        for (( step = 0; step < ${#codes[@]}; step++ )); do
            code=$(( 10#${codes[step]:-0} ))
            case $code in
                2|90) dim=1 ;;
                0|22|39|3[0-7]|9[1-7]) dim=0 ;;
                38|48)
                    [[ $code == 38 ]] && dim=0
                    # 38;5;n and 38;2;r;g;b carry numbers that are no codes of their own.
                    case ${codes[step+1]:-} in 5) step=$(( step + 2 )) ;; 2) step=$(( step + 4 )) ;; esac ;;
            esac
        done
    done
    before_cursor=${plain:0:cursor_x}
    [[ $before_cursor =~ $prompt_start ]] || return 0
    after_cursor=${plain:cursor_x}
    for (( index = 0; index < ${#after_cursor}; index++ )); do
        char=${after_cursor:index:1}
        [[ $char == " " || $char == $'\u00a0' || ${dim_flags:cursor_x+index:1} == 1 ]] || return 0
    done
    return 1
}

# "pid comm" of the first background process among the pane's descendants: a shell run by the
# agent itself (a background command it started: bash under claude), or anything but the agent
# under the sandbox's pid 1, the inner bwrap, where `cmd &`, nohup and setsid leave what they
# start. What runs above the sandbox (greywall, its proxies, claude-auto-retry) is the session's
# own plumbing. Fails when the processes cannot be read.
background_shell_of() { # pane
    local pane_pid table found
    pane_pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
    [[ $pane_pid =~ ^[0-9]+$ ]] || return 1
    table=$(timeout 2 ps -eo pid=,ppid=,comm= 2>/dev/null) || return 1
    found=$(descendants_of "$pane_pid" <<< "$table" | awk -v root="$pane_pid" '
        { parent[$1] = $2; name[$1] = $3 }
        END { for (pid in parent) if (name[pid] == "bwrap" && name[parent[pid]] == "bwrap") sandbox_init = pid
              for (pid in parent) {
                  if (pid == root) continue
                  agent_shell = name[pid] ~ /^(bash|sh|zsh|fish|dash)$/ && name[parent[pid]] ~ /^(claude|opencode)$/
                  left_the_agent = sandbox_init != "" && parent[pid] == sandbox_init && name[pid] !~ /^(claude|opencode)$/
                  if (agent_shell || left_the_agent) print pid, name[pid] } }' | sort -n) || return 1
    printf '%s' "${found%%$'\n'*}"
}

# The first reason this session must stay awake, or nothing. Any doubt is a reason.
sleep_blocker() { # id pane
    local id=$1 pane=$2 agent shell background_work
    [[ $(session_field "$id" state) == waiting ]] || { echo "it is not waiting at its prompt"; return; }
    [[ -z $(session_field "$id" needs_input) ]] || { echo "it needs an answer"; return; }
    agent=$(agent_of_session "$id")
    if [[ $agent == claude ]]; then
        has_conversation "$id" || { echo "it has no conversation to resume yet"; return; }
        for background_work in background agents; do
            [[ $(session_field "$id" "$background_work") =~ ^0?$ ]] || { echo "it has $background_work work running"; return; }
        done
    fi
    if prompt_has_draft "$pane" "$agent"; then echo "its prompt holds a draft or cannot be read"; return; fi
    shell=$(background_shell_of "$pane") || { echo "its processes cannot be read"; return; }
    [[ -z $shell ]] || echo "it runs a background process ($shell)"
}

# Exit 0: asleep. Exit 3: it stays awake (the reason is logged and on stderr). Exit 1: an error.
# The note is written before the exit, so a session that is gone always has one to wake from; an
# exit that fails takes the note back.
sleep_session() { # id
    local id=$1 pane project agent title since started slept_at remote=false reason note temporary target permit token
    [[ $id =~ ^[A-Za-z0-9_-]+$ ]] || { echo "cockpit: invalid session id $id" >&2; return 1; }
    require_feature "$id" sleep "sleeping" || return 1
    project=$(session_field "$id" project)
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then reason="it has no tmux pane"; else reason=$(sleep_blocker "$id" "$pane"); fi
    since=$(session_field "$id" since)
    [[ -n $reason || $since =~ ^[0-9]+(\.[0-9]+)?$ ]] || reason="its idle time is unknown"
    if [[ -n $reason ]]; then
        log_event INFO sleep "$project stays awake: $reason"
        # An expected outcome, not an error: the column's background runs log stderr as ERROR,
        # and ERROR lines are handed to a session to fix.
        log_failure_level=INFO
        [[ -n ${COCKPIT_LOG_STDERR:-} ]] || echo "cockpit: $project stays awake: $reason" >&2
        return 3
    fi
    (
    local operation_dir="${XDG_RUNTIME_DIR:-/tmp}/cockpit.sleep-operations" operation_guard
    if ! (umask 077; mkdir -p -m 700 "$operation_dir") || [[ -L $operation_dir || ! -O $operation_dir ]] ||
            ! chmod 700 "$operation_dir" || [[ -L $operation_dir/$id || ( -e $operation_dir/$id && ! -f $operation_dir/$id ) ]]; then
        echo "cockpit: could not secure sleep operation" >&2
        return 1
    fi
    # Never unlink these files: every holder must lock the same inode, including orphan helpers.
    (umask 077; touch "$operation_dir/$id") || return 1
    chmod 600 "$operation_dir/$id" || return 1
    exec {operation_guard}<>"$operation_dir/$id"
    flock -n "$operation_guard" || return 3
    # Closing our reference must not unlock inherited helpers; the daemon checks their quiescence.
    trap 'status=$?; exec {operation_guard}>&-
    if (( status )) && [[ -n ${permit:-} ]]; then
        if [[ -z ${note:-} || ! -e $note ]]; then cancel_sleep_permit "$id" "$permit";
        else team_sleep_request sleep-status "$id" "$permit" >/dev/null || log_event WARN sleep "$project interrupted; daemon reconciliation unavailable"; fi
    fi' EXIT
    if ! permit=$(cockpit-team sleep-prepare "$id" 2>/dev/null) ||
            ! jq -e 'type == "object" and has("token") and (.token == null or (.token | type == "string" and length > 0))' >/dev/null 2>&1 <<< "$permit"; then
        log_event WARN sleep "$project stays awake: team membership preparation unavailable or refused"
        [[ -n ${COCKPIT_LOG_STDERR:-} ]] || echo "cockpit: $project stays awake: team membership preparation unavailable or refused" >&2
        return 3
    fi
    token=$(jq -r '.token // empty' <<< "$permit")
    [[ -n $token ]] || permit=""
    agent=$(agent_of_session "$id")
    title=$(session_field "$id" task)
    # Kept so the card holds its place in the column; without it the card sorts by its idle time.
    started=$(session_field "$id" started)
    [[ $started =~ ^[0-9]+(\.[0-9]+)?$ ]] || started=""
    [[ $agent == claude ]] && session_is_remote "$id" && remote=true
    printf -v slept_at '%(%s)T' -1
    note="$ASLEEP_DIR/$id"
    # Outside the folder: the column and `cockpit wake` read every file in it as a note.
    if ! mkdir -p -m 700 "$ASLEEP_DIR" || [[ -L $ASLEEP_DIR || ! -O $ASLEEP_DIR ]] || ! chmod 700 "$ASLEEP_DIR"; then
        cancel_sleep_permit "$id" "$permit"
        echo "cockpit: could not secure sleep notes" >&2
        return 1
    fi
    temporary=$(umask 077; mktemp "$(dirname "$ASLEEP_DIR")/.asleep-$id.XXXXXX") || { cancel_sleep_permit "$id" "$permit"; return 1; }
    if ! (umask 077; printf '%s' "$token" | jq -Rs --arg session "$id" --arg agent "$agent" --arg project "$project" --arg cwd "$(session_field "$id" cwd)" \
            --arg title "$title" --argjson since "$since" --arg started "$started" --argjson slept_at "$slept_at" --argjson remote "$remote" \
            '. as $token | {session: $session, agent: $agent, project: $project, cwd: $cwd, title: $title, idle_since: ($since | floor),
              slept_at: $slept_at, remote: $remote} + (if $started == "" then {} else {started: ($started | tonumber | floor)} end)
              + (if $token == "" then {} else {team_resume: $token} end)' > "$temporary"); then
        rm -f "$temporary"
        cancel_sleep_permit "$id" "$permit"
        echo "cockpit: could not write the note for $id" >&2
        return 1
    fi
    if ! chmod 600 "$temporary" || ! mv -fT -- "$temporary" "$note"; then
        rm -f "$temporary"
        cancel_sleep_permit "$id" "$permit"
        return 1
    fi
    target=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || target=""
    if [[ -n $permit ]] && ! team_sleep_request sleep-recorded "$id" "$permit" >/dev/null; then
        if [[ -n $target ]] && tmux has-session -t "=$target" 2>/dev/null; then
            forget_sleep_note "$id"
        else
            cancel_sleep_permit "$id" "$permit"
            log_event WARN sleep "$project vanished before recording; its sleep note is retained"
        fi
        log_event WARN sleep "$project stays awake: team sleep recording failed"
        [[ -n ${COCKPIT_LOG_STDERR:-} ]] || echo "cockpit: $project stays awake: team sleep recording failed" >&2
        return 3
    fi
    reason=$(sleep_blocker "$id" "$pane")
    if [[ -n $reason ]]; then
        if [[ -n $target ]] && tmux has-session -t "=$target" 2>/dev/null; then
            forget_sleep_note "$id"
        else
            cancel_sleep_permit "$id" "$permit"
            log_event WARN sleep "$project vanished before exit; its sleep note is retained"
        fi
        log_event INFO sleep "$project stays awake: $reason"
        [[ -n ${COCKPIT_LOG_STDERR:-} ]] || echo "cockpit: $project stays awake: $reason" >&2
        return 3
    fi
    if ! exit_session "$id"; then
        if [[ $agent == opencode ]]; then
            log_event WARN sleep "$project conversation-wide exit failed; its sleep note is retained"
            return 1
        fi
        # An exit that finished just before the last-resort kill fails it: the session is gone
        # all the same, and only the note can wake it.
        if [[ -n $target ]] && tmux has-session -t "=$target" 2>/dev/null; then
            forget_sleep_note "$id"
            log_event WARN sleep "$project did not exit to sleep; its note is removed"
            return 1
        fi
        if [[ -z $target ]]; then
            log_event WARN sleep "$project exit outcome unknown; its sleep note is retained"
            return 1
        fi
        log_event INFO sleep "$project left while its exit was failing; it sleeps"
    fi
    clear_exited_viewer "$id"
    log_event INFO sleep "$project asleep after $(( (slept_at - ${since%.*}) / 60 )) min idle"
    )
}

# Sessions ended on purpose (exit, the sidebar's x): not offered back after a reboot.
ENDED_SESSIONS="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/ended-sessions"
RESTORE_WAIT_S=${COCKPIT_RESTORE_WAIT:-25}
# The OSD daemon's record of the sessions that ran, for the restore: their billing among the rest.
RECENT_SESSIONS="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/recent-sessions.json"

# Bring back each <dir> <id> pair, each in a tmux session of its own, so none depends on the viewer
# pane (agent_*_restore). A folder that is gone is skipped.
restore_sessions() { # dir id [dir id …]
    (( $# % 2 == 0 && $# > 0 )) || { echo "usage: cockpit restore <dir> <id> [<dir> <id> …]" >&2; return 1; }
    local directory id
    while (( $# )); do
        directory=$1 id=$2
        shift 2
        if [[ ! -d $directory ]]; then
            log_event WARN manager "restore: skipped $id ($directory is gone)"
            continue
        fi
        "agent_$(agent_of_session "$id")_restore" "$directory" "$id"
    done
}

# A note per session being restarted, "<since>\n<project>\n<directory>\n<old pane>": the column
# holds its card (Restarting) and its selection until the new process reports, and the session pane
# waits for it (restarting_screen). Without it, the card vanished at the exit and the column viewed
# the next one.
RESTARTING_DIR="${XDG_RUNTIME_DIR:-/tmp}/cockpit.restarting"
RESTART_TIMEOUT_S=90

is_restarting() { # id
    [[ $1 =~ ^[A-Za-z0-9_-]+$ && -f $RESTARTING_DIR/$1 ]]
}

# A message for a session that is not running yet; the column sends it once the new process waits
# at its prompt (apps/cockpit/src/prompts.rs).
queue_for_wake() { # id message
    local folder="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/prompt-queue/$1"
    mkdir -p "$folder"
    printf '%s' "$2" > "$folder/$(date +%s%N).txt"
    log_event INFO sessions "prompt queued for $1 until it wakes"
    audit_event manager prompt.queued queued "session=$1" "fp:text=$2"
}

# Whether an asleep session can wake: fills the caller's project, directory, remote and agent from
# its note. Claude's restore would start a fresh session when its conversation is gone, so that is
# checked here. When it cannot, the note is deleted and the reason logged and printed, as a dead
# session would be: a wake, or a message waiting for one, must not be left hanging.
check_wakeable() { # id
    local id=$1 note="$ASLEEP_DIR/$1" reason=""
    IFS=$'\x1f' read -r project directory remote < <(jq -r '[.project // "", .cwd // "", (.remote // false | tostring)] | join("\u001f")' "$note" 2>/dev/null) || true
    [[ -n $project ]] || project=$id
    agent=$(agent_of_session "$id")
    if [[ -z $directory || $directory == *"#"* || ! -d $directory ]]; then
        reason="its folder is unknown or gone"
    elif [[ $agent == claude ]] && ! has_conversation "$id"; then
        reason="its conversation is gone"
    elif [[ $agent == opencode ]]; then
        case $(opencode_session_state "$id") in
            gone) reason="its conversation is gone" ;;
            unknown) log_event INFO sleep "$project wakes though opencode's database cannot tell whether its session is still there" ;;
        esac
    fi
    [[ -n $reason ]] || return 0
    forget_sleep_note "$id"
    log_event WARN sleep "$project could not wake: $reason"
    echo "cockpit: $project could not wake: $reason" >&2
    return 1
}

# Resume an asleep session's conversation out of sight, the way restore does, under a restart note
# (the column shows Restarting, the session pane waits for it). The agent not starting keeps the
# note. Team launch permissions are never retried after an ambiguous launch.
wake_session() { # id
    local id=$1 note="$ASLEEP_DIR/$1"
    is_asleep "$id" || { echo "cockpit: $id is not asleep" >&2; return 1; }
    # The sleep note is the lock: a click and a message waking it together resume it once.
    (
        flock -n 9 || { log_event INFO sleep "$id is already waking"; exit 0; }
        [[ -f $note ]] || exit 0
        local project directory remote agent woke_at permit status launch_team_resume=
        check_wakeable "$id" || exit 1
        permit=$(jq -ce 'select(.team_resume | type == "string" and length > 0) | {token: .team_resume}' "$note" 2>/dev/null) || permit=""
        if [[ -z $permit ]] && jq -e 'has("team_resume")' "$note" >/dev/null 2>&1; then
            forget_sleep_note "$id"
            log_event WARN sleep "$id team wake failed: invalid sleep permit note"
            exit 1
        fi
        if [[ -n $permit ]]; then
            if ! team_sleep_request sleep-begin-wake "$id" "$permit" >/dev/null; then
                # The previous waiter may have died after binding committed but before cleanup.
                if status=$(team_sleep_request sleep-status "$id" "$permit") &&
                        jq -e '.state == "bound"' >/dev/null 2>&1 <<< "$status"; then
                    [[ ! $note -ef /dev/fd/9 ]] || rm -f "$note"
                    log_event INFO sleep "$id woke; team binding acknowledged"
                    exit 0
                fi
                log_event WARN sleep "$id team wake failed: host refused launch permission"
                echo "cockpit: $id team wake failed: host refused launch permission" >&2
                exit 1
            fi
            launch_team_resume=$(jq -r .token <<< "$permit")
        fi
        printf -v woke_at '%(%s)T' -1
        mkdir -p "$RESTARTING_DIR"
        printf '%s\n%s\n%s\n\n' "$woke_at" "$project" "$directory" > "$RESTARTING_DIR/$id"
        if [[ $(cat "$CURRENT" 2>/dev/null) == "$id" ]]; then show_restarting "$id"; fi
        if ! "agent_${agent}_restore" "$directory" "$id" 9<&-; then
            rm -f "$RESTARTING_DIR/$id"
            log_event WARN sleep "$project could not wake: its $agent did not start"
            echo "cockpit: $project could not wake: its $agent did not start" >&2
            exit 1
        fi
        if [[ -n $permit ]]; then
            # Keep the wake lock in the waiter, not in tmux or its long-lived agent.
            ( wait_team_binding "$id" "$permit" "$woke_at" ) </dev/null >/dev/null 2>&1 &
        else
            rm -f "$note"
            log_event INFO sleep "$project woke"
        fi
        # Not inheriting the lock: the wait outlives this wake by up to RESTART_TIMEOUT_S.
        if [[ $remote == true ]]; then setsid -f cockpit wake-remote "$id" "$woke_at" 9<&- >/dev/null 2>&1; fi
    ) 9<"$note"
}

wait_team_binding() { # id token-object woke-at; inherits the sleep note's lock on fd 9
    local id=$1 permit=$2 woke_at=$3 status state reason="binding acknowledgement timed out" note="$ASLEEP_DIR/$1"
    while (( $(date +%s) - woke_at < RESTART_TIMEOUT_S )); do
        if [[ ! $note -ef /dev/fd/9 ]]; then reason="sleep note removed or replaced"; break; fi
        if ! status=$(team_sleep_request sleep-status "$id" "$permit"); then reason="host status unavailable"; break; fi
        state=$(jq -er '.state | select(type == "string")' <<< "$status" 2>/dev/null) || { reason="invalid host status"; break; }
        case $state in
            bound)
                # A concurrent explicit exit may have deleted or replaced this note while IPC ran.
                if [[ $note -ef /dev/fd/9 ]]; then rm -f "$note"; fi
                log_event INFO sleep "$id woke; team binding acknowledged"
                return 0 ;;
            waking) sleep 1 ;;
            *) reason="host did not acknowledge binding"; break ;;
        esac
    done
    rm -f "$RESTARTING_DIR/$id"
    log_event WARN sleep "$id team wake failed: $reason; sleep note retained, no automatic retry"
    return 1
}

# Remote Control does not survive the exit: switch it back on once the resumed session waits at its
# prompt (a new process: started at or after the wake).
restore_remote_control() { # id woke_at
    local id=$1 woke_at=$2 pane status_line
    [[ $id =~ ^[A-Za-z0-9_-]+$ && $woke_at =~ ^[0-9]+$ ]] || { echo "usage: cockpit wake-remote <session-id> <woke-at>" >&2; return 1; }
    while (( $(date +%s) - woke_at <= RESTART_TIMEOUT_S )); do
        pane=$(jq -r --arg id "$id" --argjson woke_at "$woke_at" \
            'first(.sessions[] | select(.session == $id and (.tmux_pane // "") != "" and .state == "waiting" and (.started // 0) >= $woke_at)) | .tmux_pane' \
            "$SNAPSHOT" 2>/dev/null || true)
        if [[ -n $pane ]]; then
            # The status line the sleeping process wrote still says remote: only a newer one counts.
            status_line="$HOME/.cache/claude/statusline-$id.json"
            if (( $(stat -c %Y "$status_line" 2>/dev/null || echo 0) >= woke_at )) && session_is_remote "$id"; then return 0; fi
            send_remote_toggle "$pane"
            return 0
        fi
        sleep 1
    done
    log_event WARN sleep "$id did not reach its prompt within ${RESTART_TIMEOUT_S}s: Remote Control stays off"
    return 1
}

# Exit it and bring it back in its directory; each agent says how (agent_*_restart). An effort or a
# billing is refused for an agent without the feature.
restart_session() { # id [effort] [detached] [credits|subscription]
    local id=$1 effort=${2:-} detached=${3:-} billing=${4:-} directory note permit launch_team_resume=
    "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription" cancel-session "$id" || return
    # A live pane first: a note can outlive its process by the length of the sleep's exit.
    if [[ -z $(session_field "$id" tmux_pane) ]] && is_asleep "$id"; then
        [[ -z $effort && -z $billing ]] || { echo "cockpit: $id is asleep; wake it before changing its effort or billing" >&2; return 1; }
        wake_session "$id"
        return
    fi
    directory=$(session_field "$id" cwd)
    audit_event manager session.restart asked "session=$id" "directory=$directory"
    if [[ -z $directory ]]; then
        echo "cockpit: session $id has no directory to restart in" >&2
        return 1
    fi
    [[ -z $effort ]] || require_feature "$id" effort "effort" || return 1
    [[ -z $billing ]] || require_feature "$id" billing "billing" || return 1
    [[ $id =~ ^[A-Za-z0-9_-]+$ ]] || { echo "cockpit: refusing session id $id" >&2; return 1; }
    # A team member keeps its membership through this restart only: the host binds the permit to
    # the relaunch once the old process is gone, in the same folder. Agents that can sleep are the
    # ones whose launches carry it. Refused or unavailable, the restart goes ahead without it.
    if agent_can "$(agent_of_session "$id")" sleep; then
        if permit=$(cockpit-team restart-prepare "$id" 2>/dev/null); then
            launch_team_resume=$(jq -r '.token | select(type == "string" and test("^[0-9a-f]{32}$"))' <<< "$permit" 2>/dev/null) || launch_team_resume=""
        else
            log_event WARN sessions "$(session_field "$id" project) restarts without its team membership: the host refused or could not be reached"
        fi
    fi
    note="$RESTARTING_DIR/$id"
    mkdir -p "$RESTARTING_DIR"
    printf '%s\n%s\n%s\n%s\n' "$(date +%s)" "$(session_field "$id" project)" "$directory" "$(session_field "$id" tmux_pane)" > "$note"
    # Detached, nothing else takes the session pane: it would show a dead client.
    if [[ $detached == detached && $(cat "$CURRENT" 2>/dev/null) == "$id" ]]; then
        show_restarting "$id"
    fi
    if ! "agent_$(agent_of_session "$id")_restart" "$id" "$directory" "$effort" "$detached" "$billing"; then
        rm -f "$note"
        [[ -z $launch_team_resume ]] || cancel_sleep_permit "$id" "{\"token\":\"$launch_team_resume\"}"
        return 1
    fi
}

show_restarting() { # id
    local sidebar viewer approval approval_run sidebar_dead
    read_manager_panes
    [[ -n $viewer ]] || return 0
    tmux respawn-pane -k -t "$viewer" cockpit restarting-screen "$1"
}

# The session pane while a session restarts out of sight: a spinner, then the session again once its
# new process reports (the same conversation, or a fresh one in its folder when it had none). It runs
# the view in the background: the view replaces this pane.
restarting_screen() { # id
    local id=$1 since project directory old_pane frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) tick=0 rows columns label back
    if ! { read -r since; read -r project; read -r directory; read -r old_pane; } < "$RESTARTING_DIR/$id" 2>/dev/null; then
        printf '\n  No restart under way for %s.\n' "$id"
        exec sleep infinity
    fi
    label="Restarting $project …"
    tput civis 2>/dev/null || true
    while (( $(date +%s) - since <= RESTART_TIMEOUT_S )); do
        back=$(jq -r --arg session "$id" --arg directory "$directory" --arg pane "$old_pane" --argjson since "$since" \
            'first(.sessions[] | select(((.started // 0) >= $since and (.session == $session or .cwd == $directory))
                                        or (.session == $session and (.tmux_pane // "") != "" and .tmux_pane != $pane))) | .session' \
            "$SNAPSHOT" 2>/dev/null || true)
        if [[ -n $back ]]; then
            setsid -f cockpit view "$back" >/dev/null 2>&1
            exec sleep infinity
        fi
        rows=$(tput lines 2>/dev/null || echo 24) columns=$(tput cols 2>/dev/null || echo 80)
        printf '\033[2J\033[%d;%dH\033[1;36m%s\033[0m  \033[1m%s\033[0m' \
            $(( rows / 2 )) $(( (columns - ${#label} - 3) / 2 > 1 ? (columns - ${#label} - 3) / 2 : 1 )) "${frames[tick % 10]}" "$label"
        tick=$(( tick + 1 ))
        sleep 0.15
    done
    log_event WARN sessions "restart of $project ($id) did not report within ${RESTART_TIMEOUT_S}s"
    printf '\033[2J\033[H\n  ✗ %s did not come back within %ss.\n  cockpit logs says more; its card shows it if it reports later.\n' "$project" "$RESTART_TIMEOUT_S"
    exec sleep infinity
}

# One after the other: each restart reuses the viewer pane. The session shown before comes back.
# Each one is launched in a tmux session of its own, never in the viewer pane: a launch there dies
# with whatever takes the pane next (the next restart, a click on another card) until
# claude-auto-retry has moved it out, and one restart-all lost a session that way.
restart_sessions() { # [id...]
    local shown id waited sessions session_ids=()
    if (( $# == 0 )); then
        # Capture the list before restarting: the daemon replaces rows as sessions come back.
        if ! sessions=$(jq -er '[.sessions[] | select((.tmux_pane // "") != "" and (.terminal // false) == false) | .session] | unique | join("\n")' "$SNAPSHOT"); then
            echo "cockpit: cannot read running sessions from $SNAPSHOT" >&2
            return 1
        fi
        [[ -n $sessions ]] || { echo "cockpit: no managed running sessions"; return 0; }
        mapfile -t session_ids <<< "$sessions"
        set -- "${session_ids[@]}"
    fi
    shown=$(cat "$CURRENT" 2>/dev/null || true)
    for id in "$@"; do
        restart_session "$id" "" detached || log_event WARN sessions "restart of $id failed during restart-all"
    done
    [[ -n $shown ]] || return 0
    # The session that was on screen comes back once it reports in again (it may be one of these).
    for (( waited = 0; waited < RESTORE_WAIT_S; waited++ )); do
        [[ -n $(session_field "$shown" tmux_pane) ]] && break
        sleep 1
    done
    view_session "$shown" || true
}

# The OSD daemon (osd.service) keeps running the build it started with: make build replaces the
# binary, not the process, so the daemon's fixes were not live after an apply until a manual
# restart. reload restarts it when its build is older than the one on disk, once no approval is
# open: a restart forgets the approval the daemon shows (its pane and window would stay), and the
# apply itself often runs in one.
OSD_BINARY="${COCKPIT_OSD_BINARY:-$HOME/agent-cockpit/apps/target/release/osd}"

# unit_is_stale <unit> <binary>: the unit runs and started before its binary was last built.
unit_is_stale() {
    local unit=$1 binary=$2 pid running_for built
    pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
    [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
    running_for=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
    built=$(stat -c %Y "$binary" 2>/dev/null)
    [[ $running_for =~ ^[0-9]+$ && $built =~ ^[0-9]+$ ]] || return 1
    (( built > $(date +%s) - running_for ))
}

osd_is_stale() {
    unit_is_stale osd.service "$OSD_BINARY"
}

restart_stale_osd() {
    osd_is_stale || return 0
    echo "The OSD daemon runs an older build: it restarts once no approval is open."
    log_event INFO manager "osd.service runs a build older than $OSD_BINARY: restart once no approval is open"
    start_detached "$0" restart-osd-when-idle
}

# start_detached <command…>: in its own session, holding none of the caller's descriptors. The OSD
# waiter outlived the apply that reloaded and kept its install lock open (2026-10-28): the
# approved installs queued behind that lock never ran, so the approvals the waiter waited on
# never closed.
start_detached() (
    local descriptor
    for descriptor in /proc/$BASHPID/fd/*; do
        descriptor=${descriptor##*/}
        if (( descriptor > 2 && descriptor != 255 )); then exec {descriptor}>&-; fi
    done
    exec setsid -f "$@" </dev/null >/dev/null 2>&1
)

# The phone page (claude-remote.service) is compiled into its binary: after an apply the phone kept
# the old page until a manual restart. It restarts at once: it shows no approval of its own (a
# decision in flight fails on the phone, which says so), and its pairings are on disk.
REMOTE_BINARY="${COCKPIT_REMOTE_BINARY:-$HOME/agent-cockpit/apps/target/release/cockpit-remote}"

restart_stale_remote() {
    unit_is_stale cockpit-remote.service "$REMOTE_BINARY" || return 0
    if systemctl --user restart cockpit-remote.service; then
        echo "The phone page ran an older build: restarted."
        log_event INFO manager "cockpit-remote.service restarted on its new build"
    else
        echo "The phone page did not restart: systemctl --user restart cockpit-remote.service" >&2
        log_event ERROR manager "cockpit-remote.service did not restart: systemctl --user restart cockpit-remote.service by hand"
    fi
}

# One waiter at a time: several sessions reloading around one apply each scheduled a restart, the
# waiters all saw the last approval close at once, and six restarts in a second hit systemd's start
# limit (2026-10-19 19:17, osd.service failed). A second waiter leaves; the one left checks again
# that the daemon still runs an older build before it restarts it.
OSD_RESTART_LOCK="${XDG_RUNTIME_DIR:-/tmp}/cockpit.osd-restart.lock"

# The daemon's ABANDONED_AFTER: an approval nobody waited for this long holds no restart back. A
# command that hung on a prompt after its ask-to-run gave up (2026-10-20 16:03) kept the old daemon
# running for hours; its pane and window still close by themselves when it ends.
OSD_APPROVAL_ABANDONED_S=300

# The approvals (claude-run-<id> tmux sessions) someone still waits for: ask-to-run's heartbeat, or
# before its first beat the daemon's copy of the request, is recent. With neither file there is
# nothing to judge by, and the approval counts, as in the daemon.
awaited_approvals() {
    local name id stamp touched
    while read -r name; do
        id=${name#claude-run-}
        stamp="$RUNS_DIR/$id.waiting"
        [[ -e $stamp ]] || stamp="$REQUESTS_DIR/$id.request"
        if touched=$(stat -c %Y "$stamp" 2>/dev/null) && (( $(date +%s) - touched > OSD_APPROVAL_ABANDONED_S )); then
            continue
        fi
        echo "$name"
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude-run-[0-9a-f]\{12\}$')
}

restart_osd_when_idle() {
    exec {lock}>"$OSD_RESTART_LOCK"
    if ! flock -n "$lock"; then
        log_event INFO manager "osd.service restart already waiting: this one leaves"
        return 0
    fi
    local awaited guides reported="" migration_tool
    migration_tool="$(dirname "$(readlink -f "$0")")/../../../../tools/migrate-cockpit-names.py"
    while true; do
        awaited=$(awaited_approvals)
        if ! guides=$(python3 "$migration_tool" --check-guides 2>&1); then
            [[ -z $awaited ]] || awaited+=$'\n'
            awaited+="$guides"
        fi
        [[ -n $awaited ]] || break
        if [[ $awaited != "$reported" ]]; then
            log_event INFO manager "osd.service restart waits on $(paste -sd ' ' <<< "$awaited")"
            reported=$awaited
        fi
        sleep 2
    done
    if ! osd_is_stale; then
        log_event INFO manager "osd.service already on its new build: no restart"
        return 0
    fi
    if systemctl --user restart osd.service; then
        log_event INFO manager "osd.service restarted on its new build"
    else
        log_event ERROR manager "osd.service did not restart: systemctl --user restart osd.service by hand"
    fi
}

# The morning digest (the digest action of the sidebar's : list, and the first time the cockpit opens each day): yesterday's
# sessions and cost, today so far, plan usage, who waits for you, the pull requests. Any key goes
# back to the session that was in the pane.
DIGEST_DAY="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/digest-day"

show_digest() {
    ensure_manager
    local previous
    previous=$(cat "$CURRENT" 2>/dev/null || true)
    tmux respawn-pane -k -t "$(viewer_pane)" bash -c 'cockpit-sidebar digest
        read -rsn 1 -p "  any key goes back " _
        if [[ -n $1 ]]; then exec cockpit view "$1"; else exec cockpit idle; fi' bash "$previous"
    tmux set-option -p -t "$(viewer_pane)" @project "digest"
    mkdir -p "$(dirname "$DIGEST_DAY")"
    date +%F > "$DIGEST_DAY"
}

digest_due() {
    [[ $(cat "$DIGEST_DAY" 2>/dev/null) != "$(date +%F)" ]]
}

# The clones holding nothing new go once a day, on the first show, in the background: checking
# each one runs git in greywall, too slow to hold the cockpit back.
CLONES_SWEEP_DAY="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/clones-sweep-day"

sweep_clones_once_a_day() {
    [[ $(cat "$CLONES_SWEEP_DAY" 2>/dev/null) != "$(date +%F)" ]] || return 0
    mkdir -p "$(dirname "$CLONES_SWEEP_DAY")"
    date +%F > "$CLONES_SWEEP_DAY"
    ("$0" clones-sweep >/dev/null 2>&1 &)
}

show_manager() {
    ensure_manager
    if [[ -z ${1:-} ]] && "$ON_CLAUDE_WORKSPACE"; then
        hyprctl dispatch 'hl.dsp.focus({ workspace = "previous" })' >/dev/null
        return
    fi
    if [[ -n ${1:-} ]]; then
        view_session "$1" && focus_viewer
    elif digest_due && setting_is_on daily-digest; then
        show_digest
    fi
    sweep_clones_once_a_day
    # Hide the bar before the switch rather than after it, or it flashes over the cockpit.
    "$BAR_VISIBILITY" hide
    if hyprctl -j clients | jq -e --arg class "$WINDOW_CLASS" 'any(.[]; .class == $class)' >/dev/null; then
        hyprctl dispatch "hl.dsp.focus({ window = \"class:^$WINDOW_CLASS\$\" })" >/dev/null
    else
        # cockpit.conf adds the key maps that turn Ctrl+Tab and Ctrl+digit into chords tmux can see.
        setsid -f kitty --class "$WINDOW_CLASS" --config "$KITTY_CONFIG" --config "$KITTY_MANAGER_CONFIG" -e cockpit
        # The window rule puts it on the Claude workspace; go there now rather than when it maps.
        hyprctl dispatch "hl.dsp.focus({ workspace = $WORKSPACE })" >/dev/null
    fi
}

sweep_caches() {
    # One status-line file per session ever run, and toast ids of sessions long gone.
    find "$HOME/.cache/claude" -maxdepth 1 \( -name 'statusline-*.json' -o -name 'toast-*.id' \) -mtime +7 -delete 2>/dev/null || true
    # Run requests and their results (ask-to-run).
    find -H "$RUNS_DIR" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null || true
    find "$HOME/.cache/claude/guides" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null || true
}

doctor() {
    local failures=0 daemon_pid fifo="${XDG_RUNTIME_DIR:-/tmp}/osd.fifo"
    report() { # ok|fail  what  [fix]
        if [[ $1 == ok ]]; then
            printf '  ok    %s\n' "$2"
        else
            printf '  FAIL  %s\n        fix: %s\n' "$2" "$3"
            failures=$((failures + 1))
        fi
    }
    echo "daemon"
    # pgrep -f also matches wrappers around the daemon (a shell, a unit's exec line), so every
    # match is inspected and the daemon is the one holding the FIFO open.
    local daemon_pids holder=""
    daemon_pids=$(pgrep -x osd || true)
    for daemon_pid in $daemon_pids; do
        if ls -l "/proc/$daemon_pid/fd" 2>/dev/null | grep -q osd.fifo; then holder=$daemon_pid; break; fi
    done
    if [[ -n $daemon_pids ]]; then report ok "osd running (pid ${daemon_pids//$'\n'/, })"; else report fail "osd not running" "systemctl --user restart osd.service"; fi
    if [[ -p $fifo ]]; then report ok "FIFO $fifo exists"; else report fail "FIFO $fifo missing" "restart the daemon, it creates it"; fi
    if [[ -n $holder ]]; then report ok "daemon reads the FIFO (pid $holder)"; elif [[ -n $daemon_pids ]]; then report fail "no osd process holds the FIFO" "systemctl --user restart osd.service; then: pgrep -ax osd"; fi
    echo "greywall (what sessions can reach)"
    local greywall="$HOME/.config/greywall/greywall.json"
    if jq -e --arg path "$fifo" '.filesystem.allowWrite | index($path)' "$greywall" >/dev/null 2>&1; then report ok "$fifo in allowWrite"; else report fail "$fifo not in greywall allowWrite" "add it to filesystem.allowWrite in $greywall"; fi
    local pin_check
    if pin_check=$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../../packages/greywall/check.sh" "$GREYWALL" 2>&1); then
        report ok "$pin_check"
    else
        report fail "${pin_check%%:*}" "make -C ~/agent-cockpit greywall-patch (sessions get flagged for a restart)"
    fi
    if jq -e '.filesystem.allowRead | index("~/agent-cockpit/config/claude")' "$greywall" >/dev/null 2>&1; then report ok "~/agent-cockpit/config/claude in allowRead"; else report fail "~/agent-cockpit/config/claude not in greywall allowRead" "add it, or hooks are unreachable from other projects"; fi
    echo "hooks"
    if [[ -x $(readlink -f "$HOME/.claude/hooks/session-state.sh") ]]; then report ok "~/.claude/hooks/session-state.sh resolves"; else report fail "~/.claude/hooks/session-state.sh does not resolve" "cd ~/agent-cockpit/config && stow --no-folding -t ~ --restow claude"; fi
    local event missing_events=""
    for event in SessionStart UserPromptSubmit PostToolUse Notification Stop StopFailure SessionEnd; do
        jq -e --arg event "$event" '[.hooks[$event][]?.hooks[]?.command] | any(test("session-state.sh"))' "$HOME/.claude/settings.json" >/dev/null 2>&1 \
            || missing_events="$missing_events $event"
    done
    if [[ -z $missing_events ]]; then
        report ok "settings.json runs session-state.sh on the six events"
    else
        report fail "settings.json misses session-state.sh on:$missing_events" "add {\"type\": \"command\", \"command\": \"bash ~/.claude/hooks/session-state.sh\"} under hooks.<event>"
    fi
    if [[ -x $(readlink -f "$HOME/.claude/statusline-command.sh") ]]; then report ok "status line script resolves"; else report fail "~/.claude/statusline-command.sh does not resolve" "cd ~/agent-cockpit/config && stow --no-folding -t ~ --restow claude"; fi
    echo "bar"
    if pgrep -x waybar >/dev/null; then report ok "waybar running"; else report fail "waybar not running" "waybar &"; fi
    if pgrep -f workspace-listener.sh >/dev/null; then report ok "workspace listener running"; else report fail "workspace-listener.sh not running" "pkill -x -SIGUSR2 waybar (reload) and check custom/workspace-listener in config.jsonc"; fi
    local wanted=1; "$ON_CLAUDE_WORKSPACE" && wanted=0
    if [[ $(cat "${XDG_RUNTIME_DIR:-/tmp}/waybar-visible" 2>/dev/null || echo 1) == "$wanted" ]]; then report ok "bar visibility matches the workspace"; else report fail "bar visibility state out of step" "$HOME/.config/waybar/scripts/waybar-visibility.sh sync"; fi
    echo "tmux"
    # pacman can replace the local patch without changing tmux's reported version.
    local fingerprint="$HOME/.config/tmux/border-junction.sha256" expected_digest actual_digest tmux_binary
    expected_digest=$(cat "$fingerprint" 2>/dev/null) || expected_digest=""
    if [[ ! $expected_digest =~ ^[0-9a-f]{64}$ ]]; then
        report fail "tmux border-junction fix: fingerprint missing or invalid" "restore $fingerprint from the reviewed dotfiles"
    else
        tmux_binary=$(type -P tmux) || tmux_binary=""
        actual_digest=$(sha256sum -- "$tmux_binary" 2>/dev/null) || actual_digest=""
        if [[ ${actual_digest%% *} == "$expected_digest" ]]; then
            report ok "tmux border-junction fix verified"
        else
            report fail "tmux border-junction fix: binary replaced or unreadable" "review packages/tmux/top-border-junction.patch and reinstall patched tmux; update $fingerprint only after verifying the fix"
        fi
    fi
    if [[ $(tmux show -gv window-size 2>/dev/null) == latest ]]; then report ok "window-size latest"; else report fail "tmux window-size is not latest" "tmux source ~/.config/tmux/tmux.conf"; fi
    if [[ $(tmux show -sv set-clipboard 2>/dev/null) == on ]]; then report ok "set-clipboard on (opencode's copy reaches the clipboard)"; else report fail "tmux set-clipboard is not on: opencode's copy reaches no clipboard" "tmux source ~/.config/tmux/tmux.conf"; fi
    if tmux list-keys -T root 2>/dev/null | grep -q ' root *Left .*cockpit-left'; then report ok "Left goes to the column from the start of the prompt only"; else report fail "Left in the session pane is not cockpit-left's" "tmux source ~/.config/tmux/tmux.conf"; fi
    echo "manager"
    if tmux has-session -t "=$MANAGER" 2>/dev/null; then
        report ok "manager tmux session exists"
        if [[ $(tmux display-message -p -t "$(sidebar_pane)" '#{pane_dead}' 2>/dev/null) == 0 ]]; then report ok "sidebar alive"; else report fail "sidebar pane dead" "cockpit reload"; fi
        if [[ -n $(viewer_pane) ]]; then report ok "viewer pane tagged"; else report fail "manager panes lack role tags" "tmux kill-session -t $MANAGER; cockpit prepare"; fi
    else
        report fail "manager tmux session missing" "cockpit prepare (systemctl --user start cockpit.service)"
    fi
    local usage="${XDG_RUNTIME_DIR:-/tmp}/claude-usage.json"
    if [[ -f $usage ]] && (( $(date +%s) - $(stat -c %Y "$usage") < 900 )); then report ok "usage cache fresh"; else report fail "usage cache missing or stale" "$HOME/.config/waybar/scripts/claude-usage.sh five_hour (needs the OAuth token in ~/.claude/.credentials.json)"; fi
    echo "services and updates"
    local unit
    # Sessions frozen by game-performance during a game; still listed with no game means a missed thaw.
    if [[ -s ${XDG_RUNTIME_DIR:-/tmp}/game-performance.frozen ]] && ! pgrep -x gamemoded >/dev/null; then
        report fail "agent sandboxes still paused after a game" "game-performance off"
    fi
    for unit in claude-update.timer elephant.service walker.service; do
        if [[ $(systemctl --user is-active "$unit" 2>/dev/null) == active ]]; then report ok "$unit active"; else report fail "$unit not active" "systemctl --user reset-failed $unit; systemctl --user enable --now $unit"; fi
    done
    local versions_dir=${CLAUDE_VERSIONS_DIR:-$HOME/.local/share/claude/versions} link=${CLAUDE_LINK:-$HOME/.local/bin/claude} newest linked
    # || true: no version there (grep matches nothing) must not stop the doctor half-way (pipefail).
    newest=$(find "$versions_dir" -maxdepth 1 -type f -executable -printf '%f\n' 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)
    linked=$(basename "$(readlink "$link" 2>/dev/null || true)")
    if [[ -z $newest || $linked == "$newest" ]]; then report ok "claude starts the newest version (${linked:-none})"; else report fail "claude starts $linked, $newest is in the versions folder" "claude-update (claude-update.timer runs it every 6 h)"; fi
    local archive="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/usage.sqlite" newest_transcript
    newest_transcript=$(find "${COCKPIT_TRANSCRIPTS:-$HOME/.claude/projects}" -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 || true)
    newest_transcript=${newest_transcript%.*}
    if [[ -f $archive ]] && (( $(stat -c %Y "$archive") + 600 >= ${newest_transcript:-0} )); then report ok "usage archive up to date"; else report fail "usage archive missing or behind the transcripts" "cockpit reload (the sidebar keeps it), or cockpit-sidebar costs"; fi
    local recent_facts
    recent_facts=$(find "$HOME/.cache/claude" -maxdepth 1 -name 'statusline-*.json' -mmin -60 2>/dev/null || true)
    if [[ -z $recent_facts ]] || jq -e 'select(.effort != null)' $recent_facts >/dev/null 2>&1; then report ok "status line reports the effort"; else report fail "status line reports no effort" "install .handoff/claude/statusline-command.sh"; fi
    if command -v ask-to-run >/dev/null && command -v cockpit-run-approve >/dev/null; then report ok "ask-to-run and cockpit-run-approve resolve"; else report fail "ask-to-run or cockpit-run-approve not on PATH" "cd ~/agent-cockpit/config && stow --no-folding -t ~ --restow bin"; fi
    if command -v ask-to-guide >/dev/null && command -v cockpit-guide >/dev/null && command -v kitten >/dev/null; then report ok "ask-to-guide, cockpit-guide and kitten resolve"; else report fail "ask-to-guide, cockpit-guide or kitten not on PATH" "cd ~/agent-cockpit/config && stow --no-folding -t ~ --restow bin"; fi
    if grep -qs "this terminal" "$HOME/.config/fish/functions/claude.fish"; then report ok "claude asks manager or terminal"; else report fail "fish claude function missing or the old one (~/.config/fish/functions/claude.fish)" "make -C ~/agent-cockpit install"; fi
    local agent
    for agent in "${AGENTS[@]}"; do
        if declare -F "agent_${agent}_doctor" >/dev/null; then "agent_${agent}_doctor"; fi
    done
    echo "logs"
    local since errors last_error
    since=$(date -d '24 hours ago' -Iseconds)
    # The health check's own result is left out: it runs this doctor, and its last failure would
    # fail the next run for a day.
    errors=$(awk -v since="$since" '$1 >= since && $2 == "ERROR" && $3 != "health:"' "$LOG_FILE" 2>/dev/null | wc -l)
    last_error=$(awk -v since="$since" '$1 >= since && $2 == "ERROR" && $3 != "health:"' "$LOG_FILE" 2>/dev/null | tail -1)
    if (( errors == 0 )); then report ok "no error logged in 24 h ($LOG_FILE)"; else report fail "$errors error(s) logged in 24 h, the last: ${last_error:0:160}" "cockpit logs"; fi
    echo "pane heuristics (what the daemon sees for each running session, and the process that keeps it alive)"
    if [[ -s $SNAPSHOT ]]; then
        while IFS=$'\t' read -r session project state pane; do
            local alive seen
            alive=$(osd liveness "$session" "$pane")
            [[ -n $pane ]] || { printf '  %-24s hook says %-9s no tmux pane     process %s\n' "$project" "$state" "$alive"; continue; }
            seen=$(tmux capture-pane -p -t "$pane" -S -20 2>/dev/null | osd classify)
            printf '  %-24s hook says %-9s pane shows %-9s process %s\n' "$project" "$state" "$seen" "$alive"
        done < <(jq -r '.sessions[] | [.session, .project, .state, (.tmux_pane // "")] | @tsv' "$SNAPSHOT")
    else
        echo "  no session tracked"
    fi
    (( failures == 0 )) && echo "all good" && return 0
    echo "$failures problem(s)"
    # Its findings are in its output: as an ERROR, its exit would start a repair session from the
    # error hand-off and fail the next doctor's log check for a day.
    if [[ $log_command == doctor ]]; then log_failure_level=WARN; fi
    return 1
}

# Parallel sessions on one repository each get their own clone, so they never edit the same files.
# A clone, not a git worktree: greywall mounts only the folder a session starts in, and a worktree
# keeps its metadata in the main repository's .git, which the sandbox would not see. A local clone
# hardlinks the objects (fast, little disk) and is self-contained; origin points at the real
# remote. Clones live in $CLONES_DIR/<repository>/<name>; the registry and the sidebar name such a
# session after <repository>. A clone shares its repository's Docker daemon (agent-docker), whose
# socket for clones is $CLONES_DIR/<repository>/.agent-docker/docker.sock.
CLONES_DIR="${COCKPIT_CLONES:-$HOME/IdeaProjects/.parallel}"
GREYWALL="${COCKPIT_GREYWALL:-$HOME/.local/bin/greywall}"

# The repository a clone is filed under: a clone of a clone (+ on a card that runs in one) still
# belongs to the first repository.
clone_repository() { # repository-top
    case $1 in
        "$CLONES_DIR"/*/*) local inside=${1#"$CLONES_DIR"/}; echo "${inside%%/*}" ;;
        *) basename "$1" ;;
    esac
}

clone_for() { # source-dir name -> prints the clone's path, created on first use
    local source=$1 name=$2 top repository clone origin
    top=$(git -C "$source" rev-parse --show-toplevel) || return 1
    repository=$(clone_repository "$top")
    clone="$CLONES_DIR/$repository/$name"
    if [[ ! -d $clone/.git ]]; then
        mkdir -p "$CLONES_DIR/$repository"
        # --no-local: objects are copied through git's own transport, never hard-linked or borrowed.
        git clone --quiet --no-local "$top" "$clone" >&2 || return 1
        if origin=$(git -C "$top" remote get-url origin 2>/dev/null); then
            git -C "$clone" remote set-url origin "$origin"
        fi
        # A pull request's clone gets someone else's code (its .claude/settings.json hooks, its
        # CLAUDE.md): Claude Code's trust dialog must ask about it, never inherit the yes.
        # Its hooks too: out here, git fetches and switches a pull request's head in it.
        if [[ $name != pr-* ]]; then
            inherit_trust "$top" "$clone"
            install_lefthook_hooks "$clone"
        fi
        set_aside_claude_memory "$clone"
    fi
    printf '%s\n' "$clone"
}

# A session started before this clone existed could write the clone's folder in ~/.claude/projects
# (the launcher protects only the folders there when a sandbox starts) and plant memory the clone's
# first session would load as Theo's own: memory found for a fresh clone is set aside, never loaded
# (security audit 2026-10-19, H2).
set_aside_claude_memory() { # clone-dir
    local memory="$HOME/.claude/projects/${1//[^A-Za-z0-9]/-}/memory"
    [[ -e $memory ]] || return 0
    mv "$memory" "$memory.set-aside-$(date +%s)"
    log_event WARN sessions "memory found for the fresh clone $1 was set aside: $memory.set-aside-*"
}

# Sessions cannot write .git/hooks (greywall mounts it read-only: a planted hook would run out
# here), so the `lefthook install` of a session's pnpm install fails and its commits would skip
# the checks. A fresh clone gets them here instead: one hook per git hook its lefthook config
# names, each running the clone's own lefthook at commit time, as lefthook's generated hook does.
# The hooks are this script's text, never the clone's: only hook names are read from the config.
# Only while the clone is fresh: a session could later replace .git/hooks with a symlink.
LEFTHOOK_GIT_HOOKS=(applypatch-msg pre-applypatch post-applypatch pre-commit pre-merge-commit
    prepare-commit-msg commit-msg post-commit pre-rebase post-checkout post-merge pre-push
    pre-auto-gc post-rewrite reference-transaction push-to-checkout sendemail-validate post-index-change)

install_lefthook_hooks() { # clone-dir
    local clone=$1 config="" candidate hook installed=()
    for candidate in lefthook.yml .lefthook.yml lefthook.yaml .lefthook.yaml; do
        if [[ -f $clone/$candidate && ! -L $clone/$candidate ]]; then config=$clone/$candidate; break; fi
    done
    [[ -n $config ]] || return 0
    mkdir -p "$clone/.git/hooks"
    for hook in "${LEFTHOOK_GIT_HOOKS[@]}"; do
        grep -qE "^${hook}:" "$config" || continue
        lefthook_hook_script "$hook" > "$clone/.git/hooks/$hook"
        chmod 755 "$clone/.git/hooks/$hook"
        installed+=("$hook")
    done
    log_event INFO sessions "lefthook hooks installed in $clone: ${installed[*]:-none named in $(basename "$config")}"
}

lefthook_hook_script() { # hook
    printf '#!/bin/sh\n# Installed by cockpit when this parallel clone was created.\nhook=%s\n' "$1"
    cat <<'EOF'
[ "$LEFTHOOK" = "0" ] && exit 0
dir=$(git rev-parse --show-toplevel)
platform="$(uname | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/aarch64/arm64/;s/x86_64/x64/')"
if [ -n "$LEFTHOOK_BIN" ]; then
    exec "$LEFTHOOK_BIN" run "$hook" "$@"
elif lefthook -h >/dev/null 2>&1; then
    exec lefthook run "$hook" "$@"
fi
for lefthook in "$dir/node_modules/lefthook-$platform/bin/lefthook" \
    "$dir/node_modules/@evilmartians/lefthook/bin/lefthook-$platform/lefthook" \
    "$dir/node_modules/lefthook/bin/index.js"; do
    [ -f "$lefthook" ] && exec "$lefthook" run "$hook" "$@"
done
echo "lefthook not found: run pnpm install, or its $hook checks are skipped" >&2
EOF
}

# A fresh clone holds the same files as its source, so a source Claude already trusts makes the
# clone trusted too: no trust prompt on each parallel session. An untrusted source leaves the prompt.
# Claude rewrites ~/.claude.json while it runs, and losing a race only brings the prompt back.
# Running sandboxes bind-mount the file itself: one moved over it is a new inode they never see,
# and their own writes land in the old one. So the update goes over the same inode, without
# truncating first: Claude reading an empty file would start over from blank settings.
CLAUDE_CONFIG_FILE="$HOME/.claude.json"

inherit_trust() { # source-dir clone-dir
    local updated
    jq -e --arg source "$1" '.projects[$source].hasTrustDialogAccepted == true' "$CLAUDE_CONFIG_FILE" >/dev/null 2>&1 || return 0
    if ! updated=$(mktemp "$CLAUDE_CONFIG_FILE.XXXXXX"); then
        log_event WARN sessions "could not mark $2 as trusted: no temp file next to $CLAUDE_CONFIG_FILE"
        return 0
    fi
    if jq --arg clone "$2" '.projects[$clone].hasTrustDialogAccepted = true' "$CLAUDE_CONFIG_FILE" > "$updated" \
        && dd if="$updated" of="$CLAUDE_CONFIG_FILE" conv=notrunc status=none \
        && truncate -s "$(stat -c %s "$updated")" "$CLAUDE_CONFIG_FILE"; then
        rm -f "$updated"
    else
        rm -f "$updated"
        log_event WARN sessions "could not mark $2 as trusted in $CLAUDE_CONFIG_FILE"
    fi
}

# A failure in the background (the sidebar runs these without a terminal) shows in the viewer.
show_failure() { # message
    log_event ERROR manager "$1"
    ensure_manager
    tmux respawn-pane -k -t "$(viewer_pane)" sh -c 'printf "\n  ✗ %s\n\n  any key closes this pane " "$1"; read -r _' sh "$1"
}

# A new session on its own branch, in its own clone of the repository (the sidebar's +).
parallel_session() { # dir branch [prompt: its first message, the Todo panel's N]
    local directory=$1 branch=$2 prompt=${3:-} clone
    require_plain_directory "$directory"
    if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
        show_failure "not a branch name: $branch"; return 1
    fi
    if ! clone=$(clone_for "$directory" "${branch//\//-}" 2>&1); then
        show_failure "could not clone $directory: $clone"; return 1
    fi
    # The clone may be one a session already ran in, with a .git/config it could write: git runs
    # inside greywall there, as for lazygit.
    git_in_sandbox "$clone" switch --quiet -c "$branch" 2>/dev/null || git_in_sandbox "$clone" switch --quiet "$branch"
    if [[ -z $prompt ]]; then
        new_session "$clone" && focus_viewer
        return
    fi
    [[ $prompt == -* ]] && prompt="Task: $prompt" # never an option of the agent's
    # Out of sight, as a card of its own: started in the session pane, it replaced the session on
    # screen and cleared it, and the Todo panel it was sent from lost its project (all projects shown).
    "agent_${launch_agent}_detached" "$clone" "$prompt"
}

chief_start_session() { # reserved-session-id dedicated-directory
    local session=$1 directory=$2 model
    if [[ $launch_agent != opencode || $directory != "$HOME/IdeaProjects/cockpit-chief" || $directory == *'#'* ]] || ! agent_opencode_is_session_id "$session"; then
        echo "cockpit: Chief needs its reserved OpenCode identity and dedicated folder" >&2; return 2
    fi
    if [[ -L $HOME/IdeaProjects || -L $directory ]]; then
        echo "cockpit: refusing a symlink for the Chief folder" >&2; return 2
    fi
    mkdir -p -- "$directory" || return 2
    model=$(opencode_default_model) || return 2
    # Once tmux is called, an error is uncertain: it may have created the session already.
    start_opencode "$directory" "$session" "$model" --prompt 'You are the dedicated Cockpit Chief session. Wait for the protected Chief grant and its bootstrap instructions before coordinating work. Do not take project todos or infer permissions from this startup message.' >/dev/null || return 3
}

# A teammate Theo approved, started by the OSD daemon: Designer or Developer out of sight in the
# asking session's folder; QA in a fresh copy at exactly the handed-off commit. The brief is the
# new session's first message, labelled as the asking agent's text Theo approved.
team_spawn_session() { # token role dir commit|- brief
    local token=$1 role=$2 directory=$3 commit=$4 brief=$5 clone
    if [[ ! $token =~ ^[0-9a-f]{32}$ ]]; then echo "cockpit: team-spawn needs a 32-character team token" >&2; return 2; fi
    case $role in
        designer | developer) [[ $commit == - ]] || { echo "cockpit: only QA starts at a commit" >&2; return 2; } ;;
        qa) [[ $commit =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || { echo "cockpit: QA needs the full handed-off commit" >&2; return 2; } ;;
        *) echo "cockpit: team-spawn role is designer, developer or qa" >&2; return 2 ;;
    esac
    [[ -n ${brief//[[:space:]]/} && $brief != -* ]] || { echo "cockpit: team-spawn needs a brief that is not an option" >&2; return 2; }
    require_plain_directory "$directory" || return 1
    audit_event manager session.team_spawn ok "role=$role" "directory=$directory" "agent=$launch_agent"
    launch_team_spawn=$token
    # The daemon's brief arrives labelled (who wrote it, what Theo approved); it never starts with "-".
    if [[ $role != qa ]]; then
        "agent_${launch_agent}_background" "$directory" "$brief"
        return
    fi
    # A folder per start: a copy another QA had, with its leftovers, is no fresh copy at the commit.
    local name="qa-${commit:0:12}-${token:0:8}" top
    top=$(git -C "$directory" rev-parse --show-toplevel) || return 1
    # An agent's handoff makes the host clone this folder, which its session could rewrite: only a
    # plain repository, holding its own objects (no .git file pointing elsewhere, no alternates).
    if [[ ! -d $top/.git || -L $top/.git || -e $top/.git/objects/info/alternates ]]; then
        echo "cockpit: $top is not a plain repository with its own objects; QA is not copied from it" >&2
        return 1
    fi
    if [[ -e $CLONES_DIR/$(clone_repository "$top")/$name ]]; then
        echo "cockpit: $name already exists; QA starts only in a fresh copy" >&2
        return 1
    fi
    clone=$(clone_for "$directory" "$name") || { echo "cockpit: could not copy $directory for QA" >&2; return 1; }
    git_in_sandbox "$clone" switch --quiet --detach "$commit" || { echo "cockpit: commit $commit is not in $directory" >&2; return 1; }
    "agent_${launch_agent}_detached" "$clone" "$brief"
}

git_in_sandbox() { # dir git-arguments...
    local directory=$1
    shift
    # Drift merges rewrite the stowed, reviewed profile and dirty the running copy.
    (cd "$directory" && GREYWALL_NO_PROMPT=1 "$GREYWALL" --auto-profile --profile claude -- git "$@")
}

# A session reviewing pull request <number>, at its head in a clone (the sidebar's c on a
# pull request).
review_session() { # dir number
    local directory=$1 number=$2 clone
    require_plain_directory "$directory"
    if [[ ! $number =~ ^[0-9]+$ ]]; then
        show_failure "not a pull request number: $number"; return 1
    fi
    # Always a fresh clone: fetching needs the network and Theo's credentials, so git runs out here,
    # and out here it must never run in a clone a session could have written (.git/config). A
    # pull request reviewed before gets pr-<number>-<time>; K deletes the old ones.
    local name="pr-$number" top repository
    top=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || { show_failure "not a repository: $directory"; return 1; }
    repository=$(clone_repository "$top")
    if [[ -e $CLONES_DIR/$repository/$name ]]; then name="pr-$number-$(date +%Y%m%d-%H%M%S)"; fi
    if ! clone=$(clone_for "$directory" "$name" 2>&1); then
        show_failure "could not clone $directory: $clone"; return 1
    fi
    if ! git -C "$clone" fetch --quiet origin "pull/$number/head" 2>/dev/null || ! git -C "$clone" switch --quiet --detach FETCH_HEAD; then
        show_failure "could not fetch pull request #$number from $(git -C "$clone" remote get-url origin)"; return 1
    fi
    local prompt="Review pull request #$number of this repository (its head is checked out here): read the diff against its base branch, run the relevant tests, and report problems by severity with file and line. Do not push, and do not comment on GitHub."
    new_session_with_prompt "$clone" "$prompt"
}

# The clones left by + and by pull request reviews, in a popup (the clones action of the sidebar's
# : list): each one with no session in it, no uncommitted change and no commit missing from its
# remote can go, after a y. The daily sweep (clones-sweep) deletes the same ones without asking.
clones_popup() {
    tmux display-popup -E -w 80% -h 70% -T " clones " "$0" clones-review
}

# What a clone holds that exists nowhere else: "changes", "commits", or nothing. git runs inside
# greywall, as for lazygit: the clone's .git/config is the session's to write (core.fsmonitor,
# filters), and out here git would run what it names. Its answer only decides whether to keep.
clone_leftovers() { # clone
    local report name clone
    if IFS=$'\t' read -r name clone < <(reviewed_clone_of "$1"); then
        report=$(reviewed_clone_report "$1" "$(live_checkout_of "$name")") || { echo "unreadable"; return; }
    else
        report=$(cd "$1" && GREYWALL_NO_PROMPT=1 "$GREYWALL" --auto-profile --profile claude -- sh -c \
            'git status --porcelain 2>/dev/null | head -1; echo "-- commits"; git log --branches --not --remotes --oneline 2>/dev/null | head -1' 2>/dev/null) \
            || { echo "unreadable"; return; }
    fi
    if [[ ${report%%-- commits*} == *[![:space:]]* ]]; then echo "changes"
    elif [[ ${report#*-- commits} == *[![:space:]]* ]]; then echo "commits"
    fi
}

# A reviewed clone's commits reach live main through git am, with new hashes, never through a push:
# its branches are compared with a fresh fetch of live main by change (patch id), as apply-run and
# the card's counter do. Without that, every clone whose work was applied stayed forever.
reviewed_clone_report() { # clone live
    # shellcheck disable=SC2016
    (cd "$1" && GREYWALL_NO_PROMPT=1 "$GREYWALL" --auto-profile --profile claude --allow-read-path "$2" -- sh -c '
        git status --porcelain 2>/dev/null | head -1
        echo "-- commits"
        git fetch -q "$1" +main:refs/remotes/origin/main || exit 1
        git for-each-ref --format="%(refname)" refs/heads | while read -r branch; do
            git log --cherry-pick --right-only --no-merges --oneline "refs/remotes/origin/main...$branch"
        done | head -1' sh "$2" 2>/dev/null)
}

clones_review() { # [sweep]
    local sweep=${1:-} clones_root clone real in_use asleep_in_use leftovers removable=() line answer
    clones_root=$(realpath -e "$CLONES_DIR" 2>/dev/null) || {
        echo "No clones ($CLONES_DIR does not exist)."
        [[ -n $sweep ]] || read -r -p "Enter closes. " _
        return 0
    }
    # Without the session list no clone is known to be free (right after login the sweep can
    # start before the manager writes it): keep every clone, and succeed.
    if ! in_use=$(jq -r '.sessions[]?.cwd // empty' "$SNAPSHOT" 2>/dev/null); then
        echo "The session list is not readable yet ($SNAPSHOT): nothing deleted."
        [[ -n $sweep ]] || read -r -p "Enter closes. " _ || true
        return 0
    fi
    # An asleep session wakes in its folder, so a clone it names is not one to delete.
    asleep_in_use=$(jq -r '.cwd // empty' "$ASLEEP_DIR"/* 2>/dev/null || true)
    echo "Clones in $CLONES_DIR"
    echo
    for clone in "$clones_root"/*/*/; do
        clone=${clone%/}
        [[ -d $clone/.git && ! -L $clone ]] || continue
        line="  $(basename "$(dirname "$clone")")/$(basename "$clone")"
        if grep -qxF -- "$clone" <<< "$in_use"; then
            echo "$line: kept, a session runs in it"
            continue
        fi
        if grep -qxF -- "$clone" <<< "$asleep_in_use"; then
            echo "$line: kept, a session sleeps in it"
            continue
        fi
        leftovers=$(clone_leftovers "$clone")
        case $leftovers in
            changes) echo "$line: kept, uncommitted changes" ;;
            commits) echo "$line: kept, commits not on its remote" ;;
            unreadable) echo "$line: kept, could not be checked" ;;
            *) echo "$line: can go"; removable+=("$clone") ;;
        esac
    done
    echo
    if (( ${#removable[@]} == 0 )); then
        [[ -n $sweep ]] || read -r -p "Nothing to delete. Enter closes. " _
        return 0
    fi
    if [[ -z $sweep ]]; then
        read -r -p "Delete the ${#removable[@]} clone(s) that can go? [y/N] " answer || answer=""
        [[ $answer == y || $answer == Y ]] || { echo "Nothing deleted."; return 0; }
    fi
    for clone in "${removable[@]}"; do
        # Only a folder two levels under the clones folder, reached without a symlink.
        real=$(realpath -e "$clone" 2>/dev/null) || continue
        [[ $real == "$clones_root"/*/* && $real != "$clones_root"/*/*/* && ! -L $clone ]] || { echo "  refused: $clone"; continue; }
        rm -rf -- "$real" && echo "  deleted $(basename "$(dirname "$real")")/$(basename "$real")"
        rmdir -- "$(dirname "$real")" 2>/dev/null || true
    done
    log_event INFO sessions "clones: deleted ${#removable[@]}${sweep:+ by the daily sweep}"
    [[ -n $sweep ]] || read -r -p "Enter closes. " _ || true
}

# The pull requests window (Super+Ctrl+P, the sidebar's P), on the cockpit only: hidden again
# when it shows; otherwise opened on the pull request list of the repository of the session in
# the pane, or as it was (the review requests) when that session has no GitHub origin.
prs_window() {
    "$ON_CLAUDE_WORKSPACE" || return 0
    local shown directory origin repository
    shown=$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .specialWorkspace.name // ""')
    if [[ $shown == special:prs ]]; then
        hyprctl dispatch 'hl.dsp.workspace.toggle_special("prs")' >/dev/null
        return
    fi
    directory=$(session_field "$(cat "$CURRENT" 2>/dev/null || true)" cwd)
    origin=$( [[ -n $directory ]] && git "${SAFE_GIT_CONFIG[@]}" -C "$directory" remote get-url origin 2>/dev/null || true)
    if [[ $origin =~ github\.com[:/]([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$ ]]; then
        repository=${BASH_REMATCH[1]%.git}
        hyprctl eval "OPEN_IN_SCRATCHPAD(\"prs\", \"https://github.com/$repository/pulls\")" >/dev/null
    else
        hyprctl eval 'TOGGLE_SCRATCHPAD("prs")' >/dev/null
    fi
}

# The approval of a run request (claude-run-<id>, the daemon starts it) in a pane under the
# session pane. It takes the cursor when Theo is in the session pane, not when he is in the
# column (the other sessions stay usable there; Ctrl+Tab reaches it).
# "close <id>" forgets that one. Nothing happens when the manager does not run.
# The requests needing input, one line each ("<id> <session>"): several sessions can each have one.
# Running commands are removed until they ask for input again. The pane under the
# session pane shows the session on screen's own (view_session and place_approval follow it), and
# carries the run it shows in @run.
APPROVAL_STATE="${XDG_RUNTIME_DIR:-/tmp}/cockpit-approval"

approval_pane() { # id | close [id]
    tmux has-session -t "=$MANAGER" 2>/dev/null || return 0
    if [[ $1 == close ]]; then
        attention_answered "${2:-}"
        if [[ -n ${2:-} ]]; then forget_approval "$2"; else rm -f "$APPROVAL_STATE"; fi
        place_approval
        return 0
    fi
    [[ $1 =~ ^[0-9a-f]{12}$ ]] || { echo "cockpit: not a run request id: $1" >&2; return 1; }
    # The session the daemon's copy of the request names (ask-to-run sets it from inside the
    # sandbox): it only decides under which session the pane shows; the command and its project
    # show in the pane.
    local session
    session=$(jq -r '.session // empty' "$REQUESTS_DIR/$1.request" 2>/dev/null || true)
    # Any agent's id: an opencode session's request recorded with none showed under every session
    # (and a window started meanwhile at the viewer's height plus this pane's showed taller).
    is_session_id "$session" || session=""
    forget_approval "$1"
    printf '%s %s\n' "$1" "$session" >> "$APPROVAL_STATE"
    place_approval focus
}

forget_approval() { # id
    [[ -f $APPROVAL_STATE ]] || return 0
    local others
    others=$(grep -v "^$1 " "$APPROVAL_STATE" || true)
    if [[ -n $others ]]; then printf '%s\n' "$others" > "$APPROVAL_STATE"; else rm -f "$APPROVAL_STATE"; fi
}

# The approval to show under session <id>: the latest it asked that still runs (or one that names
# no session); nothing otherwise.
approval_for() { # id
    local run session found=""
    [[ -f $APPROVAL_STATE ]] || return 0
    while read -r run session; do
        tmux has-session -t "=claude-run-$run" 2>/dev/null || continue
        if [[ -z $session || $session == "$1" ]]; then found=$run; fi
    done < "$APPROVAL_STATE"
    [[ -n $found ]] && echo "$found"
    return 0
}

# The approval pane under the session pane shows the approval of the session on screen, or goes.
# "focus": Theo in the session pane gets the cursor moved to it (claude-run-approve drops what he
# typed in the first half second, and Decline is the default); in the column it stays put.
place_approval() { # [focus]
    local current run pane shown was_in_session
    current=$(cat "$CURRENT" 2>/dev/null || true)
    run=$(approval_for "$current")
    pane=$(pane_by_role approval)
    if [[ -n $pane ]]; then
        shown=$(tmux show-options -pqv -t "$pane" @run 2>/dev/null || true)
        [[ -n $run && $shown == "$run" ]] && return 0
        if [[ $(tmux display-message -p -t "$pane" '#{pane_active}' 2>/dev/null) == 1 ]]; then
            tmux select-pane -t "$(viewer_pane)"
        fi
        # The pane closes itself when its approval ends (remain-on-exit off): already gone is fine.
        tmux kill-pane -t "$pane" 2>/dev/null || true
    fi
    [[ -n $run ]] || return 0
    was_in_session=$(tmux display-message -p -t "$(viewer_pane)" '#{pane_active}' 2>/dev/null || true)
    pane=$(tmux split-window -v -d -l 40% -t "$(viewer_pane)" -P -F '#{pane_id}' env -u TMUX tmux attach-session -t "=claude-run-$run")
    tag_approval_pane "$pane" "$run"
    if [[ ${1:-} == focus && $was_in_session == 1 ]]; then tmux select-pane -t "$pane"; fi
}

# Gone with its approval even when no "close" comes (the daemon restarted meanwhile): no dead
# pane left. @run says which approval it shows.
tag_approval_pane() { # pane run
    tag_pane "$1" approval
    tmux set-option -p -t "$1" remain-on-exit off ";" set-option -p -t "$1" @run "$2"
}

# lazygit on a session's repository in a popup over the manager (the sidebar's g): review and
# commit what Claude did without leaving the cockpit; q closes it.
# lazygit runs inside greywall, like a session: git reads the repository's own configuration, which
# a session can write (core.fsmonitor, filters), and out here that would run as Theo. Its settings
# and state live in a folder of their own, the only one it may write besides the repository.
git_popup() { # dir
    local directory=$1 lazygit_home="$HOME/.cache/lazygit-sandbox"
    require_plain_directory "$directory"
    mkdir -p "$lazygit_home/config/lazygit" "$lazygit_home/state"
    if [[ -f $HOME/.config/lazygit/config.yml ]]; then cp "$HOME/.config/lazygit/config.yml" "$lazygit_home/config/lazygit/config.yml"; fi
    tmux display-popup -E -w 92% -h 92% -d "$directory" -T " lazygit · $(basename "$directory") · push with U in the column " \
        env GREYWALL_NO_PROMPT=1 XDG_CONFIG_HOME="$lazygit_home/config" XDG_STATE_HOME="$lazygit_home/state" GIT_SSL_CAINFO="$HOME/.cache/agent-ca/bundle.pem" \
        "$HOME/.local/bin/greywall" --auto-profile --profile claude --allow-path "$lazygit_home" -- lazygit
}

# Pushing the session's branch (the sidebar's U), in a popup: lazygit runs inside greywall, which
# has no SSH key and no agent, so it cannot push. This git runs out here, with Theo's key, in a
# folder a session works in. Greywall mounts .git/config and .git/hooks read-only in the folder a
# session starts in, but a session started in a subfolder, or one that replaced its .git, is not
# covered: every git out here takes SAFE_GIT_CONFIG, which resets the settings that run a program
# (security audit 2026-10-19, H1).
push_popup() { # dir
    require_plain_directory "$1"
    local name clone
    # A reviewed clone's commits reach its running copy through apply, never a push.
    if IFS=$'\t' read -r name clone < <(reviewed_clone_of "$1"); then
        tmux display-popup -E -w 80% -h 80% -d "$clone" -T " apply · $(basename "$clone") " "$0" apply-run "$clone"
        return
    fi
    tmux display-popup -E -w 70% -h 50% -d "$1" -T " push · $(basename "$1") " "$0" push-run "$1"
}

# The repositories whose running copy the host runs with Theo's rights: sessions work in clones
# (the work clone ~/IdeaProjects/<name>, or <clones>/<name>/<clone>), and the running copy only
# takes their commits through apply, after Theo read them (security audit 2026-10-19, C1).
REVIEWED_REPOSITORIES=(dotfiles agent-cockpit vitals)

live_checkout_of() { # name
    if [[ $1 == dotfiles ]]; then printf '%s\n' "$DOTFILES_LIVE"; else printf '%s\n' "$HOME/$1"; fi
}

work_clone_of() { # name
    if [[ $1 == dotfiles ]]; then printf '%s\n' "$DOTFILES_WORK"; else printf '%s\n' "$HOME/IdeaProjects/$1"; fi
}

# The reviewed clone a folder is in: prints "<repository>\t<clone root>"; fails for any other folder.
reviewed_clone_of() { # dir
    local name work inside clone_name
    for name in "${REVIEWED_REPOSITORIES[@]}"; do
        work=$(work_clone_of "$name")
        case "$1/" in
            "$work"/*)
                inside_another_checkout "$1" "$work" && return 1
                printf '%s\t%s\n' "$name" "$work"; return 0 ;;
            "$CLONES_DIR/$name"/*/*)
                inside=${1#"$CLONES_DIR/$name"/}
                clone_name=${inside%%/*}
                [[ $clone_name =~ ^[A-Za-z0-9._-]+$ && $clone_name != . && $clone_name != .. &&
                   -d $CLONES_DIR/$name/$clone_name && ! -L $CLONES_DIR/$name/$clone_name ]] || return 1
                inside_another_checkout "$1" "$CLONES_DIR/$name/$clone_name" && return 1
                printf '%s\t%s\n' "$name" "$CLONES_DIR/$name/$clone_name"
                return 0 ;;
        esac
    done
    return 1
}

# A worktree or repository below a clone's root (.worktrees/<name>) is a checkout of its own: it
# must never be taken for the clone, whose .outgoing it does not own. Paths only, no git.
inside_another_checkout() { # dir clone-root
    local folder=${1%/}
    while [[ $folder == "$2"/* ]]; do
        [[ -e $folder/.git || -L $folder/.git ]] && return 0
        folder=$(dirname "$folder")
    done
    return 1
}

# U on a reviewed clone's card: the commits live main lacks are exported inside greywall (no host
# git runs in a clone), from a fresh fetch of the running copy, leaving out those already applied
# (same change, git am's new hash), then apply shows them and asks.
apply_run() { # clone
    local name clone live
    IFS=$'\t' read -r name clone < <(reviewed_clone_of "$1") || { echo "Refused: $1 is not a reviewed clone." >&2; return 1; }
    live=$(live_checkout_of "$name")
    echo "Exporting the commits $live lacks, inside greywall …"
    # shellcheck disable=SC2016
    if ! (cd "$clone" && GREYWALL_NO_PROMPT=1 "$GREYWALL" --auto-profile --profile claude --allow-read-path "$live" -- sh -c \
            'git fetch -q "$1" main:refs/remotes/origin/main && rm -f .outgoing/*.patch && git format-patch -q --ignore-if-in-upstream -o .outgoing refs/remotes/origin/main' \
            sh "$live"); then
        echo "The export failed (above): nothing applied."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    apply_reviewed "$clone" || true
    # The running copy is a GitHub repository too: what it holds and GitHub lacks (just applied,
    # or applied earlier) goes out from here, after its own list and y/N. Never from the clone,
    # whose origin is the running copy.
    if [[ -n $(git "${SAFE_GIT_CONFIG[@]}" -C "$live" rev-list "@{upstream}..HEAD" 2>/dev/null | head -1) ]]; then
        echo
        push_run "$live" || true
        return 0
    fi
    read -r -p "Enter closes. " _ || true
}

SAFE_GIT_CONFIG=(-c core.hooksPath=/dev/null -c core.sshCommand=ssh -c core.fsmonitor=false -c core.askPass=
                 -c core.gitProxy= -c core.pager=cat -c diff.external= -c credential.helper= -c protocol.ext.allow=never
                 -c protocol.file.allow=never -c remote.origin.receivepack=git-receive-pack)

push_run() { # dir
    local branch url answer
    cd "$1" || return 1
    if ! branch=$(git "${SAFE_GIT_CONFIG[@]}" symbolic-ref --quiet --short HEAD); then
        echo "Not on a branch (detached HEAD): nothing to push."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    url=$(git "${SAFE_GIT_CONFIG[@]}" ls-remote --get-url origin 2>/dev/null)
    # Only GitHub: a remote rewritten to a path or another host is not pushed to from here.
    if [[ ! $url =~ ^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)[A-Za-z0-9._/-]+$ ]]; then
        echo "origin is $url, not a GitHub repository: not pushed."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    # A push URL or a URL rewrite would send the push somewhere other than the URL checked above.
    if git "${SAFE_GIT_CONFIG[@]}" config --local --includes --get-regexp '^(remote\.origin\.pushurl|url\..*\.(push)?insteadof)$' >/dev/null 2>&1; then
        echo "origin has a push URL or a URL rewrite in the repository's configuration: not pushed."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    echo "Push $branch to $url"
    # The commits it sends, when the branch already tracks one (a new branch has no upstream yet).
    git "${SAFE_GIT_CONFIG[@]}" --no-pager log --oneline "@{upstream}..HEAD" 2>/dev/null | head -20 | sed 's/^/  /' || true
    read -r -p "Push? [y/N] " answer || answer=""
    [[ $answer == y || $answer == Y ]] || { echo "Not pushed."; sleep 1; return 0; }
    if git "${SAFE_GIT_CONFIG[@]}" push --set-upstream origin "refs/heads/$branch:refs/heads/$branch"; then
        log_event INFO sessions "pushed $branch of $(basename "$1")"
        audit_event push push.done ok "directory=$1" "branch=$branch" "url=$url"
        # The card's "↑N unpushed" clears now, not at the session's next turn.
        osd-show session-pushed "$1" 2>/dev/null || true
        echo "Pushed."
        read -r -p "Enter closes. " _ || true
    else
        log_event WARN sessions "push of $branch of $(basename "$1") failed"
        audit_event push push.failed failed "directory=$1" "branch=$branch" "url=$url"
        echo "The push failed (above)."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
}

# The dotfiles session works in a clone (DOTFILES_WORK) the host never runs or builds from; the live
# checkout, stowed into ~/.local/bin and ~/.config, only takes its commits here, after Theo read them
# (security audit 2026-10-19, C1). The session exports them as patches (git format-patch into
# .outgoing): plain text, read from a host-only copy, applied with the live repository's own git.
# No host git ever runs inside the clone, whose .git/config the sandbox writes.
DOTFILES_LIVE="${COCKPIT_DOTFILES_LIVE-${CLAUDE_DOTFILES_LIVE:-$HOME/dotfiles}}"
DOTFILES_WORK="${COCKPIT_DOTFILES_WORK-${CLAUDE_DOTFILES_WORK:-$HOME/IdeaProjects/dotfiles}}"

# Whether the patches apply one after the other, as git am takes them: each on top of the ones
# before, in a scratch index, so the live checkout's files and index stay as they are. One
# `git apply --check` of them all held each patch against the unchanged tree and refused a series
# whose later commits edit what earlier ones changed.
patches_apply_in_order() { # live folder-of-patches
    local patch scratch_index="$2/check.index"
    GIT_INDEX_FILE="$scratch_index" git -C "$1" read-tree HEAD || return 1
    for patch in "$2"/*.patch; do
        GIT_INDEX_FILE="$scratch_index" git -C "$1" apply --cached "$patch" || return 1
    done
}

# Work that ships closes its items: each "Todo: <id>" trailer of the applied commits marks that
# item of the running copy's project done, through the queue the column applies (claude-todo's).
# Items stayed open when another session or a duplicate fixed them (todo 4ab912da). Theo read
# the trailers in the patches before his yes; a dotfiles session can mark its items done anyway.
close_shipped_todos() { # live commit-before-the-apply
    local trailer queue="${COCKPIT_TODO_UPDATES-${CLAUDE_TODO_UPDATES:-${XDG_RUNTIME_DIR:-/tmp}/cockpit-todo-updates.jsonl}}"
    while IFS= read -r trailer; do
        [[ -z $trailer ]] && continue
        if [[ ! $trailer =~ ^[0-9a-f]{8}$ ]]; then
            echo "Ignored the trailer \"Todo: $(cat -v <<< "$trailer")\": not an item id (8 hex characters)." >&2
            continue
        fi
        if ! (
            flock -x 9 || exit 1
            jq -nc --arg id "$trailer" --arg folder "$1" '{action: "done", id: $id, started_in: $folder}' >> "$queue"
        ) 9>"$queue.lock"; then
            echo "Could not mark todo $trailer done: cockpit-todo done $trailer" >&2
            continue
        fi
        echo "Todo $trailer marked done."
        log_event INFO apply "todo $trailer marked done by its commit's trailer"
    done < <(git -C "$1" log --format='%(trailers:key=Todo,valueonly,separator=%x0a)' "$2..HEAD" | sort -u)
}

# Hyprland reloads its config whenever one of its files changes. git am writes them one after the
# other, and a reload that read hyprland.lua before the file it requires left Hyprland on its
# emergency binds (todo 7bea5263). Autoreload stays off while git am writes; one reload then reads
# the finished config, which also turns autoreload back on (it is not set there).
pause_hyprland_autoreload() {
    if ! hyprctl eval 'hl.config({ misc = { disable_autoreload = true } })' >/dev/null 2>&1; then
        echo "Could not pause Hyprland's autoreload (is Hyprland running?): if it shows emergency binds afterwards, run hyprctl reload." >&2
        log_event WARN apply "could not pause Hyprland's autoreload before git am"
    fi
}

resume_hyprland_autoreload() { # commit-before-the-apply
    if git -C "$DOTFILES_LIVE" diff --quiet "$1" HEAD -- config/hyprland; then
        hyprctl eval 'hl.config({ misc = { disable_autoreload = false } })' >/dev/null 2>&1 && return 0
        echo "Could not turn Hyprland's autoreload back on: hyprctl reload does." >&2
    else
        echo "Reloading Hyprland …"
        hyprctl reload >/dev/null 2>&1 && return 0
        echo "Could not reload Hyprland: run hyprctl reload." >&2
    fi
    log_event WARN apply "could not resume Hyprland's autoreload after git am"
}

apply_reviewed() { # [clone]
    local name clone live outgoing copies patch subjects answer count before
    local installed=true
    if ! IFS=$'\t' read -r name clone < <(reviewed_clone_of "${1:-$DOTFILES_WORK}"); then
        echo "Refused: ${1:-} is not a reviewed clone (~/IdeaProjects/<repository> or $CLONES_DIR/<repository>/<name>, for ${REVIEWED_REPOSITORIES[*]})." >&2
        return 1
    fi
    live=$(live_checkout_of "$name")
    if [[ ! -d $live/.git || -L $live ]]; then
        echo "Refused: $live, the running copy of $name, is not a git checkout." >&2
        return 1
    fi
    outgoing="$clone/.outgoing"
    if [[ ! -d $outgoing || -L $outgoing ]]; then
        echo "Nothing to apply: no $outgoing (git format-patch origin/main -o .outgoing in the clone)."
        return 0
    fi
    if [[ -n $(find "$outgoing" -mindepth 1 \( ! -type f -o ! -name '*.patch' \) -print -quit) ]]; then
        echo "Refused: $outgoing holds something other than .patch files (a link, a folder)." >&2
        log_event WARN apply "refused: $outgoing holds something other than .patch files"
        return 1
    fi
    copies=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/apply-dotfiles.XXXXXX")
    # shellcheck disable=SC2064
    trap "rm -rf '$copies'" RETURN
    while IFS= read -r -d '' patch; do
        cp --no-dereference -- "$patch" "$copies/"
    done < <(find "$outgoing" -maxdepth 1 -type f -name '*.patch' -print0 | sort -z)
    count=$(find "$copies" -type f | wc -l)
    if (( count == 0 )); then
        echo "Nothing to apply: $outgoing is empty."
        return 0
    fi
    if ! git -C "$live" diff --quiet || ! git -C "$live" diff --cached --quiet; then
        echo "Refused: $live has uncommitted changes; commit or stash them first." >&2
        # Protecting local edits is an expected refusal, not a cockpit error to hand off for repair.
        if [[ $log_command == apply-dotfiles || $log_command == apply ]]; then log_failure_level=WARN; fi
        return 1
    fi
    # Typed answers with the review piped away (cockpit apply … | tail): the patches and the question
    # never reached the screen, and applies waited for hours (todo 0d52ce50). An answer fed on stdin
    # (tests, scripts) has no one to hide them from.
    if [[ -t 0 ]] && { [[ ! -t 1 ]] || [[ ! -t 2 ]]; }; then
        echo "Refused: cockpit apply asks for your yes after showing the patches, but its output goes to a pipe or a file, where you would not see them. Run it without | or a redirection." >&2
        if [[ $log_command == apply-dotfiles || $log_command == apply ]]; then log_failure_level=WARN; fi
        return 1
    fi
    subjects=$(grep -h '^Subject: ' "$copies"/*.patch | sed 's/^Subject: //' | cat -v)
    echo "$count commit(s) for $live, the running copy of $name the host runs:"
    sed 's/^/  /' <<< "$subjects"
    echo
    git -C "$live" apply --stat "$copies"/*.patch
    if ! patches_apply_in_order "$live" "$copies"; then
        echo "They do not apply to $live as it is: rebase the clone on origin/main and export again." >&2
        # A stale export needs its author, not a new cockpit repair session from the error hand-off.
        if [[ $log_command == apply-dotfiles || $log_command == apply ]]; then log_failure_level=WARN; fi
        return 1
    fi
    # Control characters shown, never interpreted: the patches are text a sandbox wrote. less reads
    # a file, not a pipe: q before the end would kill cat, and pipefail the whole command (exit 141).
    # PAGER is cat in the approval window (ask-to-run), which shows the patches as plain output.
    cat -v "$copies"/*.patch > "$copies/review.txt"
    if [[ -t 1 ]]; then ${PAGER:-less} "$copies/review.txt"; else cat "$copies/review.txt"; fi
    read -r -p "Apply these $count commit(s) to $live? [y/N] " answer || answer=""
    if [[ $answer != y && $answer != Y ]]; then
        echo "Not applied."
        log_event INFO apply "declined $count patch(es) for $name: ${subjects//$'\n'/ | }"
        audit_event apply dotfiles.declined declined "repository=$name" "patches=$count" "subjects=${subjects//$'\n'/ | }"
        return 0
    fi
    before=$(git -C "$live" rev-parse HEAD)
    local touches_hyprland=false
    if [[ $name == dotfiles ]] && ! GIT_INDEX_FILE="$copies/check.index" git -C "$live" diff --cached --quiet HEAD -- config/hyprland; then
        touches_hyprland=true
        pause_hyprland_autoreload
    fi
    if ! git -C "$live" am --quiet "$copies"/*.patch; then
        git -C "$live" am --abort 2>/dev/null || true
        if $touches_hyprland; then resume_hyprland_autoreload "$before"; fi
        echo "git am failed: nothing applied." >&2
        log_event WARN apply "git am failed for $count patch(es) for $name"
        audit_event apply dotfiles.failed failed "repository=$name" "patches=$count" "subjects=${subjects//$'\n'/ | }"
        return 1
    fi
    if $touches_hyprland; then resume_hyprland_autoreload "$before"; fi
    find "$outgoing" -maxdepth 1 -type f -name '*.patch' -delete
    # The card's "↑N unapplied" clears now, not at the session's next turn.
    osd-show session-pushed "$clone" 2>/dev/null || true
    log_event INFO apply "applied $count patch(es) to $live: ${subjects//$'\n'/ | }"
    audit_event apply dotfiles.applied ok "repository=$name" "patches=$count" "head=$(git -C "$live" rev-parse HEAD 2>/dev/null)" "subjects=${subjects//$'\n'/ | }"
    close_shipped_todos "$live" "$before"
    if [[ $name == dotfiles ]]; then
        after_dotfiles_apply "$before" || installed=false
    else
        after_reviewed_apply "$live" "$before" || installed=false
    fi
    $installed
}

# The dotfiles' command links share ~/.local/bin with agent-cockpit's, file by file (--no-folding).
after_dotfiles_apply() { # commit-before-the-apply
    if ! git -C "$DOTFILES_LIVE" diff --quiet "$1" HEAD -- config/bin; then
        echo "Refreshing command links …"
        if ! stow --dir="$DOTFILES_LIVE/config" --target="$HOME" --no-folding --restow bin; then
            echo "The commits were applied, but refreshing command links failed (above). Existing personal files were not replaced." >&2
            log_event ERROR apply "stow bin failed after the apply: command links need attention"
            return 1
        fi
    fi
    if git -C "$DOTFILES_LIVE" diff --quiet "$1" HEAD -- apps; then
        echo "Applied."
        return 0
    fi
    build_dotfiles_apps
}

# Another running copy installs itself: its Makefile's after-apply target (build, links, restarts),
# reviewed with the rest, gets the commit before the apply to see what changed.
after_reviewed_apply() { # live commit-before-the-apply
    if ! make -C "$1" -n after-apply >/dev/null 2>&1; then
        echo "Applied. $1 has no after-apply target: nothing installed."
        return 0
    fi
    echo "Applied. Installing it (make after-apply) …"
    local output line
    output=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/cockpit-after-apply.XXXXXX")
    if ! make -C "$1" after-apply BEFORE="$2" 2>&1 | tee "$output"; then
        # The error hand-off sees the log, not the approval terminal's captured output.
        while IFS= read -r line; do
            log_event WARN apply "after-apply output: $line"
        done < <(tail -n 20 "$output")
        rm -f "$output"
        echo "The commits were applied, but make after-apply failed (above)." >&2
        log_event ERROR apply "make after-apply failed in $1"
        return 1
    fi
    rm -f "$output"
}

# The dotfiles' apps/ are their own programs (widgets); the OSD daemon and the column are
# agent-cockpit's, whose after-apply rebuilds them and reloads (restarting a stale daemon).
build_dotfiles_apps() {
    echo "Applied. apps/ changed: building it …"
    if ! make -C "$DOTFILES_LIVE" build; then
        echo "The build failed (above): the dotfiles' programs keep their old build." >&2
        log_event WARN apply "make build failed in $DOTFILES_LIVE after the apply"
        return 1
    fi
    echo "Next: make test in $DOTFILES_LIVE."
}

show_usage() {
    ensure_manager
    tmux respawn-pane -k -t "$(viewer_pane)" cockpit-sidebar usage
    : > "$CURRENT"
    label_panes usage
}

clear_exited_viewer() { # session-id
    # Closing takes time: do not replace a session selected while the old one was exiting.
    [[ $(cat "$CURRENT" 2>/dev/null) == "$1" ]] || return 0
    local sidebar viewer approval approval_run sidebar_dead
    read_manager_panes
    : > "$CURRENT"
    [[ -n $viewer ]] || return 0
    local commands=(respawn-pane -k -t "$viewer" cockpit idle)
    if [[ -n $approval ]]; then
        commands+=(";" kill-pane -t "$approval")
    fi
    tmux "${commands[@]}"
    label_panes "" "$sidebar" "$viewer"
    tmux select-pane -t "$sidebar"
}

idle() {
    printf '\n  No session selected.\n\n  In the column: j/k move   Enter open   n answer the next one needing you   a new   ? every key\n  ⌘Tab moves between the column and this pane; ⌘1/2/3 jump to a panel from here.\n'
    exec sleep infinity
}

# Every command leaves a line: what ran, how it ended, how long it took. idle (the viewer's
# placeholder) and the log commands themselves are left out. Run from the sidebar in the
# background (COCKPIT_LOG_STDERR), the error messages go to the log too, since nobody
# sees that terminal.
# The agents: one file each in cockpit-agents/, named after the agent, defining every verb
# of AGENT_VERBS as agent_<name>_<verb> (README.md there says what each one does). A file missing
# a verb stops every command here, so a half-written agent is never run. Optional verbs: doctor, terminal.
# COCKPIT_AGENTS_DIR overrides the folder (tests).
AGENT_VERBS=(label is_session_id tmux_prefix can new new_with_prompt background detached resume restart restore exit say prompt_start)
AGENTS_DIR=${COCKPIT_AGENTS_DIR:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-agents}
DEFAULT_AGENT=claude
AGENTS=()
for agent_file in "$AGENTS_DIR"/*.sh; do
    [[ -f $agent_file ]] || continue
    # shellcheck source=/dev/null
    source "$agent_file"
    agent_name=$(basename "$agent_file" .sh)
    missing_verbs=""
    for verb in "${AGENT_VERBS[@]}"; do
        declare -F "agent_${agent_name}_${verb}" >/dev/null || missing_verbs+=" $verb"
    done
    if [[ -n $missing_verbs ]]; then
        echo "cockpit: the agent $agent_name ($agent_file) does not define:$missing_verbs" >&2
        exit 1
    fi
    AGENTS+=("$agent_name")
done
unset agent_file agent_name missing_verbs verb
if [[ " ${AGENTS[*]} " != *" $DEFAULT_AGENT "* ]]; then
    echo "cockpit: no $DEFAULT_AGENT agent in $AGENTS_DIR" >&2
    exit 1
fi

# The agent a start runs (new, parallel, background, review): claude, or another with --agent
# <name> before the command. A running session is its own: resume, restart and restore go by its id.
launch_agent=$DEFAULT_AGENT
if [[ ${1:-} == --agent ]]; then
    if [[ " ${AGENTS[*]} " != *" ${2:-} "* || -z ${2:-} ]]; then
        echo "cockpit: --agent takes one of: ${AGENTS[*]}" >&2
        exit 2
    fi
    launch_agent=$2
    shift 2
else
    case ${1:-attach} in
        new|parallel|background|review|terminal)
            launch_agent=$(launch_setting_value default-agent) || exit 1
            validate_launch_setting default-agent "$launch_agent" || exit 2
            ;;
    esac
fi

log_command=${1:-attach}
log_failure_level=ERROR
log_started=$(date +%s%N)
log_arguments="${*:2}"
if [[ $log_command == say ]]; then
    log_arguments="${2:-} (message of ${#3} characters)"
elif [[ $log_command == new ]]; then
    # claude's own arguments after the directory may be a prompt: count them, do not copy them.
    log_arguments="${2:-}"
    if (( $# > 2 )); then log_arguments+=" (+$(( $# - 2 )) claude arguments)"; fi
elif [[ $log_command == parallel ]]; then
    # The Todo panel's N passes the item as the first prompt: its length, not its text.
    log_arguments="${2:-} ${3:-}"
    if (( $# > 3 )); then log_arguments+=" (prompt of ${#4} characters)"; fi
elif [[ $log_command == team-spawn ]]; then
    # The token and the brief stay out of the log (the audit has the role and the folder).
    log_arguments="${3:-} ${4:-} ${5:-} (brief of ${#6} characters)"
fi
[[ $launch_agent == claude ]] || log_arguments+=" (agent $launch_agent)"
if [[ $log_command == label-state || $log_command == focus-viewer ]]; then
    # Called on every view change: only their failures are worth a line (40% of the log were these).
    trap 'log_status=$?; ((log_status)) && log_event ERROR manager "$log_command $log_arguments -> exit $log_status ($(( ($(date +%s%N) - log_started) / 1000000 )) ms)"' EXIT
elif [[ $log_command != idle && $log_command != log && $log_command != logs ]]; then
    trap 'log_status=$?
    if [[ $log_command == sleep && $log_status == 3 ]]; then log_failure_level=INFO; fi
    log_event "$( ((log_status)) && echo "$log_failure_level" || echo INFO)" manager "$log_command $log_arguments -> exit $log_status ($(( ($(date +%s%N) - log_started) / 1000000 )) ms)"' EXIT
fi
if [[ -n ${COCKPIT_LOG_STDERR:-} ]]; then
    exec 2> >(while IFS= read -r line; do log_event ERROR manager "$line"; done)
fi

case ${1:-attach} in
    opencode-models)
        require_plain_directory "${2:?usage: cockpit opencode-models <dir>}"
        cd -- "$2"
        env -u CLAUDE_CODE_SESSION_ID -u COCKPIT_OPENCODE_MODEL \
            timeout 20 "$OPENCODE_LAUNCHER" api --standalone get /api/model
        ;;
    attach)
        ensure_manager
        exec env -u TMUX tmux attach-session -t "=$MANAGER"
        ;;
    show) show_manager "${2:-}" ;;
    view) view_session "${2:?usage: cockpit view <session-id>}" ;;
    attend) attend_session "${2:?usage: cockpit attend <session-id>}" ;;
    attention-answered) attention_answered "${2:?usage: cockpit attention-answered <run-id>}" ;;
    open) view_session "${2:?usage: cockpit open <session-id>}" && focus_viewer ;;
    new) shift; new_session "${1:?usage: cockpit new <dir> [claude args]}" "${@:2}" ;;
    terminal)
        if ! declare -F "agent_${launch_agent}_terminal" >/dev/null; then
            echo "cockpit: $launch_agent does not support terminal attachment" >&2
            exit 1
        fi
        "agent_${launch_agent}_terminal" "${2:?usage: cockpit --agent opencode terminal <dir>}"
        ;;
    resume) resume_session "${2:?usage: cockpit resume <dir> <session-id>}" "${3:?usage: cockpit resume <dir> <session-id>}" ;;
    exit)
        [[ ${2:-} =~ ^[A-Za-z0-9_-]+$ ]] || { echo "cockpit: invalid session id" >&2; exit 1; }
        is_exiting_asleep=false
        # A starting pane (claude-retry-*) has no session yet, so no subscription route to cancel.
        if [[ $2 != claude-retry-* ]]; then
            "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription" cancel-session "$2" || exit
        fi
        # A live pane first: a note can outlive its process by the length of the sleep's exit.
        if [[ -z $(session_field "${2:?usage: cockpit exit <session-id>}" tmux_pane) ]] && is_asleep "$2" && ! agent_opencode_is_session_id "$2"; then
            is_exiting_asleep=true
        fi
        # Explicit ending revokes handoff even if process shutdown subsequently fails.
        if is_asleep "$2"; then forget_sleep_note "$2"; fi
        # A later resume (H) must not get the messages that waited for a wake.
        rm -rf "${XDG_STATE_HOME:-$HOME/.local/state}/cockpit/prompt-queue/$2"
        mkdir -p "$(dirname "$ENDED_SESSIONS")" && printf '%s\n' "$2" >> "$ENDED_SESSIONS"
        if [[ $is_exiting_asleep == true ]]; then
            log_event INFO sleep "$2 ended while asleep"
        else
            exit_session "$2"
            clear_exited_viewer "$2"
        fi
        ;;
    sleep) sleep_session "${2:?usage: cockpit sleep <session-id>}" ;;
    wake) wake_session "${2:?usage: cockpit wake <session-id>}" ;;
    wake-remote) restore_remote_control "${2:?usage: cockpit wake-remote <session-id> <woke-at>}" "${3:?usage: cockpit wake-remote <session-id> <woke-at>}" ;;
    restore) shift; restore_sessions "$@" ;;
    restart-all) shift; restart_sessions "$@" ;;
    background) background_session "${2:?usage: cockpit background <dir> <prompt>}" "${3:?usage: cockpit background <dir> <prompt>}" ;;
    loading-screen) show_loading ;;
    restarting-screen) restarting_screen "${2:?usage: cockpit restarting-screen <session-id>}" ;;
    restart) restart_session "${2:?usage: cockpit restart <session-id> [effort] [detached]}" "${3:-}" "${4:-}" ;;
    billing)
        # The session restarts on the same conversation, billed the other way.
        [[ ${3:-} == credits || ${3:-} == subscription ]] || { echo "usage: cockpit billing <session-id> credits|subscription" >&2; exit 2; }
        restart_session "${2:?usage: cockpit billing <session-id> credits|subscription}" "" "" "$3"
        ;;
    idle) idle ;;
    usage) show_usage ;;
    compact) compact_session "${2:?usage: cockpit compact <session-id>}" ;;
    variants) open_variants "${2:?usage: cockpit variants <session-id>}" ;;
    approval-pane) approval_pane "${2:?usage: cockpit approval-pane <id> | close [id]}" "${3:-}" ;;
    say) say_to_session "${2:?usage: cockpit say <session-id> <message>}" "${3:?usage: cockpit say <session-id> <message>}" ;;
    logs) show_logs "${2:-80}" ;;
    log) log_event "${3:?usage: cockpit log <component> <INFO|WARN|ERROR> <message>}" "${2:?}" "${4:?}" ;;
    digest) show_digest ;;
    prs) prs_window ;;
    git) git_popup "${2:?usage: cockpit git <dir>}" ;;
    push) push_popup "${2:?usage: cockpit push <dir>}" ;;
    queue-prompt-ask) queue_prompt_ask "${2:-}" ;;
    push-run) push_run "${2:?usage: cockpit push-run <dir>}" ;;
    apply|apply-dotfiles)
        (( $# <= 2 )) || { echo "usage: cockpit apply [clone]" >&2; exit 2; }
        apply_reviewed "${2:-}" ;;
    apply-run) apply_run "${2:?usage: cockpit apply-run <reviewed clone>}" ;;
    subscription-sweep)
        folder="${COCKPIT_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/cockpit/subscriptions"
        mkdir -p "$folder"
        exec 9>"$folder/sweep.lock"
        if flock -n 9; then "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-subscription" sweep; fi
        ;;
    subscription-route) subscription_route "${2:?usage: cockpit subscription-route <origin> <generation>}" "${3:?}" ;;
    chief-start) chief_start_session "${2:?usage: cockpit chief-start <reserved-session-id> <dedicated-directory>}" "${3:?}" ;;
    team-spawn) team_spawn_session "${2:?usage: cockpit team-spawn <token> <role> <dir> <commit|-> <brief>}" "${3:?}" "${4:?}" "${5:?}" "${6:-}" ;;
    parallel) parallel_session "${2:?usage: cockpit parallel <dir> <branch> [prompt]}" "${3:?usage: cockpit parallel <dir> <branch> [prompt]}" "${4:-}" ;;
    review) review_session "${2:?usage: cockpit review <dir> <pr-number>}" "${3:?usage: cockpit review <dir> <pr-number>}" ;;
    clones) clones_popup ;;
    clones-review) clones_review ;;
    clones-sweep) clones_review sweep ;;
    label-state) label_state "${2:?usage: cockpit label-state <state> [session-id]}" "${3:-}" ;;
    prepare) ensure_manager ;;
    reload)
        # The editor owns a shared lock until its text reaches todo.json, not just until it closes.
        exec {todo_editor_lock}>"${XDG_RUNTIME_DIR:-/tmp}/cockpit-todo-editor.lock"
        flock "$todo_editor_lock"
        ensure_manager
        tmux respawn-pane -k -t "$(sidebar_pane)" cockpit-sidebar
        exec {todo_editor_lock}>&-
        restart_stale_osd
        restart_stale_remote
        "$BAR_VISIBILITY" sync
        ;;
    restart-osd-when-idle) restart_osd_when_idle ;;
    focus-viewer) focus_viewer ;;
    layout) ensure_manager && apply_layout ;;
    design-review)
        if (( $# < 2 )) || [[ $2 != start && $2 != stop ]] || (( $# != 2 && $# != 3 && $# != 5 )) ||
            { (( $# >= 3 )) && [[ ! $3 =~ ^[a-zA-Z0-9_-]+$ ]]; } ||
            { (( $# == 5 )) && [[ $2 != start || $4 != --figcraft-window || ! $5 =~ ^0x[0-9a-fA-F]+$ ]]; }; then
            echo "usage: cockpit design-review start|stop [session-id] [--figcraft-window <address> (start only)]" >&2
            exit 2
        fi
        id=${3:-}
        if [[ $2 == stop ]]; then
            if [[ -n $id ]]; then
                hyprctl eval "require(\"figcraft-review\").stop(\"$id\")"
            else
                hyprctl eval 'require("figcraft-review").stop()'
            fi
        else
            [[ -n $id ]] || id=$(cat "$CURRENT" 2>/dev/null || true)
            if [[ ! $id =~ ^[a-zA-Z0-9_-]+$ ]]; then
                echo 'cockpit: select a conversation or pass its session ID' >&2
                exit 1
            fi
            pane=$(jq -er --arg id "$id" 'first(.sessions[] | select(.session == $id)) | .tmux_pane' "$SNAPSHOT")
            if [[ ! $pane =~ ^%[0-9]+$ ]]; then
                echo 'cockpit: conversation has no valid tmux pane' >&2
                exit 1
            fi
            read -r target dead server < <(tmux display-message -p -t "$pane" '#{session_name} #{pane_dead} #{pid}')
            if [[ ! $target =~ ^claude-retry-[a-zA-Z0-9_-]+$ || $dead != 0 || ! $server =~ ^[0-9]+$ ]]; then
                echo 'cockpit: conversation is not a live agent session' >&2
                exit 1
            fi
            if ! timeout --signal=KILL 2s osd owns-pane "$id" "$pane" "$server"; then
                echo 'cockpit: conversation ownership could not be verified; refusing a stale or reused tmux pane' >&2
                exit 1
            fi
            if (( $# == 5 )); then
                hyprctl eval "require(\"figcraft-review\").start(\"$id\",\"$target\",\"$5\")"
            else
                hyprctl eval "require(\"figcraft-review\").start(\"$id\",\"$target\")"
            fi
        fi
        ;;
    reset)
        tmux kill-session -t "=$MANAGER" 2>/dev/null || true
        osd-show sessions-clear
        rm -f "$CURRENT" "$VIEWED_STARTS" "$HOME"/.cache/claude/statusline-*.json "$HOME"/.cache/claude/toast-*.id
        ;;
    doctor) doctor ;;
    handoff) handoff "${2:-on}" ;;
    away) away "${2:-}" ;;
    setting) setting "${2:?usage: cockpit setting <name> [on|off]}" "${@:3}" ;;
    remote) toggle_remote "${2:?usage: cockpit remote <session-id>}" ;;
    sweep) sweep_caches ;;
    *)
        echo "usage: cockpit [attach|show [id]|view <id>|open <id>|new <dir>|resume <dir> <id>|exit <id>|restart <id>|restart-all [<id>...]|billing <id> credits|subscription|handoff [on|off]|away on|off|setting <name> [on|off]|remote <id>|prepare|idle|reload|reset|doctor|sweep]" >&2
        exit 2
        ;;
esac
