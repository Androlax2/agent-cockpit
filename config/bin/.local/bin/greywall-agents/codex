#!/bin/sh
# Keep this launcher separate from the binary replaced by vendor updates.
agent=codex
own_folders="~/.codex/**"
export COCKPIT_AGENT=codex
. "$(dirname "$0")/launcher-common.sh"
COCKPIT_SUBSCRIPTION_ACCOUNT=$(python3 "$HOME/.config/waybar/scripts/native-subscription.py" identity codex 2>/dev/null) || COCKPIT_SUBSCRIPTION_ACCOUNT=
for argument in "$@"; do
    case "$argument" in -c|-c?*|--config|--config=*|--profile|--profile=*|-p|-p?*|--oss|--local-provider|--local-provider=*) COCKPIT_SUBSCRIPTION_ACCOUNT= ;; esac
done
export COCKPIT_SUBSCRIPTION_ACCOUNT
if [ -n "${COCKPIT_SUBSCRIPTION_ROUTE:-}" ]; then
    if [ "$#" -ne 0 ]; then
        echo "codex launcher: routed launches take their model and conversation only from the protected launch plan." >&2
        exit 1
    fi
    # The capability-authenticated server and its TUI share this sandbox, never the host daemon.
    # shellcheck disable=SC2086
    exec $greywall_command --profile codex $greywall_options -- \
        $sandbox_entry node "$HOME/agent-cockpit/config/codex/.codex/cockpit-bridge.mjs" "$COCKPIT_SUBSCRIPTION_ROUTE"
fi
# Never connect a private namespace to a shared daemon whose socket belongs to another launch.
# shellcheck disable=SC2086
exec $greywall_command --profile codex $greywall_options -- $sandbox_entry "$HOME/.local/npm/bin/codex" --no-daemon "$@"
