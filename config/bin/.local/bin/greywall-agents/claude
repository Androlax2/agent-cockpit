#!/bin/sh
# Keep this launcher separate from the binary replaced by vendor updates.
agent=claude
if [ -n "${COCKPIT_SUBSCRIPTION_ROUTE:-}" ] && { [ "$#" -ne 0 ] || [ "${COCKPIT_CREDITS:-}" = 1 ]; }; then
    echo "claude launcher: routed launches require the protected subscription plan, without arguments or API billing." >&2
    exit 1
fi
# Sessions do not update Claude Code: they cannot write ~/.local/share/claude/versions (greywall.json),
# and a file planted there must never be run with Theo's rights. claude-update.timer updates it
# outside the sandbox through the installed claude.
export DISABLE_AUTOUPDATER=1
# Telemetry and error reports go to Datadog, which greyproxy denies: Claude waited on it before
# showing its prompt, 2.3 s of a 3.9 s start (measured 2026-10-19; DISABLE_TELEMETRY and
# DISABLE_ERROR_REPORTING alone did not help). This also turns off /bug inside sessions.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# --auto-profile still prompts on drift; keep the reviewed profile without blocking detached launches.
export GREYWALL_NO_PROMPT=1
. "$(dirname "$0")/launcher-common.sh"
greywall_options="--auto-profile --profile claude $greywall_options"

# A credits session (the cockpit's $ sets COCKPIT_CREDITS=1) bills the Console's API
# credits instead of the subscription: Claude prefers ANTHROPIC_API_KEY over its login. The key
# stays a greyproxy placeholder inside the sandbox. Without a key in the keyring the session does
# not start, rather than running on the subscription unnoticed (launcher-common.sh gives every other
# session none).
if [ "${COCKPIT_CREDITS:-}" = 1 ]; then
    anthropic_key=$(secret-tool lookup service agent-anthropic 2>/dev/null || true)
    if [ -z "$anthropic_key" ]; then
        echo "claude launcher: no API key in the keyring for a credits session (make -C ~/agent-cockpit agent-anthropic-key), not starting." >&2
        exit 1
    fi
    export ANTHROPIC_API_KEY="$anthropic_key"
    greywall_options="$greywall_options --secret ANTHROPIC_API_KEY"
fi

# The MCP child shell expands its verified port at execution time.
# shellcheck disable=SC2016
figcraft_mcp_config='{"mcpServers":{"figcraft-app":{"command":"sh","args":["-c","exec figcraft-cli mcp --attach \"${FIGCRAFT_CONTROL_PORT:?FigCraft is not connected to this checkout}\""]}}}'

# Linked sessions: a background hook that wakes an idle session with its next approved team message
# (asyncRewake: exit 2 wakes Claude; it exits quietly without a team). Added to ~/.claude/settings.json's hooks.
team_watch='[{"hooks":[{"type":"command","command":"cockpit-team watch","asyncRewake":true,"timeout":86400}]}]'
team_settings="{\"hooks\":{\"SessionStart\":$team_watch,\"Stop\":$team_watch}}"

COCKPIT_BILLING=subscription
[ "${COCKPIT_CREDITS:-}" != 1 ] || COCKPIT_BILLING=api
COCKPIT_BILLING_STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
export COCKPIT_BILLING COCKPIT_BILLING_STARTED_AT
if [ -n "${COCKPIT_SUBSCRIPTION_ROUTE:-}" ]; then
    # The hook's shell reads the route from its own environment.
    # shellcheck disable=SC2016
    gate='{"hooks":[{"type":"command","command":"cockpit-subscription await-gate \"$COCKPIT_SUBSCRIPTION_ROUTE\"","timeout":35}]}'
    team_settings="{\"hooks\":{\"SessionStart\":[$gate,{\"hooks\":[{\"type\":\"command\",\"command\":\"cockpit-team watch\",\"asyncRewake\":true,\"timeout\":86400}]}],\"Stop\":$team_watch}}"
    # The host verifies the execution account immediately before entering the existing sandbox.
    # shellcheck disable=SC2086
    exec python3 "$HOME/.config/waybar/scripts/native-subscription.py" launch-claude "$COCKPIT_SUBSCRIPTION_ROUTE" \
        "$HOME/.local/bin/greywall" $greywall_options -- "$HOME/.local/bin/claude" \
        --mcp-config "$figcraft_mcp_config" --settings "$team_settings"
fi

# greywall_options is split on spaces on purpose: every path in it is under $HOME or
# $XDG_RUNTIME_DIR, which have none.
COCKPIT_SUBSCRIPTION_ACCOUNT=
if [ "${COCKPIT_CREDITS:-}" != 1 ]; then
    COCKPIT_SUBSCRIPTION_ACCOUNT=$(python3 "$HOME/.config/waybar/scripts/native-subscription.py" identity claude 2>/dev/null) || COCKPIT_SUBSCRIPTION_ACCOUNT=
fi
for argument in "$@"; do
    case "$argument" in --settings | --settings=* | --setting-sources | --setting-sources=*) COCKPIT_SUBSCRIPTION_ACCOUNT= ;; esac
done
export COCKPIT_SUBSCRIPTION_ACCOUNT
# Claude's configuration subcommands (claude mcp add, claude plugin list...) reject the session's
# options ("unknown option '--mcp-config'"): they run in the same sandbox without them.
case "${1:-}" in
mcp | plugin | plugins | auth | doctor | auto-mode)
    # shellcheck disable=SC2086
    exec "$HOME/.local/bin/greywall" $greywall_options -- "$HOME/.local/bin/claude" "$@"
    ;;
esac
# shellcheck disable=SC2086
exec "$HOME/.local/bin/greywall" $greywall_options -- "$HOME/.local/bin/claude" "$@" --mcp-config "$figcraft_mcp_config" --settings "$team_settings"
