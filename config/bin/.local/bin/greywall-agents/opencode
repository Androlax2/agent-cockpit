#!/bin/sh
# Keep this launcher separate from the binary replaced by vendor updates.
agent=opencode
# Its database, credentials and config, which greywall.json hides from every other sandbox.
own_folders="~/.local/share/opencode/** ~/.config/opencode/**"
# Sessions do not update opencode, for the reason the claude launcher gives for Claude Code.
export OPENCODE_DISABLE_AUTOUPDATE=1
. "$(dirname "$0")/launcher-common.sh"
greywall_options="--auto-profile --profile opencode $greywall_options"

# Inline config outranks project files, including an old --attach 7979 command. Replace the
# whole server so an inherited environment cannot redirect the verified checkout connection.
figcraft_server='{"type":"local","command":["sh","-c","exec figcraft-cli mcp --attach \"${FIGCRAFT_CONTROL_PORT:?FigCraft is not connected to this checkout}\""]}'
opencode_config=${OPENCODE_CONFIG_CONTENT:-'{}'}
if ! OPENCODE_CONFIG_CONTENT=$(printf '%s\n' "$opencode_config" | jq -cse --argjson server "$figcraft_server" '
    if length != 1 or (.[0] | type) != "object" then error("inline config must be a JSON object") else
        .[0] | del(.mcp["figcraft-app"]) | .mcp.servers["figcraft-app"] = $server
    end'); then
    echo "opencode launcher: cannot override FigCraft in OPENCODE_CONFIG_CONTENT; provide a JSON object, not starting." >&2
    exit 1
fi
export OPENCODE_CONFIG_CONTENT

# The TUI checks --session before location plugins load. A session created by a plugin is
# too late: the home composer keeps its own selection and overwrites it on the first prompt.
session_request=""
if [ -n "${CLAUDE_SESSIONS_OPENCODE_MODEL:-}" ]; then
    if ! session_request=$(jq -nce --arg reference "$CLAUDE_SESSIONS_OPENCODE_MODEL" \
            --arg session "${CLAUDE_CODE_SESSION_ID:-}" --arg directory "$PWD" '
        ($session | test("^ses_[0-9A-Za-z]{12,40}$")) as $valid_session
        | if $valid_session then
            ($reference | capture("^(?<providerID>[^/#\\s]+)/(?<id>[^#\\s]+)(?:#(?<variant>[^/#\\s]+))?$")
                | with_entries(select(.value != null))) as $model
            | {id: $session, model: $model, location: {directory: $directory}}
          else error("invalid managed session id") end'); then
        echo "opencode launcher: invalid managed session or model reference, not starting." >&2
        exit 1
    fi
fi

# opencode's Anthropic API key, from the keyring (make agent-opencode-key): a greyproxy placeholder
# inside the sandbox, which greyproxy swaps for the key on its way to api.anthropic.com, so no
# session reads it (opencode's own credential store, opencode.db, is open to every opencode
# session). Without one in the keyring, opencode uses what `opencode auth login` stored.
opencode_key=$(secret-tool lookup service agent-opencode-anthropic 2>/dev/null || true)
if [ -n "$opencode_key" ]; then
    export ANTHROPIC_API_KEY="$opencode_key"
    greywall_options="$greywall_options --secret ANTHROPIC_API_KEY"
fi

# Each Greywall launch has private network/PID namespaces and a private /tmp.
# Sharing service.json across them makes unreachable servers replace each other.
# Set only state inside the sandbox; keep the database, config and cache shared.
# The tools opencode runs inherit that XDG_STATE_HOME: CLAUDE_SESSIONS_STATE_HOME keeps the
# cockpit's (claude-todo list and show) on the real one, which the sandbox already reads.
# greywall_options is split on spaces on purpose: every path in it is under $HOME or
# $XDG_RUNTIME_DIR, which have none.
# shellcheck disable=SC2086
exec "$HOME/.local/bin/greywall" $greywall_options -- \
    env XDG_STATE_HOME=/tmp/opencode-greywall-state CLAUDE_SESSIONS_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}" \
    sh -c '
        request=$1
        shift
        if [ -n "$request" ]; then
            "$HOME/.opencode/bin/opencode" api --standalone post /api/session --data "$request" >/dev/null || exit $?
        fi
        exec "$HOME/.opencode/bin/opencode" "$@"
    ' opencode "$session_request" "$@"
