#!/usr/bin/env python3
"""Keep greyproxy.db bounded by age and size (greyproxy-prune.timer).

greyproxy 0.4.5 keeps every captured request, body included, forever. This deletes traffic
history older than --max-age-days, then the oldest transactions and conversations until the
live data fits in --max-gb. Rules, pending requests, sessions, credentials and the DNS cache
are never touched: they are greyproxy's state, not history.

It runs next to a live greyproxy, so it deletes in small transactions: greyproxy's writes wait
at most 5 s (its busy_timeout) for the lock. Freed pages go back to disk only once the file
uses incremental auto-vacuum; --compact switches it on with a full VACUUM, which holds the
write lock for minutes, so it refuses to run while greyproxy.service is active.

GREYPROXY_DB overrides the database path (tests).
"""

import argparse
import os
from pathlib import Path
import sqlite3
import subprocess
import sys


BATCH_ROWS = 200
GIB = 1024 ** 3
# Table, timestamp column: history greyproxy only appends to.
AGED_TABLES = [
    ("http_transactions", "timestamp"),
    ("middleware_events", "created_at"),
    ("request_logs", "timestamp"),
    ("conversations", "updated_at"),
]
# Oldest first, until the data fits: bodies are in http_transactions, turns in conversations.
CAPPED_TABLES = [("http_transactions", "id"), ("conversations", "updated_at")]


def database_path():
    return Path(os.environ.get("GREYPROXY_DB", Path.home() / ".local/share/greyproxy/greyproxy.db"))


def connect(path):
    if not path.is_file():
        raise SystemExit(f"greyproxy-prune: no database at {path}")
    connection = sqlite3.connect(path, timeout=5, isolation_level=None)
    connection.execute("PRAGMA foreign_keys=ON")
    return connection


def used_bytes(connection):
    page_size = connection.execute("PRAGMA page_size").fetchone()[0]
    page_count = connection.execute("PRAGMA page_count").fetchone()[0]
    free_pages = connection.execute("PRAGMA freelist_count").fetchone()[0]
    return (page_count - free_pages) * page_size


def existing_tables(connection):
    return {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}


def delete_batch(connection, table, where, order, arguments=()):
    cursor = connection.execute(
        f"DELETE FROM {table} WHERE rowid IN "
        f"(SELECT rowid FROM {table} WHERE {where} ORDER BY {order} LIMIT {BATCH_ROWS})", arguments)
    return cursor.rowcount


def prune_by_age(connection, max_age_days):
    tables = existing_tables(connection)
    cutoff = f"-{max_age_days} days"
    deleted = {}
    for table, column in AGED_TABLES:
        if table not in tables:
            continue
        deleted[table] = 0
        while removed := delete_batch(connection, table, f"{column} < datetime('now', ?)", column, (cutoff,)):
            deleted[table] += removed
    return deleted


def prune_by_size(connection, max_bytes):
    tables = existing_tables(connection)
    deleted = {}
    for table, order in CAPPED_TABLES:
        if table not in tables:
            continue
        deleted[table] = 0
        while used_bytes(connection) > max_bytes:
            removed = delete_batch(connection, table, "1", order)
            if not removed:
                break
            deleted[table] += removed
    return deleted


def release_free_pages(connection):
    connection.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    connection.execute("PRAGMA incremental_vacuum").fetchall()
    connection.execute("PRAGMA wal_checkpoint(TRUNCATE)")


def greyproxy_is_running():
    try:
        result = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "greyproxy.service"])
    except FileNotFoundError:
        return False
    return result.returncode == 0


def compact(connection):
    connection.execute("PRAGMA auto_vacuum=INCREMENTAL")
    connection.execute("VACUUM")
    connection.execute("PRAGMA wal_checkpoint(TRUNCATE)")


def describe(deleted):
    return ", ".join(f"{table} {count}" for table, count in deleted.items() if count) or "nothing"


def warn(message):
    print(f"greyproxy-prune: {message}", file=sys.stderr)
    subprocess.run(["cockpit", "log", "greyproxy-prune", "WARN", message],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def parse_arguments(arguments):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--max-age-days", type=int, default=14)
    parser.add_argument("--max-gb", type=float, default=4)
    parser.add_argument("--compact", action="store_true",
                        help="also VACUUM and switch on incremental auto-vacuum (greyproxy must be stopped)")
    options = parser.parse_args(arguments)
    if options.max_age_days < 1 or options.max_gb <= 0:
        parser.error("--max-age-days must be at least 1 and --max-gb above 0")
    return options


def main(arguments):
    options = parse_arguments(arguments)
    if options.compact and greyproxy_is_running():
        raise SystemExit("greyproxy-prune: --compact holds the database for minutes; "
                         "run systemctl --user stop greyproxy first")
    path = database_path()
    connection = connect(path)
    max_bytes = int(options.max_gb * GIB)
    by_age = prune_by_age(connection, options.max_age_days)
    by_size = prune_by_size(connection, max_bytes)
    if options.compact:
        compact(connection)
    else:
        release_free_pages(connection)
    remaining = used_bytes(connection)
    auto_vacuum = connection.execute("PRAGMA auto_vacuum").fetchone()[0]
    connection.close()

    print(f"greyproxy-prune: older than {options.max_age_days} days: {describe(by_age)}; "
          f"over {options.max_gb:g} GB: {describe(by_size)}; "
          f"data {remaining / GIB:.2f} GB, file {path.stat().st_size / GIB:.2f} GB")
    if auto_vacuum != 2:
        warn("freed space stays inside greyproxy.db until it is compacted once: "
             "systemctl --user stop greyproxy; greyproxy-prune --compact; systemctl --user start greyproxy")
    if remaining > max_bytes:
        warn(f"greyproxy.db still holds {remaining / GIB:.2f} GB after pruning every transaction and "
             f"conversation, over the {options.max_gb:g} GB cap")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
