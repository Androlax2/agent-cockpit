#!/bin/sh
# A Rust program of the dotfiles (apps/, built with `make cockpit` into apps/target/release): this
# runs the build named like this script, found next to it through the stow link.
here=$(dirname "$(readlink -f "$0")")
binary="$here/../../../../apps/target/release/$(basename "$0")"
if [ ! -x "$binary" ]; then
    echo "$(basename "$0") is not built yet: make -C ~/dotfiles cockpit" >&2
    # In a terminal pane of its own the message stays on screen instead of a dead pane.
    [ $# -eq 0 ] && [ -t 1 ] && exec sleep 3600
    exit 1
fi
exec "$binary" "$@"
