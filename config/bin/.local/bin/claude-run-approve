#!/usr/bin/env python3
"""claude-run-approve <id>: the approval terminal for a command Claude asked to run (ask-to-run).

Started by the OSD daemon outside the sandbox, in a tmux session of its own (claude-run-<id>), shown
in the cockpit and, while it needs Theo, in a floating window; it reports asking / running / done.
Runs with Theo's rights, so nothing happens without his "y". The request is read once, here: the
sandbox can rewrite the file, so what is shown is what runs. "e" edits the command first; the
edited command is what runs and what Claude is told. The command runs in a real terminal through
`script`, so sudo passwords and prompts work, and its output is recorded in the runtime directory,
which the sandbox cannot read; it reaches Claude only after "send the output to Claude? [Y/n]".
CLAUDE_RUNS_DIR overrides the requests folder (tests).
"""

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

RUNS_DIR = os.environ.get("CLAUDE_RUNS_DIR", os.path.expanduser("~/.cache/claude/runs"))
LOG_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "claude-runs")
FIFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "osd.fifo")
MAX_AGE_S = 15 * 60
BOLD, DIM, BLUE, YELLOW, RED, GREEN, RESET = "\033[1m", "\033[2m", "\033[34m", "\033[33m", "\033[31m", "\033[32m", "\033[0m"
SCRIPT_BANNER = re.compile(r"^Script (started|done) on .*$", re.MULTILINE)


def read_request(request_id: str) -> dict:
    """The request, validated, or an exception saying why it cannot be answered."""
    if not re.fullmatch(r"[0-9a-f]{12}", request_id):
        raise ValueError("not a request id")
    if os.path.exists(os.path.join(RUNS_DIR, f"{request_id}.result")):
        raise ValueError("already answered")
    with open(os.path.join(RUNS_DIR, f"{request_id}.request")) as file:
        request = json.load(file)
    if not isinstance(request, dict) or not isinstance(request.get("command"), str) or not request["command"].strip():
        raise ValueError("no command in the request")
    if time.time() - int(request.get("requested_at", 0)) > MAX_AGE_S:
        raise ValueError("older than 15 minutes")
    return request


def write_result(request_id: str, result: dict):
    path = os.path.join(RUNS_DIR, f"{request_id}.result")
    with open(path + ".tmp", "w") as file:
        json.dump(result, file)
    os.replace(path + ".tmp", path)


def send(line: str):
    try:
        fifo = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fifo, (line + "\n").encode())
        os.close(fifo)
    except OSError:
        pass


def phase(request_id: str, name: str):
    """Tell the daemon whether this needs Theo (asking: the floating window comes up wherever he
    is) or not (running: it goes away again), or is done (the pane and window close)."""
    send(f"run-phase {request_id} {name}")


def log(level: str, message: str):
    subprocess.run(["claude-sessions", "log", "run", level, message], capture_output=True)


def edit(command: str) -> str:
    with tempfile.NamedTemporaryFile("w+", suffix=".fish", delete=False) as file:
        file.write(command + "\n")
    try:
        subprocess.run([os.environ.get("EDITOR", "nano"), file.name])
        with open(file.name) as edited:
            return edited.read().strip()
    finally:
        os.remove(file.name)


# Characters that can hide what a command really does on screen: terminal control codes (ESC
# sequences clear or rewrite lines, carriage returns overwrite them) and invisible or direction-
# changing Unicode (bidi overrides, zero-width characters). Shown escaped, never interpreted.
HIDING = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200b-\u200f\u2028-\u202e\u2060-\u2069\ufeff]")
LONG_COMMAND = 600
TYPE_AHEAD_S = 0.5
PROMPT_IDLE_S = 1.5  # output stopped mid-line this long: the command waits for input (sudo, [y/N])


def waits_for_input(log_path: str, idle_s: float) -> bool:
    """The recorded output ends without a newline and has not grown for PROMPT_IDLE_S: a prompt."""
    try:
        with open(log_path, "rb") as file:
            file.seek(-1, os.SEEK_END)
            last = file.read(1)
    except OSError:
        return False
    return idle_s >= PROMPT_IDLE_S and last not in (b"\n", b"")


def visible_command(command: str) -> tuple[str, bool]:
    """The command as it will run, with every hiding character shown as an escape, and whether
    there was any."""
    shown = HIDING.sub(lambda match: f"{RED}\\u{ord(match.group()):04x}{RESET}{BOLD}", command)
    return shown, shown != command


def project_of(directory: str) -> str:
    """The repository the command runs in, worked out here: the request's own label is not trusted."""
    path = directory
    while path and path != "/":
        if os.path.exists(os.path.join(path, ".git")):
            return os.path.basename(path)
        path = os.path.dirname(path)
    return os.path.basename(directory.rstrip("/")) or directory


def choose(question: str, options: list[tuple[str, str]], default: str) -> str:
    """An arrow-key menu (↑↓ or j/k, Enter), starting on `default`; returns the chosen option's key.
    Without a terminal (tests), a line of input: an option key, or empty for the default."""
    keys = [key for key, _ in options]
    if not sys.stdin.isatty():
        try:
            answer = input(f"{question} [{'/'.join(keys)}] ").strip().lower()[:1]
        except EOFError:
            return default
        return answer if answer in keys else default
    import termios
    import tty
    selected = keys.index(default)
    print(f"{BOLD}{question}{RESET}  {DIM}↑↓ choose · Enter confirms{RESET}")
    descriptor = sys.stdin.fileno()
    saved = termios.tcgetattr(descriptor)

    def draw(first: bool):
        if not first:
            sys.stdout.write(f"\033[{len(options)}A")
        for index, (_, label) in enumerate(options):
            marker = f"{BLUE}❯ {BOLD}{label}{RESET}" if index == selected else f"  {DIM}{label}{RESET}"
            sys.stdout.write(f"\r\033[2K{marker}\r\n")
        sys.stdout.flush()

    try:
        tty.setcbreak(descriptor)
        draw(True)
        # A new window takes the keyboard: keys typed for something else in the moment it appears
        # must not answer. Drop what is pending, and anything typed in the first half second.
        termios.tcflush(descriptor, termios.TCIFLUSH)
        shown_at = time.time()
        while True:
            key = os.read(descriptor, 3)
            if time.time() - shown_at < TYPE_AHEAD_S:
                continue
            if key in (b"\x1b[A", b"k"):
                selected = (selected - 1) % len(options)
            elif key in (b"\x1b[B", b"j"):
                selected = (selected + 1) % len(options)
            elif key in (b"\r", b"\n"):
                return keys[selected]
            elif key in (b"\x03", b"\x1b", b"q"):
                return default
            draw(False)
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, saved)


def run(command: str, cwd: str, log_path: str, request_id: str = "") -> int:
    """The command in a real terminal through `script` (sudo and prompts work), recorded, with a
    "running · 12s" line kept at the bottom: the lines above it scroll, so output still shows,
    and a command that prints nothing no longer looks stuck."""
    os.makedirs(LOG_DIR, mode=0o700, exist_ok=True)
    child = subprocess.Popen(["script", "-qfec", shlex.join(["fish", "-c", command]), log_path], cwd=cwd)
    if not sys.stdout.isatty():
        return child.wait()
    rows = os.get_terminal_size().lines
    started = time.time()
    spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    sys.stdout.write(f"\033[1;{rows - 1}r\033[{rows - 1};1H")  # everything above the last row scrolls
    try:
        tick = 0
        size, changed_at, asking = -1, time.time(), False
        while child.poll() is None:
            try:
                now_size = os.path.getsize(log_path)
            except OSError:
                now_size = 0
            if now_size != size:
                size, changed_at = now_size, time.time()
            prompt = waits_for_input(log_path, time.time() - changed_at)
            if request_id and prompt != asking:
                asking = prompt
                phase(request_id, "asking" if asking else "running")
            elapsed = int(time.time() - started)
            sys.stdout.write(f"\0337\033[{rows};1H\033[2K{BLUE}{spinner[tick % len(spinner)]}{RESET} "
                             f"{DIM}running · {elapsed // 60}m {elapsed % 60:02d}s{RESET}\0338")
            sys.stdout.flush()
            tick += 1
            time.sleep(0.1)
    finally:
        sys.stdout.write(f"\0337\033[{rows};1H\033[2K\0338\033[r\033[{rows - 1};1H\n")
        sys.stdout.flush()
    return child.returncode


def recorded_output(log_path: str) -> str:
    try:
        with open(log_path, errors="replace") as file:
            return SCRIPT_BANNER.sub("", file.read()).strip("\n")
    except OSError:
        return ""


def approve(request_id: str) -> int:
    try:
        request = read_request(request_id)
    except (OSError, ValueError) as error:
        print(f"{RED}Cannot answer request {request_id}: {error}.{RESET}")
        return 1
    command, original = request["command"], request["command"]
    cwd = request.get("cwd") if isinstance(request.get("cwd"), str) and os.path.isdir(request.get("cwd")) else os.path.expanduser("~")
    project = project_of(cwd)
    phase(request_id, "asking")
    while True:
        shown, hiding = visible_command(command)
        print(f"\n{BOLD}{BLUE}Claude · {project}{RESET} asks you to run, in {DIM}{cwd}{RESET}:\n")
        print("\n".join(f"  {BOLD}{line}{RESET}" for line in shown.split("\n")) + "\n")
        if hiding:
            print(f"{RED}{BOLD}This command contains hidden characters (shown in red as \\uXXXX). "
                  f"They can make a command look different from what runs. Decline unless you know why.{RESET}\n")
        if len(command) > LONG_COMMAND:
            print(f"{YELLOW}Long command ({len(command)} characters): read all of it.{RESET}\n")
        answer = choose("Run it?", [("n", "Decline"), ("y", "Run it"), ("e", "Edit it first")], "n")
        if answer == "e":
            command = edit(command) or command
            continue
        break
    send(f"notice-clear run-{request_id}")
    if answer != "y":
        phase(request_id, "done")
        write_result(request_id, {"status": "declined"})
        log("INFO", f"declined {request_id} for {project}")
        print("Declined: Claude is told.")
        return 0
    log_path = os.path.join(LOG_DIR, f"{request_id}.log")
    print(f"{DIM}─── running ───{RESET}")
    phase(request_id, "running")
    exit_code = run(command, cwd, log_path, request_id)
    phase(request_id, "asking")
    print(f"{DIM}─── {RESET}{GREEN if exit_code == 0 else RED}exit {exit_code}{RESET}")
    keep = choose("Send the output to Claude?", [("y", "Send the output"), ("n", "Keep it out (only the exit status)")], "y") == "y"
    write_result(request_id, {"status": "ran", "exit": exit_code, "output": recorded_output(log_path) if keep else "",
                              "output_withheld": not keep, "edited_command": command if command != original else None})
    try:
        os.remove(log_path)
    except OSError:
        pass
    phase(request_id, "done")
    log("INFO", f"ran {request_id} for {project}: exit {exit_code}"
                f"{', edited' if command != original else ''}{', output withheld' if not keep else ''}")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: claude-run-approve <id>")
    status = approve(sys.argv[1])
    if not os.environ.get("TMUX"):  # in its tmux session, the pane and window close by themselves
        try:
            input(f"{DIM}Enter closes this window.{RESET}")
        except EOFError:
            pass
    sys.exit(status)
