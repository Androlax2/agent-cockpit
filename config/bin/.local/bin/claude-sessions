#!/usr/bin/env bash
# Claude session manager, Turborepo style: a sidebar listing every Claude Code session on the
# left (claude-sessions-sidebar) and the selected session, attached with nested tmux, on the
# right. Sessions come from the OSD daemon's snapshot ($XDG_RUNTIME_DIR/claude-sessions.json);
# each one lives in the tmux session claude-auto-retry created for it, so viewing is attaching.
#
#   claude-sessions              attach the manager in this terminal (created on first use)
#   claude-sessions show [id]    open or focus the manager window (kitty, workspace 6), view id;
#                                without id, from the Claude workspace itself, go back to the
#                                previous workspace instead (ALT + C toggles)
#   claude-sessions view <id>    show a session in the viewer pane (the sidebar's n); id is the
#                                daemon's session id or a claude-retry-* tmux session name
#   claude-sessions open <id>    view it and put the cursor in it (the sidebar's Enter)
#   claude-sessions new <dir> [claude args…]
#                                start `claude` in <dir> inside the viewer pane (the sidebar's a,
#                                and the fish `claude` function from any terminal). Without claude
#                                arguments, a session already running in <dir> is shown instead:
#                                typing `claude` twice in a project must not leave the first one
#                                running unseen in the background.
#   claude-sessions resume <dir> <id>
#                                resume a past session there (the sidebar's Enter on a recent one)
#   claude-sessions exit <id>    end a running session the way you would by hand: Ctrl-C twice,
#                                then its tmux session is killed if it is still there (the sidebar's x)
#   claude-sessions restart <id> [effort]
#                                exit it and resume the same conversation in its directory, which
#                                is how an installed Claude update gets applied (the sidebar's r);
#                                with an effort level (low … max) it comes back on that one (the
#                                sidebar's effort menu), without one it keeps the level it had
#   claude-sessions restart-all <id>...
#                                restart those sessions one after the other (the sidebar's Ctrl+R)
#   claude-sessions background <dir> <prompt>
#                                start a session there out of sight, with that first message (the
#                                sidebar's error hand-off); it shows as a card
#   claude-sessions loading-screen
#                                what the popup over the viewer pane runs while a session starts
#   claude-sessions idle         what the viewer pane runs while nothing is selected
#   claude-sessions usage        show the plan's usage report in the viewer pane (the sidebar's Enter on Status)
#   claude-sessions logs [lines] the end of the log (~/.local/state/claude-sessions/log) and the hook's
#   claude-sessions log <component> <INFO|WARN|ERROR> <message>
#                                add a line, for the lock, idle and update scripts
#   claude-sessions git <dir>    lazygit on that repository in a popup over the manager (the sidebar's g)
#   claude-sessions push <dir>   push its branch to origin with Theo's SSH key, after a yes (the sidebar's U)
#   claude-sessions prs          the pull requests window on the viewed session's repository (Super+Ctrl+P)
#   claude-sessions digest       yesterday, today, usage, waiting sessions and pull requests in the viewer
#                                (the sidebar's D; also the first time the cockpit opens each day)
#   claude-sessions parallel <dir> <branch>
#                                a new session on <branch> in its own clone of the repository (the sidebar's A)
#   claude-sessions clones       the clones of + and of reviews, and delete those holding nothing new (the sidebar's K)
#   claude-sessions review <dir> <pr-number>
#                                a session reviewing that pull request in its own clone (the sidebar's c)
#   claude-sessions label-state <state>
#                                colour the viewer's title line by the viewed session's state (the sidebar)
#   claude-sessions focus-viewer move the cursor into the viewer pane (the sidebar's l / Right)
#   claude-sessions prepare      create the manager's tmux session without a window (login autostart)
#   claude-sessions reload       restart the sidebar in place (after editing it)
#   claude-sessions layout       reapply the sidebar width
#   claude-sessions reset        close the manager and forget every tracked session; running
#                                Claude sessions themselves are left alone
#   claude-sessions doctor       check every piece this depends on (daemon, FIFO, greywall paths,
#                                hooks, bar, tmux, manager) and what the pane heuristics see
#   claude-sessions handoff [on|off|lock|unlock]
#                                hand every running session to Remote Control (Claude's /rc, driven
#                                from the phone or claude.ai/code) before leaving, or take them back
#   claude-sessions remote <id>  toggle Remote Control for one session (the sidebar's R)
#   claude-sessions restore <dir> <id> […]
#                                resume those sessions one after the other (the sidebar's B after a reboot)
#   claude-sessions compact <id> type /compact into a session waiting at its prompt (the sidebar's C)
#   claude-sessions zoom         the session pane over the whole window, and back (the sidebar's z)
#   claude-sessions approval-pane <id>|close
#                                show a run request's approval under the session pane (the daemon)
#   claude-sessions say <id> <message>
#                                send a session a message without opening it (the sidebar's m)
#   claude-sessions answer <id> yes|no
#                                answer its open permission dialog (the sidebar's Y and N)
set -euo pipefail

MANAGER=claude-manager
MANAGER_WINDOW="$MANAGER:manager"
SNAPSHOT="${XDG_RUNTIME_DIR:-/tmp}/claude-sessions.json"
# One log for the manager, the sidebar, the daemon and the lock and idle scripts: a line per event
# ("<time> <LEVEL> <component>: <message>"), never per redraw. 1 MB, then one previous file. Prompt
# text stays out of it; long command lines are cut. `claude-sessions logs` shows the end of it.
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions/log"
LOG_MAX_BYTES=1048576
LOG_LINE_MAX=300
HOOK_LOG_FILE="$HOME/.cache/claude/hook.log"
CURRENT="${XDG_RUNTIME_DIR:-/tmp}/claude-sessions.current"
SIDEBAR_WIDTH=60   # columns; the rest is the session
WINDOW_CLASS=claude-sessions
KITTY_CONFIG="$HOME/.config/kitty/kitty.conf"
KITTY_MANAGER_CONFIG="$HOME/.config/kitty/claude-sessions.conf"
WORKSPACE=6  # apps/claude.lua routes the manager window there
ON_CLAUDE_WORKSPACE="$HOME/.config/waybar/scripts/on-claude-workspace.sh"
BAR_VISIBILITY="$HOME/.config/waybar/scripts/waybar-visibility.sh"

# hyprctl finds Hyprland through HYPRLAND_INSTANCE_SIGNATURE. This runs from the manager's tmux
# server and systemd units, which can hold a stale value (Hyprland restarted since) or none: take
# the running instance, the newest $XDG_RUNTIME_DIR/hypr/<id> with a socket.
refresh_hyprland_instance() {
    local base="${XDG_RUNTIME_DIR:-/tmp}/hypr" instance
    [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -e $base/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock ]] && return
    while read -r instance; do
        if [[ -e $base/$instance/.socket.sock ]]; then
            export HYPRLAND_INSTANCE_SIGNATURE=$instance
            return
        fi
    done < <(ls -t "$base" 2>/dev/null)
}
refresh_hyprland_instance

log_event() { # LEVEL component message
    local message=${3//$'\n'/ }
    {
        mkdir -p "$(dirname "$LOG_FILE")"
        if (( $(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0) > LOG_MAX_BYTES )); then
            mv -f "$LOG_FILE" "$LOG_FILE.1"
        fi
        printf '%s %s %s: %s\n' "$(date -Iseconds)" "$1" "$2" "${message:0:$LOG_LINE_MAX}" >> "$LOG_FILE"
    } 2>/dev/null || true  # a read-only state dir (inside greywall) must not break the command
}

show_logs() { # [lines]
    local lines=${1:-80}
    [[ $lines =~ ^[0-9]+$ ]] || { echo "usage: claude-sessions logs [lines]" >&2; return 1; }
    echo "== $LOG_FILE"
    tail -n "$lines" "$LOG_FILE" 2>/dev/null || echo "(empty)"
    if [[ -f $HOOK_LOG_FILE ]]; then
        echo "== $HOOK_LOG_FILE (the hook, inside greywall)"
        tail -n 20 "$HOOK_LOG_FILE"
    fi
}

apply_layout() {
    tmux resize-pane -t "$(sidebar_pane)" -x "$SIDEBAR_WIDTH"
}

# tmux expands formats in -c start directories, so refuse any directory containing #.
require_plain_directory() {
    local directory=$1
    if [[ $directory == *"#"* || ! -d $directory ]]; then
        echo "claude-sessions: refusing directory $directory" >&2
        exit 1
    fi
}

# Panes are addressed by a role tag (@role = sidebar | viewer), never by index: tmux
# numbers panes by position, so a later split moves the numbers around.
pane_by_role() {
    tmux list-panes -t "$MANAGER_WINDOW" -F '#{pane_id} #{@role}' 2>/dev/null | awk -v role="$1" '$2 == role { print $1; exit }'
}

sidebar_pane() { pane_by_role sidebar; }
viewer_pane() { pane_by_role viewer; }

tag_pane() { # pane role
    tmux set-option -p -t "$1" @role "$2"
}

ensure_manager() {
    local sidebar viewer
    if ! tmux has-session -t "=$MANAGER" 2>/dev/null; then
        tmux new-session -d -s "$MANAGER" -n manager -x 240 -y 60 claude-sessions-sidebar
        # A pane whose command ends (a viewed session exits, the sidebar crashes) stays as a dead
        # pane to be respawned instead of vanishing and leaving the sidebar alone in the window.
        tmux set-option -w -t "$MANAGER_WINDOW" remain-on-exit on
        # The kitty window's title: "Claude · <project>" on the sidebar, "Claude · ✳ <task>" in a session.
        tmux set-option -t "$MANAGER" set-titles-string 'Claude · #{pane_title}'
        tag_pane "$(tmux display-message -p -t "$MANAGER_WINDOW" '#{pane_id}')" sidebar
    fi
    sidebar=$(sidebar_pane)
    if [[ -z $sidebar ]]; then
        echo "claude-sessions: the manager predates pane roles; run: tmux kill-session -t $MANAGER" >&2
        return 1
    fi
    # A title line over the session pane names the project and Claude's own title for it, so the
    # session you are typing in is never a guess; the sidebar's own top border stays blank.
    tmux set-option -w -t "$MANAGER_WINDOW" pane-border-status top
    # @state (label_state, pushed by the sidebar) colours the title: red needs you, yellow waiting.
    tmux set-option -w -t "$MANAGER_WINDOW" pane-border-format \
        '#{?#{==:#{@role},viewer},#{?#{@project},#{?#{==:#{@state},needs-you},#[fg=red],#{?#{==:#{@state},waiting},#[fg=yellow],#[fg=blue]}} #[bold]#{@project}#[nobold] · #{pane_title} #[default], no session },}'
    viewer=$(viewer_pane)
    if [[ -z $viewer ]]; then
        viewer=$(tmux split-window -h -t "$sidebar" -l 70% -P -F '#{pane_id}' claude-sessions idle)
        tag_pane "$viewer" viewer
        tmux resize-pane -t "$sidebar" -x "$SIDEBAR_WIDTH"
        tmux select-pane -t "$sidebar"
    fi
    if [[ $(tmux display-message -p -t "$sidebar" '#{pane_dead}') == 1 ]]; then
        tmux respawn-pane -k -t "$sidebar" claude-sessions-sidebar
    fi
}

view_session() {
    local id=$1 pane target
    if [[ $id == claude-retry-* ]]; then
        [[ $id == *"#"* ]] && { echo "claude-sessions: refusing session name $id" >&2; return 1; }
        target=$id
    else
        pane=$(jq -r --arg id "$id" '.sessions[] | select(.session == $id) | .tmux_pane // empty' "$SNAPSHOT")
        if [[ -z $pane ]]; then
            echo "claude-sessions: session $id has no tmux pane" >&2
            return 1
        fi
        target=$(tmux display-message -p -t "$pane" '#{session_name}')
    fi
    ensure_manager
    # Nested on purpose: the inner client is the real, interactive session.
    tmux respawn-pane -k -t "$(viewer_pane)" env -u TMUX tmux attach-session -t "=$target"
    printf '%s\n' "$id" > "$CURRENT"
    place_approval
    # Its banner ("waiting for your input") has been read now that the session is on screen.
    osd-show session-seen "$id" 2>/dev/null || true
    label_panes "$(session_field "$id" project)"
}

# The kitty window title (sidebar pane title) and the session pane's title line both carry the project.
label_panes() {
    tmux select-pane -t "$(sidebar_pane)" -T "${1:-sessions}"
    tmux set-option -p -t "$(viewer_pane)" @project "${1:-}"
    tmux set-option -p -t "$(viewer_pane)" @state ""
}

# The viewed session's state for the title line's colour (the sidebar calls this when it changes).
label_state() {
    local state=$1
    case $state in
        working|waiting|needs-you|unknown) ;;
        *) echo "claude-sessions: unknown state $state" >&2; return 1 ;;
    esac
    tmux set-option -p -t "$(viewer_pane)" @state "$state"
}

focus_viewer() {
    tmux select-pane -t "$(viewer_pane)"
}

running_session_in() {
    jq -r --arg cwd "$1" '.sessions[] | select(.cwd == $cwd) | .session' "$SNAPSHOT" 2>/dev/null | head -1
}

new_session() {
    local directory=$1 existing
    shift
    require_plain_directory "$directory"
    ensure_manager
    if (( $# == 0 )); then
        existing=$(running_session_in "$directory")
        if [[ -n $existing ]]; then
            view_session "$existing"
            return
        fi
    fi
    # fish owns the `claude` function (greywall + claude-auto-retry). With no tmux variable left in
    # the environment the launcher creates the session's own tmux session and attaches it here;
    # with one still set it would run claude directly in this pane, which the next view kills.
    # CLAUDE_SESSIONS_INSIDE stops the function from delegating back to this manager.
    # The launch takes a few seconds (fish, the launcher, greywall, Claude): say so in the pane
    # until Claude's own screen takes over.
    loading_overlay "Starting Claude in $(basename "$directory") …" "$directory"
    tmux respawn-pane -k -t "$(viewer_pane)" -c "$directory" \
        env -u TMUX -u TMUX_PANE CLAUDE_SESSIONS_INSIDE=1 \
        fish -ic 'echo; echo "  ⟳ Starting Claude in $PWD …"; echo; claude $argv'"$LAUNCH_EPILOGUE" -- "$@"
    : > "$CURRENT"
    label_panes "$(basename "$directory")"
}

# A session started out of sight, in a tmux session of its own: the session pane keeps what it
# shows. Inside tmux the launcher runs claude right there. It appears as a card once it reports
# in. The sidebar's error hand-off uses it.
background_session() { # dir prompt
    require_plain_directory "$1"
    [[ -n $2 ]] || { echo "claude-sessions: background needs a prompt" >&2; return 1; }
    local prompt=$2
    [[ $prompt == -* ]] && prompt="Task: $prompt" # never an option of claude's
    tmux new-session -d -s "claude-retry-bg-$(date +%s)" -x 200 -y 50 -c "$1" \
        env -u TMUX_PANE CLAUDE_SESSIONS_INSIDE=1 fish -ic 'claude $argv' -- "$prompt"
}

# Every `fish -ic '…' -- args` keeps the --: without it fish takes an argument such as --resume or
# --effort as its own option and exits ("unknown option") before Claude starts.
# Appended to every launch in the viewer pane: a start that fails says so and stays on screen,
# instead of leaving a bare "Pane is dead (status 1)". Claude itself runs in its own tmux session
# (claude-auto-retry), so its error may be there; the epilogue lists those sessions.
LAUNCH_EPILOGUE='; set -l code $status; if test $code -ne 0; claude-sessions log manager ERROR "claude exited with status $code in $PWD" 2>/dev/null; echo; echo "  ✗ claude exited with status $code"; echo "  Claude sessions still open:"; tmux ls 2>/dev/null | string match "*claude-retry*" | string replace -r "^" "    "; echo "  More: claude-sessions doctor · journalctl --user -u claude-sessions"; read -n 1 -P "  any key closes this pane " answer; end'

# Claude's effort levels (claude --help, --effort).
EFFORT_LEVELS=(low medium high xhigh max)

require_effort() {
    local level=$1 known
    for known in "${EFFORT_LEVELS[@]}"; do [[ $level == "$known" ]] && return 0; done
    echo "claude-sessions: unknown effort $level (${EFFORT_LEVELS[*]})" >&2
    return 1
}

# While a session closes and starts in the viewer pane (restart, effort switch, new, resume), a
# popup exactly over that pane shows what is happening instead of the shell, the launcher and the
# sandbox scrolling by. It closes once the new session reports in (its SessionStart in the
# snapshot), after LOADING_TIMEOUT_S (logged), or on Escape. A second call while it shows only
# changes its text. Nothing when no terminal shows the manager.
LOADING_STATE="${XDG_RUNTIME_DIR:-/tmp}/claude-sessions-loading"
LOADING_TIMEOUT_S=${CLAUDE_SESSIONS_LOADING_TIMEOUT_S:-60}

loading_overlay() { # label directory [session-id] [start|gone]
    local client pane size
    printf '%s\n%s\n%s\n%s\n%s\n' "$1" "$2" "${3:-}" "$(date +%s)" "${4:-start}" > "$LOADING_STATE"
    client=$(tmux list-clients -t "=$MANAGER" -F '#{client_name}' 2>/dev/null | head -n 1)
    [[ -n $client ]] || return 0
    pgrep -f "claude-sessions loading-screen" >/dev/null && return 0
    pane=$(viewer_pane)
    size=$(tmux display-message -p -t "$pane" '#{pane_width} #{pane_height}')
    # display-popup waits for the popup to close: started in the background.
    tmux display-popup -B -E -c "$client" -t "$pane" -x '#{popup_pane_left}' -y '#{popup_pane_bottom}' \
        -w "${size% *}" -h "${size#* }" claude-sessions loading-screen >/dev/null 2>&1 &
    disown
}

loading_ready() { # directory session-id since start|gone
    if [[ $4 == gone ]]; then
        # Closing: done once the daemon has dropped the session.
        ! jq -e --arg session "$2" 'any(.sessions[]; .session == $session)' "$SNAPSHOT" >/dev/null 2>&1
        return
    fi
    jq -e --arg directory "$1" --arg session "$2" --argjson since "$3" \
        '[.sessions[] | select((.started // 0) >= $since)
          | select(if $session != "" then .session == $session else .cwd == $directory end)] | length > 0' \
        "$SNAPSHOT" >/dev/null 2>&1
}

# Claude can ask something before SessionStart (the workspace trust prompt, for one): the loading
# screen must not hide it. Its selection prompts end with this footer.
viewer_shows_prompt() {
    tmux capture-pane -p -t "$(viewer_pane)" 2>/dev/null | grep -q 'Enter to confirm'
}

show_loading() {
    local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) tick=0 label directory session since mode rows columns
    # No TERM (the tests run from a systemd unit by the health check): no cursor to hide, and no
    # reason to stop.
    tput civis 2>/dev/null || true
    while { read -r label; read -r directory; read -r session; read -r since; read -r mode; } < "$LOADING_STATE" 2>/dev/null; do
        if loading_ready "$directory" "$session" "$since" "$mode"; then
            sleep 0.5  # the session reported in; give it a moment to draw its screen
            break
        fi
        if viewer_shows_prompt; then
            log_event INFO sessions "loading screen yielded to a prompt: $label in $directory"
            break
        fi
        if (( $(date +%s) - since > LOADING_TIMEOUT_S )); then
            log_event WARN sessions "loading screen timed out after ${LOADING_TIMEOUT_S}s: $label in $directory"
            break
        fi
        rows=$(tput lines 2>/dev/null || echo 24) columns=$(tput cols 2>/dev/null || echo 80)
        printf '\033[2J\033[%d;%dH\033[1;34m%s\033[0m  \033[1m%s\033[0m' \
            $(( rows / 2 )) $(( (columns - ${#label} - 3) / 2 > 1 ? (columns - ${#label} - 3) / 2 : 1 )) "${frames[tick % 10]}" "$label"
        printf '\033[%d;%dH\033[2m%s\033[0m' $(( rows / 2 + 2 )) $(( (columns - 20) / 2 > 1 ? (columns - 20) / 2 : 1 )) "Escape hides this"
        tick=$(( tick + 1 ))
        sleep 0.15
    done
    rm -f "$LOADING_STATE"
}

resume_session() { # dir id [effort]
    require_plain_directory "$1"
    local effort_flags=()
    if [[ -n ${3:-} ]]; then
        require_effort "$3"
        effort_flags=(--effort "$3")
    fi
    ensure_manager
    loading_overlay "Resuming $(basename "$1")${3:+ · effort $3} …" "$1" "$2"
    tmux respawn-pane -k -t "$(viewer_pane)" -c "$1" \
        env -u TMUX -u TMUX_PANE CLAUDE_SESSIONS_INSIDE=1 \
        fish -ic 'echo; echo "  ⟳ Resuming the conversation in $PWD …"; echo; claude --resume $argv'"$LAUNCH_EPILOGUE" -- "$2" "${effort_flags[@]}"
    : > "$CURRENT"
    label_panes "$(basename "$1")"
    focus_viewer
}

session_field() { # id field
    jq -r --arg id "$1" --arg field "$2" '.sessions[] | select(.session == $id) | .[$field] // empty' "$SNAPSHOT" 2>/dev/null
}


# The session is over once its tmux session ended, or once no Claude runs in its pane any more:
# claude-auto-retry keeps a shell after a non-zero exit, and that wait used to cost two rounds.
claude_left() { # tmux-session pane timeout-seconds
    local tenths
    for (( tenths = 0; tenths < $3 * 10; tenths++ )); do
        tmux has-session -t "=$1" 2>/dev/null || return 0
        [[ $(osd liveness "" "$2" 2>/dev/null) == none ]] && return 0
        sleep 0.1
    done
    return 1
}

exit_session() {
    local id=$1 pane target attempt
    if [[ $id == claude-retry-* ]]; then
        [[ $id == *"#"* ]] && { echo "claude-sessions: refusing session name $id" >&2; return 1; }
        target=$id
        pane=$(tmux list-panes -t "=$target" -F '#{pane_id}' | head -1)
    else
        pane=$(session_field "$id" tmux_pane)
        if [[ -z $pane ]]; then
            echo "claude-sessions: session $id has no tmux pane" >&2
            return 1
        fi
        target=$(tmux display-message -p -t "$pane" '#{session_name}')
    fi
    # At the idle prompt /exit is the clean way out. Otherwise two Ctrl-C in quick succession: the
    # first interrupts the turn or clears typed input, the second must follow within Claude's short
    # "press again to exit" window. Two rounds, then the tmux session is killed.
    for attempt in 1 2; do
        if pane_at_prompt "$pane"; then
            submit_to_pane "$pane" "/exit"
        else
            tmux send-keys -t "$pane" C-c
            sleep 0.3
            tmux send-keys -t "$pane" C-c
        fi
        if claude_left "$target" "$pane" 3; then
            # What claude-auto-retry left behind, if anything.
            if tmux has-session -t "=$target" 2>/dev/null; then tmux kill-session -t "=$target" 2>/dev/null || true; fi
            return 0
        fi
    done
    echo "claude-sessions: $id did not exit, killing its tmux session" >&2
    tmux kill-session -t "=$target"
}

# A command typed at Claude's prompt and submitted. Text and Enter go in two send-keys calls with a
# pause: in one burst Claude's input takes them as a paste and the Enter becomes a newline, so the
# command never runs (claude-auto-retry's SUBMIT_DELAY_MS, src/tmux.js, documents the same).
submit_to_pane() { # pane text
    tmux send-keys -t "$1" -l -- "$2"
    sleep 0.15
    tmux send-keys -t "$1" Enter
}

pane_at_prompt() {
    # The daemon's reading of the pane (osd classify): one definition of "idle".
    [[ $(tmux capture-pane -p -t "$1" -S -20 2>/dev/null | osd classify) == waiting ]]
}

session_is_remote() {
    [[ $(jq -r '.remote // false' "$HOME/.cache/claude/statusline-$1.json" 2>/dev/null) == true ]]
}

# Claude's /rc toggles Remote Control. At an idle prompt it is typed and sent; while Claude works
# it is queued (ctrl+x, Enter) so the running turn is not interrupted.
send_remote_toggle() { # pane
    tmux send-keys -t "$1" "/rc"
    if pane_at_prompt "$1"; then
        tmux send-keys -t "$1" Enter
    else
        tmux send-keys -t "$1" C-x Enter
    fi
}

toggle_remote() {
    local id=$1 pane
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        echo "claude-sessions: session $id has no tmux pane" >&2
        return 1
    fi
    send_remote_toggle "$pane"
}

# /compact typed into a session that waits at its prompt (the sidebar's C). Not queued while it
# works: a compaction landing mid-task would summarise away what it is doing.
compact_session() { # id
    local id=$1 pane
    pane=$(session_field "$id" tmux_pane)
    if [[ -z $pane ]]; then
        echo "claude-sessions: session $id has no tmux pane" >&2
        return 1
    fi
    if ! pane_at_prompt "$pane"; then
        echo "claude-sessions: $(session_field "$id" project) is busy; compact it when it waits" >&2
        return 1
    fi
    submit_to_pane "$pane" "/compact"
}

# Answer a session's permission dialog from the sidebar (Y approves, N declines). The pane is read
# again right before: approve presses Enter only while the dialog is open with its cursor on
# "1. Yes"; decline presses Escape, Claude's own "no". Nothing is sent when the dialog is gone.
answer_permission() { # id yes|no
    local id=$1 answer=$2 pane tail
    pane=$(session_field "$id" tmux_pane)
    [[ -n $pane ]] || { echo "claude-sessions: session $id has no tmux pane" >&2; return 1; }
    tail=$(tmux capture-pane -p -t "$pane" -S -20 2>/dev/null)
    if [[ $(osd classify <<<"$tail") != needs-you ]]; then
        echo "claude-sessions: no permission dialog open in $(session_field "$id" project) any more" >&2
        return 1
    fi
    case $answer in
        yes)
            if ! grep -qE '❯[[:space:]]*1\.[[:space:]]*Yes' <<<"$tail"; then
                echo "claude-sessions: the dialog's cursor is not on \"1. Yes\"; answer it in the session" >&2
                return 1
            fi
            tmux send-keys -t "$pane" Enter
            ;;
        no) tmux send-keys -t "$pane" Escape ;;
        *) echo "usage: claude-sessions answer <session-id> yes|no" >&2; return 1 ;;
    esac
}

# A message for a session without opening it (the sidebar's m): sent at its prompt, queued with
# Claude's own Ctrl+X Enter while it works, refused while a dialog is open (it would answer it).
say_to_session() { # id message
    local id=$1 message=$2 pane tail
    pane=$(session_field "$id" tmux_pane)
    [[ -n $pane ]] || { echo "claude-sessions: session $id has no tmux pane" >&2; return 1; }
    if [[ -z $message || $message == *$'\n'* || ${#message} -gt 4000 ]]; then
        echo "claude-sessions: a message is one line of at most 4000 characters" >&2
        return 1
    fi
    # send-keys turns a control character into a key press (Escape, Ctrl+C, Shift+Tab's sequence).
    if [[ $message == *[[:cntrl:]]* ]]; then
        echo "claude-sessions: a message cannot carry control characters" >&2
        return 1
    fi
    tail=$(tmux capture-pane -p -t "$pane" -S -20 2>/dev/null)
    if [[ $(osd classify <<<"$tail") == needs-you ]]; then
        echo "claude-sessions: $(session_field "$id" project) has a dialog open; answer it first (Y or N)" >&2
        return 1
    fi
    tmux send-keys -t "$pane" -l -- "$message"
    if pane_at_prompt "$pane"; then
        tmux send-keys -t "$pane" Enter
    else
        tmux send-keys -t "$pane" C-x Enter
    fi
}

# The session pane over the whole window and back (the sidebar's z). Moving to the column with
# Ctrl+Tab unzooms too: tmux leaves zoom when the active pane changes.
zoom_viewer() {
    ensure_manager
    tmux select-pane -t "$(viewer_pane)"
    tmux resize-pane -Z -t "$(viewer_pane)"
}

# Sessions the lock screen handed to Remote Control (handoff lock), taken back on unlock only.
HANDED_OFF="${XDG_RUNTIME_DIR:-/tmp}/claude-sessions.handed-off"

# on / off: every session. lock / unlock: what hypr/scripts/lock.sh does around the lock screen;
# unlock takes back only the sessions lock handed off, so one put on Remote Control by hand stays.
handoff() { # on|off|lock|unlock
    local wanted=${1:-on} id pane count=0
    case $wanted in on|off|lock|unlock) ;; *) echo "usage: claude-sessions handoff [on|off|lock|unlock]" >&2; return 1 ;; esac
    if [[ ! -s $SNAPSHOT ]]; then
        [[ $wanted == lock || $wanted == unlock ]] && { rm -f "$HANDED_OFF"; return 0; }
        echo "claude-sessions: no running session" >&2; return 1
    fi
    [[ $wanted == lock ]] && : > "$HANDED_OFF"
    while IFS=$'\t' read -r id pane; do
        [[ -n $pane ]] || continue
        case $wanted in
            on|lock)
                session_is_remote "$id" && continue
                send_remote_toggle "$pane"; count=$((count + 1))
                [[ $wanted == lock ]] && printf '%s\n' "$id" >> "$HANDED_OFF"
                ;;
            off)
                session_is_remote "$id" || continue
                send_remote_toggle "$pane"; count=$((count + 1))
                ;;
            unlock)
                grep -qx "$id" "$HANDED_OFF" 2>/dev/null || continue
                send_remote_toggle "$pane"; count=$((count + 1))
                ;;
        esac
    done < <(jq -r '.sessions[] | [.session, (.tmux_pane // "")] | @tsv' "$SNAPSHOT")
    [[ $wanted == unlock ]] && rm -f "$HANDED_OFF"
    echo "claude-sessions: remote control $wanted for $count session(s)"
}

# Claude writes a conversation's transcript only once something was said in it: a session nobody
# typed in yet has nothing to resume (claude --resume fails with "No conversation found").
has_conversation() { # id
    local transcript
    for transcript in "${CLAUDE_SESSIONS_TRANSCRIPTS:-$HOME/.claude/projects}"/*/"$1".jsonl; do
        [[ -f $transcript ]] && grep -qs '"type":"user"' "$transcript" && return 0
    done
    return 1
}

# Sessions ended on purpose (exit, the sidebar's x): not offered back after a reboot.
ENDED_SESSIONS="${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions/ended-sessions"
RESTORE_WAIT_S=${CLAUDE_SESSIONS_RESTORE_WAIT:-25}

# Bring back each <dir> <id> pair, each in a tmux session of its own (launch_detached), so none
# depends on the viewer pane: a conversation is resumed; a session nobody typed in yet has none,
# and starts fresh in its folder. A folder that is gone is skipped.
restore_sessions() { # dir id [dir id …]
    (( $# % 2 == 0 && $# > 0 )) || { echo "usage: claude-sessions restore <dir> <id> [<dir> <id> …]" >&2; return 1; }
    local directory id effort
    while (( $# )); do
        directory=$1 id=$2
        shift 2
        if [[ ! -d $directory ]]; then
            log_event WARN manager "restore: skipped $id ($directory is gone)"
            continue
        fi
        effort=$(jq -r '.effort // empty' "$HOME/.cache/claude/statusline-$id.json" 2>/dev/null || true)
        require_effort "$effort" 2>/dev/null || effort=""
        if has_conversation "$id"; then
            launch_detached "$directory" --resume "$id" ${effort:+--effort "$effort"}
        else
            log_event INFO manager "restore: $id had no conversation yet, a fresh session starts in $directory"
            launch_detached "$directory" ${effort:+--effort "$effort"}
        fi
    done
}

# A restart keeps the session's effort unless a new one is given: the level the status line last
# reported (statusline-command.sh copies CLAUDE_EFFORT, which Claude exports to its children).
restart_session() { # id [effort] [detached]
    local id=$1 effort=${2:-} detached=${3:-} directory
    directory=$(session_field "$id" cwd)
    if [[ -z $directory ]]; then
        echo "claude-sessions: session $id has no directory to restart in" >&2
        return 1
    fi
    if [[ -n $effort ]]; then
        require_effort "$effort" || return 1
    else
        effort=$(jq -r '.effort // empty' "$HOME/.cache/claude/statusline-$id.json" 2>/dev/null || true)
        require_effort "$effort" 2>/dev/null || effort=""
    fi
    if [[ $detached == detached ]]; then
        exit_session "$id" || return 1
        if has_conversation "$id"; then
            launch_detached "$directory" --resume "$id" ${effort:+--effort "$effort"}
        else
            launch_detached "$directory" ${effort:+--effort "$effort"}
        fi
        return
    fi
    loading_overlay "Restarting $(basename "$directory")${effort:+ · effort $effort} …" "$directory" "$id"
    exit_session "$id" || return 1
    if ! has_conversation "$id"; then
        # Nothing said yet: a fresh session in the same directory is the same thing.
        new_session "$directory" ${effort:+--effort "$effort"}
        return
    fi
    # The exited session leaves a dead pane behind; replace it right away so the gap reads as intended.
    tmux respawn-pane -k -t "$(viewer_pane)" sh -c 'printf "\n  ⟳ Session closed, resuming it …\n"; sleep 30'
    resume_session "$directory" "$id" "$effort"
}

# One after the other: each restart reuses the viewer pane. The session shown before comes back.
# Each one is launched in a tmux session of its own, never in the viewer pane: a launch there dies
# with whatever takes the pane next (the next restart, a click on another card) until
# claude-auto-retry has moved it out, and one restart-all lost a session that way.
restart_sessions() { # id...
    local shown id waited
    shown=$(cat "$CURRENT" 2>/dev/null || true)
    for id in "$@"; do
        restart_session "$id" "" detached || log_event WARN sessions "restart of $id failed during restart-all"
    done
    [[ -n $shown ]] || return 0
    # The session that was on screen comes back once it reports in again (it may be one of these).
    for (( waited = 0; waited < RESTORE_WAIT_S; waited++ )); do
        [[ -n $(session_field "$shown" tmux_pane) ]] && break
        sleep 1
    done
    view_session "$shown" || true
}

# A session started out of the viewer pane, in a tmux session named like claude-auto-retry's so the
# manager treats it as any other; inside tmux the launcher runs claude right there. A failed start
# is logged, since nobody watches that session.
launch_detached() { # dir claude-arguments...
    local directory=$1
    shift
    tmux new-session -d -s "claude-retry-restart-$(date +%s%N)" -x 200 -y 50 -c "$directory" \
        env -u TMUX_PANE CLAUDE_SESSIONS_INSIDE=1 \
        fish -ic 'claude $argv; or claude-sessions log manager ERROR "claude exited with status $status in $PWD"' -- "$@"
}

# The morning digest (the sidebar's D, and the first time the cockpit opens each day): yesterday's
# sessions and cost, today so far, plan usage, who waits for you, the pull requests. Any key goes
# back to the session that was in the pane.
DIGEST_DAY="${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions/digest-day"

show_digest() {
    ensure_manager
    local previous
    previous=$(cat "$CURRENT" 2>/dev/null || true)
    tmux respawn-pane -k -t "$(viewer_pane)" bash -c 'claude-sessions-sidebar digest
        read -rsn 1 -p "  any key goes back " _
        if [[ -n $1 ]]; then exec claude-sessions view "$1"; else exec claude-sessions idle; fi' bash "$previous"
    tmux set-option -p -t "$(viewer_pane)" @project "digest"
    mkdir -p "$(dirname "$DIGEST_DAY")"
    date +%F > "$DIGEST_DAY"
}

digest_due() {
    [[ $(cat "$DIGEST_DAY" 2>/dev/null) != "$(date +%F)" ]]
}

show_manager() {
    ensure_manager
    if [[ -z ${1:-} ]] && "$ON_CLAUDE_WORKSPACE"; then
        hyprctl dispatch 'hl.dsp.focus({ workspace = "previous" })' >/dev/null
        return
    fi
    if [[ -n ${1:-} ]]; then
        view_session "$1" && focus_viewer
    elif digest_due; then
        show_digest
    fi
    # Hide the bar before the switch rather than after it, or it flashes over the cockpit.
    "$BAR_VISIBILITY" hide
    if hyprctl -j clients | jq -e --arg class "$WINDOW_CLASS" 'any(.[]; .class == $class)' >/dev/null; then
        hyprctl dispatch "hl.dsp.focus({ window = \"class:^$WINDOW_CLASS\$\" })" >/dev/null
    else
        # claude-sessions.conf adds the key maps that turn Ctrl+Tab and Ctrl+digit into chords tmux can see.
        setsid -f kitty --class "$WINDOW_CLASS" --config "$KITTY_CONFIG" --config "$KITTY_MANAGER_CONFIG" -e claude-sessions
        # The window rule puts it on the Claude workspace; go there now rather than when it maps.
        hyprctl dispatch "hl.dsp.focus({ workspace = $WORKSPACE })" >/dev/null
    fi
}

sweep_caches() {
    # One status-line file per session ever run, and toast ids of sessions long gone.
    find "$HOME/.cache/claude" -maxdepth 1 \( -name 'statusline-*.json' -o -name 'toast-*.id' \) -mtime +7 -delete 2>/dev/null || true
    # Run requests and their results (ask-to-run).
    find "$HOME/.cache/claude/runs" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null || true
    find "$HOME/.cache/claude/guides" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null || true
}

doctor() {
    local failures=0 daemon_pid fifo="${XDG_RUNTIME_DIR:-/tmp}/osd.fifo"
    report() { # ok|fail  what  [fix]
        if [[ $1 == ok ]]; then
            printf '  ok    %s\n' "$2"
        else
            printf '  FAIL  %s\n        fix: %s\n' "$2" "$3"
            failures=$((failures + 1))
        fi
    }
    echo "daemon"
    # pgrep -f also matches wrappers around the daemon (a shell, a unit's exec line), so every
    # match is inspected and the daemon is the one holding the FIFO open.
    local daemon_pids holder=""
    daemon_pids=$(pgrep -x osd || true)
    for daemon_pid in $daemon_pids; do
        if ls -l "/proc/$daemon_pid/fd" 2>/dev/null | grep -q osd.fifo; then holder=$daemon_pid; break; fi
    done
    if [[ -n $daemon_pids ]]; then report ok "osd running (pid ${daemon_pids//$'\n'/, })"; else report fail "osd not running" "systemctl --user restart osd.service"; fi
    if [[ -p $fifo ]]; then report ok "FIFO $fifo exists"; else report fail "FIFO $fifo missing" "restart the daemon, it creates it"; fi
    if [[ -n $holder ]]; then report ok "daemon reads the FIFO (pid $holder)"; elif [[ -n $daemon_pids ]]; then report fail "no osd process holds the FIFO" "systemctl --user restart osd.service; then: pgrep -ax osd"; fi
    echo "greywall (what sessions can reach)"
    local greywall="$HOME/.config/greywall/greywall.json"
    if jq -e --arg path "$fifo" '.filesystem.allowWrite | index($path)' "$greywall" >/dev/null 2>&1; then report ok "$fifo in allowWrite"; else report fail "$fifo not in greywall allowWrite" "add it to filesystem.allowWrite in $greywall"; fi
    if jq -e '.filesystem.allowRead | index("~/dotfiles/config/claude")' "$greywall" >/dev/null 2>&1; then report ok "~/dotfiles/config/claude in allowRead"; else report fail "~/dotfiles/config/claude not in greywall allowRead" "add it, or hooks are unreachable from other projects"; fi
    echo "hooks"
    if [[ -x $(readlink -f "$HOME/.claude/hooks/session-state.sh") ]]; then report ok "~/.claude/hooks/session-state.sh resolves"; else report fail "~/.claude/hooks/session-state.sh does not resolve" "ln -s ../dotfiles/config/claude/.claude/hooks ~/.claude/hooks"; fi
    local event missing_events=""
    for event in SessionStart UserPromptSubmit PostToolUse Notification Stop SessionEnd; do
        jq -e --arg event "$event" '[.hooks[$event][]?.hooks[]?.command] | any(test("session-state.sh"))' "$HOME/.claude/settings.json" >/dev/null 2>&1 \
            || missing_events="$missing_events $event"
    done
    if [[ -z $missing_events ]]; then
        report ok "settings.json runs session-state.sh on the six events"
    else
        report fail "settings.json misses session-state.sh on:$missing_events" "add {\"type\": \"command\", \"command\": \"bash ~/.claude/hooks/session-state.sh\"} under hooks.<event>"
    fi
    if [[ -x $(readlink -f "$HOME/.claude/statusline-command.sh") ]]; then report ok "status line script resolves"; else report fail "~/.claude/statusline-command.sh does not resolve" "ln -s ../dotfiles/config/claude/.claude/statusline-command.sh ~/.claude/statusline-command.sh"; fi
    echo "bar"
    if pgrep -x waybar >/dev/null; then report ok "waybar running"; else report fail "waybar not running" "waybar &"; fi
    if pgrep -f workspace-listener.sh >/dev/null; then report ok "workspace listener running"; else report fail "workspace-listener.sh not running" "pkill -SIGUSR2 waybar (reload) and check custom/workspace-listener in config.jsonc"; fi
    local wanted=1; "$ON_CLAUDE_WORKSPACE" && wanted=0
    if [[ $(cat "${XDG_RUNTIME_DIR:-/tmp}/waybar-visible" 2>/dev/null || echo 1) == "$wanted" ]]; then report ok "bar visibility matches the workspace"; else report fail "bar visibility state out of step" "$HOME/.config/waybar/scripts/waybar-visibility.sh sync"; fi
    echo "tmux"
    if [[ $(tmux show -gv window-size 2>/dev/null) == latest ]]; then report ok "window-size latest"; else report fail "tmux window-size is not latest" "tmux source ~/.config/tmux/tmux.conf"; fi
    if tmux list-keys -T root 2>/dev/null | grep -q 'root Left .*viewer'; then report ok "Left from the session pane to the column bound"; else report fail "Left is not bound to the column in the session pane" "tmux source ~/.config/tmux/tmux.conf"; fi
    echo "manager"
    if tmux has-session -t "=$MANAGER" 2>/dev/null; then
        report ok "manager tmux session exists"
        if [[ $(tmux display-message -p -t "$(sidebar_pane)" '#{pane_dead}' 2>/dev/null) == 0 ]]; then report ok "sidebar alive"; else report fail "sidebar pane dead" "claude-sessions reload"; fi
        if [[ -n $(viewer_pane) ]]; then report ok "viewer pane tagged"; else report fail "manager panes lack role tags" "tmux kill-session -t $MANAGER; claude-sessions prepare"; fi
    else
        report fail "manager tmux session missing" "claude-sessions prepare (systemctl --user start claude-sessions.service)"
    fi
    local usage="${XDG_RUNTIME_DIR:-/tmp}/claude-usage.json"
    if [[ -f $usage ]] && (( $(date +%s) - $(stat -c %Y "$usage") < 900 )); then report ok "usage cache fresh"; else report fail "usage cache missing or stale" "$HOME/.config/waybar/scripts/claude-usage.sh five_hour (needs the OAuth token in ~/.claude/.credentials.json)"; fi
    echo "services and updates"
    local unit
    # Sessions frozen by game-performance during a game; still listed with no game means a missed thaw.
    if [[ -s ${XDG_RUNTIME_DIR:-/tmp}/game-performance.frozen ]] && ! pgrep -x gamemoded >/dev/null; then
        report fail "Claude sessions still paused after a game" "game-performance off"
    fi
    for unit in claude-update.timer elephant.service walker.service; do
        if [[ $(systemctl --user is-active "$unit" 2>/dev/null) == active ]]; then report ok "$unit active"; else report fail "$unit not active" "systemctl --user enable --now $unit (units in .handoff/systemd-user until installed)"; fi
    done
    local versions_dir=${CLAUDE_VERSIONS_DIR:-$HOME/.local/share/claude/versions} link=${CLAUDE_LINK:-$HOME/.local/bin/claude} newest linked
    # || true: no version there (grep matches nothing) must not stop the doctor half-way (pipefail).
    newest=$(find "$versions_dir" -maxdepth 1 -type f -executable -printf '%f\n' 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)
    linked=$(basename "$(readlink "$link" 2>/dev/null || true)")
    if [[ -z $newest || $linked == "$newest" ]]; then report ok "claude starts the newest version (${linked:-none})"; else report fail "claude starts $linked, $newest is in the versions folder" "claude-update (claude-update.timer runs it every 6 h)"; fi
    local archive="${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions/usage.sqlite" newest_transcript
    newest_transcript=$(find "${CLAUDE_SESSIONS_TRANSCRIPTS:-$HOME/.claude/projects}" -name '*.jsonl' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 || true)
    if [[ -f $archive ]] && (( $(stat -c %Y "$archive") + 600 >= ${newest_transcript%.*:-0} )); then report ok "usage archive up to date"; else report fail "usage archive missing or behind the transcripts" "claude-sessions reload (the sidebar keeps it), or claude-sessions-sidebar costs"; fi
    local recent_facts
    recent_facts=$(find "$HOME/.cache/claude" -maxdepth 1 -name 'statusline-*.json' -mmin -60 2>/dev/null || true)
    if [[ -z $recent_facts ]] || jq -e 'select(.effort != null)' $recent_facts >/dev/null 2>&1; then report ok "status line reports the effort"; else report fail "status line reports no effort" "install .handoff/claude/statusline-command.sh"; fi
    if command -v ask-to-run >/dev/null && command -v claude-run-approve >/dev/null; then report ok "ask-to-run and claude-run-approve resolve"; else report fail "ask-to-run or claude-run-approve not on PATH" "cd ~/dotfiles/config && stow -t ~ --restow bin"; fi
    if command -v ask-to-guide >/dev/null && command -v claude-guide >/dev/null && command -v kitten >/dev/null; then report ok "ask-to-guide, claude-guide and kitten resolve"; else report fail "ask-to-guide, claude-guide or kitten not on PATH" "cd ~/dotfiles/config && stow -t ~ --restow bin"; fi
    if grep -qs "this terminal" "$HOME/.config/fish/config.fish"; then report ok "claude asks manager or terminal"; else report fail "fish claude function is the old one" "install .handoff/fish/config.fish"; fi
    echo "logs"
    local since errors last_error
    since=$(date -d '24 hours ago' -Iseconds)
    # The health check's own result is left out: it runs this doctor, and its last failure would
    # fail the next run for a day.
    errors=$(awk -v since="$since" '$1 >= since && $2 == "ERROR" && $3 != "health:"' "$LOG_FILE" 2>/dev/null | wc -l)
    last_error=$(awk -v since="$since" '$1 >= since && $2 == "ERROR" && $3 != "health:"' "$LOG_FILE" 2>/dev/null | tail -1)
    if (( errors == 0 )); then report ok "no error logged in 24 h ($LOG_FILE)"; else report fail "$errors error(s) logged in 24 h, the last: ${last_error:0:160}" "claude-sessions logs"; fi
    echo "pane heuristics (what the daemon sees for each running session, and the process that keeps it alive)"
    if [[ -s $SNAPSHOT ]]; then
        while IFS=$'\t' read -r session project state pane; do
            local alive seen
            alive=$(osd liveness "$session" "$pane")
            [[ -n $pane ]] || { printf '  %-24s hook says %-9s no tmux pane     process %s\n' "$project" "$state" "$alive"; continue; }
            seen=$(tmux capture-pane -p -t "$pane" -S -20 2>/dev/null | osd classify)
            printf '  %-24s hook says %-9s pane shows %-9s process %s\n' "$project" "$state" "$seen" "$alive"
        done < <(jq -r '.sessions[] | [.session, .project, .state, (.tmux_pane // "")] | @tsv' "$SNAPSHOT")
    else
        echo "  no session tracked"
    fi
    (( failures == 0 )) && echo "all good" || { echo "$failures problem(s)"; return 1; }
}

# Parallel sessions on one repository each get their own clone, so they never edit the same files.
# A clone, not a git worktree: greywall mounts only the folder a session starts in, and a worktree
# keeps its metadata in the main repository's .git, which the sandbox would not see. A local clone
# hardlinks the objects (fast, little disk) and is self-contained; origin points at the real
# remote. Clones live in $CLONES_DIR/<repository>/<name>; the registry and the sidebar name such a
# session after <repository>. A per-project Docker daemon (agent-docker) does not follow a clone.
CLONES_DIR="${CLAUDE_SESSIONS_CLONES:-$HOME/IdeaProjects/.parallel}"
GREYWALL="${CLAUDE_SESSIONS_GREYWALL:-$HOME/.local/bin/greywall}"

# The repository a clone is filed under: a clone of a clone (+ on a card that runs in one) still
# belongs to the first repository.
clone_repository() { # repository-top
    case $1 in
        "$CLONES_DIR"/*/*) local inside=${1#"$CLONES_DIR"/}; echo "${inside%%/*}" ;;
        *) basename "$1" ;;
    esac
}

clone_for() { # source-dir name -> prints the clone's path, created on first use
    local source=$1 name=$2 top repository clone origin
    top=$(git -C "$source" rev-parse --show-toplevel) || return 1
    repository=$(clone_repository "$top")
    clone="$CLONES_DIR/$repository/$name"
    if [[ ! -d $clone/.git ]]; then
        mkdir -p "$CLONES_DIR/$repository"
        git clone --quiet "$top" "$clone" >&2 || return 1
        if origin=$(git -C "$top" remote get-url origin 2>/dev/null); then
            git -C "$clone" remote set-url origin "$origin"
        fi
        # A pull request's clone gets someone else's code (its .claude/settings.json hooks, its
        # CLAUDE.md): Claude Code's trust dialog must ask about it, never inherit the yes.
        if [[ $name != pr-* ]]; then inherit_trust "$top" "$clone"; fi
    fi
    printf '%s\n' "$clone"
}

# A fresh clone holds the same files as its source, so a source Claude already trusts makes the
# clone trusted too: no trust prompt on each parallel session. An untrusted source leaves the prompt.
# Claude rewrites ~/.claude.json while it runs; the write is atomic (temp file, then mv), and
# losing a race only brings the prompt back.
CLAUDE_CONFIG_FILE="$HOME/.claude.json"

inherit_trust() { # source-dir clone-dir
    local updated
    jq -e --arg source "$1" '.projects[$source].hasTrustDialogAccepted == true' "$CLAUDE_CONFIG_FILE" >/dev/null 2>&1 || return 0
    if ! updated=$(mktemp "$CLAUDE_CONFIG_FILE.XXXXXX"); then
        log_event WARN sessions "could not mark $2 as trusted: no temp file next to $CLAUDE_CONFIG_FILE"
        return 0
    fi
    if jq --arg clone "$2" '.projects[$clone].hasTrustDialogAccepted = true' "$CLAUDE_CONFIG_FILE" > "$updated"; then
        chmod 600 "$updated"
        mv -f "$updated" "$CLAUDE_CONFIG_FILE"
    else
        rm -f "$updated"
        log_event WARN sessions "could not mark $2 as trusted in $CLAUDE_CONFIG_FILE"
    fi
}

# A failure in the background (the sidebar runs these without a terminal) shows in the viewer.
show_failure() { # message
    log_event ERROR manager "$1"
    ensure_manager
    tmux respawn-pane -k -t "$(viewer_pane)" sh -c 'printf "\n  ✗ %s\n\n  any key closes this pane " "$1"; read -r _' sh "$1"
}

# A new session on its own branch, in its own clone of the repository (the sidebar's A).
parallel_session() { # dir branch
    local directory=$1 branch=$2 clone
    require_plain_directory "$directory"
    if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
        show_failure "not a branch name: $branch"; return 1
    fi
    if ! clone=$(clone_for "$directory" "${branch//\//-}" 2>&1); then
        show_failure "could not clone $directory: $clone"; return 1
    fi
    # The clone may be one a session already ran in, with a .git/config it could write: git runs
    # inside greywall there, as for lazygit.
    git_in_sandbox "$clone" switch --quiet -c "$branch" 2>/dev/null || git_in_sandbox "$clone" switch --quiet "$branch"
    new_session "$clone"
}

git_in_sandbox() { # dir git-arguments...
    local directory=$1
    shift
    (cd "$directory" && "$GREYWALL" --auto-profile --profile claude -- git "$@")
}

# A Claude session reviewing pull request <number>, at its head in a clone (the sidebar's c on a
# pull request).
review_session() { # dir number
    local directory=$1 number=$2 clone
    require_plain_directory "$directory"
    if [[ ! $number =~ ^[0-9]+$ ]]; then
        show_failure "not a pull request number: $number"; return 1
    fi
    # Always a fresh clone: fetching needs the network and Theo's credentials, so git runs out here,
    # and out here it must never run in a clone a session could have written (.git/config). A
    # pull request reviewed before gets pr-<number>-<time>; K deletes the old ones.
    local name="pr-$number" top repository
    top=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || { show_failure "not a repository: $directory"; return 1; }
    repository=$(clone_repository "$top")
    if [[ -e $CLONES_DIR/$repository/$name ]]; then name="pr-$number-$(date +%Y%m%d-%H%M%S)"; fi
    if ! clone=$(clone_for "$directory" "$name" 2>&1); then
        show_failure "could not clone $directory: $clone"; return 1
    fi
    if ! git -C "$clone" fetch --quiet origin "pull/$number/head" 2>/dev/null || ! git -C "$clone" switch --quiet --detach FETCH_HEAD; then
        show_failure "could not fetch pull request #$number from $(git -C "$clone" remote get-url origin)"; return 1
    fi
    new_session "$clone" "Review pull request #$number of this repository (its head is checked out here): read the diff against its base branch, run the relevant tests, and report problems by severity with file and line. Do not push, and do not comment on GitHub."
}

# The clones left by + and by pull request reviews, in a popup (the sidebar's K): each one with no
# session in it, no uncommitted change and no commit missing from its remote can go, after a y.
clones_popup() {
    tmux display-popup -E -w 80% -h 70% -T " clones " "$0" clones-review
}

# What a clone holds that exists nowhere else: "changes", "commits", or nothing. git runs inside
# greywall, as for lazygit: the clone's .git/config is the session's to write (core.fsmonitor,
# filters), and out here git would run what it names. Its answer only decides whether to keep.
clone_leftovers() { # clone
    local report
    report=$(cd "$1" && "$GREYWALL" --auto-profile --profile claude -- sh -c \
        'git status --porcelain 2>/dev/null | head -1; echo "-- commits"; git log --branches --not --remotes --oneline 2>/dev/null | head -1' 2>/dev/null) \
        || { echo "unreadable"; return; }
    if [[ ${report%%-- commits*} == *[![:space:]]* ]]; then echo "changes"
    elif [[ ${report#*-- commits} == *[![:space:]]* ]]; then echo "commits"
    fi
}

clones_review() {
    local clones_root clone real in_use leftovers removable=() line
    clones_root=$(realpath -e "$CLONES_DIR" 2>/dev/null) || { echo "No clones ($CLONES_DIR does not exist)."; read -r -p "Enter closes. " _; return 0; }
    in_use=$(jq -r '.sessions[]?.cwd // empty' "$SNAPSHOT" 2>/dev/null)
    echo "Clones in $CLONES_DIR"
    echo
    for clone in "$clones_root"/*/*/; do
        clone=${clone%/}
        [[ -d $clone/.git && ! -L $clone ]] || continue
        line="  $(basename "$(dirname "$clone")")/$(basename "$clone")"
        if grep -qxF -- "$clone" <<< "$in_use"; then
            echo "$line: kept, a session runs in it"
            continue
        fi
        leftovers=$(clone_leftovers "$clone")
        case $leftovers in
            changes) echo "$line: kept, uncommitted changes" ;;
            commits) echo "$line: kept, commits not on its remote" ;;
            unreadable) echo "$line: kept, could not be checked" ;;
            *) echo "$line: can go"; removable+=("$clone") ;;
        esac
    done
    echo
    if (( ${#removable[@]} == 0 )); then
        read -r -p "Nothing to delete. Enter closes. " _
        return 0
    fi
    read -r -p "Delete the ${#removable[@]} clone(s) that can go? [y/N] " answer || answer=""
    [[ $answer == y || $answer == Y ]] || { echo "Nothing deleted."; return 0; }
    for clone in "${removable[@]}"; do
        # Only a folder two levels under the clones folder, reached without a symlink.
        real=$(realpath -e "$clone" 2>/dev/null) || continue
        [[ $real == "$clones_root"/*/* && $real != "$clones_root"/*/*/* && ! -L $clone ]] || { echo "  refused: $clone"; continue; }
        rm -rf -- "$real" && echo "  deleted $(basename "$(dirname "$real")")/$(basename "$real")"
        rmdir -- "$(dirname "$real")" 2>/dev/null || true
    done
    log_event INFO sessions "clones: deleted ${#removable[@]}"
    read -r -p "Enter closes. " _ || true
}

# The pull requests window (Super+Ctrl+P, the sidebar's P), on the cockpit only: hidden again
# when it shows; otherwise opened on the pull request list of the repository of the session in
# the pane, or as it was (the review requests) when that session has no GitHub origin.
prs_window() {
    "$ON_CLAUDE_WORKSPACE" || return 0
    local shown directory origin repository
    shown=$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .specialWorkspace.name // ""')
    if [[ $shown == special:prs ]]; then
        hyprctl dispatch 'hl.dsp.workspace.toggle_special("prs")' >/dev/null
        return
    fi
    directory=$(session_field "$(cat "$CURRENT" 2>/dev/null || true)" cwd)
    origin=$( [[ -n $directory ]] && git -C "$directory" remote get-url origin 2>/dev/null || true)
    if [[ $origin =~ github\.com[:/]([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)$ ]]; then
        repository=${BASH_REMATCH[1]%.git}
        hyprctl eval "OPEN_IN_SCRATCHPAD(\"prs\", \"https://github.com/$repository/pulls\")" >/dev/null
    else
        hyprctl eval 'TOGGLE_SCRATCHPAD("prs")' >/dev/null
    fi
}

# The approval of a run request (claude-run-<id>, the daemon starts it) in a pane under the
# session pane. It takes the cursor when Theo is in the session pane, not when he is in the
# column (the other sessions stay usable there; Ctrl+Tab reaches it).
# "close" removes the pane. Nothing happens when the manager does not run.
# The approval being asked, and the session that asked it ("<id> <session>"): its pane shows only
# under that session, and comes back when Theo returns to it (view_session calls place_approval).
APPROVAL_STATE="${XDG_RUNTIME_DIR:-/tmp}/claude-sessions-approval"
RUNS_DIR="${CLAUDE_RUNS_DIR:-$HOME/.cache/claude/runs}"

approval_pane() { # id | close
    tmux has-session -t "=$MANAGER" 2>/dev/null || return 0
    if [[ $1 == close ]]; then
        rm -f "$APPROVAL_STATE"
        hide_approval
        return 0
    fi
    [[ $1 =~ ^[0-9a-f]{12}$ ]] || { echo "claude-sessions: not a run request id: $1" >&2; return 1; }
    # The session named in the request (ask-to-run writes it from inside the sandbox): it only
    # decides under which session the pane shows; the command and its project show in the pane.
    local session
    session=$(jq -r '.session // empty' "$RUNS_DIR/$1.request" 2>/dev/null || true)
    [[ $session =~ ^[0-9a-f-]{36}$ ]] || session=""
    printf '%s %s\n' "$1" "$session" > "$APPROVAL_STATE"
    hide_approval
    place_approval focus
}

# The pane closes itself when its approval ends (remain-on-exit off), often just before a close
# arrives: a pane already gone is the outcome wanted, not a failure.
hide_approval() {
    local pane
    pane=$(pane_by_role approval)
    if [[ -n $pane ]]; then tmux kill-pane -t "$pane" 2>/dev/null || true; fi
}

# The approval pane under the session pane while the session shown is the one that asked (or the
# request names none); hidden under any other session. "focus": Theo in the session pane gets the
# cursor moved to it (claude-run-approve drops what he typed in the first half second, and Decline
# is the default); in the column it stays put.
place_approval() { # [focus]
    local id session pane current was_in_session
    read -r id session < "$APPROVAL_STATE" 2>/dev/null || return 0
    if ! tmux has-session -t "=claude-run-$id" 2>/dev/null; then
        rm -f "$APPROVAL_STATE"
        hide_approval
        return 0
    fi
    current=$(cat "$CURRENT" 2>/dev/null || true)
    if [[ -n $session && $session != "$current" ]]; then
        hide_approval
        return 0
    fi
    pane=$(pane_by_role approval)
    [[ -z $pane ]] || return 0
    was_in_session=$(tmux display-message -p -t "$(viewer_pane)" '#{pane_active}' 2>/dev/null || true)
    pane=$(tmux split-window -v -d -l 40% -t "$(viewer_pane)" -P -F '#{pane_id}' env -u TMUX tmux attach-session -t "=claude-run-$id")
    tag_pane "$pane" approval
    # Gone with its approval even when no "close" comes (the daemon restarted meanwhile): no dead pane left.
    tmux set-option -p -t "$pane" remain-on-exit off
    if [[ ${1:-} == focus && $was_in_session == 1 ]]; then tmux select-pane -t "$pane"; fi
}

# lazygit on a session's repository in a popup over the manager (the sidebar's g): review and
# commit what Claude did without leaving the cockpit; q closes it.
# lazygit runs inside greywall, like a session: git reads the repository's own configuration, which
# a session can write (core.fsmonitor, filters), and out here that would run as Theo. Its settings
# and state live in a folder of their own, the only one it may write besides the repository.
git_popup() { # dir
    local directory=$1 lazygit_home="$HOME/.cache/lazygit-sandbox"
    require_plain_directory "$directory"
    mkdir -p "$lazygit_home/config/lazygit" "$lazygit_home/state"
    if [[ -f $HOME/.config/lazygit/config.yml ]]; then cp "$HOME/.config/lazygit/config.yml" "$lazygit_home/config/lazygit/config.yml"; fi
    tmux display-popup -E -w 92% -h 92% -d "$directory" -T " lazygit · $(basename "$directory") · push with U in the column " \
        env XDG_CONFIG_HOME="$lazygit_home/config" XDG_STATE_HOME="$lazygit_home/state" GIT_SSL_CAINFO="$HOME/.cache/agent-ca/bundle.pem" \
        "$HOME/.local/bin/greywall" --auto-profile --profile claude --allow-path "$lazygit_home" -- lazygit
}

# Pushing the session's branch (the sidebar's U), in a popup: lazygit runs inside greywall, which
# has no SSH key and no agent, so it cannot push. This git runs out here, with Theo's key, in a
# folder a session works in. Sessions cannot write .git/config or .git/hooks (greywall mounts them
# read-only); hooks are off anyway, and the settings that could run a program are reset here.
push_popup() { # dir
    require_plain_directory "$1"
    tmux display-popup -E -w 70% -h 50% -d "$1" -T " push · $(basename "$1") " "$0" push-run "$1"
}

SAFE_PUSH_CONFIG=(-c core.hooksPath=/dev/null -c core.sshCommand=ssh -c core.fsmonitor=false -c core.askPass=
                  -c core.gitProxy= -c credential.helper= -c protocol.ext.allow=never -c protocol.file.allow=never
                  -c remote.origin.receivepack=git-receive-pack)

push_run() { # dir
    local branch url answer
    cd "$1" || return 1
    if ! branch=$(git symbolic-ref --quiet --short HEAD); then
        echo "Not on a branch (detached HEAD): nothing to push."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    url=$(git "${SAFE_PUSH_CONFIG[@]}" ls-remote --get-url origin 2>/dev/null)
    # Only GitHub: a remote rewritten to a path or another host is not pushed to from here.
    if [[ ! $url =~ ^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)[A-Za-z0-9._/-]+$ ]]; then
        echo "origin is $url, not a GitHub repository: not pushed."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
    echo "Push $branch to $url"
    # The commits it sends, when the branch already tracks one (a new branch has no upstream yet).
    git --no-pager log --oneline "@{upstream}..HEAD" 2>/dev/null | head -20 | sed 's/^/  /' || true
    read -r -p "Push? [y/N] " answer || answer=""
    [[ $answer == y || $answer == Y ]] || { echo "Not pushed."; sleep 1; return 0; }
    if git "${SAFE_PUSH_CONFIG[@]}" push --set-upstream origin "refs/heads/$branch:refs/heads/$branch"; then
        log_event INFO sessions "pushed $branch of $(basename "$1")"
        # The card's "↑N unpushed" clears now, not at the session's next turn.
        osd-show session-pushed "$1" 2>/dev/null || true
        echo "Pushed."
        read -r -p "Enter closes. " _ || true
    else
        log_event WARN sessions "push of $branch of $(basename "$1") failed"
        echo "The push failed (above)."
        read -r -p "Enter closes. " _ || true
        return 1
    fi
}

show_usage() {
    ensure_manager
    tmux respawn-pane -k -t "$(viewer_pane)" claude-sessions-sidebar usage
    : > "$CURRENT"
    label_panes usage
}

idle() {
    printf '\n  No session selected.\n\n  In the column: j/k move   Enter open   n peek at the next one needing you   a new   ? every key\n  Ctrl+Tab moves between the column and this pane; Ctrl+1/2/3 jump to a panel from here.\n'
    exec sleep infinity
}

# Every command leaves a line: what ran, how it ended, how long it took. idle (the viewer's
# placeholder) and the log commands themselves are left out. Run from the sidebar in the
# background (CLAUDE_SESSIONS_LOG_STDERR), the error messages go to the log too, since nobody
# sees that terminal.
log_command=${1:-attach}
log_started=$(date +%s%N)
log_arguments="${*:2}"
if [[ $log_command == say ]]; then
    log_arguments="${2:-} (message of ${#3} characters)"
elif [[ $log_command == new ]]; then
    # claude's own arguments after the directory may be a prompt: count them, do not copy them.
    log_arguments="${2:-}"
    if (( $# > 2 )); then log_arguments+=" (+$(( $# - 2 )) claude arguments)"; fi
fi
if [[ $log_command != idle && $log_command != log && $log_command != logs ]]; then
    trap 'log_status=$?; log_event "$( ((log_status)) && echo ERROR || echo INFO)" manager "$log_command $log_arguments -> exit $log_status ($(( ($(date +%s%N) - log_started) / 1000000 )) ms)"' EXIT
fi
if [[ -n ${CLAUDE_SESSIONS_LOG_STDERR:-} ]]; then
    exec 2> >(while IFS= read -r line; do log_event ERROR manager "$line"; done)
fi

case ${1:-attach} in
    attach)
        ensure_manager
        exec env -u TMUX tmux attach-session -t "=$MANAGER"
        ;;
    show) show_manager "${2:-}" ;;
    view) view_session "${2:?usage: claude-sessions view <session-id>}" ;;
    open) view_session "${2:?usage: claude-sessions open <session-id>}" && focus_viewer ;;
    new) shift; new_session "${1:?usage: claude-sessions new <dir> [claude args]}" "${@:2}" ;;
    resume) resume_session "${2:?usage: claude-sessions resume <dir> <session-id>}" "${3:?usage: claude-sessions resume <dir> <session-id>}" ;;
    exit)
        # The session in the pane: a "Closing" screen until it is gone, as for a start.
        if [[ $(cat "$CURRENT" 2>/dev/null) == "${2:?usage: claude-sessions exit <session-id>}" ]]; then
            loading_overlay "Closing $(session_field "$2" project) …" "$(session_field "$2" cwd)" "$2" gone
        fi
        exit_session "$2"
        mkdir -p "$(dirname "$ENDED_SESSIONS")" && printf '%s\n' "$2" >> "$ENDED_SESSIONS"
        ;;
    restore) shift; restore_sessions "$@" ;;
    restart-all) shift; restart_sessions "$@" ;;
    background) background_session "${2:?usage: claude-sessions background <dir> <prompt>}" "${3:?usage: claude-sessions background <dir> <prompt>}" ;;
    loading-screen) show_loading ;;
    restart) restart_session "${2:?usage: claude-sessions restart <session-id> [effort]}" "${3:-}" ;;
    idle) idle ;;
    usage) show_usage ;;
    compact) compact_session "${2:?usage: claude-sessions compact <session-id>}" ;;
    zoom) zoom_viewer ;;
    approval-pane) approval_pane "${2:?usage: claude-sessions approval-pane <id>|close}" ;;
    say) say_to_session "${2:?usage: claude-sessions say <session-id> <message>}" "${3:?usage: claude-sessions say <session-id> <message>}" ;;
    answer) answer_permission "${2:?usage: claude-sessions answer <session-id> yes|no}" "${3:?usage: claude-sessions answer <session-id> yes|no}" ;;
    logs) show_logs "${2:-80}" ;;
    log) log_event "${3:?usage: claude-sessions log <component> <INFO|WARN|ERROR> <message>}" "${2:?}" "${4:?}" ;;
    digest) show_digest ;;
    prs) prs_window ;;
    git) git_popup "${2:?usage: claude-sessions git <dir>}" ;;
    push) push_popup "${2:?usage: claude-sessions push <dir>}" ;;
    push-run) push_run "${2:?usage: claude-sessions push-run <dir>}" ;;
    parallel) parallel_session "${2:?usage: claude-sessions parallel <dir> <branch>}" "${3:?usage: claude-sessions parallel <dir> <branch>}" ;;
    review) review_session "${2:?usage: claude-sessions review <dir> <pr-number>}" "${3:?usage: claude-sessions review <dir> <pr-number>}" ;;
    clones) clones_popup ;;
    clones-review) clones_review ;;
    label-state) label_state "${2:?usage: claude-sessions label-state <state>}" ;;
    prepare) ensure_manager ;;
    reload)
        ensure_manager
        tmux respawn-pane -k -t "$(sidebar_pane)" claude-sessions-sidebar
        ;;
    focus-viewer) focus_viewer ;;
    layout) ensure_manager && apply_layout ;;
    reset)
        tmux kill-session -t "=$MANAGER" 2>/dev/null || true
        osd-show sessions-clear
        rm -f "$CURRENT" "$HOME"/.cache/claude/statusline-*.json "$HOME"/.cache/claude/toast-*.id
        ;;
    doctor) doctor ;;
    handoff) handoff "${2:-on}" ;;
    remote) toggle_remote "${2:?usage: claude-sessions remote <session-id>}" ;;
    sweep) sweep_caches ;;
    *)
        echo "usage: claude-sessions [attach|show [id]|view <id>|open <id>|new <dir>|resume <dir> <id>|exit <id>|restart <id>|handoff [on|off]|remote <id>|prepare|idle|reload|reset|doctor|sweep]" >&2
        exit 2
        ;;
esac
