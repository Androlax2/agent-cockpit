#!/bin/sh
# A Rust program of agent-cockpit (apps/, built with `make build` into apps/target/release): this
# runs the canonical build, found next to it through the stow link.
# A boot-time user service may start before the desktop imports ~/.local/bin into PATH.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
here=$(dirname "$(readlink -f "$0")")
binary="$here/../../../../apps/target/release/$(basename "$0")"
if [ ! -x "$binary" ]; then
    echo "$(basename "$0") is not built yet: make -C ~/agent-cockpit build" >&2
    # In a terminal pane of its own the message stays on screen instead of a dead pane.
    [ $# -eq 0 ] && [ -t 1 ] && exec sleep 3600
    exit 1
fi
exec "$binary" "$@"
